import { Theme, Signal } from "../theme.slint";
import { Card, SectionTitle, Label, Button, Toggle, Pill, Mono, Divider, PanelHead, Slider, SplitToggle, SplitButton, Contact, SubLabel, ColorPicker, Palette, Field, ConfirmButton, Lamp, Disclosure } from "../widgets/controls.slint";
import { NotesView } from "../widgets/update.slint";
import { State } from "../state.slint";
import { ChromaStreamRow, DiagRow } from "../models.slint";

// ONE mock OBS menu item — a mono label that can wear an accent highlight (the one you click).
component ObsMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> lit: false;
    width: txt.preferred-width + 12px;
    height: 18px;
    border-radius: Theme.radius-sm;
    background: lit ? Theme.accent-glow : transparent;
    border-width: lit ? Theme.hair : 0px;
    border-color: Theme.accent-line;
    // ui-lint: allow(loose-text) the chip takes its width from this text
    txt := Mono {
        x: 6px;
        text: root.label;
        color: lit ? Theme.accent : Theme.text-dim;
        font-size: Theme.fs-small;
    }
}

// THE OBS FINDER — a little in-style mock of the OBS window that shows WHERE the setting hides:
// the MENU BAR (not Settings), the Tools menu, then "WebSocket Server Settings". The exact path
// that's annoying to find the first time. Pure decoration built from the app's own tokens.
component ObsFinder inherits Rectangle {
    background: Theme.bg;
    border-radius: Theme.radius;
    border-width: Theme.hair;
    border-color: Theme.line;
    clip: true;
    height: 112px;

    // title bar — a slim chrome strip so it reads as "an app window": a little app mark on the
    // left, the name, and three window-control dots on the right.
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 20px;
        background: Theme.bg-2;
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 6px;
            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.text-faint; } }
            Mono { text: "OBS Studio"; color: Theme.text-faint; font-size: Theme.fs-small; }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 5px;
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.line; }
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.line; }
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.line; }
                }
            }
        }
    }

    // menu bar — Tools is lit. Laid out left-to-right; the dropdown below points at it.
    menubar := HorizontalLayout {
        x: 6px; y: 22px; height: 18px; spacing: 2px; alignment: start;
        ObsMenuItem { label: "File"; }
        ObsMenuItem { label: "Edit"; }
        ObsMenuItem { label: "View"; }
        ObsMenuItem { label: "Docks"; }
        ObsMenuItem { label: "Profile"; }
        tools := ObsMenuItem { label: "Tools"; lit: true; }
        ObsMenuItem { label: "Help"; }
    }

    // the drop that falls from Tools → the target item highlighted
    dropdown := Rectangle {
        x: menubar.x + tools.x - 4px;
        y: 42px;
        width: 172px;
        background: Theme.bg-2;
        border-radius: Theme.radius-sm;
        border-width: Theme.hair;
        border-color: Theme.accent-line;
        height: 62px;
        VerticalLayout {
            padding: 5px; spacing: 2px;
            Mono { text: "Auto-Configuration Wizard"; color: Theme.text-faint; font-size: Theme.fs-small; }
            Rectangle {
                height: 20px; border-radius: Theme.radius-sm;
                background: Theme.accent-glow; border-width: Theme.hair; border-color: Theme.accent-line;
                Mono {
                    x: 6px; text: "WebSocket Server Settings"; color: Theme.accent;
                    font-size: Theme.fs-small; vertical-alignment: center; height: parent.height;
                }
            }
            Mono { text: "Scripts"; color: Theme.text-faint; font-size: Theme.fs-small; }
        }
    }
    // a hairline tick joining Tools to its dropdown (the "this opens that" cue)
    Rectangle {
        x: dropdown.x + 8px; y: 40px; width: 1px; height: 2px; background: Theme.accent-line;
    }
}

// A connection LAMP — a small contact light that reads dark at rest and lights phosphor with a
// soft halo the instant its protocol is actually up (a port bound, OBS authenticated). The one
// place a glow is earned: a lamp that is genuinely ON. The fade-in IS the "yes, it connected"
// signal the eye catches without reading a word.
component ConnLamp inherits Rectangle {
    in property <bool> lit;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: root.lit ? Theme.accent : Theme.text-faint.with-alpha(0.4);
    drop-shadow-color: root.lit ? Theme.accent : transparent;
    drop-shadow-blur: root.lit ? 6px : 0px;
    animate background, drop-shadow-blur, drop-shadow-color { duration: Theme.settle; }
}

// A protocol status line: the live lamp + the honest readout text, vertically aligned.
component ConnStatus inherits HorizontalLayout {
    in property <bool> lit;
    in property <string> text;
    spacing: 6px;
    VerticalLayout { alignment: center; ConnLamp { lit: root.lit; } }
    Mono { text: root.text; color: Theme.text-faint; }
}

// The quiet inline disclosure for a status line's detail rows — a WORD beside the readout, not a
// row-height key flung to the panel's far edge. Caret carries the open state, ink brightens on
// hover; same grammar as the Disclosure atom, sized to sit inside a status row.
component MoreLink inherits Rectangle {
    in property <bool> open;
    in property <string> closed-text: "▸ more";
    in property <string> open-text: "▾ less";
    callback clicked();
    width: t.preferred-width;
    t := Text {
        text: root.open ? root.open-text : root.closed-text;
        height: 100%;
        vertical-alignment: center;
        font-family: Theme.mono;
        font-size: Theme.fs-small;
        color: mta.has-hover ? Theme.text-mid : Theme.text-faint;
        animate color { duration: Theme.quick; }
    }
    mta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component ChromaStream inherits HorizontalLayout {
    in property <ChromaStreamRow> stream;
    spacing: 8px;
    VerticalLayout { width: 76px; alignment: center; Mono { text: root.stream.device; color: Theme.text-mid; } }
    VerticalLayout { width: 78px; alignment: center; Mono { text: root.stream.effect; color: Theme.text-faint; } }
    HorizontalLayout {
        spacing: 3px;
        Rectangle { width: 10px; height: 10px; border-radius: 2px; background: root.stream.first; border-width: Theme.hair; border-color: Theme.line; }
        Rectangle { width: 10px; height: 10px; border-radius: 2px; background: root.stream.second; border-width: Theme.hair; border-color: Theme.line; }
        Rectangle { width: 10px; height: 10px; border-radius: 2px; background: root.stream.third; border-width: Theme.hair; border-color: Theme.line; }
    }
    Mono { text: root.stream.detail; color: Theme.text-faint; }
}

// SOUND PULSE — a sound-wave AURA that pulses OUT around the notification CARD (the puck). Toggling the
// audio cue fires a strong pulse (rings bloom outward on ON, retreat inward on OFF); nudging the VOLUME
// fires a soft one — and every pulse's reach scales with the volume, so the card itself reacts to the cue.
// Re-triggerable (animation-tick driven) and gated by `live`, so it's perfectly still at rest.
component RingPulse inherits Rectangle {
    in property <bool> audio;
    in property <float> amp;          // 0..1, the live volume
    property <duration> t0;
    property <bool> live: false;
    property <bool> outward: true;    // ON blooms out, OFF retreats in
    property <float> strength: 1.0;   // a toggle is a strong pulse; a volume nudge is soft
    // 0→1 over the pulse, frozen (and dependency-free, so no repaint) when not live
    property <float> p: root.live ? max(0.0, min(1.0, (animation-tick() - root.t0) / 660ms)) : 1.0;
    Timer { interval: 700ms; running: root.live; triggered => { root.live = false; } }
    function fire(out: bool, strong: float) {
        root.outward = out;
        root.strength = strong;
        root.t0 = animation-tick();
        root.live = true;
    }
    changed audio => { root.fire(root.audio, 1.0); }   // toggle: strong, direction = new state
    changed amp => { root.fire(true, 0.5); }            // volume: a soft outward nudge
    background: transparent;
    // three concentric rings, staggered, each tracing the card's rounded rect and blooming outward
    for k in [0, 1, 2] : Rectangle {
        property <float> rp: max(0.0, min(1.0, root.p * 1.34 - k * 0.17));
        property <float> ef: root.outward ? (1.0 - (1.0 - self.rp) * (1.0 - self.rp)) : (1.0 - self.rp);
        property <length> grow: (8px + 20px * root.amp * root.strength) * self.ef;
        // ui-lint: allow(bleed) the rings are drawn around the card, outside it by design
        x: -self.grow;
        y: -self.grow;
        width: parent.width + 2 * self.grow;
        height: parent.height + 2 * self.grow;
        border-radius: Theme.radius-sm + self.grow;   // trace the CARD's corner, blooming outward
        background: transparent;
        border-width: 1.5px;
        border-color: Theme.accent.with-alpha((1.0 - self.rp) * 0.5 * root.strength);
    }
}

// NOTIFICATION PLACER — a mock monitor you drop the confirmation card onto. Drag it anywhere; it's
// MAGNETICALLY drawn to a 3×3 grid of clean spots (the named corners/edges + their centres), but you
// can release on any free pixel ("custom"). The five NAMED presets light when the card rests on them;
// "off" dims the screen (audio-only). Everything commits through ONE call — set-notif-pos(x,y) — and
// Rust canonicalises an exact spot back to its preset slug. (The page Flickable is interactive:false,
// so this drag never fights a page scroll.)
component NotifPlacer inherits Rectangle {
    // gated with the notifications master switch — dimmed + inert when notifications are off, so the
    // drag surface can't be used behind a disabled subsystem (mirrors the atoms' `enabled`).
    in property <bool> enabled: true;
    property <bool> off: State.notif-placement == "off";
    property <length> inset: 16px;          // keeps the card off the very bezel
    property <length> puck-w: 62px;
    property <length> puck-h: 22px;
    property <length> track-w: self.width - 2 * self.inset - self.puck-w;   // travel for the card's left edge
    property <length> track-h: self.height - 2 * self.inset - self.puck-h;
    property <bool> dragging: false;
    property <float> drag-x;
    property <float> drag-y;
    // the live anchor the puck shows: the drag while dragging, else the saved truth
    property <float> ax: self.dragging ? self.drag-x : State.notif-x;
    property <float> ay: self.dragging ? self.drag-y : State.notif-y;

    // per-axis magnet: snap to 0 / 0.5 / 1 within a threshold, free everywhere else
    pure function snap1(v: float) -> float {
        if (v < 0.12) { return 0.0; }
        if (v > 0.88) { return 1.0; }
        if (v > 0.4 && v < 0.6) { return 0.5; }
        return v;
    }
    // pointer (relative to the screen) → the snapped normalised anchor (the card's CENTRE follows you)
    function place-at(mx: length, my: length) {
        self.drag-x = self.snap1(max(0.0, min(1.0, (mx - self.puck-w / 2 - self.inset) / self.track-w)));
        self.drag-y = self.snap1(max(0.0, min(1.0, (my - self.puck-h / 2 - self.inset) / self.track-h)));
    }

    min-width: 348px; max-width: 348px;   // pin the mock screen's width (can't also set `width`)
    height: 196px;
    // a deliberate monitor-bezel exception — a physical screen reads rounder than an instrument
    // control, so this stays 7px rather than snapping to Theme.radius (4px).
    border-radius: 7px;
    background: @linear-gradient(180deg, Theme.bg-2 0%, Theme.bg 100%);   // a faint screen sheen
    border-width: Theme.hair;
    border-color: Theme.line;
    clip: true;
    opacity: root.off ? Theme.dim-gated : 1.0;
    animate opacity { duration: Theme.quick; }

    // faint screen structure — the centre cross the magnet pulls toward
    Rectangle { x: parent.width / 2 - 0.5px; y: root.inset; width: 1px; height: parent.height - 2 * root.inset; background: Theme.line-soft; }
    Rectangle { x: root.inset; y: parent.height / 2 - 0.5px; width: parent.width - 2 * root.inset; height: 1px; background: Theme.line-soft; }

    // the five NAMED preset SNAP DOTS — quiet little targets, NOT card-like boxes. The one the card is
    // parked on hides (the card itself marks the spot), so a resting card never sits inside a stray square.
    for ps in [
        {nx: 0.0, ny: 0.0}, {nx: 0.5, ny: 0.0}, {nx: 1.0, ny: 0.0},
        {nx: 0.0, ny: 1.0}, {nx: 1.0, ny: 1.0},
    ] : Rectangle {
        property <bool> lit: root.ax > ps.nx - 0.01 && root.ax < ps.nx + 0.01
            && root.ay > ps.ny - 0.01 && root.ay < ps.ny + 0.01;
        width: 6px; height: 6px; border-radius: 3px;
        x: root.inset + root.puck-w / 2 - self.width / 2 + ps.nx * root.track-w;
        y: root.inset + root.puck-h / 2 - self.height / 2 + ps.ny * root.track-h;
        background: Theme.text-faint.with-alpha(0.5);
        opacity: self.lit ? 0.0 : 1.0;
        animate opacity { duration: Theme.quick; }
    }

    // the sound-wave AURA — rings bloom from around the CARD itself (and follow it as it moves),
    // clipped to the screen. Pulses on audio toggle + volume; see RingPulse.
    sound := RingPulse {
        x: root.inset + root.ax * root.track-w;
        y: root.inset + root.ay * root.track-h;
        width: root.puck-w; height: root.puck-h;
        audio: State.notif-audio; amp: State.notif-volume;
        animate x, y { duration: Theme.press-throw; easing: ease-out; }
    }

    // THE CARD — the confirmation card in miniature; drag it anywhere
    puck := Rectangle {
        width: root.puck-w; height: root.puck-h;
        x: root.inset + root.ax * root.track-w;
        y: root.inset + root.ay * root.track-h;
        border-radius: Theme.radius-sm;
        // mirrors the real card: a grounded squircle (fill + border) when "card background" is ON, and
        // the background REMOVED when it's OFF — the card floats as just its content (lamp + lines). The
        // off state fades to the SAME hue at zero alpha (never `transparent`), so it dissolves cleanly.
        background: State.notif-panel ? (root.dragging ? Theme.well-hi : Theme.well) : Theme.well.with-alpha(0);
        border-width: Theme.hair;
        // the card wears the WEAVE colour (what a real notification actually shows), NOT the interface accent
        border-color: State.notif-panel ? (root.dragging ? State.weave-accent-col : State.weave-accent-col.with-alpha(0.27)) : State.weave-accent-col.with-alpha(0);
        animate x, y { duration: Theme.press-throw; easing: ease-out; }   // a weighty magnetic settle
        animate background, border-color { duration: Theme.quick; }
        HorizontalLayout {
            padding-left: 7px; padding-right: 7px; spacing: 6px;
            VerticalLayout { alignment: center; Rectangle { width: 5px; height: 5px; border-radius: 3px; background: State.weave-accent-col; } }
            VerticalLayout {
                alignment: center; spacing: 3px;
                Rectangle { height: 2px; width: 28px; border-radius: 1px; background: Theme.text-faint; }
                Rectangle { height: 2px; width: 18px; border-radius: 1px; background: Theme.line; }
            }
        }
    }

    // the whole screen is the drag surface: press to place, drag to move, magnetic on the grid
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: !root.enabled ? MouseCursor.default : root.dragging ? MouseCursor.grabbing : MouseCursor.grab;
        moved => { if (root.dragging) { root.place-at(self.mouse-x, self.mouse-y); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragging = true;
                root.place-at(self.mouse-x, self.mouse-y);
            } else if (e.kind == PointerEventKind.up) {
                if (root.dragging) {
                    // optimistic local write first so the puck doesn't flicker when `dragging` clears,
                    // then persist (Rust re-pushes the same resolved x/y + the preset/custom slug).
                    State.notif-x = root.drag-x;
                    State.notif-y = root.drag-y;
                    State.set-notif-pos(root.drag-x, root.drag-y);
                    root.dragging = false;
                }
            }
        }
    }
}

// The WHEN-SEVERAL-LAND preview — a mock "screen corner" that shows how multiple cards behave in the
// chosen mode: STACK = a depth-stacked column (newest in front, brightest; older recede); LATEST = one
// card; DIGEST = one card with a count + a row of source glyphs. A glanceable picture of the live mode.
component NotifStackMock inherits Card {
    in property <string> mode;
    width: 150px;
    height: 96px;
    clip: true;
    property <length> cw: 96px;
    property <length> pad: 9px;
    // STACK — three cards, newest front (bright), older receding (dimmer + narrower).
    if root.mode == "stack" : Rectangle {
        x: parent.width - root.cw - root.pad;
        y: root.pad;
        width: root.cw;
        for i in 3 : Rectangle {
            y: i * 23px;
            width: root.cw * (1.0 - i * 0.07);
            x: root.cw - self.width;
            height: 19px;
            border-radius: Theme.radius-sm;
            background: Theme.well;
            border-width: Theme.hair;
            border-color: State.weave-accent-col.with-alpha(0.27);
            opacity: 1.0 - i * 0.3;
            HorizontalLayout {
                padding-left: 5px; padding-right: 5px; spacing: 5px;
                VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 1px; background: State.weave-accent-col; } }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                    Rectangle { height: 3px; width: 68%; border-radius: 1px; background: Theme.text-faint; }
                    Rectangle { height: 3px; width: 42%; border-radius: 1px; background: Theme.line; }
                }
            }
        }
    }
    // LATEST — a single card.
    if root.mode == "latest" : Rectangle {
        x: parent.width - root.cw - root.pad;
        y: root.pad;
        width: root.cw;
        height: 19px;
        border-radius: Theme.radius-sm;
        background: Theme.well;
        border-width: Theme.hair;
        border-color: State.weave-accent-col.with-alpha(0.27);
        HorizontalLayout {
            padding-left: 5px; padding-right: 5px; spacing: 5px;
            VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 1px; background: State.weave-accent-col; } }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 3px;
                Rectangle { height: 3px; width: 68%; border-radius: 1px; background: Theme.text-faint; }
                Rectangle { height: 3px; width: 42%; border-radius: 1px; background: Theme.line; }
            }
        }
    }
    // DIGEST — one card: a big count + a row of source glyphs + a line.
    if root.mode == "digest" : Rectangle {
        x: parent.width - root.cw - root.pad;
        y: root.pad;
        width: root.cw;
        height: 30px;
        border-radius: Theme.radius-sm;
        background: Theme.well;
        border-width: Theme.hair;
        border-color: State.weave-accent-col.with-alpha(0.27);
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px; spacing: 6px;
            VerticalLayout { alignment: center; Text { text: "3"; color: State.weave-accent-col; font-family: Theme.mono; font-weight: 700; font-size: Theme.fs-body; } }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 4px;
                HorizontalLayout {
                    spacing: 3px;
                    for d in 3 : Rectangle { width: 5px; height: 5px; border-radius: 1px; background: State.weave-accent-col; }
                    Rectangle {}
                }
                Rectangle { height: 3px; width: 70%; border-radius: 1px; background: Theme.text-faint; }
            }
        }
    }
}

// A small per-kind PING icon (16px), drawn from rectangles + rounded-rect "circles" — no fonts, so it
// matches the overlay's procedural glyph vocabulary. `ink` tints it accent (earns a ping) or dim.
component PingIcon inherits Rectangle {
    in property <string> slug;
    in property <bool> on;
    width: 16px;
    height: 16px;
    property <color> ink: root.on ? Theme.accent : Theme.text-dim;
    // DPI — a reticle: two rings + a centre dot
    if root.slug == "dpi" : Rectangle {
        Rectangle { x: 1px; y: 1px; width: 14px; height: 14px; border-radius: 7px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 5px; y: 5px; width: 6px; height: 6px; border-radius: 3px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 7px; y: 7px; width: 2px; height: 2px; border-radius: 1px; background: root.ink; }
    }
    // SNIPER — a scope: one ring, four crosshair ticks breaking its edge, a centre dot (kin to
    // DPI's reticle — same domain — but unmistakably the aiming instrument, not the setting)
    if root.slug == "sniper" : Rectangle {
        Rectangle { x: 2px; y: 2px; width: 12px; height: 12px; border-radius: 6px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 7.25px; y: 0px; width: 1.5px; height: 4px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 7.25px; y: 12px; width: 1.5px; height: 4px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 0px; y: 7.25px; width: 4px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 12px; y: 7.25px; width: 4px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 7px; y: 7px; width: 2px; height: 2px; border-radius: 1px; background: root.ink; }
    }
    // SENSITIVITY — a scroll wheel: a vertical capsule + a centre notch
    if root.slug == "scroll" : Rectangle {
        Rectangle { x: 4.5px; y: 1px; width: 7px; height: 14px; border-radius: 3.5px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 7px; y: 3.5px; width: 2px; height: 4px; border-radius: 1px; background: root.ink; }
    }
    // POLLING — three rising bars (the frequency), sharing a 14.5px baseline so the staircase
    // reads cleanly and the tallest bar matches the 13px footprint the rest of the set uses
    if root.slug == "polling" : Rectangle {
        Rectangle { x: 2px; y: 8.5px; width: 2.5px; height: 6px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 6.75px; y: 5px; width: 2.5px; height: 9.5px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 11.5px; y: 1.5px; width: 2.5px; height: 13px; border-radius: 1px; background: root.ink; }
    }
    // BRIGHTNESS — a sun: a filled core + four rays, pulled in to a centred 13px footprint
    if root.slug == "brightness" : Rectangle {
        Rectangle { x: 5px; y: 5px; width: 6px; height: 6px; border-radius: 3px; background: root.ink; }
        Rectangle { x: 7.25px; y: 1.5px; width: 1.5px; height: 2.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 7.25px; y: 12px; width: 1.5px; height: 2.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 1.5px; y: 7.25px; width: 2.5px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 12px; y: 7.25px; width: 2.5px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
    }
    // PROFILE — a person: head + shoulders, filling a centred 13px footprint
    if root.slug == "profile" : Rectangle {
        Rectangle { x: 5.5px; y: 1.5px; width: 5px; height: 5px; border-radius: 2.5px; background: root.ink; }
        Rectangle { x: 3px; y: 8px; width: 10px; height: 6.5px; border-radius: 3px; background: root.ink; }
    }
    // LAYER — three stacked bars (depth), spread to a centred 12.5px footprint with even gaps
    if root.slug == "layer" : Rectangle {
        Rectangle { x: 2px; y: 1.5px; width: 12px; height: 3px; border-radius: 1.5px; background: root.ink; opacity: 0.5; }
        Rectangle { x: 2px; y: 6.25px; width: 12px; height: 3px; border-radius: 1.5px; background: root.ink; opacity: 0.75; }
        Rectangle { x: 2px; y: 11px; width: 12px; height: 3px; border-radius: 1.5px; background: root.ink; }
    }
    // BEACON — a broadcast: a centre dot + two rings
    if root.slug == "beacon" : Rectangle {
        Rectangle { x: 1px; y: 1px; width: 14px; height: 14px; border-radius: 7px; border-width: 1.25px; border-color: root.ink; opacity: 0.5; }
        Rectangle { x: 5px; y: 5px; width: 6px; height: 6px; border-radius: 3px; border-width: 1.25px; border-color: root.ink; opacity: 0.82; }
        Rectangle { x: 7px; y: 7px; width: 2px; height: 2px; border-radius: 1px; background: root.ink; }
    }
    // BATTERY — a body + nub + fill, a touch taller (10px) so it stops reading as squat next to
    // the 13–14px ring icons; still clearly battery-proportioned (wide, rounded, centred)
    if root.slug == "battery" : Rectangle {
        Rectangle { x: 1px; y: 3px; width: 12px; height: 10px; border-radius: 1.5px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 13px; y: 5.5px; width: 2px; height: 5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 3px; y: 5.5px; width: 5px; height: 5px; border-radius: 0.75px; background: root.ink; }
    }
    // SIDE PLATE — a swappable plate: a rounded panel + two button dots (nods to the 2/6/12-button plates)
    if root.slug == "side_plate" : Rectangle {
        Rectangle { x: 3px; y: 1.5px; width: 10px; height: 13px; border-radius: 2.5px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 6.75px; y: 5px; width: 2.5px; height: 2.5px; border-radius: 1.25px; background: root.ink; }
        Rectangle { x: 6.75px; y: 9px; width: 2.5px; height: 2.5px; border-radius: 1.25px; background: root.ink; }
    }
    // UPDATE — an arrow landing in a tray: a new release is ready to fetch
    if root.slug == "update" : Rectangle {
        Rectangle { x: 7.25px; y: 1px; width: 1.5px; height: 9px; background: root.ink; }
        Rectangle { x: 4.5px; y: 6.5px; width: 7px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
        Rectangle { x: 2px; y: 10px; width: 12px; height: 5px; border-radius: 1.5px; border-width: 1.5px; border-color: root.ink; }
    }
    // GAME — a screen on a stand (the notification's own glyph): a scene changed in a game you
    // aren't looking at
    if root.slug == "game" : Rectangle {
        Rectangle { x: 1px; y: 2px; width: 14px; height: 10px; border-radius: 1.5px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 7.25px; y: 12px; width: 1.5px; height: 2px; background: root.ink; }
        Rectangle { x: 4.5px; y: 13.5px; width: 7px; height: 1.5px; border-radius: 0.75px; background: root.ink; }
    }
}

// One PING-kind card for the grid — a compact icon + label + what-it-is, lit when the kind earns a
// ping. Replaces the old full-width rows so the kinds tile 4-per-row instead of wasting the width.
component PingCard inherits Rectangle {
    in property <string> slug;
    in property <string> label;
    in property <string> desc;
    in property <bool> on;
    // gated with the notifications master switch — inert when notifications are off (the dim-gate over
    // the whole subordinate block carries the visual quieting; this stops the click).
    in property <bool> enabled: true;
    callback toggled();
    horizontal-stretch: 1;
    height: 54px;
    border-radius: Theme.radius-sm;
    background: root.on ? Theme.accent-glow : (ta.has-hover ? Theme.well : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.on ? Theme.accent-line : (ta.has-hover ? Theme.text-faint : Theme.line);
    animate background, border-color { duration: Theme.quick; }
    // icon ABOVE a centred label + tag — stacking gives the text the card's FULL width (the old
    // side-by-side icon stole ~half the room, so every desc elided and the two lines crammed). Roomy.
    VerticalLayout {
        alignment: center;
        spacing: 5px;
        padding-left: 6px; padding-right: 6px;
        HorizontalLayout { alignment: center; PingIcon { slug: root.slug; on: root.on; } }
        VerticalLayout {
            spacing: 2px;
            Mono { text: root.label; color: root.on ? Theme.accent : Theme.text-mid; font-size: Theme.fs-small; font-weight: 700; horizontal-alignment: center; overflow: elide; }
            Mono { text: root.desc; color: Theme.text-faint; font-size: Theme.fs-small; horizontal-alignment: center; overflow: elide; }
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.toggled(); } }
}

// The WHAT-EARNS-A-PING grid — the three DOMAIN CLUSTERS, data-driven: each caption owns ONE
// full-width row of exactly its domain's kinds (the glue's exhaustive ping_slot map decides
// membership), every card stretching to share the row evenly up to a card's own ceiling (200px —
// past that a toggle card is an empty slab, so wide rows pack left instead of inflating). The
// layout structurally CANNOT grow a dangling odd card — a new kind joins its domain's row and that
// row just gets denser; a denser row beside a looser one reads as grouping, not damage. One
// component, because the placer row instantiates it in BOTH its wide and narrow arrangements.
component PingGrid inherits VerticalLayout {
    in property <bool> gate: true;
    spacing: 9px;
    VerticalLayout {
        spacing: 5px;
        SubLabel { text: "POINTER"; color: Theme.text-faint; letter-spacing: Theme.track-3; }
        HorizontalLayout {
            spacing: 6px;
            for k in State.ping-pointer : PingCard {
                slug: k.icon; label: k.label; desc: k.desc; on: k.on;
                enabled: root.gate;
                max-width: 200px;
                toggled => { State.set-notif-event(k.slug, !k.on); }
            }
            Rectangle {}
        }
    }
    VerticalLayout {
        spacing: 5px;
        SubLabel { text: "HARDWARE"; color: Theme.text-faint; letter-spacing: Theme.track-3; }
        HorizontalLayout {
            spacing: 6px;
            for k in State.ping-hardware : PingCard {
                slug: k.icon; label: k.label; desc: k.desc; on: k.on;
                enabled: root.gate;
                max-width: 200px;
                toggled => { State.set-notif-event(k.slug, !k.on); }
            }
            Rectangle {}
        }
    }
    VerticalLayout {
        spacing: 5px;
        SubLabel { text: "SESSION"; color: Theme.text-faint; letter-spacing: Theme.track-3; }
        HorizontalLayout {
            spacing: 6px;
            for k in State.ping-session : PingCard {
                slug: k.icon; label: k.label; desc: k.desc; on: k.on;
                enabled: root.gate;
                max-width: 200px;
                toggled => { State.set-notif-event(k.slug, !k.on); }
            }
            Rectangle {}
        }
    }
}

// SYSTEM is one page of titled groups, in the order a person reaches for them: what neuron does at
// startup and what it may touch, staying current, how it looks, how it tells you things, who else
// may drive the lights, your macro asks, your files, and its health. A group is a bezel of rows,
// split by hairlines: words on the left, the control on the right, or under the words when the
// control is the thing itself (a colour picker, the notification screen).

// A group's frame: its name and one line about it, an optional verb on the right, and its rows.
component Group inherits VerticalLayout {
    in property <string> title;
    in property <string> caption;
    in property <color> caption-color: Theme.text-dim;
    in property <string> verb;
    callback verb-clicked();
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: end;
            spacing: 3px;
            horizontal-stretch: 1;
            SectionTitle { text: root.title; }
            if root.caption != "" : Mono { text: root.caption; color: root.caption-color; font-size: Theme.fs-small; wrap: word-wrap; }
        }
        if root.verb != "" : VerticalLayout {
            alignment: end;
            Pill { text: root.verb; clickable: true; clicked => { root.verb-clicked(); } }
        }
    }
    Card {
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            @children
        }
    }
}

// One setting: what it is (and a line on what it does), its control on the right.
component Row inherits VerticalLayout {
    in property <string> label;
    in property <string> desc;
    in property <color> desc-color: Theme.text-dim;
    in property <bool> rule: true;
    in property <bool> enabled: true;
    if root.rule : Divider {}
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: root.enabled ? Theme.text-mid : Theme.text-faint;
                font-family: Theme.mono;
                font-size: Theme.fs-body;
                wrap: word-wrap;
            }
            if root.desc != "" : Mono { text: root.desc; color: root.desc-color; font-size: Theme.fs-small; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

// One setting whose control is the thing itself, laid out under its words at full width.
component Block inherits VerticalLayout {
    in property <string> label;
    in property <string> desc;
    in property <color> desc-color: Theme.text-dim;
    in property <bool> rule: true;
    if root.rule : Divider {}
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 9px;
        if root.label != "" : VerticalLayout {
            spacing: 3px;
            Text { text: root.label; color: Theme.text-mid; font-family: Theme.mono; font-size: Theme.fs-body; wrap: word-wrap; }
            if root.desc != "" : Mono { text: root.desc; color: root.desc-color; font-size: Theme.fs-small; wrap: word-wrap; }
        }
        @children
    }
}

// An on/off setting: the whole row is the switch.
component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> rule: true;
    // a connection's lamp beside its switch: lit while the protocol is actually up
    in property <bool> lamp: false;
    in property <bool> lamp-lit: false;
    callback toggled(bool);
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    row := Row {
        width: parent.width;
        height: parent.height;
        label: root.label;
        desc: root.desc;
        rule: root.rule;
        enabled: root.enabled;
        if root.lamp : VerticalLayout { alignment: center; ConnLamp { lit: root.lamp-lit; } }
        Rectangle {
            width: 40px;
            height: 20px;
            border-radius: Theme.radius-sm;
            background: (root.checked && root.enabled) ? Theme.accent-glow : Theme.well;
            border-width: Theme.hair;
            border-color: !root.enabled ? Theme.line-soft
                : root.checked ? Theme.accent.with-alpha(0.7)
                : (ta.has-hover ? Theme.text-faint : Theme.line);
            animate background, border-color { duration: ta.has-hover ? Theme.hover-in : Theme.hover-out; }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 2px;
                background: (root.checked && root.enabled) ? Theme.accent : Theme.text-faint;
                y: (parent.height - self.height) / 2;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                animate x, background { duration: Theme.quick; }
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggled(!root.checked); }
    }
}

// A station of the diagnostics bench as one line: its lamp, its name, its verdict. A failed or
// skipped station jumps to the page it tested.
component DiagChip inherits Rectangle {
    in property <DiagRow> d;
    property <bool> jumpable: d.state == "fail" || d.state == "skip";
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: d.state == "fail" ? Theme.danger-glow : (root.jumpable && dta.has-hover ? Theme.well : transparent);
    border-width: Theme.hair;
    border-color: d.state == "fail" ? Theme.danger-line
        : d.state == "skip" ? Theme.warn-line
        : d.state == "pass" ? Theme.accent-line
        : Theme.line;
    animate background, border-color { duration: Theme.quick; }
    dta := TouchArea {
        enabled: root.jumpable;
        mouse-cursor: root.jumpable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        // shape carries the verdict as well as hue: skip is a hollow ring, pass and fail are solid
        VerticalLayout {
            alignment: center;
            Rectangle {
                property <bool> hollow: root.d.state == "skip";
                width: 6px; height: 6px; border-radius: 1px;
                background: self.hollow ? transparent
                    : root.d.state == "pass" ? Theme.accent
                    : root.d.state == "fail" ? Theme.danger
                    : Theme.text-faint;
                border-width: self.hollow ? 1.5px : 0px;
                border-color: Theme.warn;
            }
        }
        Mono { text: root.d.name; color: Theme.text-mid; font-size: Theme.fs-small; overflow: elide; horizontal-stretch: 1; }
        Mono {
            text: (root.d.state == "pass" ? "pass" : root.d.state == "fail" ? "fail" : root.d.state == "skip" ? "skip" : "—")
                + (root.jumpable && dta.has-hover ? " \u{203a}" : "");
            color: root.d.state == "pass" ? Theme.accent
                : root.d.state == "fail" ? Theme.danger
                : root.d.state == "skip" ? Theme.warn
                : Theme.text-faint;
            font-size: Theme.fs-small;
        }
    }
}

export component SettingsPanel inherits VerticalLayout {
    in property <length> viewport-top;
    in property <length> viewport-bottom;
    // where each group starts on the page, for a jump to it (SYSTEM's index, the beacon pill)
    public pure function anchor-y(name: string) -> length {
        (name == "updates" ? g-updates.absolute-position.y
            : name == "appearance" ? g-appearance.absolute-position.y
            : name == "notifications" ? g-notifications.absolute-position.y
            : name == "connections" ? g-connections.absolute-position.y
            : name == "beacons" ? g-beacons.absolute-position.y
            : name == "files" ? g-files.absolute-position.y
            : name == "health" || name == "reliability" ? g-health.absolute-position.y
            : root.absolute-position.y) - root.absolute-position.y
    }
    spacing: 0;
    // The notification screen sits beside its ping grid while the grid keeps a workable measure,
    // and stacks above it when it would not. Measured from the panel's width, which the page
    // imposes, so reading it cannot loop through the content it rearranges.
    property <length> column: min(root.width, 860px);
    property <bool> narrow-col: root.column - 28px - 348px - Theme.gap-col < 440px;
    // The material gallery animates only while it is on screen, at ~10fps: each worker frame
    // crossfades over one tick (100ms), which must match the tiles' fade.
    Timer {
        interval: 100ms;
        running: State.window-shown && State.page == 3
            && material-grid.absolute-position.y < root.viewport-bottom
            && material-grid.absolute-position.y + material-grid.height > root.viewport-top;
        triggered => { State.material-preview-tick(); }
    }
    PanelHead {
        label: "SYSTEM";
        caption: "set it up · prove it works";
    }
    Divider {}
    Rectangle { height: Theme.lead-in; }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            preferred-width: 860px;
            max-width: 860px;
            horizontal-stretch: 1;
            spacing: Theme.section-gap;

            // the page's index: every group one click away
            HorizontalLayout {
                spacing: 6px;
                for g in ["startup", "updates", "appearance", "notifications", "connections", "beacons", "files", "health"] : Pill {
                    text: g;
                    clickable: true;
                    clicked => { State.system-jump-target = g; }
                }
                Rectangle {}
            }

            // ── STARTUP & SAFETY ─────────────────────────────────────────
            g-startup := Group {
                title: "STARTUP & SAFETY";
                caption: !State.writes-paused && State.input-armed ? "live · devices and input both on"
                    : !State.writes-paused && !State.input-armed ? "tuning hardware · remaps and macros held"
                    : State.writes-paused && State.input-armed ? "remaps and macros live · hardware untouched"
                    : "observing · reads only, nothing fires";
                SwitchRow {
                    rule: false;
                    label: "device writes";
                    desc: "lighting, dpi and other settings reach your devices";
                    checked: !State.writes-paused;
                    toggled(v) => { State.toggle-writes-paused(); }
                }
                SwitchRow {
                    label: "input & macros";
                    desc: "remaps, macros and casts fire";
                    checked: State.input-armed;
                    toggled(v) => { State.toggle-input-armed(); }
                }
                Row {
                    label: "on launch";
                    desc: State.launch-mode == 1 ? "starts with Windows, stays in the tray"
                        : State.launch-mode == 2 ? "starts with Windows, opens the window"
                        : "you launch it yourself";
                    SplitToggle {
                        options: ["manual", "tray", "window"];
                        index: State.launch-mode;
                        min-cell: 64px;
                        picked(i) => { State.set-launch-mode(i); }
                    }
                }
                SwitchRow {
                    label: "restart after a crash";
                    desc: "windows relaunches neuron if it crashes or hangs";
                    checked: State.phoenix;
                    toggled(v) => { State.set-phoenix(v); }
                }
            }

            // ── UPDATES ──────────────────────────────────────────────────
            g-updates := Group {
                title: "UPDATES";
                Row {
                    rule: false;
                    label: "neuron " + (State.app-version == "" ? "unknown" : State.app-version);
                    desc: State.update-status;
                    Button {
                        text: "check now";
                        busy: State.update-checking;
                        enabled: State.update-enabled;
                        clicked => { State.update-check-now(); }
                    }
                }
                SwitchRow {
                    label: "check automatically";
                    desc: "a signed release shows up as a pill in the header";
                    checked: State.update-auto;
                    enabled: State.update-enabled;
                    toggled(v) => { State.update-set-auto(v); }
                }
                if State.installed-notes.length > 0 : Block {
                    VerticalLayout {
                    Disclosure {
                        label: "what's new in " + State.app-version;
                        open: State.installed-notes-open;
                        toggled => { State.installed-notes-open = !State.installed-notes-open; }
                    }
                    Rectangle {
                        height: State.installed-notes-open ? installed.preferred-height : 0px;
                        clip: true;
                        animate height { duration: Theme.settle; easing: ease-out; }
                        installed := NotesView {
                            y: 0;
                            width: parent.width;
                            height: self.preferred-height;
                            rows: State.installed-notes;
                            media: State.installed-media;
                        }
                    }
                    }
                }
            }

            // ── APPEARANCE ───────────────────────────────────────────────
            g-appearance := Group {
                title: "APPEARANCE";
                Block {
                    rule: false;
                    label: "interface accent";
                    desc: "anything live lights up in this · "
                        + floor(round(State.ui-accent-contrast * 10) / 10) + "." + mod(round(State.ui-accent-contrast * 10), 10) + ":1 against the background"
                        + (State.ui-accent-contrast-low ? ", low" : "");
                    desc-color: State.ui-accent-contrast-low ? Theme.warn : Theme.text-dim;
                    HorizontalLayout {
                        spacing: 10px;
                        ColorPicker {
                            horizontal-stretch: 1;
                            current: Theme.accent;
                            value: State.ui-accent;
                            swatches: Palette.accent;
                            pick(h) => { State.set-ui-accent(h); }
                        }
                        if State.ui-accent.to-lowercase() != "4af2b0" && State.ui-accent.to-lowercase() != "#4af2b0" : VerticalLayout {
                            alignment: start;
                            Button { text: "reset"; clicked => { State.set-ui-accent("4af2b0"); } }
                        }
                    }
                }
                Block {
                    label: "weave";
                    desc: "the colour and the substance your casts are poured from";
                    ColorPicker {
                        current: State.weave-accent-col;
                        value: State.weave-accent;
                        swatches: Palette.accent;
                        pick(h) => { State.set-weave-accent(h); }
                    }
                    // each tile is the real shader, live
                    material-grid := Rectangle {
                        property <length> gap: 8px;
                        property <int> cols: 4;
                        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        property <length> th: self.cw * 0.5 + 48px;
                        property <int> rows: ceil(State.material-cards.length / self.cols);
                        height: self.rows * self.th + max(0, self.rows - 1) * self.gap;
                        for c[i] in State.material-cards : card := Rectangle {
                            property <bool> sel: c.slug == State.weave-material;
                            x: mod(i, material-grid.cols) * (material-grid.cw + material-grid.gap);
                            y: floor(i / material-grid.cols) * (material-grid.th + material-grid.gap);
                            width: material-grid.cw;
                            height: material-grid.th;
                            border-radius: Theme.radius;
                            background: self.sel ? Theme.accent-glow : (mta.has-hover ? Theme.well : Theme.bg);
                            border-width: Theme.hair;
                            border-color: self.sel ? Theme.accent-line : (mta.has-hover ? Theme.text-faint : Theme.line);
                            animate background, border-color { duration: Theme.quick; }
                            clip: true;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 4px;
                                alignment: start;
                                // each fresh frame lands in the hidden slot, then fades over one tick
                                Rectangle {
                                    width: parent.width - 10px;
                                    height: self.width * 0.5;
                                    Image { source: c.swatch; width: 100%; height: 100%; image-fit: fill; }
                                    Image {
                                        source: c.swatch-alt;
                                        width: 100%; height: 100%;
                                        image-fit: fill;
                                        opacity: State.material-show-alt ? 1.0 : 0.0;
                                        animate opacity { duration: 100ms; easing: linear; }
                                    }
                                }
                                Mono { text: c.name; color: card.sel ? Theme.accent : Theme.text-mid; font-size: Theme.fs-small; font-weight: 700; overflow: elide; }
                                Mono { text: c.blurb; color: Theme.text-faint; font-size: Theme.fs-small; wrap: word-wrap; overflow: elide; }
                            }
                            mta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { State.set-weave-material(c.slug); }
                            }
                        }
                    }
                    // the selected material's own knobs
                    if State.weave-knobs.length > 0 : VerticalLayout {
                        spacing: 7px;
                        HorizontalLayout {
                            SubLabel { text: "TUNE"; letter-spacing: Theme.track-3; }
                            Rectangle {}
                            rta := TouchArea {
                                width: rl.preferred-width; height: 18px;
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { State.reset-weave-material(); }
                                rl := Text {
                                    text: "reset";
                                    color: rta.has-hover ? Theme.text-mid : Theme.text-faint;
                                    font-family: Theme.mono; font-size: Theme.fs-small; vertical-alignment: center;
                                }
                            }
                        }
                        for k[i] in State.weave-knobs : HorizontalLayout {
                            spacing: 9px;
                            VerticalLayout { alignment: center; width: 96px; Mono { text: k.label; font-size: Theme.fs-small; overflow: elide; } }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Slider {
                                    compact: true;
                                    minimum: k.min; maximum: k.max; value: k.value;
                                    step: (k.max - k.min) / 100;
                                    wheel: false;
                                    changed(v) => { State.set-weave-knob(i, v); }
                                }
                            }
                            VerticalLayout { alignment: center; width: 42px; Mono { text: round(k.value * 100) / 100; color: Theme.text-mid; font-size: Theme.fs-small; horizontal-alignment: right; } }
                        }
                    }
                }
            }

            // ── NOTIFICATIONS ────────────────────────────────────────────
            g-notifications := Group {
                title: "NOTIFICATIONS";
                caption: "a heads-up when something changes";
                verb: "test";
                verb-clicked => { State.test-notification(); }
                SwitchRow {
                    rule: false;
                    label: "notifications";
                    checked: State.notif-enabled;
                    toggled(v) => { State.set-notif-enabled(v); }
                }
                // everything below is held, quieted and inert, while notifications are off
                VerticalLayout {
                    opacity: State.notif-enabled ? 1.0 : Theme.dim-gated;
                    animate opacity { duration: Theme.quick; }
                    Row {
                        label: "where";
                        desc: State.notif-placement == "off" ? "off · audio only"
                            : State.notif-placement == "custom" ? "custom placement · drag the card anywhere"
                            : State.notif-placement + " · drag the card anywhere";
                        Pill {
                            text: "audio only";
                            clickable: true;
                            enabled: State.notif-enabled;
                            selected: State.notif-placement == "off";
                            clicked => {
                                if (State.notif-placement == "off") {
                                    State.set-notif-pos(State.notif-x, State.notif-y);
                                } else {
                                    State.set-notif-placement("off");
                                }
                            }
                        }
                    }
                    Block {
                        rule: false;
                        if !root.narrow-col : HorizontalLayout {
                            spacing: Theme.gap-col;
                            NotifPlacer { enabled: State.notif-enabled; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: start;
                                spacing: 10px;
                                SubLabel { text: "WHAT EARNS A PING"; }
                                PingGrid { gate: State.notif-enabled; }
                            }
                        }
                        if root.narrow-col : VerticalLayout {
                            spacing: Theme.gap;
                            HorizontalLayout { alignment: start; NotifPlacer { enabled: State.notif-enabled; } }
                            VerticalLayout {
                                spacing: 10px;
                                SubLabel { text: "WHAT EARNS A PING"; }
                                PingGrid { gate: State.notif-enabled; }
                            }
                        }
                    }
                    Block {
                        label: "when several land";
                        HorizontalLayout {
                            spacing: Theme.gap-col;
                            NotifStackMock { mode: State.notif-stack; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: Theme.measure-max;
                                spacing: 6px;
                                Contact { fill: true; enabled: State.notif-enabled; label: "stack"; desc: "a column · see each"; active: State.notif-stack == "stack"; clicked => { State.set-notif-stack("stack"); } }
                                Contact { fill: true; enabled: State.notif-enabled; label: "latest"; desc: "newest only, one card"; active: State.notif-stack == "latest"; clicked => { State.set-notif-stack("latest"); } }
                                Contact { fill: true; enabled: State.notif-enabled; label: "digest"; desc: "one summary, counted"; active: State.notif-stack == "digest"; clicked => { State.set-notif-stack("digest"); } }
                            }
                            Rectangle {}
                        }
                    }
                    SwitchRow {
                        label: "card background";
                        desc: "a grounded card, or the bare floating spell";
                        enabled: State.notif-enabled;
                        checked: State.notif-panel;
                        toggled(v) => { State.set-notif-panel(v); }
                    }
                    SwitchRow {
                        label: "audio cue";
                        enabled: State.notif-enabled;
                        checked: State.notif-audio;
                        toggled(v) => { State.set-notif-audio(v); }
                    }
                    if State.notif-audio : Row {
                        label: "volume";
                        enabled: State.notif-enabled;
                        Slider {
                            width: 200px;
                            compact: true;
                            enabled: State.notif-enabled;
                            minimum: 0.0;
                            maximum: 1.0;
                            value: State.notif-volume;
                            step: 0.05;
                            wheel: false;
                            changed(v) => { State.set-notif-volume(v); }
                        }
                    }
                    if State.notif-audio : Row {
                        label: "voice";
                        enabled: State.notif-enabled;
                        SplitToggle {
                            options: ["pulse", "warm", "glass"];
                            min-cell: 64px;
                            enabled: State.notif-enabled;
                            index: (State.notif-sound == "warm" ? 1 : State.notif-sound == "glass" ? 2 : 0);
                            picked(i) => { State.set-notif-sound(i == 1 ? "warm" : i == 2 ? "glass" : "pulse"); }
                        }
                    }
                }
            }

            // ── CONNECTIONS ──────────────────────────────────────────────
            // Chroma games, OpenRGB tools and OBS drive the boards as layers above your lighting,
            // which returns when they let go. Off by default: opening ports is a conscious opt-in.
            g-connections := Group {
                title: "CONNECTIONS";
                caption: State.host-enabled && State.host-devices-line != "" ? State.host-devices-line : "";
                SwitchRow {
                    rule: false;
                    label: "let apps & games control lighting";
                    desc: "your lighting stays underneath and comes back when they stop";
                    checked: State.host-enabled;
                    toggled(v) => { State.set-host-enabled(v); }
                }
                if State.host-enabled : SwitchRow {
                    label: "chroma · games";
                    desc: State.host-chroma-status;
                    lamp: true;
                    lamp-lit: State.host-chroma-live;
                    checked: State.host-chroma;
                    toggled(v) => { State.set-host-chroma(v); }
                }
                if State.host-enabled && (State.host-chroma-streams.length > 0 || State.host-chroma-live) : Block {
                    HorizontalLayout {
                        spacing: 10px;
                        ConnStatus { horizontal-stretch: 0; lit: State.host-chroma-live; text: State.host-chroma-live ? "a game is painting" : "waiting for a game"; }
                        if State.host-chroma-streams.length > 0 : MoreLink {
                            open: State.host-chroma-detail-open;
                            clicked => { State.host-chroma-detail-open = !State.host-chroma-detail-open; }
                        }
                        if State.host-chroma-live : MoreLink {
                            open: false;
                            closed-text: "lab in LIGHTING ›";
                            clicked => { State.chroma-lab-open = true; State.page = 1; }
                        }
                        Rectangle {}
                    }
                    if State.host-chroma-detail-open && State.host-chroma-streams.length > 0 : VerticalLayout {
                        spacing: 4px;
                        for stream in State.host-chroma-streams : ChromaStream { stream: stream; }
                    }
                }
                if State.host-enabled : SwitchRow {
                    label: "openrgb · tools";
                    desc: State.host-openrgb-status;
                    lamp: true;
                    lamp-lit: State.host-openrgb-live;
                    checked: State.host-openrgb;
                    toggled(v) => { State.set-host-openrgb(v); }
                }
                if State.host-enabled : SwitchRow {
                    label: "obs · scenes & stream";
                    desc: State.host-obs-status;
                    lamp: true;
                    lamp-lit: State.host-obs-live;
                    checked: State.host-obs;
                    toggled(v) => { State.set-host-obs(v); }
                }
                if State.host-enabled && State.host-obs : Block {
                    label: "obs websocket";
                    desc: "Tools → WebSocket Server Settings in OBS · the on-air light is the On Air layer, in LIGHTING";
                    ObsFinder { }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            placeholder: "server password";
                            secret: true;
                            field-width: 240px;
                            text: State.host-obs-password;
                            edited(v) => { State.host-obs-password = v; }
                            accepted(v) => { State.set-host-obs-password(v); }
                        }
                        Button { text: "save"; clicked => { State.set-host-obs-password(State.host-obs-password); } }
                        Rectangle {}
                    }
                }
            }

            // ── BEACONS ──────────────────────────────────────────────────
            g-beacons := Group {
                title: "BEACONS";
                caption: "a macro that asks. hold the trigger and flick: → yes · ← no · ↕ pass";
                verb: "author a macro →";
                verb-clicked => { State.macro-jump-pending = true; State.input-view = 0; State.goto-page(2); }
                if State.beacon-macros.length == 0 : Row {
                    rule: false;
                    label: "no asks yet";
                    desc: "add neuron.ask(\"…\") to a macro and it shows up here";
                }
                for m[i] in State.beacon-macros : Row {
                    rule: i > 0;
                    label: m.name;
                    desc: m.asks != "" ? "asks  " + m.asks : "";
                    // lit while its ask is on screen
                    VerticalLayout {
                        alignment: center;
                        Lamp { signal: Signal.listening; lit: State.beacon-active && State.beacon-macro == m.name; }
                    }
                    Button { text: "test"; clicked => { State.test-beacon(m.name); } }
                    ConfirmButton { text: "×"; confirm-text: "delete?"; confirmed => { State.delete-beacon(m.name); } }
                }
            }

            // ── FILES ────────────────────────────────────────────────────
            g-files := Group {
                title: "FILES & SYNAPSE";
                Row {
                    rule: false;
                    label: "config folder";
                    desc: State.run-dir == "" ? "every setting is plain, hand-editable TOML and JSON" : State.run-dir;
                    Button { text: "open"; clicked => { State.open-config-dir(); } }
                }
                Row {
                    label: "import from Synapse";
                    desc: "bring your profiles and binds across";
                    Button { text: "import…"; clicked => { State.import-open = true; } }
                }
                Row {
                    label: "purge Synapse";
                    desc: State.purge-status == "" ? "stops Synapse and demotes its services so they skip boot. it still opens by hand. asks for admin." : State.purge-status;
                    desc-color: State.purge-status == "" ? Theme.text-dim : Theme.text;
                    ConfirmButton { text: "purge"; confirm-text: "purge?"; confirmed => { State.purge-synapse(); } }
                }
            }

            // ── HEALTH ───────────────────────────────────────────────────
            g-health := Group {
                title: "HEALTH";
                caption: "up " + State.uptime + " · the flight recorder is always on and survives crashes";
                // a lamp per worker: lit while it beats, red when it stalls
                Block {
                    rule: false;
                    label: "workers";
                    organs := Rectangle {
                        property <int> cols: 4;
                        property <length> gap: 6px;
                        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        height: ceil(State.organs.length / self.cols) * 24px;
                        for o[i] in State.organs : HorizontalLayout {
                            x: mod(i, organs.cols) * (organs.cw + organs.gap);
                            y: floor(i / organs.cols) * 24px;
                            width: organs.cw;
                            height: 20px;
                            spacing: 7px;
                            VerticalLayout {
                                alignment: center;
                                Lamp { signal: o.state == "stall" ? Signal.consequence : Signal.live; lit: o.state == "beat" || o.state == "stall"; }
                            }
                            Mono {
                                text: o.name;
                                color: o.state == "stall" ? Theme.danger : Theme.text-mid;
                                font-size: Theme.fs-small;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if State.organ-stall : VerticalLayout {
                        for o in State.organs : VerticalLayout {
                            if o.state == "stall" : Mono { text: o.name + " · " + o.detail; color: Theme.danger; font-size: Theme.fs-small; wrap: word-wrap; }
                        }
                    }
                }
                Row {
                    label: "crash record";
                    desc: State.crash-summary;
                    desc-color: State.crash-present ? Theme.warn : Theme.text-dim;
                    SplitButton {
                        left-text: "flight dump";
                        right-text: "crash log";
                        left-clicked => { State.write-flight-dump(); }
                        right-clicked => { State.open-crash-log(); }
                    }
                }
                Block {
                    label: "diagnostics";
                    desc: State.diag-summary;
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "run";
                            busy: State.diag-running;
                            clicked => { State.run-diagnostics(); }
                        }
                        Button {
                            text: "copy summary";
                            enabled: (State.diag-pass + State.diag-fail + State.diag-skip > 0) && !State.diag-running;
                            clicked => { State.copy-diagnostics(); }
                        }
                        // the verdict: pass, fail and skip as shares of one bar
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            if State.diag-pass + State.diag-fail + State.diag-skip > 0 : Rectangle {
                                height: 6px;
                                border-radius: 1px;
                                clip: true;
                                property <int> total: max(1, State.diag-pass + State.diag-fail + State.diag-skip);
                                property <length> w-pass: self.width * State.diag-pass / self.total;
                                property <length> w-fail: self.width * State.diag-fail / self.total;
                                Rectangle { x: 0; width: parent.w-pass; height: parent.height; background: Theme.accent; animate width { duration: Theme.settle; } }
                                Rectangle { x: parent.w-pass + 1px; width: parent.w-fail; height: parent.height; background: Theme.danger; animate width { duration: Theme.settle; } }
                                if State.diag-skip > 0 : Rectangle {
                                    x: parent.w-pass + parent.w-fail + 2px;
                                    width: max(0px, parent.width - parent.w-pass - parent.w-fail - 2px);
                                    height: parent.height;
                                    background: Theme.text-faint;
                                    animate width { duration: Theme.settle; }
                                }
                            }
                        }
                    }
                    if State.diagnostics.length > 0 : bench := Rectangle {
                        property <int> cols: 3;
                        property <length> gap: 6px;
                        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        height: ceil(State.diagnostics.length / self.cols) * 32px - self.gap;
                        for d[i] in State.diagnostics : DiagChip {
                            d: d;
                            x: mod(i, bench.cols) * (bench.cw + bench.gap);
                            y: floor(i / bench.cols) * 32px;
                            width: bench.cw;
                            clicked => {
                                if (d.name == "lighting test pattern" || d.name == "effect engine") {
                                    State.page = 1;
                                } else if (d.name == "spine engine" || d.name == "macro runtime" || d.name == "mic endpoint") {
                                    State.input-view = 0;
                                    State.page = 2;
                                } else if (d.name == "gesture vault") {
                                    State.input-view = 1;
                                    State.page = 2;
                                } else {
                                    State.page = 0;
                                }
                            }
                        }
                    }
                    // what a failed or skipped station said
                    if State.diag-fail + State.diag-skip > 0 : VerticalLayout {
                        spacing: 2px;
                        for d in State.diagnostics : VerticalLayout {
                            if d.state == "fail" || d.state == "skip" : Mono { text: d.name + " · " + d.detail; color: d.state == "fail" ? Theme.danger : Theme.warn; font-size: Theme.fs-small; wrap: word-wrap; }
                        }
                    }
                }
                // writes a scrubbed report folder and zip, then opens a pre-filled issue or copies a
                // prompt for the person's coding agent. Nothing is sent.
                Block {
                    label: "report a bug";
                    desc: "your home folder, user and pc names are scrubbed. you attach the zip yourself.";
                    HorizontalLayout {
                        spacing: 8px;
                        bug-what := Field {
                            placeholder: "what happened?";
                            field-width: 320px;
                            accepted(v) => { State.report-bug(v, false); }
                        }
                        SplitButton {
                            horizontal-stretch: 0;
                            left-text: "open an issue";
                            right-text: "for your agent";
                            left-clicked => { State.report-bug(bug-what.text, false); }
                            right-clicked => { State.report-bug(bug-what.text, true); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // the nameplate
            VerticalLayout {
                spacing: 3px;
                padding-bottom: 6px;
                Mono {
                    text: "neuron " + (State.app-version == "" ? "unknown" : State.app-version) + " · © 2026 Woflo Labs · github.com/worflor/neuron";
                    color: Theme.text-faint;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
                // WLCSL is source-available, not an OSI licence: never "open source" here
                Mono {
                    text: "GPL-3.0-or-later · WLCSL community-source research core · no warranty";
                    color: Theme.text-faint;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
            }
        }
    }
}
