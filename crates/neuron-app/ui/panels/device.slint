import { Theme } from "../theme.slint";
import { Card, SectionTitle, Label, Button, Field, Slider, ContactRow, Toggle, Pill, Mono, Divider, Readout, PanelHead, SplitButton, SplitToggle, LampRail, Disclosure, SelectTick } from "../widgets/controls.slint";
import { State } from "../state.slint";
import { DeviceRow } from "../models.slint";

// DEVICE — the merged overview + performance surface. Left: the enumerated devices as instrument
// channels, each a strip of live readouts pulled straight from neuron-core capability::*, led by a
// hairline silhouette of the instrument itself. Right: the real "feel" controls acting on the
// SELECTED channel — seeded from live device reads, with the DPI fader carrying the stage table as
// detent ticks and polling as the discrete contacts the hardware actually takes. ADVANCED splits
// into two trust zones: LIVE (verified writes) and GATED (verify-gated, honest [gated]).

// A hairline device silhouette — the channel's strongest spatial identifier, drawn (stroke-only
// Path), monochrome ink, never accent. Every silhouette is drawn centred in the 26×26 box so the
// glyph column reads as one consistent stack. kind: mouse | keyboard | mic | output | (else).
component DeviceGlyph inherits Path {
    in property <string> kind;
    in property <color> ink: Theme.text-faint;
    width: 26px;
    height: 26px;
    // one SHARED authored coordinate space — every command set below is drawn on a 0..24 grid. Without a
    // pinned viewbox each Path stretched to its OWN command bounding-box, so a narrow glyph (the mouse,
    // x 8..18) fattened its stroke + drifted in optical scale versus a wide one (the keyboard, x 2..24).
    // Fixing the viewbox to the design grid makes all five silhouettes scale identically and sit centred.
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.ink;
    stroke-width: Theme.hair;
    fill: transparent;
    commands: root.kind == "mouse"
        // capsule body + the scroll split line
        ? "M 8 3 A 5 5 0 0 1 18 3 L 18 17 A 5 5 0 0 1 8 17 Z M 13 3 L 13 9"
        : root.kind == "keyboard"
        // bezel + key ticks + spacebar
        ? "M 2 8 L 24 8 L 24 19 L 2 19 Z M 5 11.5 L 7 11.5 M 9 11.5 L 11 11.5 M 13 11.5 L 15 11.5 M 17 11.5 L 19 11.5 M 7 15.5 L 19 15.5"
        : root.kind == "mic"
        // a microphone: pill capsule, the cradle arc, stem + base — centred on x=13
        ? "M 10 5 A 3 3 0 0 1 16 5 L 16 12 A 3 3 0 0 1 10 12 Z M 7 11 A 6 6 0 0 0 19 11 M 13 17 L 13 21 M 9 21 L 17 21"
        : root.kind == "output"
        // a speaker: driver box + cone + two sound waves — centred on x=13
        ? "M 5 10 L 9 10 L 14 5 L 14 21 L 9 16 L 5 16 Z M 17 9 A 4 4 0 0 1 17 17 M 19 6 A 7.5 7.5 0 0 1 19 20"
        // generic: a chassis with a port notch
        : "M 4 5 L 22 5 L 22 21 L 4 21 Z M 9 10 L 17 10";
}

// Online sheen: an invisible moving clip window reveals an accent duplicate of the
// exact glyph/text, so the light lives on the ink rather than washing the card.
component SheenGlyph inherits Rectangle {
    in property <string> kind;
    in property <bool> live;
    in property <color> ink: Theme.text-faint;
    width: 26px;
    height: 26px;
    background: transparent;
    property <length> band-width: 9px;
    property <length> band-x: root.live ? root.width + 4px : -root.band-width - 4px;

    DeviceGlyph {
        kind: root.kind;
        ink: root.ink;
    }
    Rectangle {
        x: root.band-x;
        y: 0px;
        width: root.band-width;
        height: parent.height;
        clip: true;
        background: transparent;
        opacity: root.live ? 1.0 : 0.0;
        animate x, opacity { duration: Theme.sheen; }
        DeviceGlyph {
            x: -parent.x;
            kind: root.kind;
            ink: Theme.accent;
        }
    }
    Rectangle {
        x: root.band-x + root.band-width * 0.42;
        y: 0px;
        width: 2px;
        height: parent.height;
        clip: true;
        background: transparent;
        opacity: root.live ? 0.92 : 0.0;
        animate x, opacity { duration: Theme.sheen; }
        DeviceGlyph {
            x: -parent.x;
            kind: root.kind;
            ink: Theme.text;
        }
    }
}

component SheenText inherits Rectangle {
    in property <string> value;
    in property <bool> live;
    in property <color> ink: Theme.text-mid;
    in property <length> size: Theme.fs-data;
    in property <int> weight: 700;
    in property <length> tracking: Theme.track-1;
    horizontal-stretch: 1;
    height: root.size + 4px;
    background: transparent;
    clip: true;
    property <length> band-width: min(58px, max(24px, root.width * 0.18));
    property <length> band-x: root.live ? root.width + 8px : -root.band-width - 8px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.value;
        color: root.ink;
        font-size: root.size;
        font-weight: root.weight;
        font-family: Theme.mono;
        letter-spacing: root.tracking;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: root.band-x;
        y: 0px;
        width: root.band-width;
        height: parent.height;
        clip: true;
        background: transparent;
        opacity: root.live ? 1.0 : 0.0;
        animate x, opacity { duration: Theme.sheen; }
        Text {
            x: -parent.x;
            width: root.width;
            height: root.height;
            text: root.value;
            color: Theme.accent;
            font-size: root.size;
            font-weight: root.weight;
            font-family: Theme.mono;
            letter-spacing: root.tracking;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        x: root.band-x + root.band-width * 0.54;
        y: 0px;
        width: 3px;
        height: parent.height;
        clip: true;
        background: transparent;
        opacity: root.live ? 0.82 : 0.0;
        animate x, opacity { duration: Theme.sheen; }
        Text {
            x: -parent.x;
            width: root.width;
            height: root.height;
            text: root.value;
            color: Theme.text;
            font-size: root.size;
            font-weight: root.weight;
            font-family: Theme.mono;
            letter-spacing: root.tracking;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ── FEEL-pane grammar ─────────────────────────────────────────────────────
// Small, local building blocks so every capability in the inspector reads on ONE rhythm — a quiet
// labelled header, a consistent apply, and an honest (but elegant) "verify-gated" marker — instead
// of the old scatter of loose sliders, raw env-var tags, and dev-speak paragraphs.

// A capability heading inside a card — a small mono term on the left, an optional live readout on the
// right (the current value / state), and an optional GATE marker. One look for DPI, REPORT RATE,
// BRIGHTNESS, WHEEL MODE, SLEEP, … so the pane scans as a stack of like things.
component CapHead inherits HorizontalLayout {
    in property <string> term;
    in property <string> readout: "";
    in property <color> readout-ink: Theme.text-faint;
    in property <bool> gated: false;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.term;
            color: Theme.text-dim;
            font-size: Theme.fs-small;
            font-family: Theme.mono;
            font-weight: 700;
            letter-spacing: Theme.track-2;
            vertical-alignment: center;
        }
    }
    Rectangle { horizontal-stretch: 1; min-width: 8px; }
    if root.readout != "" : VerticalLayout {
        alignment: center;
        Text {
            text: root.readout;
            color: root.readout-ink;
            font-size: Theme.fs-small;
            font-family: Theme.mono;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // the honesty marker — a single quiet caution dot in the SAME warn hue as the card's "verify-gated"
    // pill (one vocabulary), NOT a second pill (the card header already wears the legend). It just says
    // "this row is a real, verify-gated hardware write" at a glance, without leaking the write-path name.
    if root.gated : VerticalLayout {
        alignment: center;
        Rectangle {
            width: Theme.dot; height: Theme.dot; border-radius: 1px;
            background: Theme.warn.with-alpha(0.6);
        }
    }
}

// One gated capability's standard footer note — a single quiet line in user-facing language. Keeps
// the honesty (we never fake a working write) but trims the paragraph of dev jargon to one sentence.
component GateNote inherits Mono {
    color: Theme.text-faint;
    wrap: word-wrap;
}

// A COMPACT FEEL TILE — one everyday capability boxed into a small well so the deck reads as a 2-up
// grid of at-a-glance instruments instead of a stack of full-width rows (the "scroll dump" the deck
// used to be). A faint hairline well, a tracked-out term up top, the control beneath. Tiles size to
// content within their grid cell; the caller drops the control as @children.
component FeelTile inherits Rectangle {
    in property <string> term;
    in property <string> readout: "";
    in property <color> readout-ink: Theme.text-faint;
    background: Theme.well.with-alpha(0.5);
    border-radius: Theme.radius-sm;
    border-width: Theme.hair;
    border-color: Theme.line;
    VerticalLayout {
        padding: 11px;
        spacing: 9px;
        CapHead {
            term: root.term;
            readout: root.readout;
            readout-ink: root.readout-ink;
        }
        @children
    }
}

// One device channel — flat strip; a phosphor index tick marks the selected one.
component DeviceLine inherits Rectangle {
    in property <DeviceRow> d;
    in property <bool> selected;
    callback clicked();
    callback backup();
    height: 84px;
    clip: true;
    border-radius: Theme.radius;
    // A placeholder (adopting) row is an ANNOTATION, not a device: dim the whole row and suppress
    // the hover well so it reads as an inert note. Clicking stays live — selection carry-over for
    // learning rows must keep working.
    opacity: root.d.adopting ? Theme.dim-gated : 1.0;
    background: selected ? Theme.bg-2 : ((ta.has-hover && !root.d.adopting) ? Theme.well : transparent);
    border-width: Theme.hair;
    // one consistent state ladder: selected wears the full hairline, a hovered row a fainter line-soft
    // (it used to get the background wash but ZERO border), at rest nothing. Hover now reads as a real
    // rung between rest and selected instead of a border-less wash.
    border-color: selected ? Theme.line
        : (ta.has-hover && !root.d.adopting) ? Theme.line-soft
        : transparent;
    animate background, border-color, opacity { duration: Theme.quick; }
    property <bool> sheen-live: root.d.connected && ta.has-hover;
    // When firmware is the ONLY readout this device would show, a one-key data strip is an orphan —
    // a lone two-line "FW / v1.01" block breaking the list's name-plus-meta rhythm. Fold it into the
    // meta line instead ("pid 0221 · wired · fw v1.01") and suppress the strip.
    property <bool> lone-fw: !root.d.cap-dpi && !root.d.cap-poll && root.d.battery == ""
        && !root.d.cap-bright && root.d.storage == ""
        && !(root.d.cap-plate && root.d.plate != "");
    // A wireless mouse that hasn't spoken yet shows "—" for every live readout while the FEEL panel
    // confidently shows its CONFIG values — two halves of one screen disagreeing about whether the
    // device is connected. The strip earns a one-line explanation instead of four bare dashes.
    property <bool> asleep: root.d.cap-dpi && root.d.dpi == "—";
    // accent index tick on the selected channel — the only colour; the shared SelectTick is the bar +
    // its settle, and this site supplies its own vertical inset (12px top/bottom).
    SelectTick {
        active: root.selected;
        y: 12px; height: parent.height - 24px;
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    // CARD CONTENT — a flow row: [glyph] [main: identity over data] [backup]. The layout engine places
    // `backup` (the trailing child) flush-right against the card's ACTUAL laid-out width — there is no
    // parent.width arithmetic that can diverge from the rendered width (the flaw that put `backup`
    // ~50px past the card border in every absolute-positioned attempt). `main` (stretch:1) eats the
    // slack so `backup` lands at one identical x; the data strip is a preferred-0 Flickable (min 0,
    // preferred 0) so it can neither push `backup` nor inflate the card, and the header elides — so the
    // card's intrinsic width stays tiny and the deck VBox stretches every card to the uniform column
    // width. Same shape as the profiles app-rule rows (flow list, trailing action at one x).
    HorizontalLayout {
        padding-left: 18px; padding-right: 14px; padding-top: 12px; padding-bottom: 12px;
        spacing: 14px;

        // ── the device's identity glyph ───────────────────────────────────
        VerticalLayout {
            alignment: center;
            SheenGlyph {
                kind: root.d.icon;
                ink: root.selected ? Theme.text-mid : Theme.text-faint;
                live: root.sheen-live;
            }
        }

        // ── main: identity header over the data strip ─────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 9px;
            // header: a persistent connection LAMP + name + pid/link mode. The hover sheen stays a
            // flourish, but at REST a connected row now reads at a glance (accent dot) vs a dropped one
            // (dark lamp-off gutter) — before, rest-state connected and disconnected rendered identically.
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Theme.dot; height: Theme.dot; border-radius: Theme.dot / 2;
                        background: root.d.connected ? Theme.accent : Theme.lamp-off;
                        animate background { duration: Theme.quick; }
                    }
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    horizontal-stretch: 1;
                    SheenText {
                        value: root.d.name;
                        live: root.sheen-live;
                        ink: root.selected ? Theme.text : Theme.text-mid;
                        size: Theme.fs-data;
                        weight: 700;
                        tracking: Theme.track-1;
                    }
                    SheenText {
                        value: root.d.pid != ""
                            ? "pid " + root.d.pid + (root.d.mode != "" ? " · " + root.d.mode : "")
                              + (root.lone-fw && root.d.firmware != "" && root.d.firmware != "—"
                                  ? " · fw " + root.d.firmware : "")
                            : root.d.detail;
                        live: root.sheen-live;
                        ink: Theme.text-faint;
                        size: Theme.fs-small;
                        weight: 400;
                        tracking: 0px;
                    }
                }
            }
            // data strip — most-glanced first: DPI · POLL · BATT · LIGHT · ONBOARD · FW. A preferred-0
            // Flickable: it neither pushes `backup` (min 0) nor inflates the card (preferred 0); it clips
            // the trailing (least-glanced) readouts when the card is tight. The PAGE owns scrolling.
            // Gated on !adopting too: a placeholder has all caps false + empty battery/storage, so
            // only "FW —" would render — a dead readout on a row that isn't a device. Suppress the
            // strip entirely so a placeholder is just its name + mode line.
            if root.d.pid != "" && !root.d.adopting && !root.lone-fw : Flickable {
                height: 30px;
                interactive: false;
                // NO viewport-width binding: the content lays out at its natural width and the Flickable
                // CLIPS it at its own (main-allocated) width. Binding viewport-width to self.width made
                // the Flickable's preferred track its content, so a readout-heavy device leaked ~360px
                // into `main` and squeezed the trailing `backup` button (its label overflowed its box).
                    HorizontalLayout {
                        spacing: 13px;
                    // capability-gated readouts — a keyboard never prints "DPI —", a lightless mouse
                    // never prints "LIGHT —"; each key shows only where the descriptor says it's real.
                    if root.d.cap-dpi : Readout { key: "DPI"; value: root.d.dpi; }
                    if root.d.cap-poll : Readout { key: "POLL"; value: root.d.polling; }
                    // BATT rides the SAME key-over-value Readout rhythm as DPI/POLL (identical label row),
                    // with the drawn cell gauge APPENDED after the value — so the vitals strip shares one
                    // baseline: the value leads the second row, the gauge trails it as a graphic footnote.
                    if root.d.battery != "" : VerticalLayout {
                        alignment: center; spacing: 3px;
                        Text {
                            text: "BATT";
                            color: Theme.text-faint;
                            font-size: Theme.fs-small;
                            font-family: Theme.mono;
                            letter-spacing: Theme.track-3;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            // value first — matches Readout's fs-data/600 value line (the shared baseline)
                            Text {
                                text: root.d.battery;
                                color: root.d.charging ? Theme.accent : Theme.text-mid;
                                animate color { duration: Theme.quick; }
                                font-size: Theme.fs-data;
                                font-weight: 600;
                                font-family: Theme.mono;
                                vertical-alignment: center;
                            }
                            if root.d.charging : Text {
                                text: "CHG";
                                color: Theme.accent;
                                font-size: Theme.fs-small;
                                font-family: Theme.mono;
                                letter-spacing: Theme.track-2;
                                vertical-alignment: center;
                            }
                            // …then the drawn cell gauge, appended after the value — a level is a gauge, not a string
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px; height: 8px;
                                    border-width: Theme.hair;
                                    border-color: Theme.line;
                                    border-radius: 1px;
                                    Rectangle {
                                        x: 1px; y: 1px;
                                        height: parent.height - 2px;
                                        width: max(0px, (parent.width - 2px) * max(0.0, root.d.battery-frac));
                                        background: root.d.charging ? Theme.accent
                                            : root.d.battery-frac < Theme.battery-low-frac ? Theme.warn
                                            : Theme.text-dim;
                                        animate background { duration: Theme.quick; }
                                    }
                                }
                            }
                        }
                    }
                    // LIGHT keys on the brightness GETTER, not the lighting block — a board that can
                    // only SET brightness (the legacy BlackWidow) has no number to report, and a
                    // readout that says "—" forever is a lie of layout.
                    if root.d.cap-bright : Readout { key: "LIGHT"; value: root.d.brightness; }
                    if root.d.storage != "" : Readout { key: "ONBOARD"; value: root.d.storage; }
                    // SIDE PLATE — push-only readout under the mouse it belongs to (capability-gated,
                    // shown only once a plate has actually been reported, so it's never a lie).
                    if root.d.cap-plate && root.d.plate != "" : Readout { key: "PLATE"; value: root.d.plate; }
                    Readout { key: "FW"; value: root.d.firmware; }
                    // the strip-level explanation for a sleeping wireless device — one quiet clause
                    // instead of a row of dashes that contradicts the FEEL panel's config values.
                    if root.asleep : VerticalLayout {
                        alignment: center;
                        Text {
                            text: "asleep · readouts return when it moves";
                            color: Theme.text-faint;
                            font-size: Theme.fs-small;
                            font-family: Theme.mono;
                        }
                    }
                    Rectangle {}
                }
            }
        }

        // ── backup — the trailing flow child, a FIXED-width column so the layout engine can never
        // squeeze it (explicit width = min==max==width, immune to any shrink). `main` (stretch:1) eats
        // all slack, so this sits flush-right at the identical x on every device, full label intact. ──
        // A placeholder carries a real pid but is unclaimable — a `backup` on it can only fail, so
        // gate it out (!adopting) alongside the pid check.
        if root.d.pid != "" && !root.d.adopting : VerticalLayout {
            width: 72px;
            alignment: center;
            Button { text: "backup"; clicked => { root.backup(); } }
        }
    }
}

// SNAP TAP STAGE — "THE DIVERGENCE". The self-demonstrating visual for the Snap Tap mechanical
// advantage, reimagined as a TWO-PLAYER RACE on the same input. Two stacked full-width lanes are fed
// the IDENTICAL counter-strafe sequence (the shared [A] [D] keycaps drive both): the upper RAW lane is
// the dim, normal-SOCD player; the lower SNAP lane is the glowing accent player. On the snap the accent
// player flips to D INSTANTLY while the dim one STALLS in the SOCD dead-zone — and the glowing LEAD-GAP
// spanning the horizontal distance between them is the hero element: the edge, quantified. Same trigger,
// one's already there, one's stuck. No text — accent=winner / dim=laggard carries it.
//
//   [A] ........... shared input lights both lanes ........... [D]
//   raw   o..........|..  (stalls in the dead-zone)  — dim hollow ring, frozen
//   snap  *======================>(O)  halo + rail-flash  — accent, snapped to D, instant
//              |---- LEAD-GAP (glows) ----|             the advantage, made visible
//
// PHASES have a RHYTHM — the Timer's interval is bound to the phase, so beats vary: the SNAP (2) DWELLS
// longest as the hero frame, catchup is quick, ready/reset just breathe. The snap flips fast then HOLDS
// the rest of its (long) tick — that held frame after the instant flip is what sells "instant":
//   0  ready   — both markers at A (left), keys up (a breath before the beat)         550ms
//   1  strafe  — A pressed ([A] lit on both lanes); both markers hold the A end       750ms
//   2  SNAP    — D tapped while A held: accent SNAPS to D (instant) + halo + the SNAP  1150ms (hero)
//               rail FLASHES; dim STALLS in the dead-zone (warn pulse); LEAD-GAP blooms
//   3  catchup — dim limps over to D (slow, too late); the lead-gap collapses          900ms
//   4  reset   — keys up; both ease back to A, then loop                               650ms
// `live` gates the Timer so it only animates while the option is REVEALED (sealed = perfectly still).
// INTERACTIVE hand-off: while ANY cap is held, control stays yours indefinitely; ~2.4s after the LAST
// release the idle timer fires ONCE and hands back to the loop at phase 0 (the ready beat, keys up) so
// markers glide home. Releasing keys does NOT recentre — each marker RESTS at the last resolved side.
component SnapTapStage inherits Rectangle {
    in property <bool> live: false;        // REVEALED → the demo plays; LOCKED → frozen
    property <int> phase: 0;

    // ── the demo's private timing scale — named so the choreography reads at a glance (each was tuned
    // by eye; do NOT retime). The snap-INSTANT halves of the `snapping ? fast : …` ternaries stay
    // inline — they're the crisp flip, semantically bound to the snap, not part of this settle scale. ──
    property <duration> dur-settle: 360ms;   // the weighty glide — markers / lead-gap easing back to rest
    property <duration> dur-lag:    380ms;   // the raw laggard's slow limp across the rail
    property <duration> dur-warn:   300ms;   // the dead-zone flare + the trapped marker's warn tint
    property <duration> dur-halo:   320ms;   // the accent hero's halo bloom
    property <duration> dur-ticks:  220ms;   // the lead-gap measurement ticks fading in

    // ── INTERACTIVE DRIVE — once revealed, you can press-and-hold the [A]/[D] caps and drive the race
    // yourself: the snap lane snaps to the last-pressed instantly while the raw lane stalls in the
    // dead-zone when both are held. Purely illustrative — works on any device (only the ENABLE step is
    // gated). While `interactive`, positions DERIVE from the held keys; a declarative idle Timer hands
    // control back to the auto-loop ~2.4s after the LAST release (it can never fire while a key is held),
    // and the auto-loop only advances `phase` while !interactive. ──
    property <bool> a-held: false;         // [A] cap currently pressed (mouse-down)
    property <bool> d-held: false;         // [D] cap currently pressed
    property <int> last-key: 0;            // 0 = A, 1 = D — the last RESOLVED side (press wins; releasing one of two held keys hands it to the survivor)
    property <bool> interactive: false;    // the user is driving (vs the auto-loop)

    // ── the SHARED full-width lane geometry — both rails span MOST of the card (A=left, D=right) ──
    property <length> inset: 30px;         // rail end ← card edge; keeps markers off the keycaps
    property <length> rail-x0: self.inset;
    property <length> rail-w: self.width - 2 * self.inset;
    // marker centre x for a normalised position p (0 = A end, 1 = D end), in card coords.
    pure function mx(p: float) -> length { root.rail-x0 + p * root.rail-w }
    // the two stacked rails' y centres (and the keycap row above), inside the ~150px host.
    property <length> caps-y: 26px;        // the shared input-cue keycap row
    property <length> rail-t-y: 76px;      // upper rail — RAW (dim)
    property <length> rail-b-y: 124px;     // lower rail — SNAP TAP (accent, the hero)

    // the ACCENT (snap-tap) player's normalised position 0(A) .. 1(D).
    //   INTERACTIVE: snap to last-pressed — both held → last-key; only D → D; only A → A; neither → rest.
    //   AUTO:        the phased loop (ready/strafe→A, SNAP/catchup→D, reset→A).
    property <float> accent-pos: root.interactive
        ? ( (root.a-held && root.d-held) ? (root.last-key == 1 ? 1.0 : 0.0)
            : root.d-held ? 1.0
            : root.a-held ? 0.0
            // releasing inputs doesn't move you — rest where the last input resolved, no recentre.
            : (root.last-key == 1 ? 1.0 : 0.0) )
        : ( root.phase == 0 ? 0.0 :        // ready  → A
            root.phase == 1 ? 0.0 :        // strafe → A (agrees)
            root.phase == 2 ? 1.0 :        // SNAP   → D (instant)
            root.phase == 3 ? 1.0 :        // catchup→ holds D
            0.0 );                          // reset  → A
    // the DIM (raw SOCD) player: STALLS dead-centre when both are held (the dead-zone), else follows.
    //   INTERACTIVE: both held → 0.5 (stall); only D → D; only A → A; neither → rest.
    //   AUTO:        agrees on strafe, stalls on the snap, then limps to D.
    property <float> dim-pos: root.interactive
        ? ( (root.a-held && root.d-held) ? 0.5   // both held → stall dead-centre (the dead-zone)
            : root.d-held ? 1.0
            : root.a-held ? 0.0
            // releasing inputs doesn't move you — rest where the last input resolved, no recentre.
            : (root.last-key == 1 ? 1.0 : 0.0) )
        : ( root.phase == 0 ? 0.0 :        // ready  → A
            root.phase == 1 ? 0.0 :        // strafe → A (agrees)
            root.phase == 2 ? 0.5 :        // STALLS dead-centre — the neutral dead-zone the edge removes
            root.phase == 3 ? 1.0 :        // limps over (too late)
            0.0 );                          // reset  → A
    // which key is "pressed" (lights BOTH lanes' shared cue). Interactive → the real held state; auto →
    // the scripted sequence (A held through 1,2,3; D tapped 2,3).
    property <bool> a-down: root.interactive ? root.a-held : (root.phase == 1 || root.phase == 2 || root.phase == 3);
    property <bool> d-down: root.interactive ? root.d-held : (root.phase == 2 || root.phase == 3);
    // THE SNAP — drives the accent's crisp easing, the halo bloom, the rail-flash, the gap, the warn dead-zone.
    // Interactive: both keys held = the live SOCD conflict (raw stalls, snap holds last). Auto: phase 2.
    property <bool> snapping: root.interactive ? (root.a-held && root.d-held) : (root.phase == 2);
    // the lead-gap is "live" (visible) whenever the accent is meaningfully ahead of the dim marker.
    property <bool> gap-open: root.interactive ? (root.a-held && root.d-held) : (root.phase == 2);

    height: 150px;
    border-radius: Theme.radius;
    background: Theme.bg-2;
    border-width: Theme.hair;
    border-color: Theme.line;
    clip: true;

    // the loop: 5 phases. The snap (2) flips fast then holds the rest of its (long) tick; 0 + 4 breathe.
    // It keeps ticking while the user drives but only ADVANCES the phase when !interactive — manual
    // driving never fights the auto-loop. Hand-back (the idle timer) resets to phase 0, so the loop
    // always re-enters at the ready beat and the markers glide home.
    Timer {
        // beat lengths — the SNAP dwells longest (the hero frame), ready/reset just breathe
        interval: root.phase == 2 ? 1150ms
                : root.phase == 3 ? 900ms
                : root.phase == 1 ? 750ms
                : root.phase == 4 ? 650ms
                : 550ms;
        running: root.live;
        triggered => { if (!root.interactive) { root.phase = mod(root.phase + 1, 5); } }
    }
    // IDLE-RESUME — declarative: it only RUNS once driving AND all caps are up, so holding any key keeps
    // control yours indefinitely (running goes false while held) and any re-press cancels the countdown.
    // ~2.4s after the last release it fires ONCE, handing back to the auto-loop at phase 0 (the ready
    // beat, keys up) so the markers glide home smoothly instead of jumping into a stale frozen phase.
    idle-timer := Timer {
        interval: 2400ms;
        running: root.interactive && !root.a-held && !root.d-held;
        triggered => { root.interactive = false; root.phase = 0; }
    }
    function start-driving(key: int) {
        root.last-key = key;
        root.interactive = true;
    }

    // ── the two RAILS — faint full-width tracks the markers ride; end stops at A and D. Split into two
    // explicit rails so the SNAP rail can FLASH accent while snapping (the old comet streak, folded into
    // the rail itself). RAW rail stays a plain hairline. Both keep their A/D end-stop ticks. ──
    // RAW rail (dim)
    Rectangle {
        x: root.rail-x0; y: root.rail-t-y - 1px;
        width: root.rail-w; height: 2px; border-radius: 1px;
        background: Theme.line;
        for ex in [0.0, 1.0] : Rectangle {
            x: ex * root.rail-w - 1px; y: -4px;
            width: 2px; height: 10px; border-radius: 1px;
            background: Theme.text-faint.with-alpha(0.6);
        }
    }
    // SNAP rail (accent hairline) — brightens on the snap, then eases back (the rail-flash punctuation).
    Rectangle {
        x: root.rail-x0; y: root.rail-b-y - 1px;
        width: root.rail-w; height: 2px; border-radius: 1px;
        background: root.snapping ? Theme.accent.with-alpha(0.55) : Theme.accent-line;
        animate background { duration: root.snapping ? 90ms : 420ms; easing: ease-out; }
        for ex in [0.0, 1.0] : Rectangle {
            x: ex * root.rail-w - 1px; y: -4px;
            width: 2px; height: 10px; border-radius: 1px;
            background: Theme.text-faint.with-alpha(0.6);
        }
    }
    // the DEAD-ZONE on the RAW rail — the neutral trap where opposing inputs cancel. The dim player falls
    // in and STALLS dead-centre; the SNAP-TAP rail has NONE. Faintly present, it flares warn as the marker
    // is caught in it on the snap — naming the exact stall the advantage removes (no text needed).
    Rectangle {
        x: root.mx(0.38); y: root.rail-t-y - 9px;
        width: root.mx(0.62) - root.mx(0.38); height: 18px;
        border-radius: Theme.radius-sm;
        background: Theme.warn.with-alpha(root.snapping ? 0.16 : 0.06);
        border-width: Theme.hair;
        border-color: Theme.warn.with-alpha(root.snapping ? 0.55 : 0.22);
        animate background, border-color { duration: root.dur-warn; easing: ease-out; }
    }

    // ── the LEAD-GAP — THE SIGNATURE. A glowing accent band bridging the two lanes' x-positions:
    // from where the dim player STALLED to where the accent player SNAPPED. It blooms on the snap = the
    // edge made visible ("this far ahead"), then collapses as the dim one finally limps over on catchup.
    Rectangle {
        // span horizontally from the dim marker (left edge of the gap) to the accent marker (right edge),
        // spanning vertically between the two rails so it visibly connects laggard → winner.
        x: root.mx(root.dim-pos);
        y: root.rail-t-y;
        width: max(0px, root.mx(root.accent-pos) - root.mx(root.dim-pos));
        height: root.rail-b-y - root.rail-t-y;
        border-radius: Theme.radius-sm;
        background: Theme.accent-glow;
        border-width: Theme.hair;
        border-color: Theme.accent-line;
        opacity: root.gap-open ? 1.0 : 0.0;
        // bloom fast with the snap; fade as it collapses on catchup. width follows the markers' easing.
        animate x { duration: root.snapping ? 90ms : root.dur-settle; easing: root.snapping ? ease-out : ease-in-out; }
        animate width { duration: root.snapping ? 90ms : root.dur-settle; easing: root.snapping ? ease-out : ease-in-out; }
        animate opacity { duration: root.gap-open ? 140ms : 280ms; easing: ease-out; }
        // MEASUREMENT TICKS — faint vertical hairlines stepping across the gap, brightening toward the
        // winning (D, right) edge: the lead reads as QUANTIFIED ("this many steps ahead"), not a blob.
        // Evenly spaced by fraction so they ride the gap as it blooms/collapses; the directional ramp
        // gives a soft shimmer toward D. Hidden when the gap is too narrow to subdivide cleanly.
        for tk in [0.2, 0.4, 0.6, 0.8] : Rectangle {
            x: parent.width * tk - self.width / 2;
            y: 2px; width: 1px; height: parent.height - 4px;
            border-radius: 0.5px;
            background: Theme.accent;
            // ramp brighter toward D — the lead, measured off; only when the gap is wide enough to read.
            opacity: (root.gap-open && parent.width > 24px) ? (0.18 + tk * 0.34) : 0.0;
            animate opacity { duration: root.dur-ticks; easing: ease-out; }
        }
        // a brighter inner edge on the winning (right) side — the leading front of the advantage.
        Rectangle {
            x: parent.width - self.width; width: 2px; height: parent.height;
            border-radius: 1px; background: Theme.accent;
            opacity: root.gap-open ? 0.7 : 0.0;
            animate opacity { duration: 200ms; }
        }
    }

    // ── the RAW (dim) marker — normal SOCD, a HOLLOW ring on the upper rail; the laggard. ──
    Rectangle {
        x: root.mx(root.dim-pos) - self.width / 2;
        y: root.rail-t-y - self.height / 2;
        width: 13px; height: 13px; border-radius: 7px;
        background: transparent;
        border-width: 1.5px;
        // tints WARN when caught in the dead-zone on the snap (trapped); dim otherwise — the stall while
        // the accent is already at D IS the pitch.
        border-color: root.snapping ? Theme.warn : Theme.text-faint.with-alpha(0.9);
        animate border-color { duration: root.dur-warn; easing: ease-out; }
        // ALWAYS moves with weight (slow) — so on the snap it visibly LAGS, stuck in the dead-zone.
        animate x { duration: root.dur-lag; easing: ease-in-out; }
        opacity: root.snapping ? 1.0 : 0.6;
        animate opacity { duration: Theme.settle; }
        // a faint WARNING PULSE ring at the stuck spot on the snap — "frozen here, weighty, late".
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.snapping ? 32px : 13px; height: self.width; border-radius: self.width / 2;
            background: transparent;
            border-width: 1.5px;
            border-color: Theme.warn;
            opacity: root.snapping ? 0.8 : 0.0;
            animate width, opacity { duration: root.dur-settle; easing: ease-out; }
        }
    }

    // ── the SNAP TAP (accent) marker — the winner; solid, glowing, on the lower rail. ──
    Rectangle {
        x: root.mx(root.accent-pos) - self.width / 2;
        y: root.rail-b-y - self.height / 2;
        width: 14px; height: 14px; border-radius: 7px;
        background: Theme.accent;
        // crisp instant reversal on the snap (~85ms ease-out); weighty glide otherwise — the edge's feel.
        animate x {
            duration: root.snapping ? 85ms : root.dur-settle;
            easing: root.snapping ? ease-out : ease-in-out;
        }
        // a steady accent halo (the glow that marks it as the hero), blooming bolder on the snap instant
        // and giving a soft confirming pulse at D on catchup ("snap-tap arrived first").
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.snapping ? 38px : (root.phase == 3 ? 30px : 22px);
            height: self.width; border-radius: self.width / 2;
            background: Theme.accent-glow;
            border-width: 1.5px;
            border-color: Theme.accent;
            opacity: root.snapping ? 1.0 : (root.phase == 3 ? 0.7 : (root.phase == 0 || root.phase == 4 ? 0.0 : 0.5));
            animate width, opacity { duration: root.dur-halo; easing: ease-out; }
        }
    }

    // ── DISCOVERABILITY HINT — a quiet nudge between the caps that you can drive it yourself. Only shows
    // in the live auto-demo (fades the instant you take over). Behind the caps; Text has no input. ──
    Text {
        text: "hold A + D yourself";
        color: Theme.text-faint;
        font-family: Theme.mono; font-size: Theme.fs-small;
        horizontal-alignment: center; vertical-alignment: center;
        x: 0; width: parent.width; y: root.caps-y - self.height / 2;
        opacity: (root.live && !root.interactive) ? 0.8 : 0.0;
        animate opacity { duration: 300ms; easing: ease-out; }
    }

    // ── the SHARED INPUT CUE — [A] far left, [D] far right. Now LIVE: press-and-hold to drive the race.
    // Each cap lights (accent + depress) when its key is down, lifts/brightens a hair on hover (so it
    // reads as pressable BEFORE the click), and its TouchArea feeds a-held/d-held + last-key (the idle
    // Timer resumes declaratively on release). Works regardless of device support — the demo, not the gate. ──
    for kc in [
        { lbl: "A", key: 0, nx: 0.0 },
        { lbl: "D", key: 1, nx: 1.0 },
    ] : Rectangle {
        property <bool> down: kc.key == 0 ? root.a-down : root.d-down;
        x: root.mx(kc.nx) - self.width / 2;
        // pressed → dips (depresses) a hair; hovered (not pressed) → lifts a hair — both tactile.
        y: root.caps-y - self.height / 2
            + (self.down ? 1px : (cap-ta.has-hover ? -1px : 0px));
        width: 28px; height: 28px;
        border-radius: Theme.radius-sm;
        background: self.down ? Theme.accent-glow : (cap-ta.has-hover ? Theme.well : Theme.well.with-alpha(0.6));
        border-width: Theme.hair;
        border-color: self.down ? Theme.accent-line : (cap-ta.has-hover ? Theme.text-faint : Theme.line);
        animate background, border-color, y { duration: Theme.quick; easing: ease-out; }
        Text {
            text: kc.lbl;
            // hover pre-brightens the glyph (text-mid) before it lights accent on press.
            color: parent.down ? Theme.accent : (cap-ta.has-hover ? Theme.text-mid : Theme.text-dim);
            font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
            width: parent.width; height: parent.height;
            animate color { duration: Theme.quick; }
        }
        cap-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    if (kc.key == 0) { root.a-held = true; } else { root.d-held = true; }
                    root.start-driving(kc.key);   // arm interactivity (the idle timer is declarative)
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (kc.key == 0) { root.a-held = false; } else { root.d-held = false; }
                    // if the OTHER key is still held, releasing this one re-resolves to the survivor — so the
                    // eventual full-release rest stays where the markers are already shown (no teleport).
                    if (root.a-held) { root.last-key = 0; } else if (root.d-held) { root.last-key = 1; }
                    // no timer poke — with all caps up the idle Timer's `running` binding starts its ~2.4s countdown.
                }
            }
        }
    }
}

// MECH ADVANTAGE — the reusable two-step-consent card for an opt-in, edge-giving device feature.
// LOCKED: the stage visual is dimmed + sealed (a lock glyph), with a "click to reveal ▸" affordance —
// you can tell something powerful is here. REVEALED: the visual plays its demo and a clear TOGGLE
// appears with a quiet ⚠ warn accent (the legality acknowledgment IS the consent click, not a
// paragraph). If the device can't do it, the toggle stays GATED ("needs a supporting device") —
// honest, like the other gates. The stage visual is passed in as the `stage` content.
component MechAdvantage inherits Card {
    in property <string> name;             // the option name (e.g. "snap tap")
    in property <string> tagline;          // one short line shown REVEALED (what the edge is)
    in property <bool> supported;          // a capable device is connected (else GATED)
    in-out property <bool> revealed;       // step 1 done
    in-out property <bool> enabled;        // step 2: the feature is on
    // shared invite-hover: the reveal ROW writes here so the SEAL (a sibling, out of the row's `if`
    // scope) can light its lock too — hovering either invites the unseal.
    property <bool> row-hover: false;
    callback reveal();                     // step 1 click
    callback set-enabled(bool);            // step 2 toggle

    // the enabled card wears Card's accent-line frame (active = a lit/chosen surface); Card provides
    // the bg-2 ground + hairline + the border-color settle.
    active: root.enabled;
    clip: true;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        // header: the option name + a state word on the right (sealed / ready / ON / gated)
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Mono {
                    text: root.name;
                    color: root.enabled ? Theme.accent : Theme.text-mid;
                    font-size: Theme.fs-small; font-weight: 700;
                    letter-spacing: Theme.track-2;
                    animate color { duration: Theme.quick; }
                }
            }
            Rectangle {}
            VerticalLayout {
                alignment: center;
                Mono {
                    text: !root.supported ? "GATED"
                        : root.enabled ? "ON"
                        : root.revealed ? "READY"
                        : "SEALED";
                    color: !root.supported ? Theme.warn
                        : root.enabled ? Theme.accent
                        : Theme.text-faint;
                    font-size: Theme.fs-small; font-weight: 700;
                    letter-spacing: Theme.track-2;
                }
            }
        }

        // ── the STAGE — the demo visual, with a LOCKED overlay until revealed ──
        stage-host := Rectangle {
            height: 150px;
            // the passed-in stage visual fills this host (a layout stretches the child to full width)
            VerticalLayout { @children }
            // the SEAL — a dim scrim + lock glyph over the visual until step 1. Fades on reveal.
            // Hovering the sealed stage (or the reveal row) gives the lock a "press me" affordance: it
            // lifts a hair + gains a faint accent glow, then settles back on leave. The seal is itself
            // clickable (so the whole sealed card invites the unseal, not just the row).
            seal := Rectangle {
                // shared invite-hover: this scrim OR the reveal row below it.
                property <bool> invite: !root.revealed && (seal-ta.has-hover || root.row-hover);
                width: parent.width; height: parent.height;
                border-radius: Theme.radius;
                background: Theme.bg-2.with-alpha(0.82);
                opacity: root.revealed ? 0.0 : 1.0;
                visible: root.revealed ? false : true;
                // the UNSEAL — a deliberate fade rather than a blink (the lock scales down a touch as it
                // goes, like a key turning, then the scrim clears).
                animate opacity { duration: Theme.settle; easing: ease-in-out; }
                // a faint accent halo behind the lock on hover — the "something powerful here" tell.
                Rectangle {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 64px; height: 64px; border-radius: 32px;
                    background: Theme.accent-glow;
                    opacity: parent.invite ? 0.9 : 0.0;
                    animate opacity { duration: Theme.settle; easing: ease-out; }
                }
                // a small procedural LOCK (shackle arc approximated by a rounded-top body + a keyhole).
                // A fixed-footprint wrapper keeps the layout still; the glyph inside scales/lifts.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px; height: 34px;   // stable footprint — no layout shift
                            lock := Rectangle {
                                // a unit length that scales the whole glyph: full size sealed, a touch
                                // smaller as it unseals (the "turn"), drawn from a 34u design grid.
                                property <length> u: (root.revealed ? 0.8px : 1px) * (seal.invite ? 1.06 : 1.0);
                                width: 34 * self.u; height: 34 * self.u;
                                x: (parent.width - self.width) / 2;
                                // lift a hair on invite-hover — the "press me" affordance.
                                y: (parent.height - self.height) / 2 + (seal.invite ? -2px : 0px);
                                animate width, height, y { duration: Theme.settle; easing: ease-in-out; }
                                // shackle — a hollow rounded rect, bottom hidden behind the body
                                Rectangle {
                                    x: 9 * lock.u; y: 3 * lock.u; width: 16 * lock.u; height: 16 * lock.u;
                                    border-radius: 8 * lock.u;
                                    border-width: 2px;
                                    // brightens toward accent on invite — it reads as armed/pressable.
                                    border-color: seal.invite ? Theme.accent : Theme.text-dim;
                                    animate border-color { duration: Theme.settle; }
                                }
                                // body
                                Rectangle {
                                    x: 6 * lock.u; y: 13 * lock.u; width: 22 * lock.u; height: 17 * lock.u;
                                    border-radius: 3 * lock.u;
                                    background: seal.invite ? Theme.accent : Theme.text-dim;
                                    animate background { duration: Theme.settle; }
                                }
                                // keyhole
                                Rectangle {
                                    x: 15 * lock.u; y: 19 * lock.u; width: 4 * lock.u; height: 4 * lock.u;
                                    border-radius: 2 * lock.u;
                                    background: Theme.bg-2;
                                }
                            }
                        }
                    }
                }
                // the sealed stage is itself the unseal target — the whole card invites the click.
                seal-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.reveal(); }
                }
            }
        }

        // ── the GATE ROW — step 1 (reveal) or step 2 (enable), depending on state ──
        // The demo is ALWAYS revealable (it's illustrative — you should be able to watch what the
        // feature does even on a board that can't run it). Only the ENABLE step is device-gated.
        if !root.revealed : Rectangle {
            height: Theme.seg-h;
            border-radius: Theme.radius-sm;
            background: rta.has-hover ? Theme.well : Theme.bg-2;
            border-width: Theme.hair;
            border-color: rta.has-hover ? Theme.text-faint : Theme.line;
            animate background, border-color { duration: Theme.quick; }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "click to reveal ▸";
                    color: rta.has-hover ? Theme.text-mid : Theme.text-dim;
                    font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
                    vertical-alignment: center;
                }
            }
            rta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.reveal(); }
                // mirror hover up so the SEAL's lock lights too (the row and seal invite together).
                changed has-hover => { root.row-hover = self.has-hover; }
            }
        }
        // REVEALED → the tagline, then step 2: the enable toggle (supported) or the honest gate (not).
        if root.revealed : VerticalLayout {
            spacing: 8px;
            if root.tagline != "" : Mono {
                text: root.tagline;
                color: Theme.text-faint;
                font-size: Theme.fs-small;
                wrap: word-wrap;
            }
            // supported → the ⚠ legality accent + the enable toggle
            if root.supported : HorizontalLayout {
                spacing: 8px;
                // ⚠ — the legality acknowledgment as a quiet accent, NOT a paragraph
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "!";
                        color: Theme.warn;
                        font-family: Theme.mono; font-size: Theme.fs-body;
                        vertical-alignment: center;
                    }
                }
                Rectangle {}
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        caption: "enable";
                        checked: root.enabled;
                        toggled(v) => { root.set-enabled(v); }
                    }
                }
            }
            // unsupported → the honest gate, consistent with the other "needs hardware" lines
            if !root.supported : Mono {
                text: "needs a supporting device";
                color: Theme.text-faint;
                font-size: Theme.fs-small;
                wrap: word-wrap;
            }
        }
    }
}

export component DevicePanel inherits VerticalLayout {
    spacing: 0;

    // Which ADVANCED rows the SELECTED device actually earns — straight from the descriptor's
    // capability flags (see DeviceRow), which is what those flags were always for. WHEEL MODE needs a
    // stage-scroll wheel, SLEEP a wireless idle timer, and the sensor pair (HYPERPOLLING + LIFT-OFF)
    // rides the DPI/sensor cap. The disclosure appears only when at least one row is real, so a
    // device with no advanced writes simply has no advanced drawer instead of an empty ceremony.
    property <bool> adv-wheel: State.sel-can-scroll;
    property <bool> adv-sleep: State.sel-can-idle;
    property <bool> adv-sensor: State.sel-can-dpi;
    property <bool> adv-any: root.adv-wheel || root.adv-sleep || root.adv-sensor;

    // which STAGE cell the live DPI fader is currently sitting on — the stage table's NEAR highlight
    // (a quiet secondary marker, not the active/lit cell). No indexOf in Slint, so a bounded ternary
    // over the stage list (Razer caps at ~5 DPI stages); an unmatched fader yields -1 (no highlight).
    property <int> dpi-near-stage:
        (State.dpi-stage-nums.length > 0 && round(State.dpi) == State.dpi-stage-nums[0]) ? 0
        : (State.dpi-stage-nums.length > 1 && round(State.dpi) == State.dpi-stage-nums[1]) ? 1
        : (State.dpi-stage-nums.length > 2 && round(State.dpi) == State.dpi-stage-nums[2]) ? 2
        : (State.dpi-stage-nums.length > 3 && round(State.dpi) == State.dpi-stage-nums[3]) ? 3
        : (State.dpi-stage-nums.length > 4 && round(State.dpi) == State.dpi-stage-nums[4]) ? 4
        : -1;

    // SCAN's discard-guard: when there are unapplied FEEL edits (State.feel-dirty), a scan would throw
    // them away (it re-seeds the drafts from hardware), so the first SCAN click ARMS (relabels to a
    // "sure?" verb, reddened) and only a second click within the confirm window actually re-scans —
    // ConfirmButton's semantics, inlined onto the left half of the deck. A clean deck scans on one click.
    property <bool> scan-armed: false;
    Timer {
        interval: Theme.confirm-window;
        running: root.scan-armed;
        triggered => { root.scan-armed = false; }
    }
    // walking away from a dirty deck (a device reselect discards drafts) also disarms — the drafts the
    // arm was protecting are gone, so a stale armed state would be a lie.
    changed adv-any => { root.scan-armed = false; }

    // ── ADVANCED reveal · SCROLL-INTO-VIEW ────────────────────────────────────────────────────
    // The ADVANCED disclosure sits at the BOTTOM of the inspector's own wheel-only scroller, so
    // everything it reveals lands below the fold: the row looks dead even though it worked. That
    // exact illusion cost three separate investigations (see the note at the Flickable below, and
    // docs/archive/UX-PENTEST-2026-08-04.md) — a reveal you cannot see is indistinguishable from a reveal that did not
    // happen. Opening now scrolls its own content into view.
    //
    // WHY A TIMER rather than scrolling in the click handler: the drawer's height eases open over
    // `Theme.settle`, and i-slint-core's Flickable clamps `viewport-y` against the extent it has
    // RIGHT NOW (`ensure_in_bound`, items/flickable.rs) — and its re-clamp handler only ever pulls
    // an OUT-of-bounds viewport back in, never re-scrolls one that is already legal. Scroll on the
    // click and you are clamped to the pre-growth bottom, which then stays "in bounds" forever as
    // the content grows past it: a silent no-op.
    //
    // And why a FOLLOW rather than one shot at `Theme.settle`: a single sample assumes the extent
    // is final the very frame the animation ends — true only if layout has already propagated by
    // then, and silently wrong the day anyone retunes the animation. Re-pinning on a short interval
    // across a window comfortably longer than the animation is self-correcting: whatever the extent
    // settles to, the last tick lands on it. Cheap — a handful of assignments, then it stops itself.
    property <int> reveal-ticks: 0;   // ticks elapsed in the current follow; reset on each open
    reveal-scroll := Timer {
        interval: 40ms;
        running: false;
        triggered => {
            // most-negative legal offset == the Flickable's own lower bound (h - vh), floored at 0
            // so a drawer that already fits can't scroll a short column upward.
            insp.viewport-y = min(0px, insp.height - insp.viewport-height);
            root.reveal-ticks += 1;
            if (root.reveal-ticks >= 8) { self.running = false; }   // 320ms ≈ 3x Theme.settle
        }
    }

    PanelHead {
        label: "DEVICE";
        caption: "live device readout";
        if State.writes-paused : VerticalLayout { alignment: center; Pill { text: "WRITES PAUSED"; tint: Theme.danger; } }
        VerticalLayout { width: 8px; }
        // SCAN ⇄ APPLY as one joined control (the DIRECT/WEAVE split-button idiom). SCAN re-reads every
        // device (and so doubles as the FEEL deck's revert — it re-seeds the drafts from the hardware);
        // APPLY commits the selected device's FEEL drafts in one write. APPLY lights only when a tunable
        // HID is selected (a mic/output or empty selection leaves it quiet); SCAN is always live.
        VerticalLayout {
            width: 150px;
            alignment: center;
            SplitButton {
                // SCAN relabels to the armed "discard?" verb (reddened) while a dirty scan is armed.
                left-text: root.scan-armed ? "discard?" : "scan";
                left-danger: root.scan-armed;
                right-text: "apply";
                // APPLY lights the commit accent ONLY when there's something to commit (feel-dirty); a
                // clean deck leaves it plain — nothing to spend the accent on.
                right-primary: State.feel-dirty;
                right-enabled: !State.writes-paused
                    && (State.selected-device-kind == "mouse"
                        || State.selected-device-kind == "keyboard"
                        || State.selected-device-kind == "device");
                left-clicked => {
                    // dirty + not yet armed → ARM (scan would discard the edits); otherwise scan for real
                    // (a clean deck, or the confirming second click). Either path clears the arm.
                    if (State.feel-dirty && !root.scan-armed) {
                        root.scan-armed = true;
                    } else {
                        root.scan-armed = false;
                        State.refresh-devices();
                    }
                }
                right-clicked => { State.apply-feel(); }
            }
        }
    }
    Divider {}
    Rectangle { height: Theme.lead-in; }

    HorizontalLayout {
        spacing: Theme.gap-col;
        vertical-stretch: 1;   // fill the page height so each column is a FIXED footprint (static UI)

        // ── device channels ───────────────────────────────────────────────
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 2;
            preferred-width: 440px;
            alignment: start;   // top-pack the channel cards (the column now fills the height)
            // a width FLOOR for the list. The cards now report ~0 preferred width (their content lives
            // in a preferred-0 Flickable so it can't inflate the column), which is what stops the row
            // overflowing into FEEL — but it also means the column would otherwise collapse toward
            // FEEL's larger preferred. This floor keeps the list the wide 2/3 it's meant to be: 440 +
            // FEEL's 340 + the 24 gutter = 804, inside the 856 work area at the 900px-min window.
            min-width: 440px;
            if State.devices.length == 0 : VerticalLayout {
                padding-top: 24px; spacing: 6px;
                Mono { text: "no recognized Razer devices"; color: Theme.text-dim; }
                Mono { text: "plug one in and press scan"; }
            }
            // The cards stack in a plain VerticalLayout (the page-level PanelPage Flickable owns the
            // vertical scroll). The trick that makes this work where every prior attempt failed: a
            // DeviceLine's children are ABSOLUTELY positioned (the identity/data clip + the geometry-
            // pinned backup, both keyed off parent.width), so the card imposes NO min-width of its own
            // → it reports 0 → the VerticalLayout stretches EVERY card to the identical column width
            // with zero overflow. No explicit card width (that was circular: card.width = deck.width fed
            // the card's own width back into the deck and inflated the row past its slot). Same shape as
            // the profiles app-rule rows — a flow list with a trailing action that sits at one x.
            VerticalLayout {
                spacing: 5px;
                for d[i] in State.devices : DeviceLine {
                    d: d;
                    selected: i == State.selected-device;
                    clicked => { State.select-device(i); }
                    backup => { State.backup-device(d.id); }
                }
            }
            // Unclaimed vendor pipes are an INVENTORY fact, not device channels — their functional
            // faces (the audio endpoint rows) already list above; a row per pipe double-listed real
            // hardware (live complaint 2026-07-07). One dim line answers "why isn't my device a
            // channel" without pretending the pipe is one.
            if State.unclaimed-note != "" : Mono {
                text: State.unclaimed-note;
                color: Theme.text-faint;
                overflow: elide;
            }
        }

        // ── feel + ADVANCED controls for the selected device ──────────────
        VerticalLayout {
            // TRULY fixed width (min == max) so the panel is a constant footprint the content can NEVER
            // resize — toggling ADVANCED, content fitting-vs-scrolling, and focus re-layout all left it
            // visibly shifting before this. 410 fits the widest row (the 7-chip hyperpolling) and still
            // leaves the device list above its floor at the 900px-min window. The list (stretch) eats the
            // rest. This is the "fixed-footprint inspector" the design always intended.
            horizontal-stretch: 0;
            min-width: 410px;
            preferred-width: 410px;
            max-width: 410px;
            insp := Flickable {
                // WHEEL-ONLY, exactly like the page-level PanelPage. A plain (drag-to-flick) Flickable
                // HIJACKS a click-drag that begins on a child control into a scroll — that competition is
                // why controls in this pane (the ▸ advanced disclosure especially) clicked inconsistently
                // once it had scrolled, while working fine maximized (nothing to scroll). `interactive:
                // false` drops the drag gesture; the mouse wheel still scrolls.
                interactive: false;
                viewport-width: self.width;
                viewport-height: max(self.height, ibody.preferred-height);
                ibody := VerticalLayout {
                    width: parent.viewport-width;
                    // fill the viewport (match PanelPage's body) so the scroll geometry is exact; cards
                    // still sit at NATURAL size, top-packed (alignment:start) — no stretch / empty-gap.
                    height: parent.viewport-height;
                    alignment: start;
                    // a little breathing room under the last element at max-scroll.
                    padding-bottom: 18px;
            // the controls act on a SELECTED channel — with none, don't present live-looking controls
            if State.devices.length == 0 : VerticalLayout {
                padding-top: 24px;
                Mono { text: "no channel · plug in a Razer device to tune it"; color: Theme.text-faint; }
            }
            // AUDIO endpoint (mic / output) selected — its own volume + mute card (acts on THIS
            // endpoint, not the system default).
            if (State.selected-device-kind == "mic" || State.selected-device-kind == "output") : VerticalLayout {
                spacing: 16px;
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        HorizontalLayout {
                            SectionTitle { text: State.selected-device-kind == "mic" ? "MICROPHONE" : "OUTPUT"; }
                            Rectangle {}
                            Mono { text: State.selected-device-name; color: Theme.text-faint; overflow: elide; }
                        }
                        Mono { text: "moves this device, not your system default"; color: Theme.text-faint; wrap: word-wrap; }
                        // dim the fader when the channel is muted so the dead channel READS dead — it stays
                        // interactive (we don't expect an unmute-by-drag), it just quiets to gated opacity.
                        VerticalLayout {
                            opacity: State.device-muted ? Theme.dim-gated : 1.0;
                            animate opacity { duration: Theme.quick; }
                            Slider {
                                caption: "VOLUME";
                                minimum: 0; maximum: 100; value: State.device-volume; step: 2;
                                // readout tracks the drag; the endpoint write (a COM round-trip) fires ONCE
                                // on release, not per drag-tick — same "one write per gesture" rule as sniper.
                                changed(v) => { State.device-volume = v; }
                                released(v) => { State.set-device-volume(v); }
                            }
                        }
                        // channel state, RENDERED BY FACET (read × write — see `Dialect::
                        // audio_mute_writable` / `read_audio_mute`): a control is interactive only when
                        // there is a PROVEN setter behind it; a read-only hardware mute gets a live
                        // indicator, never a toggle that would silently no-op against the firmware.
                        if State.device-mute-writable : SplitToggle {
                            // WRITABLE — an interactive two-way SplitToggle (LIVE ↔ MUTED) driving the
                            // endpoint's OS mute, which genuinely silences the stream for BOTH kinds (a
                            // render endpoint's playback, a capture endpoint's mic signal with a proven
                            // setter) — so the switch is always functional, never decorative. A strictly
                            // EXCLUSIVE pick, so it belongs on the fused index-picked idiom — LampRail is
                            // reserved for genuinely multi-select banks (KEY GUARD). Picking the held
                            // cell is a no-op.
                            options: ["LIVE", "MUTED"];
                            index: State.device-muted ? 1 : 0;
                            picked(i) => {
                                if (i == 0 && State.device-muted) { State.toggle-device-mute(); }
                                if (i == 1 && !State.device-muted) { State.toggle-device-mute(); }
                            }
                        }
                        if !State.device-mute-writable && State.device-mute-hardware : VerticalLayout {
                            // READ-ONLY hardware mute (e.g. the Seiren): the firmware owns the tap-mute
                            // register and NO setter is known (an exhaustive getter-oracle sweep proved
                            // it), so an interactive OS toggle here would contradict the physical LED. A
                            // non-interactive pill mirrors the live state instead.
                            spacing: 6px;
                            Pill {
                                text: State.device-muted ? "MUTED" : "LIVE";
                                live: State.device-muted;
                                live-tint: Theme.danger;
                            }
                            Mono {
                                text: "hardware mute \u{00b7} tap the mic (sensor-owned)";
                                color: Theme.text-faint;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // HID peripheral (mouse / keyboard) selected — the FEEL + ADVANCED control stack.
            if (State.selected-device-kind == "mouse" || State.selected-device-kind == "keyboard" || State.selected-device-kind == "device") : VerticalLayout {
                spacing: 16px;

                // ── FEEL — the EVERYDAY DECK: one cohesive, dense, at-a-glance card. DPI is the hero
                // (its stage cycle folded in beneath the fader); the rest live as a compact 2-up tile
                // grid. NO per-control applies — ONE global [ reload | apply ] commits the whole tier
                // (sniper auto-saves + persist is immediate, so they ride their own writes, not apply).
                if (State.sel-can-dpi || State.sel-can-poll || State.sel-can-bright-set || State.sel-can-store) : Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        // header: FEEL · device name (the apply lives up top, joined to SCAN in the head)
                        HorizontalLayout {
                            SectionTitle { text: "FEEL"; }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Mono { text: State.selected-device-name; color: Theme.text-faint; overflow: elide; }
                                // SIDE PLATE — the swappable plate the mouse last reported (push-only;
                                // no getter). Shown only for a device with plates AND a known value, so
                                // it's never a lie. A small honest "side plate · 12-button" readout.
                                if State.sel-can-plate && State.selected-plate != "" : Mono {
                                    text: "side plate · " + State.selected-plate;
                                    color: Theme.text-mid;
                                    overflow: elide;
                                }
                            }
                        }

                        // ── DPI HERO — the big value + fader (detents = the stage cycle), with the
                        // active-stage cycle (the stages field + i+1:stage active pills) folded in
                        // beneath it as one hero block. No per-control apply: the global apply commits.
                        if State.sel-can-dpi : VerticalLayout {
                            spacing: 9px;
                            Slider {
                                caption: "DPI";
                                minimum: 100; maximum: 30000; value: State.dpi;
                                step: 50;
                                detents: State.dpi-stage-nums;
                                changed(v) => { State.dpi = v; }
                            }
                            // the stage cycle, folded under the fader — the list + which stage is active.
                            HorizontalLayout {
                                spacing: 8px;
                                Field {
                                    field-width: 220px;
                                    placeholder: "800/1600/3200/6400";
                                    text <=> State.dpi-stages;
                                    invalid: !State.dpi-stages-valid;
                                    edited(t) => { State.dpi-stages-edited(t); }
                                    // draft only — Enter just confirms the text; the global apply commits
                                    // it (an immediate apply here would write stages while DPI/rate/etc.
                                    // stay pending, which contradicts the one-apply deck).
                                    accepted(t) => { State.dpi-stages-edited(t); }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; min-width: 0px;
                                    Mono {
                                        text: State.dpi-stages-note;
                                        color: State.dpi-stages-valid ? Theme.text-faint : Theme.danger;
                                        overflow: elide; min-width: 0px;
                                    }
                                }
                            }
                            // pick which stage is ACTIVE — the cycle's second half. The stage numbers ride
                            // a content-hugging ContactRow in ORDINAL / by-index mode: the cells label as
                            // stage 1..N (the per-stage DPI values already live in the field above), the
                            // lit cell tracks dpi-active-stage. Label outside, stretch spacer trailing so
                            // the rail hugs its cells instead of spanning.
                            HorizontalLayout {
                                spacing: 6px;
                                Mono { text: "stage"; color: Theme.text-faint; }
                                ContactRow {
                                    options: State.dpi-stage-nums;
                                    ordinal: true;
                                    by-index: true;
                                    index: State.dpi-active-stage;
                                    // the fader confirming the table: the stage whose DPI equals the
                                    // live fader value wears the quiet NEAR outline (never the accent).
                                    near-index: root.dpi-near-stage;
                                    min-cell: 34px;
                                    picked-index(i) => { State.dpi-active-stage = i; }
                                }
                                Rectangle { horizontal-stretch: 1; min-width: 8px; }
                            }
                        }

                        // ── the compact tile cluster. REPORT RATE · BRIGHTNESS ride a 2-up row, each
                        // stretching so a single-capability device fills the width instead of leaving a
                        // dead half-cell. SNIPER + PERSIST sit full-width below: sniper's capture + fader
                        // + presets want the room, and pairing the tall sniper with the short persist in
                        // one cell read lopsided.
                        VerticalLayout {
                            spacing: 10px;
                            if State.sel-can-poll || State.sel-can-bright-set : HorizontalLayout {
                                spacing: 10px;
                                // REPORT RATE — DRAFT only now: pick sets State.polling-hz (the global
                                // apply commits it via apply-polling), no per-press device write.
                                if State.sel-can-poll : FeelTile {
                                    horizontal-stretch: 1;
                                    term: "REPORT RATE";
                                    readout: round(State.polling-hz) + " Hz";
                                    readout-ink: Theme.text-mid;
                                    ContactRow {
                                        options: [125, 250, 500, 1000];
                                        value: round(State.polling-hz);
                                        enabled: !State.writes-paused;
                                        picked(hz) => { State.polling-hz = hz; }
                                    }
                                }
                                // BRIGHTNESS — a compact fader, no per-control apply (global apply commits).
                                if State.sel-can-bright-set : FeelTile {
                                    horizontal-stretch: 1;
                                    term: "BRIGHTNESS";
                                    readout: round(State.brightness) + "%";
                                    readout-ink: Theme.text-mid;
                                    Slider {
                                        compact: true;
                                        minimum: 0; maximum: 100; value: State.brightness;
                                        step: 5;
                                        changed(v) => { State.brightness = v; }
                                    }
                                }
                            }
                            // SNIPER — capture + precision DPI + presets, full-width (the tallest tile). A
                            // CONFIG write (auto-saves on release), NOT part of the global apply.
                            if State.sel-can-dpi : FeelTile {
                                term: "SNIPER";
                                readout: State.sniper-button == "—" ? "no hold button yet" : "hold " + State.sniper-button;
                                // a BOUND button is a saved setting, not a live held state — so it reads in
                                // plain ink (text-mid), never accent. Accent is reserved for genuinely-live
                                // signals; nothing here observes the hold in real time, so it stays quiet.
                                readout-ink: State.sniper-button == "—" ? Theme.text-faint : Theme.text-mid;
                                // unbound → one capture verb. Bound → the joined [re-capture | unbind]
                                // split (the missing "how do I turn this off" affordance — a bind you
                                // can only overwrite, never remove, is a roach motel).
                                if State.sniper-button == "—" : HorizontalLayout {
                                    Button { text: "capture hold button"; clicked => { State.capture-sniper-button(); } }
                                    Rectangle {}
                                }
                                if State.sniper-button != "—" : HorizontalLayout {
                                    VerticalLayout {
                                        width: 200px;
                                        alignment: center;
                                        SplitButton {
                                            left-text: "re-capture";
                                            right-text: "unbind";
                                            left-clicked => { State.capture-sniper-button(); }
                                            right-clicked => { State.unbind-sniper(); }
                                        }
                                    }
                                    Rectangle {}
                                }
                                Slider {
                                    caption: "PRECISION DPI";
                                    minimum: 100; maximum: 30000; value: State.sniper-dpi;
                                    step: 50;
                                    detents: State.dpi-stage-nums;
                                    changed(v) => { State.sniper-dpi = v; }
                                    // ONE config write per gesture, not one per drag-tick
                                    released(v) => { State.save-sniper(v); }
                                }
                                // preset DPIs ride a content-hugging value-keyed ContactRow — the cell
                                // whose DPI equals sniper-dpi lights. Label outside, trailing stretch
                                // spacer so the rail hugs its cells. The pick double-writes exactly as the
                                // hand-rolled cell did: set the draft AND persist it (save-sniper).
                                if State.dpi-stage-nums.length > 0 : HorizontalLayout {
                                    spacing: 6px;
                                    Mono { text: "presets"; color: Theme.text-faint; }
                                    ContactRow {
                                        options: State.dpi-stage-nums;
                                        value: State.sniper-dpi;
                                        min-cell: 48px;
                                        picked(s) => { State.sniper-dpi = s; State.save-sniper(s); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            // PERSIST — the onboard-memory toggle, full-width + slim. An IMMEDIATE write
                            // (set-persist), NOT part of the global apply.
                            if State.sel-can-store : FeelTile {
                                term: "PERSIST";
                                Toggle {
                                    caption: "to onboard memory";
                                    checked: State.persist-to-onboard;
                                    toggled(v) => { State.persist-to-onboard = v; State.set-persist(v); }
                                }
                                Mono { text: "saved to the mouse, so it holds with the app closed. needs onboard profiles."; color: Theme.text-faint; wrap: word-wrap; }
                            }
                        }
                    }
                }

                // KEY GUARD — a host-side LL-hook OS-chord swallow (no device write). It guards
                // KEYBOARD chords, so it lives under the keyboard channel (and generic HIDs — a
                // keypad is a keyboard at heart), never under a mouse: a page that shows Alt+Tab
                // lockout on a Naga reads as a bug. Grows by chord.
                if State.selected-device-kind != "mouse" : Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 13px;
                        SectionTitle { text: "KEY GUARD"; }
                        GateNote { text: "swallow OS chords mid-game so they can't yank you out (host-side, no device write)."; }
                        // the four chords are ONE multi-select LampRail (several can be swallowed at once),
                        // fused into a single hairline rail with 1px seams. Each cell wears a lamp dot so a
                        // MULTI-lit bank stays legible (an accent-fill alone can't show "two of four on" the
                        // way lit lamps can). No tints — accent is the default lamp hue. `toggled` flips the
                        // matching flag by index, then re-applies the gaming mode.
                        LampRail {
                            options: ["Alt+Tab", "Win", "Alt+F4", "Alt+Esc"];
                            on: [State.disable-alt-tab, State.disable-win, State.disable-alt-f4, State.disable-alt-esc];
                            toggled(i) => {
                                if (i == 0) { State.disable-alt-tab = !State.disable-alt-tab; }
                                else if (i == 1) { State.disable-win = !State.disable-win; }
                                else if (i == 2) { State.disable-alt-f4 = !State.disable-alt-f4; }
                                else { State.disable-alt-esc = !State.disable-alt-esc; }
                                State.apply-gaming-mode();
                            }
                        }
                        // wrap (was clipped at "…reversible (lif") — a chord guard lifts on profile change.
                        GateNote { text: "lit = swallowed while a gaming profile is active. reversible, it lifts when the profile changes."; }
                        // THE HARDWARE SIBLING — the board's OWN firmware Win-key kill (FN+F10 / GAME_LED),
                        // surfaced beside the host chords because it eats the Win key device-side with zero
                        // software. Gated on the keyboard actually exposing it (SetGameMode capability).
                        if State.sel-can-game-mode : Divider {}
                        if State.sel-can-game-mode : Toggle {
                            caption: "keyboard game mode (firmware)";
                            checked: State.game-mode-on;
                            toggled => { State.toggle-game-mode(); }
                        }
                        if State.sel-can-game-mode : GateNote {
                            text: "the board's own FN+F10 Win-key kill, firmware-side and working with zero software. this is what ate your Win key.";
                        }
                    }
                }

                // ── ADVANCED — a quiet, FULL-WIDTH clickable Disclosure line; the deep / gated HARDWARE
                // WRITES live behind it, collapsed by default so the everyday deck stays the at-a-glance
                // surface. The whole row is the hit target (can't be missed), and the open flag is a
                // global (State.feel-adv-open). These stay OUT of the global apply: each keeps its own
                // deliberate per-control apply.
                if root.adv-any : Disclosure {
                    label: "advanced · gated hardware writes";
                    open: State.feel-adv-open;
                    toggled => {
                        State.feel-adv-open = !State.feel-adv-open;
                        // OPENING only: start the short follow that keeps the revealed drawer
                        // pinned into view while it grows (see `reveal-scroll` up top for why it
                        // can't be done inline). Closing needs nothing — the content shrinks away
                        // and the Flickable's own clamp walks the viewport back up on its own.
                        if (State.feel-adv-open) { root.reveal-ticks = 0; reveal-scroll.running = true; }
                    }
                }

                // ── HARDWARE WRITES — real device paths, held until verified on the wire ──
                // Same controls as before, but the raw write-path tags + dev paragraphs are gone:
                // the card wears ONE quiet "verify-gated" marker and each verify-gated row echoes it
                // with the same warn dot, so the trust zone reads as one system. We keep the controls
                // honest, not faked. (DEBOUNCE is the lone exception: firmware-fixed, not verify-gated.)
                // ADVANCED reveal — animate the disclosure so the Card doesn't POP in one frame: a
                // clipping wrapper whose height eases 0 ↔ content over Theme.settle (with an opacity
                // fade), so opening reads as a drawer sliding open, not a layout jump. The Card keeps its
                // natural content height (adv-body.preferred-height); the wrapper clips it as it grows.
                if root.adv-any : Rectangle {
                    property <bool> shown: State.feel-adv-open;
                    property <length> target: self.shown ? adv-body.preferred-height : 0px;
                    clip: true;
                    min-height: self.target;
                    max-height: self.target;
                    opacity: self.shown ? 1.0 : 0.0;
                    animate min-height, max-height, opacity { duration: Theme.settle; easing: ease-in-out; }
                    // the Card holds its FULL natural height (so the wrapper clips it as it grows, rather
                    // than squishing the content); a bare Rectangle child would otherwise default to the
                    // wrapper's animating height and deform the rows mid-reveal.
                    adv-body := Card {
                        y: 0;
                        width: parent.width;
                        height: self.preferred-height;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 16px;
                        HorizontalLayout {
                            SectionTitle { text: "HARDWARE WRITES"; }
                            Rectangle {}
                            Pill { text: "VERIFY-GATED"; tint: Theme.warn; }
                        }
                        GateNote { text: "real device paths, ready but held until the command is confirmed on your hardware, so nothing fires blind."; }
                        if State.perf-status != "" : Mono { text: State.perf-status; color: Theme.text-mid; wrap: word-wrap; }

                        // WHEEL MODE — HyperScroll stages (class 0x0B — hardware-verify pending).
                        // Only a device whose descriptor declares stage-scroll (cap-scroll) shows it.
                        if root.adv-wheel : VerticalLayout {
                            spacing: 9px;
                            CapHead { term: "WHEEL MODE"; gated: true; }
                            // SAME two-row shape as SLEEP TIMER below: [ field · note · apply ] over
                            // [ presets · rail ]. The note used to share the second row with the
                            // preset rail, which left it a sliver — once the rail started taking the
                            // width its labels actually need (see SplitToggle's content-aware floor)
                            // the note elided to "no scroll-stage source…" and the part that tells
                            // you what to DO was the part that got cut. Giving it the wide row is
                            // also just consistency: the two gated writes now read identically.
                            HorizontalLayout {
                                spacing: 8px;
                                Field {
                                    field-width: 160px;
                                    placeholder: "tactile/free";
                                    text <=> State.scroll-stages;
                                    invalid: State.scroll-stages-error;
                                    edited(t) => { State.scroll-stages-edited(t); }
                                    accepted(t) => { State.apply-scroll-stages(t); }
                                }
                                // ERROR-tinted, not merely un-appliable: an unread table and an empty
                                // field are both blocked-but-blameless, and red would accuse the user
                                // of a typo they never made.
                                Mono {
                                    text: State.scroll-stages-note;
                                    color: State.scroll-stages-error ? Theme.danger : Theme.text-faint;
                                    overflow: elide;
                                    min-width: 0px;
                                }
                                Button {
                                    text: "apply";
                                    enabled: !State.writes-paused && State.scroll-stages-valid;
                                    clicked => { State.apply-scroll-stages(State.scroll-stages); }
                                }
                            }
                            // A custom typed value matches no preset (index -1) so nothing lights.
                            HorizontalLayout {
                                spacing: 6px;
                                Mono { text: "presets"; color: Theme.text-faint; }
                                SplitToggle {
                                    options: ["tactile/free", "tactile", "free"];
                                    min-cell: 52px;
                                    index: State.scroll-stages == "tactile/free" ? 0
                                        : State.scroll-stages == "tactile" ? 1
                                        : State.scroll-stages == "free" ? 2
                                        : -1;
                                    picked(i) => {
                                        State.scroll-stages = i == 0 ? "tactile/free" : i == 1 ? "tactile" : "free";
                                        State.scroll-stages-edited(State.scroll-stages);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.adv-wheel && (root.adv-sleep || root.adv-sensor) : Divider { }

                        // SLEEP TIMER / idle-off timer — wireless devices only (cap-idle); a wired
                        // board has no sleep to time out.
                        if root.adv-sleep : VerticalLayout {
                            spacing: 9px;
                            CapHead {
                                term: "SLEEP TIMER";
                                readout: "now " + State.idle-readout;
                                gated: true;
                            }
                            // field + live status on one line; the apply key drops to its OWN line so its
                            // verb is never clipped by the field/status in the narrow fixed panel.
                            HorizontalLayout {
                                spacing: 8px;
                                Field {
                                    field-width: 160px;
                                    placeholder: "300";
                                    text <=> State.idle-secs-text;
                                    invalid: !State.idle-secs-valid;
                                    edited(t) => { State.idle-edited(t); }
                                    accepted(t) => { State.apply-idle(State.idle-secs); }
                                }
                                Mono {
                                    text: State.idle-secs-note;
                                    color: State.idle-secs-valid ? Theme.text-faint : Theme.danger;
                                    overflow: elide;
                                    min-width: 0px;
                                }
                                Button {
                                    text: "apply";
                                    enabled: !State.writes-paused && State.idle-secs-valid;
                                    clicked => { State.apply-idle(State.idle-secs); }
                                }
                            }
                            // idle presets ride a content-hugging SplitToggle (the N-way fused selector) —
                            // label outside, trailing stretch spacer so the rail hugs its cells. A custom
                            // typed value matches no preset (index -1) so nothing lights, same as before.
                            HorizontalLayout {
                                spacing: 6px;
                                Mono { text: "presets"; color: Theme.text-faint; }
                                SplitToggle {
                                    options: ["never", "1m", "5m", "15m", "1h"];
                                    min-cell: 44px;
                                    index: State.idle-secs-text == "0" ? 0
                                        : State.idle-secs-text == "60" ? 1
                                        : State.idle-secs-text == "300" ? 2
                                        : State.idle-secs-text == "900" ? 3
                                        : State.idle-secs-text == "3600" ? 4
                                        : -1;
                                    picked(i) => {
                                        State.idle-secs-text = i == 0 ? "0" : i == 1 ? "60" : i == 2 ? "300" : i == 3 ? "900" : "3600";
                                        State.idle-edited(State.idle-secs-text);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.adv-sleep && root.adv-sensor : Divider { }

                        // HYPERPOLLING — the EXTENDED (>1000Hz) rate path (0x00/0x40). Only REAL on the
                        // separate HyperPolling Wireless Dongle / Viper-8K-class hardware; the Naga's stock
                        // dongle is legacy-capped at 1000Hz. When the selected device CAN'T reach the
                        // extended tiers we show an honest line instead of fake 2000–8000Hz chips.
                        if root.adv-sensor : VerticalLayout {
                            spacing: 9px;
                            CapHead {
                                term: "HYPERPOLLING";
                                readout: State.sel-can-hyperpoll ? round(State.ingame-wired-hz) + " Hz" : "1000 Hz max";
                                gated: State.sel-can-hyperpoll;
                            }
                            if !State.sel-can-hyperpoll : GateNote {
                                text: "this mouse polls up to 1000 Hz · set it in REPORT RATE above. 2000–8000 Hz HyperPolling needs Razer's separate HyperPolling Wireless Dongle.";
                            }
                            if State.sel-can-hyperpoll : GateNote {
                                text: "the EXTENDED hi-res rate (>1000 Hz) for HyperPolling hardware, distinct from the live REPORT RATE above.";
                            }
                            if State.sel-can-hyperpoll : ContactRow {
                                options: [1000, 2000, 4000, 8000];
                                value: round(State.ingame-wired-hz);
                                enabled: !State.writes-paused;
                                picked(hz) => { State.ingame-wired-hz = hz; }
                            }
                            if State.sel-can-hyperpoll : HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "apply";
                                    enabled: !State.writes-paused;
                                    clicked => { State.apply-ingame-polling(State.ingame-wired-hz, State.ingame-dongle-hz); }
                                }
                            }
                        }
                        if root.adv-sensor : Divider { }

                        // SENSOR TIMING — lift-off distance (REAL verify-gated write) + debounce
                        // (firmware-fixed). Sensor territory: rides the same DPI/sensor cap as
                        // HYPERPOLLING, so the divider above pairs with it unconditionally.
                        if root.adv-sensor : VerticalLayout {
                            spacing: 9px;
                            CapHead { term: "SENSOR TIMING"; gated: true; }
                            // LIFT-OFF DISTANCE — even (symmetric low/med/high) OR split (separate LIFT vs
                            // LANDING, the Focus-Pro-30K flex). Both are real verify-gated writes.
                            CapHead { term: "LIFT-OFF DISTANCE"; readout: State.lod-readout; gated: true; }
                            // even / split mode picker — flipping it doesn't write; the controls below do.
                            SplitToggle {
                                options: ["even", "split"];
                                index: State.lod-async ? 1 : 0;
                                picked(i) => { State.lod-async = i == 1; }
                            }
                            // EVEN (symmetric) — an index pick over low/medium/high, so it's the real
                            // SplitToggle bank (gated with the shared enabled seam), not three loose pills.
                            if !State.lod-async : SplitToggle {
                                options: ["low", "medium", "high"];
                                index: State.lod-level;
                                enabled: !State.writes-paused;
                                picked(i) => { State.lod-level = i; State.apply-lod(i); }
                            }
                            // SPLIT (asymmetric) — two compact faders (LIFT 2..26 / LANDING 1..25), each with
                            // a readout, applying the PAIR on release (one write per gesture, like sniper).
                            if State.lod-async : VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Mono { text: "lift"; color: Theme.text-faint; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Mono { text: round(State.lod-lift); color: Theme.text-mid; }
                                }
                                Slider {
                                    compact: true;
                                    minimum: 2; maximum: 26; value: State.lod-lift; step: 1;
                                    wheel: false;
                                    enabled: !State.writes-paused;
                                    changed(v) => { State.lod-lift = v; }
                                    released(v) => { State.lod-lift = v; State.apply-lod-async(State.lod-lift, State.lod-land); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Mono { text: "landing"; color: Theme.text-faint; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Mono { text: round(State.lod-land); color: Theme.text-mid; }
                                }
                                Slider {
                                    compact: true;
                                    minimum: 1; maximum: 25; value: State.lod-land; step: 1;
                                    wheel: false;
                                    enabled: !State.writes-paused;
                                    changed(v) => { State.lod-land = v; }
                                    released(v) => { State.lod-land = v; State.apply-lod-async(State.lod-lift, State.lod-land); }
                                }
                            }
                            // DEBOUNCE — no getter and no settable opcode; it's fixed in the firmware,
                            // NOT verify-gated. An honest "fixed in firmware" statement (text-faint, no
                            // caution) — distinct from the warn-dot verify-gated rows, never a fake knob.
                            HorizontalLayout {
                                Mono { text: "debounce"; color: Theme.text-faint; }
                                Rectangle {}
                                Pill { text: "FIXED IN FIRMWARE"; tint: Theme.text-faint; }
                            }
                        }
                    }
                    }   // adv-body Card
                }
            }

            // ── MECHANICAL ADVANTAGES — opt-in, edge-giving device features (device-scoped hardware
            // behavior, beside the other hardware writes). Each option is one self-demonstrating visual
            // stage behind a TWO-STEP consent (reveal, then enable). The whole section is gated on the
            // SELECTED device actually supporting it: an incapable device shows NOTHING here — never a
            // stray "GATED" card. (Snap Tap is the only advantage today; when more land, gate this on
            // "the selected device supports at least one of them.")
            if State.snap-tap-supported : VerticalLayout {
                padding-top: 16px;
                spacing: 16px;
                Divider {}
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        SectionTitle { text: "MECHANICAL ADVANTAGES"; }
                        Mono { text: "opt-in, edge-giving. unseal to see what it does."; color: Theme.text-faint; }
                    }
                    Rectangle {}
                }
                MechAdvantage {
                    name: "snap tap";
                    tagline: "opposing inputs resolve to the last pressed: instant counter-strafe, no stall.";
                    supported: State.snap-tap-supported;
                    revealed: State.snap-tap-revealed;
                    enabled: State.snap-tap-enabled;
                    reveal => { State.snap-tap-revealed = true; }
                    set-enabled(v) => { State.set-snap-tap(v); }
                    // the stage visual — plays only once REVEALED (sealed = perfectly still)
                    SnapTapStage { live: State.snap-tap-revealed; }
                }
            }
                }   // ibody
            }       // inspector Flickable
        }
    }
}

