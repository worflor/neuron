import { Theme } from "../theme.slint";
import { Card, SectionTitle, Label, Button, Field, CodeArea, Pill, Mono, Divider, Slider, Toggle, PanelHead, ActionPicker, InputHead, GuideButton, SplitToggle, SplitButton, TriggerWell } from "../widgets/controls.slint";
import { State } from "../state.slint";
import { RuleRow, PocketCard, MacroBlock, MacroCard } from "../models.slint";

// One portable clipboard, shown as its EMERGENT content-sigil (a mark drawn deterministically
// from the bytes — same content, same sigil; different content, different sigil) over the legible
// summary. The sigil is the abstract fingerprint; the name + summary are the instant read. Kind
// tints it from the weave palette so the type reads at a glance too.
component PocketCardEl inherits Rectangle {
    in property <PocketCard> p;
    // kind tints from the weave palette so the type reads at a glance AND recolours with the accent.
    property <color> tint: p.kind == "image" ? Theme.warn
        : p.kind == "files" ? Theme.accent
        : p.kind == "other" ? Theme.text
        : Theme.accent;
    width: 128px;
    height: 104px;
    border-radius: Theme.radius;
    background: Theme.bg-2;
    border-width: Theme.hair;
    border-color: p.filled ? root.tint : Theme.line;
    animate border-color { duration: Theme.quick; }
    VerticalLayout {
        padding: 8px;
        spacing: 3px;
        // the emergent mark (square + centred so the rosette isn't stretched), or an empty marker
        Rectangle {
            height: 50px;
            if p.filled : Path {
                width: 50px;
                height: 50px;
                x: (parent.width - self.width) / 2;
                commands: p.sigil;
                viewbox-x: -1.12;
                viewbox-y: -1.12;
                viewbox-width: 2.24;
                viewbox-height: 2.24;
                stroke: root.tint;
                stroke-width: 1.3px;
                fill: transparent;
            }
            if !p.filled : Text {
                text: "empty";
                color: Theme.text-faint;
                font-family: Theme.mono;
                font-size: Theme.fs-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: p.name == "" ? "(default)" : p.name;
                color: Theme.text;
                font-family: Theme.mono;
                font-size: Theme.fs-small;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            // a filled dot marks a pocket kept on disk (survives a restart)
            Rectangle {
                y: 4px;
                width: Theme.dot;
                height: Theme.dot;
                border-radius: Theme.dot / 2;
                background: p.durable ? root.tint : transparent;
                border-width: p.durable ? 0 : Theme.hair;
                border-color: Theme.line;
            }
        }
        Text {
            text: p.summary;
            color: Theme.text-faint;
            font-family: Theme.mono;
            font-size: Theme.fs-small;
            overflow: elide;
        }
    }
}

// One EMERGENT macro card in the WORKSHOP catalog — name, the plain-English summary of what it does
// (walked from its own nodes in Rust), its size + option count, and the trigger(s) that fire it. The
// whole card is a click-to-load button into the editor; the currently-open macro is lit (accent). All
// content is read from disk + the macro's nodes + the loaded rules — no hardcoded names/descriptions.
component MacroCardEl inherits Rectangle {
    in property <MacroCard> c;
    // the macro currently open in the editor reads as selected (subtle accent ground + border).
    property <bool> current: c.name == State.macro-name && c.name != "";
    property <bool> unbound: c.trigger == "(unbound)";
    // DELETE is a two-step confirm: the first ✕ ARMS (red border + red ✕), the second confirms → the
    // card FADES out → then it's removed from disk + the catalog. Auto-disarms after a beat so a stray
    // first click never lingers — no accidental one-click deletes.
    property <bool> armed: false;
    property <bool> deleting: false;
    property <bool> fired: false;
    clip: true;
    opacity: root.deleting ? 0.0 : 1.0;
    animate opacity { duration: Theme.fade-out; easing: ease-out; }
    border-radius: Theme.radius;
    background: root.current ? Theme.accent-glow : (ta.has-hover ? Theme.well-hi : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.armed ? Theme.danger : (root.current ? Theme.accent-line : Theme.line);
    animate background, border-color { duration: Theme.quick; }
    // whole card = open-into-editor. Declared FIRST so the ✕ (last) wins its own corner, and a wheel
    // (no scroll handler here) falls through to the carousel's pan instead of being swallowed.
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { State.open-macro(root.c.name); }
    }
    body := VerticalLayout {
        padding: 10px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.c.name;
                color: root.current ? Theme.accent : Theme.text;
                font-family: Theme.mono;
                font-weight: 700;
                font-size: Theme.fs-body;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            // the binding(s) that fire it — dim when nothing does ("(unbound)"), accent when bound.
            Mono {
                text: root.c.trigger;
                color: root.unbound ? Theme.text-faint : Theme.accent-dim;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
            }
            // delete — click to ARM (turns red), click again to confirm. Its touch is the LAST sibling
            // so it wins this corner over the card-wide open beneath.
            del := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: Theme.radius;
                background: root.armed ? Theme.danger : (xta.has-hover ? Theme.well-hi : transparent);
                animate background { duration: Theme.quick; }
                Text {
                    // U+00D7 (×) — the app's proven close glyph; the dingbat U+2715 (✕) isn't in the mono
                    // font (renders blank). Matches the guide-popup X.
                    text: "\u{00d7}";
                    color: root.armed ? Theme.text : (xta.has-hover ? Theme.danger : Theme.text-faint);
                    font-family: Theme.mono;
                    font-size: Theme.fs-data;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: Theme.quick; }
                }
                xta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (root.armed) {
                            root.deleting = true;
                        } else {
                            root.armed = true;
                        }
                    }
                }
            }
        }
        // the emergent "what it does", in words — the whole point: understand it without the code.
        Mono {
            text: root.c.summary;
            color: Theme.text-mid;
            font-size: Theme.fs-small;
            wrap: word-wrap;
        }
        // size + declared options, at a glance.
        Mono {
            text: "\{root.c.steps} steps  \u{00b7}  \{root.c.options} options";
            color: Theme.text-faint;
            font-size: Theme.fs-small;
        }
    }
    // auto-disarm the confirm on the shared clock (Theme.confirm-window) so a stray first click never sits armed.
    Timer {
        interval: Theme.confirm-window;
        running: root.armed && !root.deleting;
        triggered => { root.armed = false; }
    }
    // fade THEN delete: the opacity animates out first, then the macro is removed from disk + the catalog
    // (which drops this card from the model). `fired` collapses the repeating timer to a single shot.
    Timer {
        interval: Theme.fade-out-hold;
        running: root.deleting && !root.fired;
        triggered => {
            root.fired = true;
            State.delete-macro(root.c.name);
        }
    }
}

// BINDINGS — the unified spine, drawn as the PATCH BAY it is. Every row is a routed signal:
// trigger jack → signal path → action jack, with a kind tag and a lamp that lights when the live
// engine actually fires that trigger (real dispatch data, not decoration — pressing the bound
// button visibly closes its contact on this board). Audio is folded in here: mic gain/mute are
// just Actions. And the macro console: write Rust -> dry-run (fires NOTHING) -> compile & verify
// (the cert surfaced; compiling never executes) -> run once (the one explicit execution verb).

// The WIRE EDITOR — the shared trigger→action authoring body, used BOTH by the inline "+ bind a
// control" add-flow AND by editing an existing rule in place. The trigger end is press-to-bind (it
// captures a real HID control), the action end is the shared ActionPicker, and the wire's arrow +
// commit preview light the instant both ends connect. ALL trigger/action state is GLOBAL (State +
// the ActionPicker read it), and only ONE of these is ever instantiated at a time (the `if`-gates on
// add-open / editing-rule guarantee it), so the single shared picker can never be double-driven.
component WireEditor inherits Card {
    in property <bool> hyper;       // the binding lands on (editing: lives on) the HyperShift layer
    in property <bool> editing;     // false = authoring a new bind · true = editing an existing one
    callback commit();
    callback close();
    VerticalLayout {
        padding: 13px;
        spacing: Theme.gap;
        // header — a live accent lamp + which layer/mode this wire is, close at the edge
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Rectangle { width: Theme.dot; height: Theme.dot; border-radius: Theme.dot / 2; background: Theme.accent; } }
            VerticalLayout { alignment: center; Mono { text: (root.editing ? "edit binding · on " : "bind a control · on ") + (root.hyper ? "HYPERSHIFT" : "BASE"); color: Theme.accent; } }
            Rectangle {}
            VerticalLayout { alignment: center; Button { text: "close"; clicked => { root.close(); } } }
        }
        // the wire, read left→right: a TRIGGER end, the arrow (faint until the circuit completes,
        // then phosphor), and the ACTION it fires.
        HorizontalLayout {
            spacing: 14px;
            // the trigger end — the whole well is the press-to-bind / REBIND target (the shared
            // TriggerWell, clickable-with-REBIND-hint flavour). It's fixed row-h, so a centring
            // VerticalLayout holds it in the stretchy cell (the well used to fill the column down to
            // the taller ACTION side; now it centres at its natural height instead of stretching).
            VerticalLayout {
                width: 300px;
                spacing: 7px;
                Mono { text: "TRIGGER"; color: Theme.text-dim; }
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    TriggerWell {
                        text: State.bind-trigger-label;
                        prompt: "press-to-bind a key or button";
                        live: State.bind-trigger-ready;
                        clickable: true;
                        hint: "REBIND";
                        clicked => { State.capture-trigger(); }
                    }
                }
                // DUPLICATE-TRIGGER honesty — a GateNote-style caution BY the well when this control is
                // already claimed on the same layer. The live executor runs every matching rule, so
                // saving replaces nothing; both fire. Glue sets it at capture; "" hides it.
                if State.dup-trigger-note != "" : Mono {
                    text: State.dup-trigger-note;
                    color: Theme.warn;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
            }
            // the wire's arrow — lights phosphor the instant both ends connect
            VerticalLayout {
                width: 18px;
                spacing: 7px;
                Mono { text: " "; }   // a label-height spacer, so the arrow drops below the labels
                VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    Text {
                        text: "→";
                        color: (State.bind-trigger-ready && picker.param-ok) ? Theme.accent : Theme.text-faint;
                        // 16px is a DELIBERATE exception to the type scale — the wire arrow is sized as a
                        // circuit glyph (the visible JOIN between the two ends), not body text, so it reads
                        // one notch bigger than any fs- token would set it.
                        font-family: Theme.mono; font-size: 16px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        animate color { duration: Theme.settle; }
                    }
                }
            }
            // the action end
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 7px;
                Mono { text: "ACTION"; color: Theme.text-dim; }
                picker := ActionPicker {}
            }
        }
        // commit — a live readout of the wire (lit when both ends connect) + the key that lays it
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: (State.bind-trigger-ready ? State.bind-trigger-label : "—")
                        + "  →  " + picker.action-label
                        + (State.action-param != "" ? "  ·  " + State.action-param : "");
                    color: (State.bind-trigger-ready && picker.param-ok) ? Theme.accent-dim : Theme.text-faint;
                    font-family: Theme.mono; font-size: Theme.fs-small;
                    overflow: elide;
                    animate color { duration: Theme.settle; }
                }
            }
            Button {
                text: root.editing ? "save" : "add binding";
                primary: true;
                enabled: State.bind-trigger-ready && picker.param-ok;
                clicked => { root.commit(); }
            }
        }
    }
}

// A quiet row control — ↑ / ↓ / ✕. Small square hit target, mono glyph, brightens on hover; `danger`
// tints the delete red. `enabled: false` faints the glyph and goes inert (default cursor, dead
// TouchArea) — the Button/IconButton convention, for a control that can't act right now (e.g. the
// top row can't move up). Defined here (above its first use in RuleLine) and reused by the workshop.
component RowGlyph inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> hovered: g-ta.has-hover;   // lets a parent card hold its hover while you reach a control
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: (root.enabled && g-ta.has-hover) ? Theme.well : transparent;
    animate background { duration: Theme.quick; }
    g-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        // the ONE delete idiom: a danger glyph rests as QUIET faint ink and brightens to danger on
        // hover (never permanently-red) — the same faint↔danger fade every ✕ in the app now uses.
        color: !root.enabled ? Theme.text-faint
            : root.danger ? (g-ta.has-hover ? Theme.danger : Theme.text-faint)
            : (g-ta.has-hover ? Theme.text : Theme.text-faint);
        font-family: Theme.mono;
        font-size: Theme.fs-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.quick; }
    }
}

component RuleLine inherits Rectangle {
    in property <RuleRow> r;
    // reorder boundary flags — the topmost editable row can't move up, the bottom can't move down, so
    // the ↑ / ↓ read DEAD at the ends instead of silently no-op'ing (never-disabled-at-boundaries bug).
    in property <bool> can-up: true;
    in property <bool> can-down: true;
    callback remove();
    callback edit();
    callback reorder(int);   // move this row: -1 = up / earlier, +1 = down / later
    height: 40px;
    border-radius: Theme.radius-sm;
    // GUI-authored rows are click-to-edit; the whole row lifts on hover to advertise it. TOML rows
    // (read-only provenance) stay inert — clicking them does nothing, as before.
    background: (root.r.removable && rowta.has-hover) ? Theme.well : transparent;
    animate background { duration: Theme.quick; }
    // the live lamp: this rule's trigger was the engine's last dispatch
    property <bool> fired: State.live-last-trigger == root.r.trigger;
    // row-level click target, BEHIND the cells (so the `del` button — declared inside the HBox above
    // — still wins its own corner, and the bare trigger/action wells fall through to here). Only
    // armed for removable (GUI-authored) rows; provenance rows aren't editable through this menu.
    rowta := TouchArea {
        enabled: root.r.removable;
        mouse-cursor: root.r.removable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.edit(); }
    }
    HorizontalLayout {
        spacing: 0;
        // kind cell — monochrome code + the fire lamp above it (accent ONLY when it fires)
        Rectangle {
            width: 34px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Rectangle {
                    width: 4px; height: 4px; border-radius: 1px;
                    x: (parent.width - self.width) / 2;
                    background: root.fired ? Theme.accent : Theme.line;
                    animate background { duration: Theme.settle; }
                }
                Text {
                    text: root.r.kind == "gesture" ? "GST"
                        : root.r.kind == "radial" ? "RAD"
                        : root.r.kind == "app" ? "APP"
                        : root.r.kind == "mic" ? "MIC"
                        : root.r.kind == "hold" ? "HLD"
                        : "IN";
                    color: Theme.text-faint;
                    font-size: Theme.fs-small;
                    font-family: Theme.mono;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
        // trigger jack — the short index; capped so the ACTION (the long field) gets the slack
        Rectangle {
            width: 30%;
            height: Theme.row-h;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.well;
            border-width: Theme.hair;
            border-color: root.fired ? Theme.accent-line : Theme.line;
            animate border-color { duration: Theme.settle; }
            HorizontalLayout {
                padding-left: 10px; padding-right: 8px;
                Text {
                    text: root.r.trigger;
                    color: Theme.text;
                    font-size: Theme.fs-body; font-family: Theme.mono; font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        // the signal path — a hairline with a node at each end; lights when the contact closes.
        // fixed (not stretch) so the slack flows to the action jack, not into the connector.
        Rectangle {
            width: 44px;
            Rectangle {
                x: 4px; width: parent.width - 8px; height: 1px;
                y: (parent.height - self.height) / 2;
                background: root.fired ? Theme.accent : Theme.line;
                animate background { duration: Theme.settle; }
            }
            Rectangle {
                x: 2px; width: 3px; height: 3px;
                y: (parent.height - self.height) / 2;
                background: root.fired ? Theme.accent : Theme.text-faint;
            }
            Rectangle {
                x: parent.width - 5px; width: 3px; height: 3px;
                y: (parent.height - self.height) / 2;
                background: root.fired ? Theme.accent : Theme.text-faint;
            }
        }
        // action jack — the payload (what the binding DOES): the wide field AND the bright one
        Rectangle {
            horizontal-stretch: 1;
            min-width: 120px;
            height: Theme.row-h;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.well;
            border-width: Theme.hair;
            border-color: root.fired ? Theme.accent-line : Theme.line;
            animate border-color { duration: Theme.settle; }
            HorizontalLayout {
                padding-left: 10px; padding-right: 8px;
                Text {
                    text: root.r.action;
                    color: Theme.text;
                    font-size: Theme.fs-body; font-family: Theme.mono;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Rectangle { width: 8px; }
        // provenance + reorder: GUI rows get quiet ↑/↓ reorder glyphs (the app's reorder idiom — faint
        // at rest, brighten on hover) + a delete; toml rows say where they live instead. Sized for the
        // WIDER (removable) state so the right edge never goes ragged between the two.
        Rectangle {
            width: 100px;
            if root.r.removable : HorizontalLayout {
                alignment: end;
                spacing: 2px;
                // ↑ dead on the first editable row, ↓ dead on the last — a boundary move reads gated.
                VerticalLayout { alignment: center; RowGlyph { glyph: "\u{2191}"; enabled: root.can-up; clicked => { root.reorder(-1); } } }   // ↑
                VerticalLayout { alignment: center; RowGlyph { glyph: "\u{2193}"; enabled: root.can-down; clicked => { root.reorder(1); } } }    // ↓
                // delete — the one idiom: quiet faint ✕ brightening to danger on hover (RowGlyph danger),
                // never the old permanent-danger key. Its TouchArea is always live (no invisible target).
                VerticalLayout { alignment: center; RowGlyph { glyph: "\u{00d7}"; danger: true; clicked => { root.remove(); } } }
            }
            if !root.r.removable : HorizontalLayout {
                alignment: end;
                VerticalLayout { alignment: center; Pill { text: "TOML"; tint: Theme.text-faint; } }
            }
        }
    }
}

component RuleList inherits VerticalLayout {
    in property <string> title;
    in property <[RuleRow]> rules;
    in property <string> empty-hint;
    // ACTIVE-LAYER WASH — the HYPER layer lights its title + group rail accent (the DIRECT analogue
    // of WEAVE's wheel-wash), so the layer you're authoring is unmistakable. Base stays neutral.
    in property <bool> accent: false;
    // which layer this list shows — disambiguates the (shared-per-layer) editing-rule row index, and
    // is handed to begin-edit-rule so the glue edits the right tier.
    in property <bool> hyper: false;
    callback remove(int);
    callback reorder(int, int);   // move row `i` by dir (-1 up / +1 down)
    // the FIRST editable/removable row's index — the removable rows are the contiguous tail, so the
    // ↑ is dead at this index and the ↓ is dead on the last row. Reads the tier's editable count.
    property <int> first-removable: root.rules.length - (root.hyper ? State.editable-hyper-count : State.editable-count);
    spacing: 7px;
    HorizontalLayout {
        spacing: 8px;
        // the column's group rail — two physical rows of jacks; lights accent for the active HYPER layer
        Rectangle { width: 2px; height: 14px; y: 1px; background: root.accent ? Theme.accent : Theme.line; animate background { duration: Theme.quick; } }
        SectionTitle { text: root.title; color: root.accent ? Theme.accent : Theme.text-dim; }
        Rectangle {}
        Mono { text: root.rules.length + (root.rules.length == 1 ? " rule" : " rules"); color: Theme.text-faint; }
    }
    if root.rules.length == 0 : Rectangle {
        height: 64px;
        VerticalLayout {
            alignment: center;
            Mono { text: root.empty-hint; color: Theme.text-faint; horizontal-alignment: center; }
        }
    }
    // each row is EITHER its read-only line OR — when it's the one being edited — the inline wire
    // editor, expanded in place (seeded by begin-edit-rule). The wrapper sizes to whichever shows.
    for r[i] in root.rules : VerticalLayout {
        if !(State.editing-rule == i && State.editing-rule-hyper == root.hyper) : RuleLine {
            r: r;
            can-up: i > root.first-removable;
            can-down: i < root.rules.length - 1;
            remove => { root.remove(i); }
            edit => { State.begin-edit-rule(i, root.hyper); }
            reorder(dir) => { root.reorder(i, dir); }
        }
        if (State.editing-rule == i && State.editing-rule-hyper == root.hyper) : WireEditor {
            editing: true;
            hyper: root.hyper;
            commit => { State.commit-edit-rule(); }
            close => { State.cancel-edit-rule(); }
        }
    }
}

// The kind ICON shown on a step card — one glyph per kind, computed in the view (the model carries
// `kind`, not the glyph, so the mapping lives where it's drawn). ⌨ press · T type · ⎘ copy · ▶ open.
component KindIcon inherits Text {
    in property <string> kind;
    in property <bool> accent;
    text: root.kind == "type_text" ? "T"
        : root.kind == "hotkey" ? "+"             // a key combo (Consolas has no ⌨ glyph — it tofus)
        : root.kind == "clipboard" ? "C"          // clipboard/paste (Consolas has no ⎘ glyph)
        : root.kind == "run" ? "\u{25B6}"         // ▶
        : root.kind == "notify" ? "!"
        : root.kind == "ask" ? "?"
        : root.kind == "raw" ? "\u{2039}/\u{203a}" // ‹/›
        : "";
    color: root.accent ? Theme.accent : Theme.text-dim;
    font-family: Theme.mono;
    font-size: Theme.fs-data;
    font-weight: 700;
    horizontal-alignment: center;
    vertical-alignment: center;
    width: 18px;
}

// One chip in the add-picker — a small mono kind label that adds a step on click.
component AddChip inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 24px;
    min-width: chip-lbl.preferred-width + 18px;
    max-width: chip-lbl.preferred-width + 18px;
    border-radius: Theme.radius-sm;
    background: chip-ta.has-hover ? Theme.accent-glow : Theme.bg-2;
    border-width: Theme.hair;
    border-color: chip-ta.has-hover ? Theme.accent-line : Theme.line;
    animate background, border-color { duration: Theme.quick; }
    chip-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    chip-lbl := Text {
        text: root.label;
        color: chip-ta.has-hover ? Theme.accent : Theme.text-mid;
        font-family: Theme.mono;
        font-size: Theme.fs-small;
        font-weight: 700;
        letter-spacing: Theme.track-1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── THE CONSTRUCTOR CANVAS ROW — the direct-manipulation macro builder, by touch ──────────────
// One flat MacroBlock renders here as one of three rows, all left-anchored to a vertical SPINE so the
// macro reads as a connected flow (a node dot per row hangs off the rail, so even the 4px row gaps
// read as one routed line):
//   • STEP — a clean rounded card that reads like a sentence: a kind ICON · the plain VERB · the param
//     as an inline editable Field. Editing COMMITS on Enter AND on blur (focus-loss) — `edit-step`
//     mutates the tree + regenerates the source only (NO re-flatten), so the caret never jumps and a
//     click-away can't lose the text. `raw` ("code") shows mono, not a field — an escape hatch to the
//     code view. On HOVER two quiet controls reveal: ↑/↓ (move-step) and ✕ (delete-step). An `ask`
//     card is accent-tinted so the branch head reads at a glance. The spine END-CAPS after the `last`
//     step of a body (a terminal node) instead of running into the add-row.
//   • LANE — an ask branch-arm header ("if yes" / "if no"); the spine FORKS into it via a curved
//     elbow wire (a Path) down-and-into the lane. Accent for yes, dim for no.
//   • ADD — an inviting "＋ add a step" that, on click, expands a compact chip picker (type · press ·
//     copy · open · ask · notify · code) — each chip calls add-step(insert, kind), which auto-focuses
//     the new step's field. Collapses after a pick. The ONLY way to add a step now.
component MacroBlockEl inherits Rectangle {
    in property <MacroBlock> b;
    property <bool> is-step: root.b.row == "step";
    property <bool> is-lane: root.b.row == "lane";
    property <bool> is-add: root.b.row == "add";
    property <bool> is-ask: root.b.kind == "ask";
    property <bool> is-raw: root.b.kind == "raw";
    property <bool> is-yes: root.b.kind == "yes";
    // a per-row toggle: the add-picker is collapsed to "＋ add a step" until clicked.
    property <bool> picker-open: false;
    // is this the EMPTY-state root add (the only row on a blank macro)? Then the +add becomes a warm,
    // unmissable CTA — it's the first thing a new user sees.
    property <bool> empty-cta: root.is-add && root.b.depth == 0 && State.macro-blocks.length <= 1;
    // nesting indent — each depth steps in 20px past the spine gutter.
    property <length> indent: root.b.depth * 20px;
    // the placeholder for a step's inline field, by kind — reads like the sentence it completes.
    property <string> ph:
        root.b.kind == "type" ? "what to type"
        : root.b.kind == "press" ? "ctrl+c"
        : root.b.kind == "key_press" ? "enter"
        : root.b.kind == "click" ? "left"
        : root.b.kind == "scroll" ? "notches (e.g. -3)"
        : root.b.kind == "move_to" ? "x, y"
        : root.b.kind == "copy" ? "text to copy"
        : root.b.kind == "open" ? "app or command"
        : root.b.kind == "focus" ? "window title"
        : root.b.kind == "wait" ? "milliseconds"
        : root.b.kind == "notify" ? "message"
        : root.b.kind == "ask" ? "the question"
        : root.b.kind == "if" ? "condition"
        : root.b.kind == "repeat_n" ? "count"
        : root.b.kind == "repeat_while" ? "condition"
        : root.b.kind == "for_each" ? "var in source"
        : root.b.kind == "set_var" ? "name = value"
        : "";

    height: self.preferred-height;

    HorizontalLayout {
        padding-left: root.indent;
        spacing: 0;

        // ── THE SPINE GUTTER — a 12px rail column. Each row hangs a NODE off it so the flow reads as
        // one routed line even across the row gaps. A step draws the through-rail (capped on `last`);
        // a lane forks in via a curved elbow; an add hangs a small open node on a stub. ──
        Rectangle {
            width: 12px;

            // STEP rail: a vertical hairline through the row, plus a node dot at the card's center.
            // The `last` step caps the rail at its center (a terminal end-cap) instead of bleeding on.
            if root.is-step : Rectangle {
                // upper half of the rail — always present (connects up to the previous row)
                Rectangle {
                    x: 4px; width: Theme.hair;
                    y: 0; height: parent.height / 2;
                    background: root.is-yes ? Theme.accent-line : Theme.line;
                }
                // lower half — suppressed on the last step so the spine ends cleanly above the add-row
                if !root.b.last : Rectangle {
                    x: 4px; width: Theme.hair;
                    y: parent.height / 2; height: parent.height / 2;
                    background: root.is-yes ? Theme.accent-line : Theme.line;
                }
                // the node — accent on an ask (the fork head) / yes-arm, quiet otherwise
                Rectangle {
                    x: 2px; y: (parent.height - self.height) / 2;
                    width: 5px; height: 5px; border-radius: 1px;
                    background: (root.is-ask || root.is-yes) ? Theme.accent : Theme.text-faint;
                }
            }

            // LANE fork: a curved elbow wire from the parent spine (top of the gutter) sweeping
            // down-and-right into the lane label. Accent for the yes arm, dim for no.
            if root.is-lane : Path {
                x: 0; y: 0; width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 22;
                // start at the rail (x=4) up top, curve down to the lane row's vertical center (y≈11),
                // exiting rightward toward the label — a soft quarter-elbow.
                commands: "M 4 0 L 4 4 C 4 9 4 11 9 11";
                stroke: root.is-yes ? Theme.accent-line : Theme.line;
                stroke-width: 1px;
                fill: transparent;
            }

            // ADD node: a short stub from the top + a small OPEN node, so the insert-point reads as
            // hanging off the flow (not floating free). Quiet — it's an invitation, not a step.
            if root.is-add : Rectangle {
                Rectangle {
                    x: 4px; width: Theme.hair;
                    y: 0; height: parent.height / 2;
                    background: Theme.line-soft;
                }
                Rectangle {
                    x: 2px; y: (parent.height - self.height) / 2;
                    width: 5px; height: 5px; border-radius: 1px;
                    background: transparent;
                    border-width: Theme.hair;
                    border-color: root.empty-cta ? Theme.accent-line : Theme.line;
                }
            }
        }

        // ── STEP CARD ──────────────────────────────────────────────────────────────────────
        if root.is-step : card := Rectangle {
            // "hovered" stays true while the cursor crosses from the card onto its ↑/↓/✕ controls (each
            // a child TouchArea that would otherwise steal card-ta's hover). Without this OR, reaching a
            // control flipped the hover off, the controls vanished, the row reflowed → flicker.
            property <bool> hovered: card-ta.has-hover || mvup.hovered || mvdn.hovered || mvdel.hovered;
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: card.hovered ? Theme.well-hi : Theme.well;
            border-width: Theme.hair;
            // hover lifts the border so the card feels touchable; an ask keeps its accent frame.
            border-color: root.is-ask ? Theme.accent-line
                : (card.hovered ? Theme.text-faint : Theme.line);
            animate background, border-color { duration: Theme.quick; }
            // a row-wide hover sensor BEHIND the controls — reveals ↑/↓/✕ without stealing field clicks.
            card-ta := TouchArea { }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    KindIcon { kind: root.b.kind; accent: root.is-ask; }
                }
                // the plain-language verb — the sentence's lead word.
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.b.verb;
                        color: root.is-ask ? Theme.accent : Theme.text-mid;
                        font-family: Theme.mono;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        letter-spacing: Theme.track-1;
                    }
                }
                // the PARAM — inline-editable for everything but raw; raw shows mono + an escape hatch.
                // COMMIT on Enter (accepted) AND on blur (has-focus → false): edit-step mutates the
                // tree + regenerates the SOURCE ONLY (no re-flatten), so the caret never resets and a
                // click-away can never lose the typed value. On `init`, if this row is the just-added
                // step (macro-focus-path), it grabs the caret so you type immediately (focus-on-add).
                if !root.is-raw : Field {
                    field-width: 1000px;   // greedy: the field IS the row's elastic cell (caps at this)
                    placeholder: root.ph;
                    text: root.b.value;
                    accepted(t) => { State.edit-step(root.b.path, t); }
                    changed has-focus => {
                        // commit on blur — the user clicked away / tabbed off without pressing Enter.
                        if (!self.has-focus) { State.edit-step(root.b.path, self.text); }
                    }
                    init => {
                        if (State.macro-focus-path == root.b.path) {
                            State.macro-focus-path = "";
                            self.focus-field();
                        }
                    }
                }
                if root.is-raw : VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.b.value == "" ? "(empty)" : root.b.value;
                        color: Theme.text-mid;
                        font-family: Theme.mono;
                        font-size: Theme.fs-data;
                        wrap: word-wrap;
                    }
                }
                if root.is-raw : VerticalLayout {
                    alignment: center;
                    Text {
                        text: "edit in code view";
                        color: Theme.text-faint;
                        font-family: Theme.mono;
                        font-size: Theme.fs-small;
                        vertical-alignment: center;
                    }
                }
                // QUIET ROW CONTROLS — reorder ↑/↓, delete ✕. Always LAID OUT and always VISIBLE as
                // quiet faint ink (no opacity-0-until-hover — that left an invisible-but-clickable ✕):
                // each RowGlyph rests faint and brightens on hover (the ✕ to danger). ↑ is dead on the
                // first body step, ↓ on the last (b.first / b.last), so a boundary move reads gated.
                HorizontalLayout {
                    spacing: 2px;
                    mvup := RowGlyph { glyph: "\u{2191}"; enabled: !root.b.first; clicked => { State.move-step(root.b.path, -1); } }   // ↑
                    mvdn := RowGlyph { glyph: "\u{2193}"; enabled: !root.b.last; clicked => { State.move-step(root.b.path, 1); } }    // ↓
                    mvdel := RowGlyph { glyph: "\u{00D7}"; danger: true; clicked => { State.delete-step(root.b.path); } } // ✕
                }
            }
        }

        // ── LANE HEADER (if yes / if no) ────────────────────────────────────────────────────
        // The fork wire lives in the spine gutter (above); here is just the arm label, set in from
        // where the elbow lands so the wire visibly flows INTO the word.
        if root.is-lane : Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            HorizontalLayout {
                padding-left: 4px;
                spacing: 0;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.is-yes ? "if yes" : "if no";
                        color: root.is-yes ? Theme.accent : Theme.text-dim;
                        font-family: Theme.mono;
                        font-size: Theme.fs-small;
                        font-weight: 700;
                        letter-spacing: Theme.track-2;
                    }
                }
                Rectangle {}
            }
        }

        // ── ADD POINT — "＋ add a step", expands to the chip picker on click ──────────────────
        if root.is-add : Rectangle {
            horizontal-stretch: 1;
            // the empty-state CTA is taller + warmer so it can't be missed; nested adds stay compact.
            height: root.empty-cta ? 36px : Theme.row-h-sm;
            // collapsed invitation
            if !root.picker-open : Rectangle {
                border-radius: Theme.radius-sm;
                // the empty-state CTA gets a warm accent wash + frame (an inviting first action);
                // a nested add stays a quiet dashed-feeling stub until hovered.
                background: root.empty-cta
                    ? (add-ta.has-hover ? Theme.accent-glow : Theme.well)
                    : (add-ta.has-hover ? Theme.well : transparent);
                border-width: Theme.hair;
                border-color: root.empty-cta
                    ? (add-ta.has-hover ? Theme.accent : Theme.accent-line)
                    : (add-ta.has-hover ? Theme.text-faint : Theme.line-soft);
                animate background, border-color { duration: Theme.quick; }
                add-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.picker-open = true; }
                }
                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    spacing: 8px;
                    Text {
                        text: "+";
                        color: root.empty-cta ? Theme.accent
                            : (add-ta.has-hover ? Theme.accent : Theme.text-faint);
                        font-family: Theme.mono;
                        font-size: root.empty-cta ? Theme.fs-data : Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.empty-cta ? "add your first step" : "add a step";
                        color: root.empty-cta ? Theme.text
                            : (add-ta.has-hover ? Theme.text-mid : Theme.text-faint);
                        font-family: Theme.mono;
                        font-size: root.empty-cta ? Theme.fs-body : Theme.fs-small;
                        font-weight: root.empty-cta ? 700 : 400;
                        letter-spacing: Theme.track-1;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                }
            }
            // expanded chip row — one chip per kind; a pick adds + collapses.
            if root.picker-open : HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 5px;
                        AddChip { label: "type"; clicked => { State.add-step(root.b.path, "type"); root.picker-open = false; } }
                        AddChip { label: "press"; clicked => { State.add-step(root.b.path, "press"); root.picker-open = false; } }
                        AddChip { label: "copy"; clicked => { State.add-step(root.b.path, "copy"); root.picker-open = false; } }
                        AddChip { label: "open"; clicked => { State.add-step(root.b.path, "open"); root.picker-open = false; } }
                        AddChip { label: "ask"; clicked => { State.add-step(root.b.path, "ask"); root.picker-open = false; } }
                        AddChip { label: "notify"; clicked => { State.add-step(root.b.path, "notify"); root.picker-open = false; } }
                        AddChip { label: "code"; clicked => { State.add-step(root.b.path, "raw"); root.picker-open = false; } }
                    }
                }
                Rectangle {}
                // a quiet bail-out so an opened picker can close without adding.
                VerticalLayout {
                    alignment: center;
                    RowGlyph { glyph: "\u{00D7}"; clicked => { root.picker-open = false; } }
                }
            }
        }
    }
}

export component BindingsPanel inherits VerticalLayout {
    spacing: 0;
    // The MACRO·PYTHON editor's vertical offset from the panel top — the cross-panel "author a
    // macro" jump scrolls the page Flickable to this so the link lands ON the editor (see app.slint).
    out property <length> macro-y: macro_row.absolute-position.y - root.absolute-position.y;
    // the stance is string-keyed in the engine but index-keyed in the SplitToggle rail
    property <int> stance-idx: State.hypershift-mode == "hold" ? 0
        : State.hypershift-mode == "latch" ? 1
        : State.hypershift-mode == "smart" ? 2 : 3;
    // THE LAYER FLIP — author one layer at a time (0 = base, 1 = hypershift), WEAVE-style.
    property <int> view-layer: 0;
    property <bool> add-open: false;     // the inline "+ bind a control" expander
    property <bool> feel-open: false;    // the tucked-away feel/forgiveness sliders
    // HYPERSHIFT, the WEAVE-lean way — opt-in, config tucked.
    property <bool> hyper-open: false;    // the user explicitly opened the HyperShift editor
    property <bool> config-open: false;   // the ⚙ disclosure (hold key / stance / feel)
    // REVEALED — show the lean base|HYPER bar (never the bare CTA) once HyperShift exists in ANY
    // form: the user opened it, a hold key is set, or shifted binds already exist (auto-enable so
    // existing setup is never hidden). When NOT revealed it's a single quiet CTA — its whole footprint.
    property <bool> hyper-revealed: root.hyper-open || State.hypershift-hold-ready || State.editable-hyper-count > 0;
    // the INPUT head — the shared InputHead (DIRECT⇄WEAVE lives once); just a quiet reload extra here.
    InputHead {
        caption: "plain binds · a control fires an action";
        VerticalLayout {
            width: 80px;
            alignment: center;
            Button { text: "reload"; clicked => { State.reload-bindings(); } }
        }
    }
    Divider {}
    Rectangle { height: Theme.lead-in; }

    // the page itself scrolls (PanelPage) — no inner whole-panel Flickable, or the two would
    // fight over the wheel and the outer viewport would mis-size around this one.
    VerticalLayout {
        VerticalLayout {
            spacing: Theme.section-gap;

            // ════════ ALTITUDE 1 · THE INPUT MAP ════════
            // the model, in one line (the teaching spine, like WEAVE's "one trigger, several rhythms")
            Mono {
                text: "Two layers of controls. The base is always live; hold your HyperShift key for the second.";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            // ── the HYPERSHIFT BAR — opt-in, WEAVE-lean. A joined hairline-split shell, just like
            //    the WEAVE radial's "HyperShift radial: off"→ON control. Two states:
            //      · NOT revealed → a single quiet CTA (the whole HyperShift footprint for non-users)
            //      · revealed     → HyperShift label · base|HYPER edit-flip · ⚙ configure (+ collapse
            //                       only while nothing is set up yet)
            HorizontalLayout {
                spacing: 8px;
                // ── COLLAPSED CTA — fresh user, nothing set up. Click to open the editor. ──
                if !root.hyper-revealed : Rectangle {
                    horizontal-stretch: 0;
                    height: Theme.row-h;
                    clip: true;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hair;
                    border-color: ctata.has-hover ? Theme.accent-line : Theme.line;
                    background: ctata.has-hover ? Theme.well : transparent;
                    animate border-color, background { duration: Theme.quick; }
                    HorizontalLayout {
                        padding-left: 13px; padding-right: 13px; spacing: 8px;
                        VerticalLayout { alignment: center; Text { text: "HyperShift \u{00b7} a second layer, held"; color: ctata.has-hover ? Theme.text : Theme.text-mid; font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700; letter-spacing: Theme.track-3; vertical-alignment: center; animate color { duration: Theme.quick; } } }
                        VerticalLayout { alignment: center; Text { text: "set up \u{25b8}"; color: ctata.has-hover ? Theme.accent : Theme.text-faint; font-family: Theme.mono; font-size: Theme.fs-small; vertical-alignment: center; animate color { duration: Theme.quick; } } }
                    }
                    // opening the editor also drops the config open — a fresh user lands straight on
                    // the hold-key row (the one thing they MUST set for the layer to ever trigger).
                    ctata := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.hyper-open = true; root.config-open = true; } }
                }

                // ── REVEALED — the joined shell: label · base|HYPER flip · ⚙ configure ──
                // "setup exists" = a hold key OR shifted binds; only the open-but-empty case offers a ×.
                // STAYS HAND-ROLLED (not recomposed from SplitToggle + IconButtons): the fused single
                // outline wraps a LABEL zone + the base|HYPER flip + a variable-width ⚙ text cell + the
                // × as ONE object, seams hairline-fused into the shared frame. A nested SplitToggle would
                // bring its own rounded border (a box inside the box), the ⚙ is a reflowing text label
                // (not a fixed glyph IconButton takes), and the × wants to be a full-height fused cell —
                // so composition can't honestly hold the one-outline look. Raw seam widths → Theme.hair.
                if root.hyper-revealed : shell := Rectangle {
                    property <bool> setup-exists: State.hypershift-hold-ready || State.editable-hyper-count > 0;
                    horizontal-stretch: 0;
                    height: Theme.row-h;
                    clip: true;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hair;
                    border-color: Theme.accent-line;
                    background: Theme.bg-2;
                    HorizontalLayout {
                        // label zone — what this shell is
                        Rectangle {
                            HorizontalLayout {
                                padding-left: 13px; padding-right: 12px; spacing: 7px;
                                VerticalLayout { alignment: center; Text { text: "HyperShift"; color: Theme.text-mid; font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700; letter-spacing: Theme.track-3; vertical-alignment: center; } }
                            }
                        }
                        Rectangle { width: Theme.hair; background: Theme.line; }
                        // base | HYPER edit-flip — the active side lit accent (WEAVE's base|HYPER)
                        Rectangle {
                            background: root.view-layer == 0 ? Theme.accent-glow : (bflip.has-hover ? Theme.well : transparent);
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 11px;
                                Text {
                                    text: "base";
                                    color: root.view-layer == 0 ? Theme.accent : (bflip.has-hover ? Theme.text-mid : Theme.text-dim);
                                    font-family: Theme.mono; font-size: Theme.fs-small;
                                    font-weight: root.view-layer == 0 ? 700 : 500;
                                    letter-spacing: Theme.track-4; vertical-alignment: center;
                                }
                            }
                            bflip := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.view-layer = 0; root.add-open = false; State.editing-rule = -1; } }
                        }
                        Rectangle { width: Theme.hair; background: Theme.line; }
                        Rectangle {
                            background: root.view-layer == 1 ? Theme.accent-glow : (hflip.has-hover ? Theme.well : transparent);
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 11px; padding-right: 12px;
                                Text {
                                    text: "HYPER";
                                    color: root.view-layer == 1 ? Theme.accent : (hflip.has-hover ? Theme.text-mid : Theme.text-dim);
                                    font-family: Theme.mono; font-size: Theme.fs-small;
                                    font-weight: root.view-layer == 1 ? 700 : 500;
                                    letter-spacing: Theme.track-4; vertical-alignment: center;
                                }
                            }
                            hflip := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.view-layer = 1; root.add-open = false; State.editing-rule = -1; } }
                        }
                        Rectangle { width: Theme.hair; background: Theme.line; }
                        // ⚙ configure — toggles the hold/stance/feel disclosure. Accent while open OR
                        // while it needs attention (revealed but no hold key — won't actually trigger):
                        // the label itself becomes the nudge, so a user can't miss that a hold key is owed.
                        cog := Rectangle {
                            property <bool> needs-key: !State.hypershift-hold-ready;
                            property <bool> lit: root.config-open || self.needs-key;
                            background: cogta.has-hover ? Theme.well : transparent;
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: cog.needs-key ? "set a hold key to reach this layer" : "configure";
                                        color: cog.lit ? Theme.accent : (cogta.has-hover ? Theme.text-mid : Theme.text-dim);
                                        font-family: Theme.mono; font-size: Theme.fs-small; vertical-alignment: center;
                                        animate color { duration: Theme.quick; }
                                    }
                                }
                            }
                            cogta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.config-open = !root.config-open; } }
                        }
                        // collapse × — ONLY while opened-but-empty (never hide real work)
                        if !shell.setup-exists : Rectangle { width: Theme.hair; background: Theme.line; }
                        if !shell.setup-exists : Rectangle {
                            background: xta.has-hover ? Theme.well : transparent;
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 11px;
                                VerticalLayout { alignment: center; Text { text: "\u{00d7}"; color: xta.has-hover ? Theme.text : Theme.text-faint; font-family: Theme.mono; font-size: Theme.fs-body; vertical-alignment: center; animate color { duration: Theme.quick; } } }
                            }
                            xta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.hyper-open = false; root.config-open = false; root.view-layer = 0; root.add-open = false; State.editing-rule = -1; } }
                        }
                    }
                }
                Rectangle {}
            }

            // ── ⚙ CONFIG DISCLOSURE — the hold key, stance, and feel, tucked out of the way ──
            if root.hyper-revealed && root.config-open : Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 13px;
                    Mono {
                        text: "Hold your HyperShift key and your controls do their HyperShift binding instead of the base one.";
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    // REACHED BY — the hold key (without it, the layer never triggers)
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; width: 92px; Mono { text: "REACHED BY"; color: Theme.text-dim; } }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            // the shared TriggerWell (lamp flavour, DISPLAY-only — the capture verb is the
                            // key beside it, so this well isn't clickable). Lamp lit accent once bound.
                            TriggerWell {
                                text: State.hypershift-hold-label;
                                prompt: "no hold key · press-to-bind the control you'll hold";
                                live: State.hypershift-hold-ready;
                                lamp: true;
                            }
                        }
                        // rebind / clear — a fused SplitButton once a key exists (clear = danger half on
                        // the right); a lone primary press-to-bind key while nothing is set (nothing to
                        // clear, so no second half).
                        if State.hypershift-hold-ready : VerticalLayout {
                            alignment: center;
                            SplitButton {
                                left-text: "rebind";
                                right-text: "clear";
                                right-danger: true;
                                left-clicked => { State.capture-hypershift-hold(); }
                                right-clicked => { State.clear-hypershift-hold(); }
                            }
                        }
                        if !State.hypershift-hold-ready : VerticalLayout {
                            alignment: center;
                            Button { text: "press-to-bind"; primary: true; clicked => { State.capture-hypershift-hold(); } }
                        }
                    }
                    // BEHAVES AS — the stance, now contextual to the layer it tunes
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; width: 92px; Mono { text: "BEHAVES AS"; color: Theme.text-dim; } }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            // the fused rail hugs its cells (min-cell floor) because the trailing spacer
                            // below eats the row's slack — it never fills the whole row.
                            SplitToggle {
                                options: ["HOLD", "LATCH", "SMART", "1-SHOT"];
                                index: root.stance-idx;
                                min-cell: 60px;
                                picked(i) => { State.set-hypershift-mode(i == 0 ? "hold" : i == 1 ? "latch" : i == 2 ? "smart" : "one-shot"); }
                            }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Mono {
                                text: State.hypershift-mode == "latch" ? "tap on · tap off"
                                    : State.hypershift-mode == "smart" ? "tap latches · hold is momentary"
                                    : State.hypershift-mode == "one-shot" ? "next press is shifted, then drops"
                                    : "live while held (Razer's behaviour)";
                                color: Theme.text-faint;
                            }
                        }
                    }
                    // feel / forgiveness — the 3 press-grammar dials, tucked behind a disclosure
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                ftog := TouchArea {
                                    width: ftl.preferred-width; height: 18px;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.feel-open = !root.feel-open; }
                                    ftl := Text {
                                        text: (root.feel-open ? "▾ " : "▸ ") + "feel · the press-grammar forgiveness windows";
                                        color: ftog.has-hover ? Theme.text-mid : Theme.text-faint;
                                        font-family: Theme.mono; font-size: Theme.fs-small; vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {}
                        }
                        if root.feel-open : HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 7px;
                                    VerticalLayout { alignment: center; Mono { text: "hold"; color: Theme.text-faint; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Slider { compact: true; minimum: 80; maximum: 600; step: 10; value: State.feel-hold-ms; wheel: false; changed(v) => { State.set-feel-timing(v, State.feel-gap-ms, State.feel-coyote-ms); } }
                                    }
                                    VerticalLayout { alignment: center; min-width: 48px; Mono { text: State.feel-hold-ms + "ms"; color: Theme.text; horizontal-alignment: right; } }
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 7px;
                                    VerticalLayout { alignment: center; Mono { text: "gap"; color: Theme.text-faint; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Slider { compact: true; minimum: 40; maximum: 400; step: 10; value: State.feel-gap-ms; wheel: false; changed(v) => { State.set-feel-timing(State.feel-hold-ms, v, State.feel-coyote-ms); } }
                                    }
                                    VerticalLayout { alignment: center; min-width: 48px; Mono { text: State.feel-gap-ms + "ms"; color: Theme.text; horizontal-alignment: right; } }
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 7px;
                                    VerticalLayout { alignment: center; Mono { text: "coyote"; color: Theme.text-faint; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Slider { compact: true; minimum: 0; maximum: 200; step: 10; value: State.feel-coyote-ms; wheel: false; changed(v) => { State.set-feel-timing(State.feel-hold-ms, State.feel-gap-ms, v); } }
                                    }
                                    VerticalLayout { alignment: center; min-width: 48px; Mono { text: State.feel-coyote-ms + "ms"; color: Theme.text; horizontal-alignment: right; } }
                                }
                            }
                        }
                    }
                }
            }

            // ── the active layer's binds (LIST) ──
            VerticalLayout {
                spacing: 11px;
                RuleList {
                    title: root.view-layer == 0 ? "BASE BINDS" : "HYPERSHIFT BINDS";
                    accent: root.view-layer == 1;
                    hyper: root.view-layer == 1;
                    rules: root.view-layer == 0 ? State.rules : State.hypershift-rules;
                    empty-hint: root.view-layer == 0
                        ? "no base binds yet · press-to-bind a control below"
                        : "no shifted binds yet · bind a control while you're on this layer";
                    remove(i) => { if (root.view-layer == 0) { State.remove-rule(i); } else { State.remove-hyper-rule(i); } }
                    reorder(i, dir) => { if (root.view-layer == 0) { State.move-rule(i, dir); } else { State.move-hyper-rule(i, dir); } }
                }
                // INLINE "+ bind a control" — the press-to-bind flow, in place. New binds land on the
                // layer you're viewing, so there's no "on HyperShift layer" checkbox to forget. Both
                // halves hide while a row is being edited (its inline editor owns the shared picker).
                if !root.add-open && State.editing-rule < 0 : Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: addta.has-hover ? Theme.well : Theme.bg-2;
                    border-width: Theme.hair;
                    border-color: addta.has-hover ? Theme.accent-line : Theme.line;
                    animate background, border-color { duration: Theme.quick; }
                    addta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        // a clean slate for a NEW bind: drop any stale captured trigger so the slot
                        // shows "press-to-bind" (the commit button gates on bind-trigger-ready, so a
                        // leftover capture can't be committed blind). The ACTION side is shared with
                        // every other picker on this page (edit-in-place, radial, gesture binder), so
                        // it can't be trusted to already be clean here — force it back to the first
                        // real choice (index 0 is always a header) so a just-edited/cancelled rule's
                        // action can never leak into the next fresh bind.
                        clicked => {
                            State.bind-hypershift = (root.view-layer == 1);
                            State.bind-trigger-ready = false;
                            State.bind-trigger-label = "—";
                            State.dup-trigger-note = "";   // fresh slate — no stale clash note
                            State.action-choice = 1;
                            State.action-param = "";
                            State.action-choice-changed();  // refresh the suggestion chips — no stale leftovers
                            root.add-open = true;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        VerticalLayout { alignment: center; Text { text: "＋"; color: Theme.accent; font-family: Theme.mono; font-size: Theme.fs-body; font-weight: 700; } }
                        VerticalLayout { alignment: center; Text { text: root.view-layer == 1 ? "bind a control to the HyperShift layer" : "bind a control"; color: addta.has-hover ? Theme.text-mid : Theme.text-faint; font-family: Theme.mono; font-size: Theme.fs-body; } }
                        Rectangle {}
                    }
                }
                if root.add-open && State.editing-rule < 0 : WireEditor {
                    hyper: root.view-layer == 1;
                    editing: false;
                    commit => { State.bind-hypershift = (root.view-layer == 1); State.add-binding(); }
                    close => { root.add-open = false; }
                }
            }

            // ════════ ALTITUDE 2 · THE WORKSHOP ════════
            Rectangle { height: 6px; }
            Rectangle { height: Theme.hair; background: Theme.line; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { width: 3px; height: 14px; border-radius: 1px; y: 1px; background: Theme.accent; }
                SectionTitle { text: "WORKSHOP"; }
                VerticalLayout { alignment: center; Mono { text: "the things you bind to · build them here"; color: Theme.text-faint; font-size: Theme.fs-small; } }
                Rectangle {}
            }

            // MACRO — the star: full width, CODE-first (blocks is the toggle). Carries macro_row for
            // the cross-panel "author a macro" jump (see app.slint).
            macro_row := VerticalLayout {
                horizontal-stretch: 1;
                spacing: 11px;
                    HorizontalLayout {
                        spacing: 8px;
                        SectionTitle { text: "MACRO"; }
                        VerticalLayout { alignment: center; Mono { text: "a script you bind to a trigger"; color: Theme.text-faint; font-size: Theme.fs-small; } }
                        // the book button — opens the macro/Workshop guide popup, anchored here.
                        // Lands after the hint (title, hint, book), mirroring the weave side's GLYPH
                        // row (title, book) — the book always trails any inline label text, never
                        // wedged between a title and its own description.
                        VerticalLayout { alignment: center; GuideButton { guide-id: "macros"; } }
                        Rectangle {}
                        if State.macro-parsing && !State.macro-code-view : Pill { text: "READING"; live: true; }
                        if State.macro-busy : Pill { text: "WORKING"; live: true; }
                        // BLOCKS ⇄ CODE — the same macro, two presentations: a visual node-blocks canvas
                        // or the raw Python. Switching TO blocks re-parses the current source so the
                        // canvas reflects whatever the code view holds. The fused SplitToggle IS the mode
                        // grammar (two halves, one outline, active side lit) — the hand-rolled byte-copy
                        // that used to sit here (drawn blocks-icon and all) is gone.
                        VerticalLayout {
                            alignment: center;
                            SplitToggle {
                                width: 160px;
                                options: ["blocks", "‹/› code"];
                                index: State.macro-code-view ? 1 : 0;
                                picked(i) => {
                                    if (i == 0) {
                                        State.macro-code-view = false;
                                        State.refresh-macro-blocks(State.macro-source);
                                    } else {
                                        State.macro-code-view = true;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout { alignment: center; Mono { text: "NAME"; color: Theme.text-dim; } }
                        Field {
                            field-width: 200px;
                            placeholder: "name it · e.g. paste_clean";
                            text <=> State.macro-name;
                        }
                        Rectangle {}
                    }
                    // THE CONSTRUCTOR — two presentations of the same macro, switched by the header's
                    // blocks⇄code segment. The BLOCKS canvas IS the builder: every row is built by touch
                    // (inline field edits, hover ↑/↓/✕, the +add picker), each mutating the Rust working
                    // tree which regenerates the source + re-flattens instantly. The CODE view is the same
                    // macro as raw Python; typing there reseeds the tree on the toggle back (or via the
                    // dirty-guard). The old top chip toolbar is gone — its job moved INTO the canvas.
                    if !State.macro-code-view : VerticalLayout {
                        spacing: 6px;
                        // a syntax/host error rides ABOVE the canvas and KEEPS the last-good rows visible
                        // — you fix the line while still seeing the structure ("works with errors").
                        if State.macro-parse-error != "" : Mono {
                            text: State.macro-parse-error;
                            color: Theme.warn;
                            font-size: Theme.fs-small;
                            wrap: word-wrap;
                        }
                        // the canvas — steps, branch lanes, and +add points, all on one spine. When
                        // empty it's just the root +add, which renders as a warm "add your first step"
                        // CTA (see MacroBlockEl.empty-cta), so no separate empty-state line is needed.
                        VerticalLayout {
                            spacing: 4px;
                            for b in State.macro-blocks : MacroBlockEl { b: b; }
                        }
                        // a quiet alternative pointer when the macro is empty — the canvas CTA is the
                        // primary call; this just notes the code-view escape hatch below it.
                        if State.macro-blocks.length <= 1 : Mono {
                            text: "\u{2026} or switch to code view to write Python directly";
                            color: Theme.text-faint;
                            font-size: Theme.fs-small;
                        }
                    }
                    if State.macro-code-view : CodeArea {
                        height: 150px;
                        placeholder: "def macro(ctx):\n    neuron.type_text(\"hello!\")";
                        text <=> State.macro-source;
                        // BIDIRECTIONAL dirty-guard: a change Rust made from the tree (a canvas edit /
                        // a parse reseed) sets macro-source-dirty — that keystroke is codegen, not a
                        // human, so clear the flag and DON'T re-note (which would loop). A genuine human
                        // edit leaves the flag false → note it (gates "test asks"); the live re-parse
                        // into blocks happens on the toggle back to the canvas (refresh-macro-blocks).
                        edited(s) => {
                            if (State.macro-source-dirty) {
                                State.macro-source-dirty = false;
                            } else {
                                State.note-macro-source(s);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Button {
                            text: "check";
                            busy: State.macro-busy;
                            clicked => { State.macro-check(State.macro-source); }
                        }
                        // open the macros/scripts/ folder (made if missing) — drop .py files in here.
                        Button {
                            text: "reveal";
                            clicked => { State.reveal-macros(); }
                        }
                        // re-read disk: register dropped-in / externally-edited macros, refresh the
                        // catalog, and reload the open macro. The "press reload" (no live-watch) path.
                        Button {
                            text: "reload";
                            clicked => { State.reload-macros(); }
                        }
                        // SURFACES ITSELF once the macro contains an ask — previews JUST its beacon(s)
                        // via the SYSTEM→BEACONS pipeline (disarmed, nothing real runs): learn asks by
                        // seeing them, no docs in your face.
                        if (State.macro-has-ask) : Button {
                            text: "test asks";
                            busy: State.macro-busy;
                            clicked => { State.test-asks(State.macro-name, State.macro-source); }
                        }
                        Button {
                            // runs it once for real — danger-tinted; SAFE-mode keeps its input harmless
                            text: "test run";
                            danger: true;
                            busy: State.macro-busy;
                            clicked => { State.macro-test(State.macro-name, State.macro-source); }
                        }
                        Rectangle {}
                        Button {
                            text: "save";
                            primary: true;
                            busy: State.macro-busy;
                            clicked => { State.macro-save(State.macro-name, State.macro-source); }
                        }
                    }
                    Mono { text: State.macro-status; color: Theme.text-mid; }
                    // after check: the defs found. after test: the macro's print()/traceback log.
                    if State.macro-dryrun.length > 0 : Card {
                        VerticalLayout {
                            padding: 11px;
                            spacing: 3px;
                            // a Python traceback has long lines — wrap so the tail doesn't bleed off-edge
                            for line in State.macro-dryrun : Mono { text: line; wrap: word-wrap; }
                        }
                    }
                    // THE CATALOG — every macro on disk, read EMERGENTLY so you understand them without
                    // opening the code: name, the plain-English summary, size + options, and the
                    // trigger(s) that fire each. Click a card to load it into the editor above (the open
                    // one is lit). Flows in the page scroll, so a long list scrolls with the panel.
                    VerticalLayout {
                        spacing: 7px;
                        HorizontalLayout {
                            spacing: 8px;
                            SectionTitle { text: "ALL MACROS"; }
                            VerticalLayout { alignment: center; Mono { text: "click one to open it"; color: Theme.text-faint; font-size: Theme.fs-small; } }
                            Rectangle {}
                            if State.macro-catalog-building : Pill { text: "READING"; live: true; }
                        }
                        if State.macro-catalog.length == 0 && !State.macro-catalog-building : Mono {
                            text: "no macros yet · build one above, or Reveal the folder, drop a .py in, then Reload";
                            color: Theme.text-faint;
                            font-size: Theme.fs-small;
                            wrap: word-wrap;
                        }
                        // a horizontal CAROUSEL (one row) instead of a tall vertical list — far less page
                        // scroll. Arithmetic-x in a clipped band: NO nested Flickable (two Flickables break
                        // the inner's hit-testing — app.slint's lesson), so card clicks + the ✕ stay live.
                        // The wheel pans; `pan` is declared FIRST (beneath the cards) so it swallows the
                        // wheel the cards don't consume — the page behind never scrolls.
                        if State.macro-catalog.length > 0 : carousel := Rectangle {
                            height: 110px;
                            clip: true;
                            property <length> step: 256px;             // card 248 + gap 8
                            property <length> content: max(0px, State.macro-catalog.length * self.step - 8px);
                            property <length> floor: min(0px, self.width - self.content);
                            property <length> scroll: 0px;
                            pan := TouchArea {
                                scroll-event(e) => {
                                    carousel.scroll = clamp(carousel.scroll + e.delta-y + e.delta-x, carousel.floor, 0px);
                                    return accept;
                                }
                            }
                            for c[i] in State.macro-catalog : MacroCardEl {
                                c: c;
                                x: i * carousel.step + carousel.scroll;
                                width: 248px;
                                height: parent.height;
                            }
                        }
                    }
                }

            Divider {}

            // POCKETS — portable clipboards, each with its emergent content-sigil
            VerticalLayout {
                spacing: 9px;
                SectionTitle { text: "POCKETS"; }
                if State.pockets.length == 0 : Mono {
                    text: "no pockets yet · bind a `pocket` action, then activate it with something on your clipboard";
                    color: Theme.text-faint;
                }
                if State.pockets.length > 0 : HorizontalLayout {
                    spacing: 8px;
                    for pk in State.pockets : PocketCardEl { p: pk; }
                    Rectangle {}
                }
            }

        }
    }
}
