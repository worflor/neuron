import { Theme } from "../theme.slint";
import { SectionTitle, Button, Field, Picker, Pill, Mono, Divider } from "../widgets/controls.slint";
import { State } from "../state.slint";
import { ProfileRow, AppRuleRow } from "../models.slint";

// PROFILES — named look+feel bundles (profile::Profile) you apply by hand or auto by focused app
// (profile::AppRules). This is the DROPDOWN form: a floating menu under the header pill, not a
// full-screen sheet. Primary action is "pick a saved profile to apply"; below it you capture the
// live state into a new bundle, and route focused apps to profiles. Same State API as before.

// One saved profile — a slim row. The whole row applies it; a two-step armed contact deletes.
component ProfileMenuRow inherits Rectangle {
    in property <ProfileRow> p;
    in property <bool> armed;
    callback apply();
    callback arm-delete();
    callback confirm-delete();
    height: 52px;
    border-radius: Theme.radius-sm;
    background: root.p.active ? Theme.accent-glow : (cta.has-hover ? Theme.well : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.p.active ? Theme.accent-line : (cta.has-hover ? Theme.text-faint : Theme.line);
    animate background, border-color { duration: Theme.quick; }
    // the active profile's index tick — its only colour, settling never teleporting
    Rectangle {
        x: 0; width: 2px; y: 9px; height: parent.height - 18px;
        background: root.p.active ? Theme.accent : transparent;
        animate background { duration: Theme.quick; }
    }
    cta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.apply(); } }
    HorizontalLayout {
        padding-left: 13px; padding-right: 9px; spacing: 9px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 3px;
            Text {
                text: root.p.name;
                color: root.p.active ? Theme.accent : Theme.text;
                font-family: Theme.mono; font-size: Theme.fs-data; font-weight: 700;
                vertical-alignment: center; overflow: elide;
                animate color { duration: Theme.quick; }
            }
            // a compact captured-values line (the data is the hero, never one prose run)
            HorizontalLayout {
                spacing: 10px;
                if root.p.dpi != "" : Mono { text: "dpi " + root.p.dpi; color: Theme.text-faint; font-size: Theme.fs-small; }
                if root.p.polling != "" : Mono { text: "poll " + root.p.polling; color: Theme.text-faint; font-size: Theme.fs-small; }
                if root.p.lighting != "" : Mono { text: "light " + root.p.lighting; color: Theme.text-faint; font-size: Theme.fs-small; }
                if root.p.dpi == "" && root.p.polling == "" && root.p.lighting == "" : Mono { text: root.p.summary; color: Theme.text-faint; font-size: Theme.fs-small; overflow: elide; }
                Rectangle {}
            }
        }
        if root.p.active : VerticalLayout { alignment: center; Pill { text: "ACTIVE"; live: true; } }
        // delete — a quiet glyph on hover; first click arms, a second commits. RESERVES the armed
        // width so arming never reflows the name beside it.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.armed ? 58px : 22px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: root.armed ? Theme.danger.with-alpha(0.15) : transparent;
                border-width: Theme.hair;
                border-color: root.armed ? Theme.danger : transparent;
                opacity: cta.has-hover || root.armed ? 1.0 : 0.0;
                animate opacity, width, background, border-color { duration: Theme.quick; }
                Text {
                    text: root.armed ? "delete?" : "✕";
                    color: Theme.danger; font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    // an opacity:0 TouchArea is still hit-tested — gate it so the empty corner is inert
                    enabled: cta.has-hover || root.armed;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { if (root.armed) { root.confirm-delete(); } else { root.arm-delete(); } }
                }
            }
        }
    }
}

export component ProfilesMenu inherits VerticalLayout {
    spacing: 0;
    padding: 16px;
    property <string> new-profile-name;
    property <string> rule-app;
    property <int> rule-profile-idx: 0;
    // name-keyed delete arming (an index can drift when the model refreshes mid-arm)
    property <string> armed-delete: "";
    Timer {
        interval: 2500ms;
        running: root.armed-delete != "";
        triggered => { root.armed-delete = ""; }
    }

    // ── header: the name + the live active state (mirrors the pill that opened it) ──
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Text {
                text: "PROFILES";
                color: Theme.text; font-family: Theme.mono; font-size: Theme.fs-title;
                font-weight: 700; letter-spacing: Theme.track-4;
            }
        }
        Rectangle {}
        VerticalLayout {
            alignment: center;
            Pill {
                text: State.active-profile == "—" ? "none active" : State.active-profile;
                live: State.active-profile != "—";
            }
        }
    }
    Rectangle { height: 4px; }
    Mono { text: "apply a saved bundle, or capture the live device state"; color: Theme.text-faint; }
    Rectangle { height: 15px; }

    // ── SAVED — the primary list (pick one to apply) ──
    HorizontalLayout {
        SectionTitle { text: "SAVED"; }
        Rectangle {}
        Mono { text: State.profiles.length + (State.profiles.length == 1 ? " profile" : " profiles"); color: Theme.text-faint; }
    }
    Rectangle { height: 8px; }
    VerticalLayout {
        spacing: 6px;
        for p in State.profiles : ProfileMenuRow {
            p: p;
            armed: root.armed-delete == p.name;
            apply => { root.armed-delete = ""; State.apply-profile(p.name); State.profile-sheet-open = false; }
            arm-delete => { root.armed-delete = p.name; }
            confirm-delete => { root.armed-delete = ""; State.delete-profile(p.name); }
        }
    }
    if State.profiles.length == 0 : Rectangle {
        height: 66px;
        border-radius: Theme.radius;
        background: Theme.bg-2;
        border-width: Theme.hair;
        border-color: Theme.line;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Mono { text: "no profiles yet"; color: Theme.text-dim; horizontal-alignment: center; }
            Mono { text: "tune your device, then capture it below"; color: Theme.text-faint; horizontal-alignment: center; }
        }
    }
    Rectangle { height: 11px; }
    // capture the live state into a new bundle (the inviting primary write)
    HorizontalLayout {
        spacing: 8px;
        Field {
            field-width: 290px;
            placeholder: "name this profile";
            text <=> root.new-profile-name;
            edited(t) => { State.profile-name-edited(t); }
            accepted(t) => {
                if (t != "") {
                    State.save-current-profile(t);
                    root.new-profile-name = "";
                    State.profile-name-edited("");
                }
            }
        }
        Button {
            text: State.profile-name-exists ? "overwrite" : "capture";
            primary: !State.profile-name-exists;
            danger: State.profile-name-exists;
            enabled: root.new-profile-name != "";
            clicked => {
                State.save-current-profile(root.new-profile-name);
                root.new-profile-name = "";
                State.profile-name-edited("");
            }
        }
    }
    Rectangle { height: 6px; }
    Mono { text: "captures a live read-back · dpi · polling · brightness · lighting · idle"; color: Theme.text-faint; font-size: Theme.fs-small; }

    Rectangle { height: 16px; }
    Divider {}
    Rectangle { height: 16px; }

    // ── AUTO-SWITCH — route the focused app to a saved profile ──
    SectionTitle { text: "AUTO-SWITCH BY APP"; }
    Rectangle { height: 8px; }
    // SOURCE — the live focused-app signal this routing switches on
    Rectangle {
        height: 28px;
        border-radius: Theme.radius-sm;
        background: Theme.well;
        border-width: Theme.hair; border-color: Theme.line;
        HorizontalLayout {
            padding-left: 11px; padding-right: 11px; spacing: 8px;
            VerticalLayout { alignment: center; Mono { text: "FOCUS"; color: Theme.text-faint; font-size: Theme.fs-small; } }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: State.focused-app; color: Theme.text-mid; font-family: Theme.mono; font-size: Theme.fs-body; vertical-alignment: center; overflow: elide; }
            }
        }
    }
    Rectangle { height: 8px; }
    VerticalLayout {
        spacing: 6px;
        for r[i] in State.app-rules : rr := Rectangle {
            height: 34px;
            border-radius: Theme.radius-sm;
            background: Theme.well;
            border-width: Theme.hair;
            property <bool> routing: i == State.active-app-rule;
            border-color: self.routing ? Theme.accent-line : Theme.line;
            animate border-color { duration: Theme.settle; }
            rowta := TouchArea {}   // row-level hover so the delete stays quiet at rest
            HorizontalLayout {
                padding-left: 11px; padding-right: 7px; spacing: 8px;
                // the closed-contact lamp: THIS rule is currently winning
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 5px; height: 5px; border-radius: 3px;
                        background: rr.routing ? Theme.accent : Theme.line;
                        animate background { duration: Theme.settle; }
                    }
                }
                Text { text: r.app; color: Theme.text; font-size: Theme.fs-body; font-family: Theme.mono; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text {
                    text: "→";
                    color: rr.routing ? Theme.accent : Theme.text-faint;
                    vertical-alignment: center;
                    animate color { duration: Theme.settle; }
                }
                Text { text: r.profile; color: Theme.text-mid; font-size: Theme.fs-body; font-family: Theme.mono; vertical-alignment: center; overflow: elide; }
                Button {
                    text: "del"; danger: true;
                    enabled: rowta.has-hover;
                    opacity: rowta.has-hover ? 1.0 : 0.0;
                    clicked => { State.remove-app-rule(i); }
                }
            }
        }
    }
    if State.app-rules.length == 0 : Mono { text: "no rules yet · match a focused app to a profile"; color: Theme.text-faint; }
    Rectangle { height: 9px; }
    // add a rule: the app substring (or grab the focused app), then the target profile
    HorizontalLayout {
        spacing: 7px;
        Field {
            field-width: 240px;
            placeholder: "app substring (e.g. valorant)";
            text <=> root.rule-app;
        }
        Button {
            text: "use focus";
            enabled: State.focused-app != "—" && State.focused-app != "";
            clicked => { root.rule-app = State.focused-app; }
        }
    }
    Rectangle { height: 7px; }
    HorizontalLayout {
        spacing: 7px;
        VerticalLayout {
            horizontal-stretch: 1;
            Picker {
                options: State.profile-names;
                index: root.rule-profile-idx;
                changed(i) => { root.rule-profile-idx = i; }
            }
        }
        Button {
            text: "+ add rule";
            primary: true;
            enabled: root.rule-app != "" && State.profile-names.length > 0;
            clicked => {
                State.add-app-rule(root.rule-app,
                    State.profile-names[min(root.rule-profile-idx, State.profile-names.length - 1)]);
                root.rule-app = "";
            }
        }
    }
    if State.profile-names.length == 0 : Rectangle { height: 7px; }
    if State.profile-names.length == 0 : Mono { text: "save a profile first to route apps to it"; color: Theme.text-faint; font-size: Theme.fs-small; }
}
