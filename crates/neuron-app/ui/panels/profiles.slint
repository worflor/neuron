import { Theme } from "../theme.slint";
import { SectionTitle, Button, Field, Picker, Pill, Mono, Divider, PanelHead, SelectTick, IconButton } from "../widgets/controls.slint";
import { State } from "../state.slint";
import { ProfileRow, AppRuleRow } from "../models.slint";

// PROFILES — named look+feel bundles (profile::Profile) you apply by hand or auto by focused app
// (profile::AppRules). This is the DROPDOWN form: a floating menu under the header pill, not a
// full-screen sheet. Primary action is "pick a saved profile to apply"; below it you capture the
// live state into a new bundle, and route focused apps to profiles. Same State API as before.

// One captured value: a faint label and its value, the value being what the eye lands on.
component Stat inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> ink: Theme.text-mid;
    spacing: 4px;
    Mono { text: root.label; color: Theme.text-faint; font-size: Theme.fs-small; }
    Mono { text: root.value; color: root.ink; font-size: Theme.fs-small; }
}

// One saved profile — a slim row. The whole row applies it; a two-step armed contact deletes; the
// name itself is a rename affordance (click it and it becomes an editable field in place).
component ProfileMenuRow inherits Rectangle {
    in property <ProfileRow> p;
    in property <bool> armed;
    // marks the row whose name is being edited in the sheet's own rename field (below the list).
    in property <bool> renaming;
    callback apply();
    callback arm-delete();
    callback confirm-delete();
    callback begin-rename();
    height: 52px;
    border-radius: Theme.radius-sm;
    background: (root.p.active || root.renaming) ? Theme.accent-glow : (cta.has-hover ? Theme.well : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.p.broken ? Theme.danger.with-alpha(0.5)
        : ((root.p.active || root.renaming) ? Theme.accent-line : (cta.has-hover ? Theme.text-faint : Theme.line));
    animate background, border-color { duration: Theme.quick; }
    // the active profile's index tick — its only colour, settling never teleporting.
    // The site keeps its own vertical inset; SelectTick owns the bar + its animation.
    SelectTick {
        active: root.p.active;
        y: 9px; height: parent.height - 18px;
    }
    // a broken profile can't be applied — no click target, so the row can't lie about being usable.
    // `enabled` deliberately does NOT depend on `renaming`. The rename affordance is a TouchArea
    // nested above this one, so a click there would flip this sibling's enabled state while Slint
    // is still dispatching that very click — which it answers with a "Recursion detected" panic.
    // While renaming, the edit Field covers this area anyway, so nothing here needs disabling.
    cta := TouchArea {
        enabled: !root.p.broken;
        mouse-cursor: MouseCursor.pointer;
        clicked => { if (!root.renaming) { root.apply(); } }
    }
    HorizontalLayout {
        padding-left: 13px; padding-right: 9px; spacing: 9px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 3px;
            min-width: 0px;
            // The row's SHAPE never changes on click. An in-place edit field here — swapping the
            // name Text out for a Field when this row's `renaming` went true — panicked Slint with
            // "Recursion detected" every single time: the click handler was replacing the very
            // subtree the click was still being dispatched through. Three narrower fixes (dropping
            // the blur handler, dropping the init-focus, unbinding the row TouchArea's `enabled`)
            // each failed, because the structural swap itself was the cause.
            //
            // So the editor lives ONCE, below the list, and a row only ever gets highlighted. No
            // element is created or destroyed by the click that starts a rename.
            HorizontalLayout {
                spacing: 7px;
                nm := Text {
                    text: root.p.name;
                    color: root.p.broken ? Theme.danger : (root.p.active ? Theme.accent : Theme.text);
                    font-family: Theme.mono; font-size: Theme.fs-data; font-weight: 700;
                    vertical-alignment: center; overflow: elide;
                    animate color { duration: Theme.quick; }
                }
                Rectangle {}
                // rename — a quiet word in the row's verb cluster, the same faint→bright idiom as ✕ beside
                // it. (Consolas draws no pencil glyph, so a word.) It opens the one editor below the list.
                if !root.p.broken : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 50px; height: 22px;
                        border-radius: Theme.radius-sm;
                        background: rnta.has-hover ? Theme.well : transparent;
                        animate background { duration: Theme.quick; }
                        Text {
                            text: "rename";
                            color: rnta.has-hover ? Theme.text : Theme.text-faint;
                            font-family: Theme.mono; font-size: Theme.fs-small;
                            horizontal-alignment: center; vertical-alignment: center;
                            animate color { duration: Theme.quick; }
                        }
                        rnta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.begin-rename(); }
                        }
                    }
                }
                // delete — the ONE idiom: an ALWAYS-VISIBLE quiet ✕ (faint ink) that brightens to danger on
                // hover (never opacity-0-until-hover, never permanently-red). First click ARMS (the cell grows
                // to a reddened "delete?"), a second confirms. RESERVES the armed width so arming never reflows
                // the name. The TouchArea is always live (no invisible-but-clickable corner).
                // The slot is a FIXED 58px — the armed "delete?" width — whether armed or not, and its
                // TouchArea owns the whole slot. The pill inside grows into it. This is what stops the
                // confirm window from turning into a footgun: the cell used to be 22px at rest and 58px
                // armed, so when the 2.5s window expired the pixels that had just read "delete?" became
                // plain row, and a second click meant to confirm a delete APPLIED the profile instead.
                // Live-reproduced. A wider quiet target is also simply easier to hit.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 58px;
                        height: 22px;
                        dta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { if (root.armed) { root.confirm-delete(); } else { root.arm-delete(); } }
                        }
                        Rectangle {
                            x: parent.width - self.width;
                            width: root.armed ? 58px : 22px;
                            height: 22px;
                            border-radius: Theme.radius-sm;
                            background: root.armed ? Theme.danger.with-alpha(0.15) : (dta.has-hover ? Theme.well : transparent);
                            border-width: Theme.hair;
                            border-color: root.armed ? Theme.danger : transparent;
                            animate width, background, border-color { duration: Theme.quick; }
                            Text {
                                text: root.armed ? "delete?" : "\u{00d7}";
                                // faint at rest, danger on hover / while armed — the shared faint↔danger fade.
                                color: (root.armed || dta.has-hover) ? Theme.danger : Theme.text-faint;
                                font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                animate color { duration: Theme.quick; }
                            }
                        }
                    }
                }
            }
            // a compact captured-values line (the data is the hero, never one prose run); a line longer
            // than the row is clipped, so the verbs at the right edge always keep their place
            Rectangle {
                clip: true;
                min-width: 0px;
                height: stats.preferred-height;
            stats := HorizontalLayout {
                x: 0px;
                width: max(self.preferred-width, parent.width);
                spacing: 10px;
                // a profile whose file won't parse says why, in place of values it doesn't have.
                if root.p.broken : Mono { text: root.p.why; color: Theme.danger; font-size: Theme.fs-small; overflow: elide; }
                if root.p.dpi != "" : Stat { label: "dpi"; value: root.p.dpi; }
                if root.p.polling != "" : Stat { label: "poll"; value: root.p.polling; }
                if root.p.brightness != "" : Stat { label: "bright"; value: root.p.brightness; }
                if root.p.lighting != "" : Stat { label: "light"; value: root.p.lighting; }
                if root.p.idle != "" : Stat { label: "idle"; value: root.p.idle; }
                if root.p.in-game != "" : Stat { label: "in-game"; value: root.p.in-game; }
                if root.p.gaming : Mono { text: "gaming"; color: Theme.text-mid; font-size: Theme.fs-small; }
                // binds ride WITH the profile: `<name>.rules.toml` is live only while it's active.
                // Without this badge a profile that carries an imported keymap looked identical to
                // one that doesn't, and there was no way to tell what applying it would change.
                if root.p.binds > 0 : Mono { text: root.p.binds + (root.p.binds == 1 ? " bind" : " binds"); color: Theme.text-dim; font-size: Theme.fs-small; }
                // every real field has its OWN badge above, so the summary fallback is now purely the
                // "(empty)" guard: it shows only when the row is genuinely blank (no field, no gaming).
                if !root.p.broken && root.p.dpi == "" && root.p.polling == "" && root.p.brightness == "" && root.p.lighting == "" && root.p.idle == "" && root.p.in-game == "" && !root.p.gaming && root.p.binds == 0 : Mono { text: root.p.summary; color: Theme.text-faint; font-size: Theme.fs-small; overflow: elide; }
                Rectangle {}
            }
            }
        }
    }
}

export component ProfilesMenu inherits VerticalLayout {
    spacing: 0;
    padding: 16px;
    property <string> new-profile-name;
    // what a capture actually names: the typed name if any, else the pre-filled suggestion (zero typing).
    property <string> effective-name: root.new-profile-name != "" ? root.new-profile-name : State.profile-name-suggested;
    // The overwrite check must follow the name that will ACTUALLY be saved (effective-name), NOT the
    // raw typed field. Otherwise the nasty case — capture TWICE under the zero-typing suggestion: the
    // first save turns that suggestion into a real profile name, so the second click overwrites it,
    // yet the button still reads "capture" (the check saw only the empty field). So re-answer it on
    // init, whenever effective-name changes (typing OR a fresh suggestion), and after every save (the
    // profiles list just changed under us). One source of truth: always check effective-name.
    init => { State.profile-name-edited(root.effective-name); }
    changed effective-name => { State.profile-name-edited(root.effective-name); }
    property <string> rule-app;
    property <int> rule-profile-idx: 0;
    // name-keyed delete arming (an index can drift when the model refreshes mid-arm)
    property <string> armed-delete: "";
    // name-keyed rename target, same reasoning
    property <string> renaming: "";
    // The sheet is built once and reopened, so a rename left open (or a delete left armed) would
    // still be there next time. Closing it is the "never mind" gesture — reset both. Mirrored into
    // a local property because `changed` needs one it owns.
    property <bool> sheet-open: State.profile-sheet-open;
    changed sheet-open => {
        if (!self.sheet-open) { root.renaming = ""; root.armed-delete = ""; }
    }
    Timer {
        interval: Theme.confirm-window;
        running: root.armed-delete != "";
        triggered => { root.armed-delete = ""; }
    }

    // ── header — the standard page frame (label + caption + a live active-state pill in the slot) ──
    PanelHead {
        label: "PROFILES";
        caption: "apply one, or capture what's live";
        // right-hand signal slot — the active profile's name, or nothing at all when none is active
        // (an absent pill says "none" more quietly than a badge that has to spell it out).
        if State.active-profile != "—" : Pill {
            text: State.profile-degraded-count > 0 ? State.active-profile + " · DEGRADED " + State.profile-degraded-count : State.active-profile;
            live: true;
        }
    }
    Divider {}
    Rectangle { height: Theme.lead-in; }

    // content — one vertical rhythm driven by layout spacing (no hand-tuned spacer rectangles)
    VerticalLayout {
        spacing: Theme.gap;

        if State.profile-degraded-count > 0 : VerticalLayout {
            spacing: 7px;
            Mono { text: "DEGRADED · " + State.profile-degraded-detail; color: Theme.warn; wrap: word-wrap; }
            Button { text: "retry profile"; clicked => { State.apply-profile(State.active-profile); State.profile-sheet-open = false; } }
        }

        // ── SAVED — the primary list (pick one to apply) ──
        HorizontalLayout {
            SectionTitle { text: "SAVED"; }
            Rectangle {}
            Mono { text: State.profiles.length + (State.profiles.length == 1 ? " profile" : " profiles"); color: Theme.text-faint; }
        }
        VerticalLayout {
            spacing: 6px;
            for p in State.profiles : ProfileMenuRow {
                p: p;
                armed: root.armed-delete == p.name;
                renaming: root.renaming == p.name;
                apply => { root.armed-delete = ""; State.apply-profile(p.name); State.profile-sheet-open = false; }
                arm-delete => { root.armed-delete = p.name; }
                confirm-delete => { root.armed-delete = ""; State.delete-profile(p.name); }
                begin-rename => { root.armed-delete = ""; root.renaming = p.name; }
            }
        }
        // RENAME — one editor for the whole list, shown only while a row is picked. It sits here,
        // not in the row, because creating an edit field inside the row that was just clicked
        // replaces the subtree the click is still travelling through, and Slint panics on that.
        if root.renaming != "" : HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Mono { text: "rename to"; color: Theme.text-dim; } }
            ren := Field {
                field-width: 220px;
                text: root.renaming;
                accepted(t) => {
                    if (t != "") { State.rename-profile(root.renaming, t); }
                    root.renaming = "";
                }
            }
            Button {
                text: "rename";
                primary: true;
                enabled: ren.text != "";
                clicked => { State.rename-profile(root.renaming, ren.text); root.renaming = ""; }
            }
            Button { text: "cancel"; clicked => { root.renaming = ""; } }
            Rectangle {}
        }
        // the live device read-back a capture freezes — the dpi/polling/brightness/lighting you already
        // dialed in on the Device and Lighting pages, surfaced so a capture is a confirmation, not data
        // entry. No section chrome or empty-state box: it reads as the "capture a new one" input beneath
        // the SAVED list (the 0-profiles count already states the emptiness).
        Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.well;
            border-width: Theme.hair; border-color: Theme.line;
            VerticalLayout {
                padding: 11px; spacing: 9px;
                HorizontalLayout {
                    spacing: 12px;
                    Mono { text: "LIVE"; color: Theme.accent-dim; font-size: Theme.fs-small; }
                    Stat { label: "dpi"; value: round(State.dpi); ink: Theme.text; }
                    Stat { label: "poll"; value: round(State.polling-hz) + " Hz"; ink: Theme.text; }
                    Stat { label: "bright"; value: round(State.brightness) + "%"; ink: Theme.text; }
                    if State.light-effect != "" : Stat { label: "light"; value: State.light-effect; ink: Theme.text; }
                    if State.gaming-live : Mono { text: "gaming"; color: Theme.accent; font-size: Theme.fs-small; }
                    Rectangle {}
                }
        // name + capture: the name is pre-filled from what you're doing right now (the focused app, else a
        // value descriptor), shown as the field's ghost text — an empty field captures under it.
        HorizontalLayout {
            spacing: 8px;
            Field {
                field-width: 400px;
                placeholder: State.profile-name-suggested != "" ? State.profile-name-suggested : "name";
                text <=> root.new-profile-name;
                // (the `changed effective-name` handler above answers the overwrite check — typing
                // updates new-profile-name → effective-name → that handler, so no per-edit call here)
                accepted(t) => {
                    if (root.effective-name != "") {
                        State.save-current-profile(root.effective-name);
                        root.new-profile-name = "";
                        State.profile-name-edited(root.effective-name); // re-check vs the now-updated list
                    }
                }
            }
            Button {
                text: State.profile-name-exists ? "overwrite" : "capture";
                primary: !State.profile-name-exists;
                danger: State.profile-name-exists;
                enabled: root.effective-name != "";
                clicked => {
                    State.save-current-profile(root.effective-name);
                    root.new-profile-name = "";
                    State.profile-name-edited(root.effective-name); // re-check vs the now-updated list
                }
            }
        }
            }
        }

        Divider {}

        // ── AUTO-SWITCH — route the focused app to a saved profile ──
        HorizontalLayout {
            spacing: 8px;
            SectionTitle { text: "AUTO-SWITCH BY APP"; }
            Rectangle {}
            // the live signal this routing switches on
            if State.focused-app != "" && State.focused-app != "—" : Stat { label: "now"; value: State.focused-app; }
        }
        // nothing to route to yet — reveal the whole apparatus only once a profile exists (no dead fields).
        // Only in the fully-empty state — with orphaned rules still listed below, "save a profile
        // first" would contradict the visible routes; there the del buttons speak for themselves.
        if State.profiles.length == 0 && State.app-rules.length == 0 : Mono { text: "save a profile first to route apps to it"; color: Theme.text-faint; }
        // Show the apparatus when there are rules OR profiles: a rule stays visible + deletable even
        // after the last profile is removed (rules aren't pruned on profile delete), so an orphaned
        // rule is never stranded with no UI path to remove it.
        if State.app-rules.length > 0 || State.profiles.length > 0 : VerticalLayout {
            spacing: Theme.gap;
            VerticalLayout {
                spacing: 6px;
                for r[i] in State.app-rules : rr := Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: Theme.well;
                    border-width: Theme.hair;
                    property <bool> routing: i == State.active-app-rule;
                    border-color: r.dangling ? Theme.danger.with-alpha(0.5)
                        : (self.routing ? Theme.accent-line : Theme.line);
                    animate border-color { duration: Theme.quick; }
                    rowta := TouchArea {}   // row-level hover so the delete stays quiet at rest
                    HorizontalLayout {
                        padding-left: 11px; padding-right: 7px; spacing: 8px;
                        // the closed-contact lamp: THIS rule is currently winning
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: Theme.dot; height: Theme.dot; border-radius: Theme.dot / 2;
                                background: rr.routing ? Theme.accent : Theme.line;
                                animate background { duration: Theme.quick; }
                            }
                        }
                        Mono { text: r.app; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                        Mono {
                            text: "→";
                            color: rr.routing ? Theme.accent : Theme.text-faint;
                            animate color { duration: Theme.quick; }
                        }
                        // a route whose target profile is gone can never fire — say so on the row
                        // instead of rendering it identically to a working one and failing silently
                        // at focus-switch time.
                        Mono { text: r.profile; color: r.dangling ? Theme.danger : Theme.text-mid; overflow: elide; }
                        if r.dangling : Mono { text: "gone"; color: Theme.danger; font-size: Theme.fs-small; }
                        // delete — the ONE idiom: an always-visible quiet ✕ (faint) that brightens to
                        // danger on hover, TouchArea always live (no opacity-0-until-hover corner).
                        VerticalLayout {
                            alignment: center;
                            IconButton { glyph: "\u{00d7}"; danger: true; clicked => { State.remove-app-rule(i); } }
                        }
                    }
                }
            }
            if State.app-rules.length == 0 : Mono { text: "no rules yet · match a focused app to a profile"; color: Theme.text-faint; }
            // WHEN NOTHING MATCHES — the other half of auto-switching. Without a fallback the last
            // profile a rule applied stays on after you close the game, which is why your DPI was
            // still at 400 in the browser. Off by default: neuron doesn't start switching profiles
            // on you until you name the one to come back to.
            // Unboxed: it isn't a route you can delete, it's where every unrouted app lands; its
            // columns (lamp, name, arrow, target) line up with the route rows above.
            if State.profiles.length > 0 : Rectangle {
                height: Theme.row-h;
                HorizontalLayout {
                    padding-left: 11px; padding-right: 0px; spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        // lit only when the fallback is BOTH in play (no rule matched) and
                        // resolvable — a fallback naming a profile that's gone is not routing
                        // anything, so it must not read as a closed contact.
                        Rectangle {
                            width: Theme.dot; height: Theme.dot; border-radius: Theme.dot / 2;
                            background: State.active-app-rule == -1 && State.fallback-index > 0 ? Theme.accent : Theme.line;
                            animate background { duration: Theme.quick; }
                        }
                    }
                    VerticalLayout { alignment: center; Mono { text: "anything else"; color: Theme.text-faint; } }
                    // apps.toml names a fallback that isn't a readable profile (hand-edited, or the
                    // file went bad). The picker resolves by name, so it would have quietly shown
                    // "stay put" while the setting on disk said otherwise.
                    if State.default-profile != "" && State.fallback-index == 0 : VerticalLayout {
                        alignment: center;
                        Mono { text: "'" + State.default-profile + "' is gone"; color: Theme.danger; font-size: Theme.fs-small; overflow: elide; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Mono {
                            text: "→";
                            color: State.active-app-rule == -1 && State.fallback-index > 0 ? Theme.accent : Theme.text-faint;
                            animate color { duration: Theme.quick; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        width: 130px;
                        Picker {
                            options: State.fallback-options;
                            index: State.fallback-index;
                            changed(i) => { State.set-default-profile(i == 0 ? "" : State.profile-names[i - 1]); }
                        }
                    }
                }
            }
            // add a rule — gated on having a profile to route to (no dead-end picker). The existing
            // rules above render unconditionally, so they stay deletable even with zero profiles.
            // One row, read left to right like a route: which app → which profile, then add. An
            // empty app field means the app in focus, shown as its ghost text.
            if State.profiles.length > 0 : composer := HorizontalLayout {
                spacing: 8px;
                property <bool> focus-known: State.focused-app != "—" && State.focused-app != "";
                property <string> app: root.rule-app != "" ? root.rule-app : (self.focus-known ? State.focused-app : "");
                Field {
                    field-width: 400px;
                    placeholder: composer.focus-known ? State.focused-app : "app name or part of it";
                    text <=> root.rule-app;
                }
                VerticalLayout { alignment: center; Mono { text: "→"; color: Theme.text-faint; } }
                VerticalLayout {
                    alignment: center;
                    width: 130px;
                    Picker {
                        options: State.profile-names;
                        index: root.rule-profile-idx;
                        changed(i) => { root.rule-profile-idx = i; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "add";
                        primary: true;
                        enabled: composer.app != "" && State.profile-names.length > 0;
                        clicked => {
                            State.add-app-rule(composer.app,
                                State.profile-names[min(root.rule-profile-idx, State.profile-names.length - 1)]);
                            root.rule-app = "";
                        }
                    }
                }
            }
        }
    }
}
