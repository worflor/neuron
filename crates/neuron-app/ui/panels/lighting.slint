import { Theme } from "../theme.slint";
import { Card, SectionTitle, Label, Button, Field, Mono, Divider, PanelHead, Contact, Pill, Slider, Segment, Toggle, SplitToggle, ColorPicker, Palette } from "../widgets/controls.slint";
import { DeviceRender } from "../widgets/render.slint";
import { State } from "../state.slint";
import { EffectTile, EffectParam } from "../models.slint";

// LIGHTING — ONE spatial surface. The render IS the page: the live device picture is the calm centre,
// the truth, and the paint surface. Everything orbits it.
//
// The paradigm is a single GRID of live-preview TILES — visual effects AND data modes together, each
// tile a tiny running preview of itself (the MATERIAL-card pattern). Picking a tile is one gesture: it
// plays on the render instantly and auto-renders one control per declared param inline (the weave-TUNE
// pattern — the effect's schema is DATA, the UI renders a control per row, zero per-effect UI code).
//
// Depth is spatial, not a menu. A single effect is the default (no layer ceremony). STACKING another
// effect is an optional, visible act — a light composite strip, never an add/select/restack list.
// PER-KEY PAINT is a brush you pick up ON the render (a gesture), never a top-level mode. There is no
// EFFECTS/PAINT toggle and no "advanced" drawer — knobs appear by relevance, not behind a reveal.
//
// SPATIAL COMPOSITION: the render is the calm hero up top (centred, constrained — it never stretches
// into a banner). Beneath it the page fills the width with TWO things side by side: the live tile
// GALLERY (LEFT, elastic — it widens its tiles to use whatever space the window gives) and, the moment
// a tile is picked, that effect's CONTEXTUAL controls slide in on the RIGHT (a fixed inspector column).
// With nothing picked the inspector takes no width at all and the gallery owns the whole row — so the
// page is a composed gallery, never a sparse one with a stranded empty third.

// One TILE in the grid — a live (or representative) preview swatch + its name, the MATERIAL-card
// pattern. `data` tiles (mouse battery) and the `stub` (notifications, future) read as first-class
// siblings of the effects; picking any of them is the SAME gesture.
component EffectTileCard inherits Rectangle {
    in property <EffectTile> tile;
    in property <bool> selected;
    in property <bool> dimmed;       // a stub (future) — shown, but visibly not-yet-wired
    callback picked();
    border-radius: Theme.radius;
    // ACTIVE > hover > rest. The selected tile wears a clear accent ground + line; a hovered tile
    // lifts to the well with a faint ink edge; everything else rests on the bezel plane.
    background: root.selected ? Theme.accent-glow
        : (ta.has-hover && !root.dimmed ? Theme.well-hi : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.selected ? Theme.accent-line
        : (ta.has-hover && !root.dimmed ? Theme.text-faint : Theme.line);
    animate background, border-color { duration: Theme.quick; }
    clip: true;
    opacity: root.dimmed ? 0.55 : 1.0;
    // a hovered tile rises a hair — a tactile pickup cue, settled not bouncy
    property <length> lift: (ta.has-hover && !root.dimmed && !root.selected) ? 1px : 0px;
    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;
        y: -root.lift;
        animate y { duration: Theme.quick; }
        // the live preview — the tile IS the effect, running (or a representative still for the stub).
        // Bigger now (0.58 of width) so the running preview is the prominent thing, not the label.
        Rectangle {
            height: parent.width * 0.58;
            border-radius: Theme.radius-sm;
            background: Theme.bg;
            border-width: Theme.hair;
            // the active tile's preview gets a faint accent frame so the lit show reads as chosen
            border-color: root.selected ? Theme.accent-line : Theme.line-soft;
            animate border-color { duration: Theme.quick; }
            clip: true;
            Image {
                source: root.tile.swatch;
                width: parent.width; height: parent.height;
                image-fit: fill;
            }
            // a tiny corner glyph marks a DATA tile (it shows your device, not a light show)
            if root.tile.kind == "data" : Mono {
                text: "DATA"; color: Theme.accent-dim; font-size: Theme.fs-small;
                x: parent.width - self.width - 5px; y: 4px;
            }
            // removed-until-wired: the "SOON" stub-tile glyph (kind == "stub"). Restore this branch
            // when the notifications-lighting surface ships and the stub tile returns to the catalog.
        }
        Text {
            text: root.tile.name;
            color: root.selected ? Theme.accent : (ta.has-hover && !root.dimmed ? Theme.text-mid : Theme.text-dim);
            font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
            letter-spacing: Theme.track-1;
            overflow: elide;
            animate color { duration: Theme.quick; }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.dimmed ? MouseCursor.default : MouseCursor.pointer;
        clicked => { if (!root.dimmed) { root.picked(); } }
    }
}

// One auto-rendered PARAM control. The effect's schema declares the row's `kind`; this renders the
// matching control (range→slider, enum→segment, color→swatch+field, toggle→switch). Adding a knob to
// an effect is DATA in effects::schema — never new UI here.
component ParamControl inherits VerticalLayout {
    in property <EffectParam> p;
    spacing: 6px;
    // RANGE → a labelled inline slider (label · track · readout), the weave-knobs row shape
    if root.p.kind == "range" : HorizontalLayout {
        spacing: 9px;
        VerticalLayout {
            alignment: center; width: 78px;
            Text { text: root.p.label; color: Theme.text-dim; font-family: Theme.mono; font-size: Theme.fs-small; overflow: elide; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Slider {
                compact: true; wheel: false;
                minimum: root.p.fmin; maximum: root.p.fmax; value: root.p.fval;
                step: (root.p.fmax - root.p.fmin) / 100;
                changed(v) => { State.set-param-range(root.p.key, v); }
            }
        }
        VerticalLayout {
            alignment: center; width: 40px;
            Text {
                text: round(root.p.fval * 100) / 100;
                color: Theme.text-mid; font-family: Theme.mono; font-size: Theme.fs-small;
                horizontal-alignment: right;
            }
        }
    }
    // ENUM → a pick-one segment (direction, breath flavour)
    if root.p.kind == "enum" : VerticalLayout {
        spacing: 6px;
        Mono { text: root.p.label; color: Theme.text-dim; }
        Segment {
            options: root.p.options;
            index: root.p.ival;
            min-seg: 52px;
            picked(i) => { State.set-param-enum(root.p.key, i); }
        }
    }
    // TOGGLE → a switch
    if root.p.kind == "toggle" : Toggle {
        caption: root.p.label;
        checked: root.p.bval;
        toggled(v) => { State.set-param-toggle(root.p.key, v); }
    }
    // COLOR is rendered by the page (it owns the swatch palette) — handled inline there, not here.
}

export component LightingPanel inherits VerticalLayout {
    spacing: 0;

    // the curated quick swatches live ONCE in `Palette.accent` (controls.slint), shared with the SYSTEM
    // accent picker so the two never drift — both the COLOUR ColorPicker and the PAINT swatch row use it.

    // the live mirror: while an effect/data tile is active and the brush is down, re-render the frame
    // onto the device render at the DEVICE's rate (the same math + time base the device runs) so the
    // preview steps in the same discrete frames the keyboard does. Honest "~ live"/"preview" badge.
    Timer {
        interval: max(33ms, 1000ms / max(1.0, State.light-fps));
        running: !State.light-brush-on && State.sel-can-light && State.grid-rows > 0 && State.light-effect != "";
        triggered => { State.preview-tick(); }
    }
    // animate the GRID swatches a touch slower (each tile is a Rust-side render — cheap but not free).
    Timer {
        interval: 90ms;
        running: State.sel-can-light && State.grid-rows > 0;
        triggered => { State.tile-preview-tick(); }
    }

    PanelHead {
        label: "LIGHTING";
        caption: State.selected-device-name;
        if State.writes-paused : VerticalLayout { alignment: center; Pill { text: "WRITES PAUSED"; tint: Theme.danger; } }
    }
    Rectangle { height: Theme.hair; background: Theme.line; }
    Rectangle { height: Theme.lead-in; }

    // ── no-lighting empty states — honest, terse, real info ───────────────
    if !State.sel-can-light : Rectangle {
        height: 300px;
        background: Theme.bg-2; border-radius: Theme.radius;
        border-width: Theme.hair; border-color: Theme.line;
        VerticalLayout {
            alignment: center; spacing: 6px;
            Mono {
                text: State.selected-device-name == "—" ? "no device selected" : State.selected-device-name + " has no lighting";
                color: Theme.text-dim; horizontal-alignment: center;
            }
            Mono {
                text: State.selected-device-name == "—" ? "pick a Razer device on DEVICE"
                    : "no addressable RGB on this channel — pick a keyboard or mouse on DEVICE";
                color: Theme.text-faint; horizontal-alignment: center; wrap: word-wrap;
            }
        }
    }
    if State.sel-can-light && State.grid-rows == 0 : Rectangle {
        height: 300px;
        background: Theme.bg-2; border-radius: Theme.radius;
        border-width: Theme.hair; border-color: Theme.line;
        VerticalLayout {
            alignment: center; spacing: 6px;
            Mono { text: "no lit device selected"; color: Theme.text-dim; horizontal-alignment: center; }
            Mono { text: "connect one, or pick another channel on DEVICE"; color: Theme.text-faint; horizontal-alignment: center; }
        }
    }

    // ── THE SURFACE: render hero (centred) → gallery + contextual inspector ─
    if State.sel-can-light && State.grid-rows > 0 : VerticalLayout {
        spacing: Theme.lead-in;

        // ── HERO: the render, centred + constrained so it stays a calm SUBJECT, not a banner. ──
        VerticalLayout {
            alignment: start;
            spacing: 7px;
            // status strip — the device geometry on the left, the honest "what this is" on the right.
            HorizontalLayout {
                Mono {
                    text: State.selected-device-name + " · " + State.grid-rows + " × " + State.grid-cols + " led";
                    color: Theme.text-faint;
                    overflow: elide; horizontal-stretch: 1;
                }
                if State.compositing : Mono { text: "~ live on device"; color: Theme.accent-dim; }
                if !State.compositing && !State.light-brush-on && State.light-effect != "" : Mono {
                    text: "preview only"; color: Theme.text-faint;
                }
                if State.light-brush-on : Mono { text: "brush down · L paint · R erase · drag sweeps"; color: Theme.accent; }
            }
            // the render itself — capped to a comfortable subject width and centred on the void so it
            // reads as the page's calm subject instead of stretching edge-to-edge into a banner.
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(parent.width, 760px);
                    height: 280px;
                    DeviceRender {
                        width: 100%; height: 100%;
                        rows: State.grid-rows;
                        cols: State.grid-cols;
                        px: State.grid-px;
                        kind: State.grid-kind;
                        editable: State.light-brush-on;
                        paint(i) => { State.paint-cell(i); }
                        erase(i) => { State.erase-cell(i); }
                    }
                }
            }
        }

        // ── GALLERY + INSPECTOR — fills the width. The gallery is elastic (it widens its tiles to
        // use the room); the inspector slides in only once a tile is picked, and takes no width at
        // all when nothing is — so the empty page is a full-width gallery, never a stranded third. ──
        HorizontalLayout {
            spacing: State.light-effect == "" ? 0px : Theme.gap-col;

            // ── the ONE grid of live-preview tiles (effects + data + stub) ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 11px;
                HorizontalLayout {
                    SectionTitle { text: "EFFECTS & DATA"; }
                    Rectangle {}
                    Button { text: "import .ChromaEffects"; clicked => { State.import-light-file(); } }
                }
                // the grid — a RESPONSIVE column count (the tiles stay a comfortable size and the row
                // adds columns as the window widens), arithmetic placement (the MATERIAL-grid pattern).
                tilegrid := Rectangle {
                    property <length> gap: 9px;
                    // aim ~150px wide tiles; clamp the column count to 3..6 so they never get tiny on a
                    // wide window nor cramped on a narrow one.
                    property <int> cols: clamp(floor((self.width + self.gap) / (150px + self.gap)), 3, 6);
                    property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                    property <length> th: self.cw * 0.58 + 42px;   // preview (0.58 of width) + name row + padding
                    property <int> nrows: ceil(State.light-tiles.length / self.cols);
                    height: self.nrows * self.th + max(0, self.nrows - 1) * self.gap;
                    for t[i] in State.light-tiles : EffectTileCard {
                        tile: t;
                        selected: t.slug == State.light-effect;
                        dimmed: t.kind == "stub";
                        x: mod(i, tilegrid.cols) * (tilegrid.cw + tilegrid.gap);
                        y: floor(i / tilegrid.cols) * (tilegrid.th + tilegrid.gap);
                        width: tilegrid.cw;
                        height: tilegrid.th;
                        picked => { State.pick-tile(t.slug); }
                    }
                }
            }

            // ── the active tile's CONTEXTUAL controls — a fixed inspector column that appears the
            // instant a tile is picked (the page coming alive in place). No width when nothing's on. ──
            if State.light-effect != "" : VerticalLayout {
                width: 332px;
                horizontal-stretch: 0;
                spacing: 14px;

                // RATE — the streamed effect's frame pacing. Drives BOTH the live device stream AND
                // this preview, so what you see steps at the keyboard's TRUE rate. Gated to EFFECT
                // mode: a DATA readout paints on-demand, so it has no rate to tune.
                if !State.light-is-data : VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        SectionTitle { text: "RATE"; }
                        Rectangle {}
                        Mono { text: round(State.light-fps) + " fps"; color: Theme.text-mid; }
                    }
                    Slider {
                        compact: true; wheel: false;
                        minimum: 1; maximum: 30; step: 1;
                        value: State.light-fps;
                        changed(v) => { State.set-light-fps(v); }
                    }
                    if State.light-fps-legacy : Mono {
                        text: "legacy board · ~6 fps before frames drop";
                        color: Theme.text-faint; wrap: word-wrap;
                    }
                }

                // COLOUR — only when the active effect declares a colour knob (default = weave accent).
                // The SHARED prism-based ColorPicker (same component the SYSTEM page uses for its accents):
                // a swatch / hex Enter COMMITS via set-param-color, and dragging the PRISM (or typing)
                // fires `preview` — also set-param-color — so the running effect RECOLOURS live as you
                // drag, the render updating in real time before you ever release.
                if State.light-uses-color : VerticalLayout {
                    spacing: 9px;
                    SectionTitle { text: "COLOUR"; }
                    ColorPicker {
                        current: State.light-color-col;
                        value: State.light-color-hex;
                        swatches: Palette.accent;
                        pick(h) => { State.set-param-color(h); }
                        preview(h) => { State.set-param-color(h); }   // live recolour while dragging the prism
                    }
                }

                // TUNE — the rest of the schema's knobs, auto-rendered (range/enum/toggle). A data tile
                // (mouse battery) declares none, so this whole block simply doesn't appear — honest.
                if State.light-params.length > 0 : VerticalLayout {
                    spacing: 9px;
                    SectionTitle { text: "TUNE"; }
                    for cp in State.light-params : VerticalLayout {
                        // skip colour (rendered above); render every other declared param
                        if cp.kind != "color" : ParamControl { p: cp; }
                    }
                }
                // a data tile is honest about being a readout, not a tunable light show
                if State.light-params.length == 0 && !State.light-uses-color : Mono {
                    text: "a live DATA surface — it paints your device's vitals, no knobs.";
                    color: Theme.text-faint; wrap: word-wrap;
                }

                Divider {}

                // ── STACK — the optional spatial composite (light, not a list) ──
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        SectionTitle { text: "STACK"; }
                        Rectangle {}
                        Mono {
                            text: State.light-stack-count <= 1 ? "single" : State.light-stack-count + " layers";
                            color: Theme.text-faint;
                        }
                    }
                    // the composite strip — one cell per stacked effect, bottom→top left→right. The
                    // active cell is lit; tapping a cell makes it the active effect (knobs follow); ✕ drops it.
                    if State.light-stack-count > 1 : HorizontalLayout {
                        spacing: 6px;
                        for li in State.light-stack-count : cell := Rectangle {
                            property <bool> on: li == State.selected-layer;
                            height: 30px; min-width: 60px; horizontal-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: cell.on ? Theme.accent-glow : (sta.has-hover ? Theme.well-hi : Theme.bg-2);
                            border-width: Theme.hair;
                            border-color: cell.on ? Theme.accent-line : (sta.has-hover ? Theme.text-faint : Theme.line);
                            animate background, border-color { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 9px; padding-right: 7px; spacing: 5px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Mono { text: "L" + (li + 1); color: cell.on ? Theme.accent : Theme.text-mid; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "✕";
                                        color: xta.has-hover ? Theme.danger : Theme.text-faint;
                                        font-family: Theme.mono; font-size: Theme.fs-small;
                                        vertical-alignment: center;
                                        animate color { duration: Theme.quick; }
                                        xta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { State.remove-stack(li); } }
                                    }
                                }
                            }
                            sta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { State.select-stack(li); } }
                        }
                    }
                    Button {
                        text: "+ stack this effect";
                        clicked => { State.stack-current(); }
                    }
                }

                Divider {}

                // ── PAINT — a brush you pick up ON the render (a gesture, not a mode) ──
                VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        SectionTitle { text: "PAINT"; }
                        Rectangle {}
                        Button {
                            text: State.light-brush-on ? "put brush down" : "pick up brush";
                            primary: State.light-brush-on;
                            clicked => { State.toggle-brush(); }
                        }
                    }
                    if State.light-brush-on : VerticalLayout {
                        spacing: 9px;
                        HorizontalLayout {
                            spacing: 9px;
                            Rectangle {
                                width: 30px; height: 30px; border-radius: Theme.radius-sm;
                                border-width: Theme.hair; border-color: Theme.line;
                                background: State.brush-color;
                            }
                            Field {
                                field-width: 120px;
                                placeholder: "4AF2B0";
                                text: State.light-color;
                                invalid: !State.light-color-valid;
                                edited(t) => { State.light-color = t; State.color-changed(t); }
                            }
                            Rectangle {}
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            for sw in Palette.accent : Rectangle {
                                width: 26px; height: 26px; border-radius: Theme.radius-sm;
                                border-width: Theme.hair;
                                border-color: sw.hex == State.light-color ? Theme.accent-line : (pswta.has-hover ? Theme.text-faint : Theme.line-soft);
                                background: sw.col;
                                animate border-color { duration: Theme.quick; }
                                pswta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { State.light-color = sw.hex; State.color-changed(sw.hex); } }
                            }
                            Rectangle {}
                        }
                        HorizontalLayout {
                            spacing: 7px;
                            Button { text: "fill"; clicked => { State.fill-grid(); } }
                            Button { text: "clear"; danger: true; clicked => { State.clear-grid(); } }
                            Button { text: "push frame"; primary: true; enabled: !State.writes-paused; clicked => { State.push-painted(); } }
                            Rectangle {}
                        }
                    }
                }

                Divider {}

                // ── APPLY — push the live surface to the device ──
                HorizontalLayout {
                    spacing: 7px;
                    Button {
                        text: State.compositing ? "restart" : "apply live";
                        primary: true;
                        enabled: !State.writes-paused;
                        clicked => { State.composite-apply(); }
                    }
                    Button { text: "stop"; danger: true; enabled: State.compositing; clicked => { State.composite-stop(); } }
                    Rectangle {}
                }
            }
        }
    }
}
