import { Theme, Signal } from "../theme.slint";
import { ChromaLab } from "chromalab.slint";
import { Card, SectionTitle, SubLabel, Label, Button, Field, Mono, Divider, PanelHead, Contact, Pill, Slider, Toggle, SplitToggle, SplitButton, IconButton, ColorPicker, SwatchRow, Palette, SelectableRow, GuideButton, FaderRow } from "../widgets/controls.slint";
import { DeviceRender } from "../widgets/render.slint";
import { State } from "../state.slint";
import { EffectTile, EffectParam } from "../models.slint";

// LIGHTING — ONE spatial surface. The render IS the page: the live device picture is the calm centre,
// the truth, and the paint surface. Everything orbits it.
//
// The paradigm is a single GRID of live-preview TILES — visual effects AND data modes together, each
// tile a tiny running preview of itself (the MATERIAL-card pattern). Picking a tile is one gesture: it
// plays on the render instantly and auto-renders one control per declared param inline (the weave-TUNE
// pattern — the effect's schema is DATA, the UI renders a control per row, zero per-effect UI code).
//
// Depth is spatial, not a menu. A single effect is the default (no layer ceremony). STACKING another
// effect is an optional, visible act — a light composite strip, never an add/select/restack list.
// PER-KEY PAINT is a brush you pick up ON the render (a gesture), never a top-level mode. There is no
// EFFECTS/PAINT toggle and no "advanced" drawer — knobs appear by relevance, not behind a reveal.
//
// SPATIAL COMPOSITION: the render is the calm hero up top (centred, constrained — it never stretches
// into a banner). Beneath it the page fills the width with TWO things side by side: the live tile
// GALLERY (LEFT, elastic — it widens its tiles to use whatever space the window gives) and, the moment
// a tile is picked, that effect's CONTEXTUAL controls slide in on the RIGHT (a fixed inspector column).
// With nothing picked the inspector takes no width at all and the gallery owns the whole row — so the
// page is a composed gallery, never a sparse one with a stranded empty third.

// One TILE in the grid — a live (or representative) preview swatch + its name, the MATERIAL-card
// pattern. `data` tiles (mouse battery) and the `stub` (notifications, future) read as first-class
// siblings of the effects; picking any of them is the SAME gesture.
component EffectTileCard inherits Rectangle {
    in property <EffectTile> tile;
    in property <bool> selected;
    in property <bool> dimmed;       // a stub (future) — shown, but visibly not-yet-wired
    // Saved effects require a second click to delete. The trailing TouchArea owns the corner
    // so pressing it cannot also load the effect.
    in property <bool> deletable: false;
    property <bool> delete-armed: false;
    callback picked();
    callback delete-requested();
    border-radius: Theme.radius;
    // ACTIVE > hover > rest. The selected tile wears a clear accent ground + line; a hovered tile
    // lifts to the well with a faint ink edge; everything else rests on the bezel plane.
    background: root.selected ? Theme.accent-glow
        : (ta.has-hover && !root.dimmed ? Theme.well-hi : Theme.bg-2);
    border-width: Theme.hair;
    border-color: root.selected ? Theme.accent-line
        : (ta.has-hover && !root.dimmed ? Theme.text-faint : Theme.line);
    animate background, border-color { duration: Theme.quick; }
    clip: true;
    opacity: root.dimmed ? 0.55 : 1.0;
    // a hovered tile rises a hair — a tactile pickup cue, settled not bouncy
    property <length> lift: (ta.has-hover && !root.dimmed && !root.selected) ? 1px : 0px;
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        alignment: start;
        y: -root.lift;
        animate y { duration: Theme.quick; }
        // the live preview — the tile IS the effect, running (or a looping demo for a fed look).
        Rectangle {
            height: parent.width * 0.52;
            border-radius: Theme.radius-sm;
            background: Theme.bg;
            border-width: Theme.hair;
            // the active tile's preview gets a faint accent frame so the lit show reads as chosen
            border-color: root.selected ? Theme.accent-line : Theme.line-soft;
            animate border-color { duration: Theme.quick; }
            clip: true;
            Image {
                source: root.tile.swatch;
                width: parent.width; height: parent.height;
                image-fit: fill;
            }
            // the FEED chip — a fed tile names its real-world source right on the art ("KEYS",
            // "AUDIO", "BATTERY", "OBS", …). Dim chrome on a grounded scrap of void so it stays
            // legible over any colour without shouting; a pure light show carries no chip.
            if root.tile.source != "" : Rectangle {
                x: parent.width - self.width - 4px; y: 4px;
                width: chip.preferred-width + 10px;
                height: chip.preferred-height + 5px;
                border-radius: 2px;
                background: Theme.bg.with-alpha(0.78);
                border-width: Theme.hair;
                border-color: Theme.line;
                chip := Mono {
                    text: root.tile.source.to-uppercase();
                    color: Theme.text-dim; font-size: Theme.fs-small;
                    letter-spacing: Theme.track-2;
                }
            }
            // removed-until-wired: the "SOON" stub-tile glyph (kind == "stub"). Restore this branch
            // when the notifications-lighting surface ships and the stub tile returns to the catalog.
        }
        Text {
            text: root.tile.name;
            color: root.selected ? Theme.accent : (ta.has-hover && !root.dimmed ? Theme.text-mid : Theme.text-dim);
            font-family: Theme.mono; font-size: Theme.fs-small; font-weight: 700;
            letter-spacing: Theme.track-1;
            overflow: elide;
            animate color { duration: Theme.quick; }
        }
        // the one plain-words line — what this look IS. Always visible (a catalog you can read,
        // not a guessing wall); two lines of quiet ink, clipped by the card's fixed height.
        Text {
            text: root.tile.blurb;
            color: ta.has-hover && !root.dimmed ? Theme.text-dim : Theme.text-faint;
            font-family: Theme.mono; font-size: Theme.fs-small;
            wrap: word-wrap;
            overflow: elide;
            animate color { duration: Theme.quick; }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.dimmed ? MouseCursor.default : MouseCursor.pointer;
        clicked => { if (!root.dimmed) { root.picked(); } }
    }
    // SUGGESTED GRADIENTS — a capsule on the art that opens in place into the rest of its pairings.
    // The pill's left edge never moves; it only grows rightward, so hovering never shifts the first
    // capsule under the pointer. Everything is arithmetic over ONE touch area (outside any `for`, so
    // the tick's row rewrites can't kill it): the hovered capsule is derived from the mouse x.
    if root.tile.pairs.length > 0 && !root.dimmed : pairs := Rectangle {
        property <length> cw: 18px;
        property <length> gap: 3px;
        property <length> pad: 4px;
        property <length> rowh: 13px;
        property <length> labh: 13px;
        property <int> n: root.tile.pairs.length;
        // the widest the pill may grow: the art's width minus a margin each side
        property <length> avail: root.width - 12px - 20px;
        // one row + the name inline when it all fits, else a row/grid of capsules under a name line
        // sized by the longest possible name, NOT the hovered one, so the width can't depend on `hov`
        property <length> inline-w: self.pad * 2 + self.n * (self.cw + self.gap) + measure.preferred-width;
        property <bool> stacked: self.inline-w > self.avail;
        property <int> cols: self.stacked ? max(1, Math.floor((self.avail - self.pad * 2 + self.gap) / (self.cw + self.gap))) : self.n;
        property <int> rows: Math.ceil(self.n / self.cols);
        property <length> open-w: self.stacked ? max(self.pad * 2 + min(self.n, self.cols) * (self.cw + self.gap) - self.gap, min(self.avail, self.pad * 2 + measure.preferred-width)) : self.inline-w;
        property <length> open-h: 18px + (self.stacked ? self.labh + (self.rows - 1) * self.rowh : 0px);
        property <length> lab-off: self.stacked ? self.labh : 0px;
        property <bool> open: pta.has-hover;
        // closed: a slice of up to three capsules in one row (+ a plus when there are more); the grid
        // geometry above only applies while open, or a stacked pill would push them out of view
        property <int> shown: min(self.n, 3);
        property <length> plus-w: self.n > 3 ? 11px : 0px;
        property <length> closed-w: self.pad * 2 + self.shown * (self.cw + self.gap) - self.gap + self.plus-w;
        property <int> hov: self.open ? max(0, min(self.n - 1,
            Math.floor((pta.mouse-y - self.lab-off - 2px) / self.rowh) * self.cols
            + max(0, min(self.cols - 1, Math.floor((pta.mouse-x - self.pad) / (self.cw + self.gap)))))) : 0;
        x: 10px;
        // bottom edge pinned: the pill grows upward over the art, the first capsule never moves
        y: 6px + (root.width - 12px) * 0.52 - 5px - self.height;
        height: self.open ? self.open-h : 18px;
        width: self.open ? self.open-w : self.closed-w;
        animate width, height { duration: 200ms; easing: ease-out; }
        border-radius: 3px;
        background: Theme.bg.with-alpha(0.88);
        border-width: Theme.hair;
        border-color: pta.has-hover ? Theme.text-faint : Theme.line;
        animate border-color { duration: Theme.quick; }
        clip: true;
        for p[i] in root.tile.pairs : Rectangle {
            x: pairs.pad + (pairs.open ? mod(i, pairs.cols) : i) * (pairs.cw + pairs.gap);
            y: (pairs.open ? pairs.lab-off + floor(i / pairs.cols) * pairs.rowh + (pairs.rowh - self.height) / 2 + 2px : (18px - self.height) / 2);
            width: pairs.cw;
            height: (pta.has-hover && i == pairs.hov) ? 11px : 8px;
            opacity: (pairs.open || i < pairs.shown) ? 1.0 : 0.0;
            animate x, y { duration: 200ms; easing: ease-out; }
            animate height, opacity { duration: Theme.quick; }
            border-radius: 2px;
            clip: true;
            Image { source: p.swatch; width: 100%; height: 100%; image-fit: fill; }
        }
        Mono {
            x: pairs.pad + pairs.shown * (pairs.cw + pairs.gap) - 1px;
            y: (18px - self.height) / 2;
            text: "+";
            color: Theme.text-dim; font-size: Theme.fs-small;
            opacity: (!pairs.open && pairs.n > 3) ? 1.0 : 0.0;
            animate opacity { duration: Theme.quick; }
        }
        measure := Mono { text: "with bubble on matrix"; font-size: Theme.fs-small; visible: false; }
        lbl := Mono {
            x: pairs.stacked ? pairs.pad : pairs.pad + pairs.n * (pairs.cw + pairs.gap);
            y: pairs.stacked ? 2px : (18px - self.height) / 2;
            text: "with " + root.tile.pairs[pairs.hov].name;
            color: Theme.text-dim; font-size: Theme.fs-small;
            opacity: pta.has-hover ? 1.0 : 0.0;
            animate opacity { duration: 200ms; }
        }
        pta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { State.pick-pair(root.tile.slug, root.tile.pairs[pairs.hov].pair); }
        }
    }
    Timer {
        interval: 3s;
        running: root.delete-armed;
        triggered => { root.delete-armed = false; }
    }
    if root.deletable : IconButton {
        x: parent.width - self.width - 3px;
        y: 3px;
        glyph: root.delete-armed ? "?" : "\u{00d7}";
        danger: root.delete-armed;
        clicked => {
            if (root.delete-armed) { root.delete-requested(); }
            else { root.delete-armed = true; }
        }
    }
}

// One SHELF of the catalog: a quiet header naming the family + what feeds it, then the responsive
// arithmetic tile grid (the MATERIAL-grid pattern — tiles stay a comfortable size, the row adds
// columns as the window widens). Same tile grammar on every shelf; the grouping is the information.
component TileShelf inherits VerticalLayout {
    in property <string> title;
    in property <string> caption;
    in property <[EffectTile]> tiles;
    // A second selection id this shelf also honours. The built-in shelves leave it empty and light off
    // `State.light-effect` alone; the YOUR-EFFECTS shelf passes the loaded saved-effect slug, because a
    // loaded user effect reports `light-effect` as its TOP LAYER's preset — which is a different tile.
    in property <string> selected-extra: "";
    in property <bool> deletable: false;
    callback delete-requested(string);
    spacing: 8px;
    HorizontalLayout {
        spacing: 9px;
        SubLabel { text: root.title; }
        VerticalLayout {
            alignment: center;
            Mono { text: root.caption; color: Theme.text-faint; font-size: Theme.fs-small; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    shelfgrid := Rectangle {
        property <length> gap: 9px;
        // aim ~170px wide tiles; clamp the column count to 3..6 so they never get tiny on a
        // wide window nor cramped on a narrow one.
        property <int> cols: clamp(floor((self.width + self.gap) / (170px + self.gap)), 3, 6);
        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
        // preview (0.52 of width) + name row + two blurb lines + paddings
        property <length> th: self.cw * 0.52 + 64px;
        property <int> nrows: ceil(root.tiles.length / self.cols);
        height: self.nrows * self.th + max(0, self.nrows - 1) * self.gap;
        for t[i] in root.tiles : EffectTileCard {
            tile: t;
            selected: t.slug == State.light-effect || t.slug == root.selected-extra;
            dimmed: t.kind == "stub";
            deletable: root.deletable;
            x: mod(i, shelfgrid.cols) * (shelfgrid.cw + shelfgrid.gap);
            y: floor(i / shelfgrid.cols) * (shelfgrid.th + shelfgrid.gap);
            width: shelfgrid.cw;
            height: shelfgrid.th;
            picked => { State.pick-tile(t.slug); }
            delete-requested => { root.delete-requested(t.slug); }
        }
    }
}

// One VISITOR lane — the blend instrument an external painter class gets (Chroma games / OpenRGB
// tools). ONE component used twice so the two lanes are provably the same instrument and the
// side-by-side symmetry can't drift. FEEL picks the blend, STRENGTH scales it, FADE eases the
// hand-back; the blurb translates the picked mode into plain words.
component VisitorLane inherits VerticalLayout {
    in property <string> title;
    in property <int> mode;
    in property <float> strength;
    in property <float> fade;
    in property <string> blurb;
    callback mode-picked(int);
    callback strength-changed(float);
    callback fade-changed(float);
    spacing: 8px;
    horizontal-stretch: 1;
    SubLabel { text: root.title; }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { width: 76px; alignment: center; Mono { text: "feel"; color: Theme.text-dim; } }
        SplitToggle {
            options: ["REPLACE", "MERGE", "BOOST", "TINT"];
            min-cell: 56px;
            index: root.mode;
            picked(i) => { root.mode-picked(i); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    FaderRow {
        label: "strength"; unit: "%"; readout-w: 56px;
        minimum: 0; maximum: 100; step: 5;
        value: root.strength;
        changed(v) => { root.strength-changed(v); }
    }
    FaderRow {
        label: "fade"; unit: "ms"; readout-w: 56px;
        minimum: 0; maximum: 2500; step: 50;
        value: root.fade;
        changed(v) => { root.fade-changed(v); }
    }
    Mono { text: root.blurb; color: Theme.text-faint; wrap: word-wrap; }
}

// The editor's fine-grained fader row: the SPECTRUM editor's continuous knobs (motion
// speed/depth/chaos, frame hold/fade) AND the auto-rendered TUNE param ranges (via ParamControl).
// `label-w` sizes the label cell (wider for the longer TUNE param names); the change is live.
component SpecSlider inherits FaderRow {
    label-w: 66px;
    readout-w: 48px;
    step: 0.02;
    decimals: 2;
    spacing: 9px;
}

// One auto-rendered PARAM control. The effect's schema declares the row's `kind`; this renders the
// matching control (range→slider, enum→segment, color→swatch+field, toggle→switch). Adding a knob to
// an effect is DATA in effects::schema — never new UI here.
component ParamControl inherits VerticalLayout {
    in property <EffectParam> p;
    spacing: 6px;
    // RANGE → the shared SpecSlider row (label · track · readout) — the same instrument the SPECTRUM
    // editor uses, with a wider label cell for the longer param names.
    if root.p.kind == "range" : SpecSlider {
        label: root.p.label;
        label-w: 78px;
        minimum: root.p.fmin;
        maximum: root.p.fmax;
        step: (root.p.fmax - root.p.fmin) / 100;
        value: root.p.fval;
        changed(v) => { State.set-param-range(root.p.key, v); }
    }
    // ENUM → a pick-one fused rail (direction, breath flavour)
    if root.p.kind == "enum" : VerticalLayout {
        spacing: 6px;
        Mono { text: root.p.label; color: Theme.text-dim; }
        HorizontalLayout {
            SplitToggle {
                options: root.p.options;
                index: root.p.ival;
                min-cell: 52px;
                picked(i) => { State.set-param-enum(root.p.key, i); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    // TOGGLE → a switch
    if root.p.kind == "toggle" : Toggle {
        caption: root.p.label;
        checked: root.p.bval;
        toggled(v) => { State.set-param-toggle(root.p.key, v); }
    }
    // COLOR is rendered by the page (it owns the swatch palette) — handled inline there, not here.
}

// THE SPECTRUM EDITOR — the active layer's COLOUR PROGRAM (a layer = PATTERN × SPECTRUM; the pattern's
// knobs auto-render in TUNE, this block owns the colour). Three stacked instruments over the phase-3
// State spectrum surface: the GRADIENT STRIP (the active palette's stops), the MOTION row (the palette's
// intra-frame animation), and the collapsible TIMELINE (the keyframe sequence). Every control writes
// straight through a State.* callback — the glue applies it to the layer, and the live preview + the
// per-device persistence follow. No colour is hardcoded: stops carry their own hex/col, the picker is
// the shared prism, and the strip's gradient fill is a Rust-rendered swatch (the active frame's image).
component SpectrumEditor inherits VerticalLayout {
    spacing: Theme.gap;
    // which stop the picker edits — the AUTHORITATIVE cursor lives in State (`light-sel-stop`) so the
    // glue can select a stop after an insert: click/drag in the strip write it; `add-stop`'s glue points
    // it at the just-inserted stop. Clamped to the live count here so a delete never strands the picker.
    property <int> stop-idx: min(max(0, State.light-sel-stop), max(0, State.light-stops.length - 1));
    // the active frame (the scrubber position) the strip + motion + per-frame controls all edit. INVARIANT:
    // `frame-idx` is a valid index ONLY when the sequence has a frame — an empty seq yields 0, and EVERY
    // reader/writer that indexes `light-seq[frame-idx]` (the strip Image, `ease-idx`, and the per-frame
    // hold / crossfade / ease controls) is gated on the SAME condition — `State.light-seq.length > 0`, the
    // real model length and the single source of truth — so the index is never dereferenced when empty and
    // no phantom-frame write is possible. `tl-open` is the timeline's open/collapsed disclosure ONLY; it
    // never guards indexing.
    property <int> frame-idx: State.light-seq.length > 0
        ? min(max(0, State.light-active-frame), State.light-seq.length - 1)
        : 0;
    // the surface speaks strings (motion / loop / ease); the fused rails speak indices — map both ways.
    property <int> motion-idx:
        State.light-motion == "drift" ? 1 :
        State.light-motion == "cycle" ? 2 :
        State.light-motion == "breathe" ? 3 :
        State.light-motion == "flow" ? 4 : 0;
    property <int> loop-idx:
        State.light-loop == "once" ? 0 :
        State.light-loop == "pingpong" ? 2 : 1;
    property <int> interp-idx: State.light-interp == "hsv" ? 1 : 0;
    // gated on a non-empty sequence so the index is never dereferenced on an empty model (stated
    // invariant, not Slint's silent default-struct fallback). Empty → linear (0), the harmless default.
    property <int> ease-idx: State.light-seq.length > 0
        ? (State.light-seq[root.frame-idx].ease == "smooth" ? 1
            : State.light-seq[root.frame-idx].ease == "snap" ? 2 : 0)
        : 0;
    // the timeline is collapsed for a single palette; it expands on demand or when a sequence exists.
    property <bool> tl-open: false;

    // ── GRADIENT STRIP — the active palette's stops ──────────────────────
    VerticalLayout {
        spacing: 9px;
        HorizontalLayout {
            spacing: 8px;
            SectionTitle { text: "SPECTRUM"; }
            // the book button — opens the SPECTRUM + MOTION guide (what a stop is, the motion kinds)
            VerticalLayout { alignment: center; GuideButton { guide-id: "spectrum"; } }
            // the palette's name, painted in the palette itself; hovering lets the gradient drift
            // through the letters and settle back. Character i samples the mirrored ramp at
            // (i/n + phase), so the wrap is seamless.
            if State.light-name-chars.length > 0 : name-hit := Rectangle {
                property <int> m: State.light-name-ramp.length;
                property <float> phase: nta.has-hover ? 0.5 : 0.0;
                animate phase { duration: 1400ms; easing: ease-in-out; }
                HorizontalLayout {
                    spacing: 0px;
                    Mono { text: "– "; color: Theme.text-faint; }
                    for ch[i] in State.light-name-chars : Mono {
                        property <float> pos: mod((i / max(State.light-name-chars.length, 1) * 0.5 + name-hit.phase) * name-hit.m, name-hit.m);
                        property <int> j: Math.floor(self.pos);
                        color: State.light-name-ramp[self.j].mix(State.light-name-ramp[mod(self.j + 1, name-hit.m)], 1 - (self.pos - self.j));
                        text: ch;
                    }
                }
                nta := TouchArea {}
            }
            Rectangle {}
            // no stop-count here: "stop N of M" under the strip already carries the total —
            // the same number twice in 75px, in two grammars, read as unconsidered.
        }
        // the strip: the Rust-rendered gradient of the ACTIVE frame's palette, with stop handles
        // overlaid. ONE touch surface owns every gesture — press grabs the nearest handle (or adds
        // a stop on open track, glue hit-tests) and the drag repositions it live, full-width, in
        // one smooth motion. The handles themselves are pure VISUALS: a touch area inside the
        // `for` dies the instant an edit rebuilds the stops model (every move does), which was the
        // old one-millimeter-per-grab jank — the strip's own area survives every rebuild.
        strip := Rectangle {
            height: 34px;
            border-radius: Theme.radius-sm;
            border-width: Theme.hair;
            border-color: Theme.line;
            background: Theme.well;
            clip: true;
            // the live gradient fill — the ACTIVE frame's palette swatch. Gated on a non-empty sequence
            // so the index is never dereferenced when the model is empty (stated invariant, not fallback).
            if State.light-seq.length > 0 : Image {
                source: State.light-seq[root.frame-idx].swatch;
                width: 100%; height: 100%;
                image-fit: fill;
            }
            strip-ta := TouchArea {
                mouse-cursor: MouseCursor.ew-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        State.strip-press(clamp(self.mouse-x / strip.width, 0.0, 1.0));
                    }
                }
                moved => {
                    if (self.pressed) {
                        State.move-stop(State.light-sel-stop, clamp(self.mouse-x / strip.width, 0.0, 1.0));
                    }
                }
            }
            for s[i] in State.light-stops : handle := Rectangle {
                property <bool> on: i == root.stop-idx;
                width: 16px;
                height: parent.height;
                x: clamp(s.at * strip.width - self.width / 2, 0px, strip.width - self.width);
                background: handle.on ? Theme.accent-glow : transparent;
                border-width: handle.on ? Theme.hair : 0px;
                border-color: Theme.accent-line;
                border-radius: 2px;
                // the colour chip — a grounded, ringed marker (bigger than the old 9px speck) so it reads
                // as a handle you grab, not a dot floating on the gradient. The selected one is larger with
                // a crisp white ring; the rest carry a subtle ring that keeps them legible on any colour.
                Rectangle {
                    width: handle.on ? 14px : 11px; height: self.width; border-radius: self.width / 2;
                    y: 4px; x: (parent.width - self.width) / 2;
                    background: s.col;
                    border-width: handle.on ? Theme.hair-2 : Theme.hair;
                    border-color: handle.on ? Theme.text : Theme.text-faint;
                }
                // the stem — ONLY the SELECTED stop drops a cursor line down the strip, marking the column
                // it controls. Unselected stops are just their chip, so the gradient stays clean instead of
                // a forest of thin tendrils (the part that read as "spooky").
                if handle.on : Rectangle {
                    width: 2px;
                    height: parent.height - 19px;
                    y: 19px; x: (parent.width - self.width) / 2;
                    background: Theme.accent;
                }
            }
        }
        // add/remove + the active-stop readout, the coupled pair fused into one deck: the destructive
        // REMOVE half wears danger ink on the left, the constructive ADD half sits right. The remove
        // half goes visibly DEAD at the last stop (left-enabled) — never a live-looking key that no-ops.
        HorizontalLayout {
            spacing: 7px;
            SplitButton {
                left-text: "− remove";
                left-enabled: State.light-stops.length > 1;
                right-text: "+ add";
                left-clicked => { State.remove-stop(root.stop-idx); }
                right-clicked => { State.add-stop(0.5); }
            }
            Rectangle { horizontal-stretch: 1; }
            Mono { text: "stop " + (root.stop-idx + 1) + " of " + State.light-stops.length; color: Theme.text-faint; }
        }
        // the selected stop's colour — the SHARED prism picker (the SAME component the SYSTEM accents
        // use). `pick` commits the hex; `preview` recolours the stop live so the strip + the board
        // update in real time as the prism is dragged. Both route through set-stop-color(idx, hex).
        if State.light-stops.length > 0 : ColorPicker {
            current: State.light-stops[root.stop-idx].col;
            value: State.light-stops[root.stop-idx].hex;
            swatches: Palette.accent;
            pick(h) => { State.set-stop-color(root.stop-idx, h); }
            preview(h) => { State.set-stop-color(root.stop-idx, h); }
        }
        // GRADIENT PRESETS — whole-ramp bases ("fire on everything"), the same 26px chips as the colour
        // swatch row above so the two read as one palette. A click swaps the stops; motion/blend stay.
        HorizontalLayout {
            spacing: 6px;
            for g[i] in State.gradient-presets : Rectangle {
                width: 26px; height: 26px; border-radius: Theme.radius-sm;
                border-width: Theme.hair;
                border-color: gta.has-hover ? Theme.text-faint : Theme.line-soft;
                clip: true;
                animate border-color { duration: Theme.quick; }
                Image { source: g.swatch; width: 100%; height: 100%; image-fit: fill; }
                gta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { State.apply-gradient(i); } }
            }
            Rectangle {}
        }
        // BLEND — how colour interpolates between stops. Only meaningful with 2+ stops (a gradient to
        // blend): RGB is predictable, HSV takes the shortest hue path so the blend stays vivid (no muddy
        // midpoint). Defaults to RGB, so no existing preset's look changes unless the user opts in.
        if State.light-stops.length > 1 : VerticalLayout {
            spacing: 6px;
            Mono { text: "blend"; color: Theme.text-dim; }
            HorizontalLayout {
                SplitToggle {
                    options: ["RGB", "HSV"];
                    index: root.interp-idx;
                    min-cell: 52px;
                    picked(i) => { State.set-interp(i == 1 ? "hsv" : "rgb"); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    Divider {}

    // ── MOTION ROW — the palette's intra-frame animation ─────────────────
    VerticalLayout {
        spacing: 9px;
        SectionTitle { text: "MOTION"; }
        HorizontalLayout {
            SplitToggle {
                options: ["HOLD", "DRIFT", "CYCLE", "BREATHE", "FLOW"];
                index: root.motion-idx;
                min-cell: 52px;
                picked(i) => {
                    State.set-motion(i == 1 ? "drift" : i == 2 ? "cycle" : i == 3 ? "breathe" : i == 4 ? "flow" : "hold");
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // speed paces every motion but Hold (which has nothing to move) — hidden honestly for Hold.
        if State.light-motion != "hold" : SpecSlider {
            label: "speed"; minimum: 0; maximum: 3; step: 0.02; has-home: true; home: 1;
            value: State.light-motion-speed;
            changed(v) => { State.set-motion-speed(v); }
        }
        // depth only shapes the breathe dip
        if State.light-motion == "breathe" : SpecSlider {
            label: "depth"; minimum: 0; maximum: 1; step: 0.02; has-home: true; home: 0.5;
            value: State.light-motion-depth;
            changed(v) => { State.set-motion-depth(v); }
        }
        // chaos only shapes the flow octaves
        if State.light-motion == "flow" : SpecSlider {
            label: "chaos"; minimum: 0; maximum: 1; step: 0.02; has-home: true; home: 0.5;
            value: State.light-motion-chaos;
            changed(v) => { State.set-motion-chaos(v); }
        }
    }

    Divider {}

    // ── TIMELINE / SEQUENCER — the keyframe track (collapsed at seq-len 1) ─
    VerticalLayout {
        spacing: 9px;
        HorizontalLayout {
            SectionTitle { text: "TIMELINE"; }
            Rectangle {}
            Mono {
                text: State.light-seq.length <= 1 ? "single frame" : State.light-seq.length + " frames";
                color: Theme.text-faint;
            }
        }
        // collapsed (a single palette): the one affordance that turns it into a sequence.
        if State.light-seq.length <= 1 && !root.tl-open : HorizontalLayout {
            Button { text: "+ sequence this palette"; clicked => { State.add-frame(); root.tl-open = true; } }
            Rectangle {}
        }
        // DISCLOSURE only — `tl-open` (manual open) or an existing sequence (auto-open) decides whether the
        // expanded track shows. It does NOT guard indexing: every `light-seq[frame-idx]` reader inside is
        // separately gated on `light-seq.length > 0` (the per-frame timing block below), so opening the
        // timeline on a momentarily-empty model can never dereference a phantom frame.
        if root.tl-open || State.light-seq.length > 1 : VerticalLayout {
            spacing: 9px;
            // the keyframe track — palette swatches laid out arithmetically inside a clipped band (NO
            // nested Flickable: two Flickables break the inner's hit-testing — app.slint's lesson). The
            // band auto-scrolls to keep the active frame centred; clicking a chip scrubs/selects it, and
            // the board render above is its live preview.
            track := Rectangle {
                height: 50px;
                clip: true;
                background: Theme.bg;
                border-radius: Theme.radius-sm;
                border-width: Theme.hair;
                border-color: Theme.line;
                // total content width (chip 57 + gap 7 = 64 each, no trailing gap) and the scroll that
                // brings the active chip into view, clamped so it never overscrolls past either end.
                property <length> total: max(0px, State.light-seq.length * 64px - 7px);
                property <length> scroll:
                    clamp((self.width - 57px) / 2 - root.frame-idx * 64px,
                          min(0px, self.width - self.total), 0px);
                for f[i] in State.light-seq : chip := Rectangle {
                    property <bool> on: i == root.frame-idx;
                    x: 5px + i * 64px + track.scroll;
                    y: 4px;
                    width: 57px;
                    height: parent.height - 8px;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hair;
                    border-color: chip.on ? Theme.accent-line : (cta.has-hover ? Theme.text-faint : Theme.line);
                    background: chip.on ? Theme.accent-glow : Theme.bg-2;
                    animate border-color, background { duration: Theme.quick; }
                    clip: true;
                    VerticalLayout {
                        padding: 4px; spacing: 3px;
                        Rectangle {
                            // deliberate 2px exception: this tiny keyframe-thumb mask wants a corner
                            // tighter than radius-sm, matched to its 20px height (not a themed radius).
                            height: 20px; border-radius: 2px; clip: true;
                            Image { source: f.swatch; width: 100%; height: 100%; image-fit: fill; }
                        }
                        Mono {
                            text: "F" + (i + 1);
                            color: chip.on ? Theme.accent : Theme.text-dim;
                            horizontal-alignment: center; font-size: Theme.fs-small;
                        }
                    }
                    cta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { State.select-frame(i); } }
                }
            }
            // add a keyframe (a clone of the active) / delete the active one — the coupled pair fused
            // into one full-width deck: DELETE (left), constructive + keyframe (right).
            // The delete half goes visibly DEAD at the last frame (left-enabled), never a silent no-op.
            SplitButton {
                left-text: "delete frame";
                left-enabled: State.light-seq.length > 1;
                right-text: "+ keyframe";
                left-clicked => { State.remove-frame(root.frame-idx); }
                right-clicked => { State.add-frame(); }
            }
            // the active frame's timing — dwell (hold) → crossfade-in (fade) → the fade ease — with the
            // reorder arrows on its header so a frame moves earlier/later in the sequence. INDEX GUARD:
            // gated on `light-seq.length > 0` (the SAME guard the strip Image + ease-idx use) — these
            // controls READ + WRITE `light-seq[frame-idx]`, so they render only when the frame exists.
            // `frame-idx` is clamped into 0..length-1 whenever the sequence is non-empty (see above).
            if State.light-seq.length > 0 : VerticalLayout {
                spacing: 9px;
                HorizontalLayout {
                    Mono { text: "frame " + (root.frame-idx + 1); color: Theme.text-dim; }
                    Rectangle { horizontal-stretch: 1; }
                    // reorder ◂ ▸ fused into one deck (hugs right). The whole rail dies for a single
                    // frame; each arrow goes visibly dead at its end of the sequence (per-half enables),
                    // so an impossible move reads gated, not broken.
                    SplitButton {
                        left-text: "◂"; right-text: "▸";
                        enabled: State.light-seq.length > 1;
                        left-enabled: root.frame-idx > 0;
                        right-enabled: root.frame-idx < State.light-seq.length - 1;
                        left-clicked => { State.move-frame(root.frame-idx, -1); }
                        right-clicked => { State.move-frame(root.frame-idx, 1); }
                    }
                }
                SpecSlider {
                    label: "hold"; minimum: 0; maximum: 10; step: 0.1; decimals: 1; unit: "s";
                    value: State.light-seq[root.frame-idx].hold;
                    changed(v) => { State.set-frame-hold(root.frame-idx, v); }
                }
                SpecSlider {
                    label: "crossfade"; minimum: 0; maximum: 5; step: 0.1; decimals: 1; unit: "s";
                    value: State.light-seq[root.frame-idx].fade;
                    changed(v) => { State.set-frame-fade(root.frame-idx, v); }
                }
                VerticalLayout {
                    spacing: 6px;
                    Mono { text: "fade ease"; color: Theme.text-dim; }
                    HorizontalLayout {
                        SplitToggle {
                            options: ["LINEAR", "SMOOTH", "SNAP"];
                            index: root.ease-idx;
                            min-cell: 52px;
                            picked(i) => { State.set-frame-ease(root.frame-idx, i == 1 ? "smooth" : i == 2 ? "snap" : "linear"); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            // playback mode — how the scrubber runs the sequence at render time.
            VerticalLayout {
                spacing: 6px;
                Mono { text: "playback"; color: Theme.text-dim; }
                HorizontalLayout {
                    SplitToggle {
                        options: ["ONCE", "LOOP", "PINGPONG"];
                        index: root.loop-idx;
                        min-cell: 52px;
                        picked(i) => { State.set-loop(i == 0 ? "once" : i == 2 ? "pingpong" : "loop"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

export component LightingPanel inherits VerticalLayout {
    spacing: 0;

    property <bool> has-target: State.selected-device >= 0 && State.selected-device-name != "—";
    property <bool> has-surface: root.has-target && State.sel-can-light && State.grid-rows > 0 && State.grid-cols > 0;
    property <Signal> surface-signal: root.has-surface && State.writes-paused ? Signal.provisional
        : root.has-surface && State.light-foreign ? Signal.live
        : root.has-surface && (State.light-brush-on || State.light-place-on) ? Signal.listening
        : root.has-surface && State.compositing ? Signal.live : Signal.idle;
    property <string> surface-detail: !root.has-target ? ""
        : !State.sel-can-light ? "no addressable RGB"
        : !root.has-surface ? "layout unavailable"
        : root.zone-mode ? State.grid-rows * State.grid-cols
            + (State.grid-rows * State.grid-cols == 1 ? " LED zone" : " LED zones")
        : State.grid-rows + " × " + State.grid-cols + " grid";
    property <string> surface-status: !root.has-surface ? ""
        : State.writes-paused ? "writes paused"
        : State.light-foreign ? "visitor painting"
        : State.light-brush-on ? "paint draft"
        : State.light-place-on ? "placing layer"
        : State.compositing ? "streaming"
        : State.light-effect != "" ? "preview only" : "no effect";

    // a mouse with a handful of LEDs is drawn as ZONES, not a lattice (see DeviceRender.zone-mode) — the
    // place-a-region gesture needs a grid to drag on, so it's hidden for those honest few-zone devices.
    property <bool> zone-mode: State.grid-kind == "mouse" && State.grid-rows * State.grid-cols <= 4;

    // the curated quick swatches live ONCE in `Palette.accent` (controls.slint), shared with the SYSTEM
    // accent picker so the two never drift — both the COLOUR ColorPicker and the PAINT swatch row use it.

    // the live mirror: while an effect/data tile is active and the brush is down, re-render the frame
    // onto the device render at the DEVICE's rate (the same math + time base the device runs) so the
    // preview steps in the same discrete frames the keyboard does. Honest "~ live"/"preview" badge.
    Timer {
        // a PREVIEW only needs to read as live — cap it at 20fps (a 50ms floor) instead of chasing the
        // device's 30. The device STREAM keeps its own rate; this Timer is just the on-screen mirror.
        interval: max(50ms, 1000ms / max(1.0, State.light-fps));
        // GATE on the lighting page being VISIBLE — PanelSlot keeps every page instantiated (just faded),
        // so without `window-shown && page == 1` this hero render ran every frame even while you were on
        // another tab or the window was hidden in the tray. Render nothing you can't see.
        running: State.window-shown && State.page == 1
            && !State.light-brush-on && root.has-surface && State.light-effect != "";
        triggered => { State.preview-tick(); }
    }
    // the GRID swatches animate a touch slower still (each tile is a Rust-side render — cheap but not
    // free), and ONLY while the lighting page is actually on screen (same gate as the hero).
    Timer {
        interval: 120ms;
        running: State.window-shown && State.page == 1 && root.has-surface;
        triggered => { State.tile-preview-tick(); }
    }

    PanelHead {
        label: "LIGHTING";
        caption: "paint it · or hand it to your games";
    }
    Divider {}
    Rectangle { height: Theme.lead-in; }

    // Visitor ownership stays beside the subject; its frame follows the same arbiter claim.
    VerticalLayout {
        spacing: Theme.section-gap;

        // ── HERO: the render, centred + constrained so it stays a calm SUBJECT, not a banner. ──
        VerticalLayout {
            alignment: start;
            spacing: 7px;
            // the render itself — capped to a comfortable subject width and centred on the void so it
            // reads as the page's calm subject instead of stretching edge-to-edge into a banner.
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(parent.width, 760px);
                    height: 306px;
                    // while a visitor paints, the FRAME says so: a soft accent halo around the
                    // subject (earned — someone else genuinely holds the brush right now), so the
                    // preview/board disagreement reads as arbitration, not a glitch. Settles in
                    // and out with the claim.
                    border-radius: Theme.radius;
                    border-width: State.light-foreign ? Theme.hair : 0px;
                    border-color: Theme.accent.with-alpha(0.45);
                    drop-shadow-color: State.light-foreign ? Theme.accent.with-alpha(0.22) : transparent;
                    drop-shadow-blur: State.light-foreign ? 10px : 0px;
                    animate drop-shadow-color, drop-shadow-blur { duration: Theme.settle; }
                    DeviceRender {
                        width: 100%; height: 100%;
                        rows: root.has-surface ? State.grid-rows : 0;
                        cols: root.has-surface ? State.grid-cols : 0;
                        px: root.has-surface ? State.grid-px : [];
                        kind: root.has-surface ? State.grid-kind : "";
                        device-name: root.has-target ? State.selected-device-name : "Lighting device";
                        device-detail: root.surface-detail;
                        stream-status: root.surface-status;
                        stream-signal: root.surface-signal;
                        editable: root.has-surface && State.light-brush-on;
                        paint(i) => { State.paint-cell(i); }
                        erase(i) => { State.erase-cell(i); }
                        // PLACE gesture — a sibling to the brush (mutually exclusive). The committed region
                        // corners drive the persistent placement outline; a drag commits a fresh rect.
                        placing: root.has-surface && State.light-place-on;
                        place-r0: State.light-place-r0;
                        place-c0: State.light-place-c0;
                        place-r1: State.light-place-r1;
                        place-c1: State.light-place-c1;
                        place-region(r0, c0, r1, c1) => { State.set-layer-region(r0, c0, r1, c1); }
                        if !root.has-surface : VerticalLayout {
                            width: 100%; height: 100%;
                            padding: 36px; padding-top: 58px; alignment: center; spacing: 12px;
                            Mono {
                                text: !root.has-target ? "Pick a keyboard or mouse with RGB"
                                    : !State.sel-can-light ? "Choose a lighting device"
                                    : "Choose another lighting channel";
                                color: Theme.text-dim; horizontal-alignment: center; wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Button { text: "choose device"; clicked => { State.page = 0; } }
                            }
                        }
                    }
                }
            }
            if root.has-surface && (State.light-brush-on || State.light-place-on || State.light-foreign || State.light-suppressed) : HorizontalLayout {
                alignment: center;
                Mono {
                    width: min(parent.width, 760px) * 0.92;
                    text: State.light-brush-on ? (State.light-foreign ? "Paint draft · " : "") + "left paint · right erase · drag to sweep"
                        : State.light-place-on ? "Drag on the grid to place this layer"
                        : State.light-foreign
                            ? (State.light-foreign-app == "" ? "Another app" : State.light-foreign-app) + " is painting · blend in VISITORS"
                            : (State.light-foreign-app == "" ? "A visitor" : State.light-foreign-app) + " is suppressed · your lighting has priority";
                    color: State.light-brush-on || State.light-place-on ? Theme.listen : Theme.text-dim;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
            }
        }

        // ── GALLERY + INSPECTOR — fills the width. The gallery is elastic (it widens its tiles to
        // use the room); the inspector slides in only once a tile is picked, and takes no width at
        // all when nothing is — so the empty page is a full-width gallery, never a stranded third. ──
        if root.has-surface : HorizontalLayout {
            spacing: State.light-effect == "" ? 0px : Theme.gap-col;

            // ── the catalog: THREE SHELVES of live-preview tiles, grouped by what feeds each look.
            // The taxonomy answers the question the old single wall couldn't: "what does this one
            // actually read?" — a pure show, your typing, or a named real-world feed. ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;
                HorizontalLayout {
                    SectionTitle { text: "CATALOG"; }
                    Rectangle {}
                    // SAVE — the name cell + the button are ONE gesture, riding the header the user is
                    // already looking at (never a dialog that hides the page they just built). Disabled
                    // honestly: no stack, or no name yet.
                    Field {
                        field-width: 172px;
                        placeholder: "name this effect";
                        text: State.light-effect-name;
                        edited(t) => { State.light-effect-name = t; }
                        accepted(t) => { State.light-effect-name = t; State.save-user-effect(t); }
                    }
                    Button {
                        text: "save effect";
                        primary: true;
                        enabled: State.light-stack-count > 0 && State.light-effect-name != "";
                        clicked => { State.save-user-effect(State.light-effect-name); }
                    }
                    Button { text: "import .ChromaEffects"; clicked => { State.import-light-file(); } }
                }
                TileShelf {
                    title: "EFFECTS";
                    caption: "pure light shows, running on a clock";
                    tiles: State.light-tiles;
                }
                TileShelf {
                    title: "REACTS TO KEYS";
                    caption: "driven by your live typing · tiles loop a demo";
                    tiles: State.light-input-tiles;
                }
                TileShelf {
                    title: "LIVE DATA";
                    caption: "each one reads a real feed, named on the chip · tiles loop a demo";
                    tiles: State.light-data-tiles;
                }
                TileShelf {
                    title: "YOUR EFFECTS";
                    caption: State.light-user-tiles.length == 0 ? "save a look above to keep it here"
                        : "saved by you · click to load, \u{00d7} to delete";
                    tiles: State.light-user-tiles;
                    selected-extra: State.light-user-effect;
                    deletable: true;
                    delete-requested(slug) => { State.delete-user-effect(slug); }
                }
            }

            // ── the active tile's CONTEXTUAL controls — a fixed inspector column that appears the
            // instant a tile is picked (the page coming alive in place). No width when nothing's on. ──
            if State.light-effect != "" : VerticalLayout {
                width: 332px;
                horizontal-stretch: 0;
                spacing: 14px;
                // PIN to the top: the gallery column is usually the taller sibling, and without an
                // alignment the layout pads the DIFFERENCE into the section gaps — the inspector read
                // as scattered orphan headings floating in void instead of one instrument column.
                alignment: start;

                // RATE — the streamed effect's frame pacing. Drives BOTH the live device stream AND
                // this preview, so what you see steps at the keyboard's TRUE rate. Unconditional now:
                // vitals streams like any effect (no more paint-on-demand readout), so every layer paces.
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        SectionTitle { text: "RATE"; }
                        Rectangle {}
                        Mono { text: round(State.light-fps) + " fps"; color: Theme.text-mid; }
                    }
                    Slider {
                        compact: true; wheel: false;
                        minimum: 1; maximum: 30; step: 1;
                        value: State.light-fps;
                        changed(v) => { State.set-light-fps(v); }
                    }
                    if State.light-fps-legacy : Mono {
                        // plain words over the invented compound ("wire-verified"): say what was
                        // done and what it means for the slider.
                        text: "30 fps is this board's measured limit";
                        color: Theme.text-faint; wrap: word-wrap;
                    }
                }

                // SPECTRUM — the active layer's full colour program (gradient stops + motion + a
                // collapsible keyframe timeline). Shown only when the layer carries an editable 1-D
                // spectrum: hidden for the Screen pattern (Ambient is full-colour, the spectrum is
                // bypassed) and for a DATA readout. Every control binds to the State spectrum surface.
                if State.light-has-spectrum : SpectrumEditor {}

                // TUNE — the rest of the schema's knobs, auto-rendered (range/enum/toggle). A data tile
                // (mouse battery) declares none, so this whole block simply doesn't appear — honest.
                if State.light-params.length > 0 : VerticalLayout {
                    spacing: 9px;
                    SectionTitle { text: "TUNE"; }
                    for cp in State.light-params : VerticalLayout {
                        // skip colour (rendered above); render every other declared param
                        if cp.kind != "color" : ParamControl { p: cp; }
                    }
                }
                // a READOUT layer (vitals) is honest about being a live device gauge, not a tunable light
                // show — it has a rate + a placement but no colour ramp or knobs, so point at what it IS.
                if State.light-is-readout : Mono {
                    text: "battery and charge, live";
                    color: Theme.text-faint; wrap: word-wrap;
                }
                // a hand-painted `custom` frame owns its pixels directly — no ramp, no knobs. It's edited
                // with the brush on the render, so the inspector just points there instead of faking knobs.
                if State.light-effect == "custom" : Mono {
                    text: "hand-painted · pick up the brush to edit";
                    color: Theme.text-faint; wrap: word-wrap;
                }

                Divider {}

                // ── STACK — the optional spatial composite (light, not a list) ──
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        SectionTitle { text: "STACK"; }
                        Rectangle {}
                        Mono {
                            text: State.light-stack-count <= 1 ? "single" : State.light-stack-count + " layers";
                            color: Theme.text-faint;
                        }
                    }
                    // the composite strip — one cell per stacked effect, bottom→top left→right. The
                    // active cell is lit; tapping a cell makes it the active effect (knobs follow); ✕ drops
                    // it. Shown at >=1 layer (not just >1) so it doubles as the layer SELECTOR the PLACE
                    // gesture needs — the user picks which layer (an effect OR the vitals readout) to place.
                    if State.light-stack-count >= 1 : HorizontalLayout {
                        spacing: 6px;
                        // each stacked effect is a pick-one SelectableRow — the shared atom now owns the
                        // frame / hover / accent-select / tick; the layer's display name is the label
                        // ("Vitals", "Heat"), falling back to L{n} until the labels model catches up. The
                        // ✕ rides the row's trailing slot (declared after the row's own pick TouchArea, so
                        // its touch wins the corner — the "can't remove" bug can't return).
                        for li in State.light-stack-count : SelectableRow {
                            min-width: 60px; horizontal-stretch: 1;
                            label: li < State.light-stack-labels.length ? State.light-stack-labels[li] : "L" + (li + 1);
                            selected: li == State.selected-layer;
                            clicked => { State.select-stack(li); }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: "\u{00d7}";
                                    danger: true;
                                    clicked => { State.remove-stack(li); }
                                }
                            }
                        }
                    }
                    // reorder the SELECTED layer up/down the stack — the ◂|▸ deck TIMELINE also wears, per-
                    // half gated at the ends. Shown only when there's a stack to reorder (>1 layer).
                    if State.light-stack-count > 1 : HorizontalLayout {
                        VerticalLayout { alignment: center; Mono { text: "reorder layer"; color: Theme.text-faint; } }
                        Rectangle { horizontal-stretch: 1; }
                        SplitButton {
                            left-text: "\u{25c2}"; right-text: "\u{25b8}";
                            enabled: State.light-stack-count > 1;
                            left-enabled: State.selected-layer > 0;
                            right-enabled: State.selected-layer < State.light-stack-count - 1;
                            left-clicked => { State.move-stack(State.selected-layer, -1); }
                            right-clicked => { State.move-stack(State.selected-layer, 1); }
                        }
                    }
                    Button {
                        text: "+ stack this effect";
                        // an empty stack has nothing to stack ONTO — picking a tile seeds the first layer
                        // instead, so this stays disabled until at least one layer exists.
                        enabled: State.light-stack-count >= 1;
                        clicked => { State.stack-current(); }
                    }
                }

                Divider {}

                // ── PAINT — a brush you pick up ON the render (a gesture, not a mode) ──
                VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        SectionTitle { text: "PAINT"; }
                        Rectangle {}
                        Button {
                            text: State.light-brush-on ? "put brush down" : "pick up brush";
                            signal: State.light-brush-on ? Signal.listening : Signal.idle;
                            clicked => { State.toggle-brush(); }
                        }
                    }
                    if State.light-brush-on : VerticalLayout {
                        spacing: 9px;
                        HorizontalLayout {
                            spacing: 9px;
                            // live brush swatch — 26px, the SwatchRow chip size, so the preview and the
                            // presets read as one family (was a 30px odd-one-out).
                            Rectangle {
                                width: 26px; height: 26px; border-radius: Theme.radius-sm;
                                border-width: Theme.hair; border-color: Theme.line;
                                background: State.brush-color;
                            }
                            Field {
                                field-width: 120px;
                                placeholder: "4AF2B0";
                                text: State.light-color;
                                invalid: !State.light-color-valid;
                                edited(t) => { State.light-color = t; State.color-changed(t); }
                            }
                            Rectangle {}
                        }
                        // the preset chips — the shared SwatchRow (was a hand-copy of ColorPicker's strip)
                        SwatchRow {
                            swatches: Palette.accent;
                            value: State.light-color;
                            pick(h) => { State.light-color = h; State.color-changed(h); }
                        }
                        HorizontalLayout {
                            spacing: 7px;
                            // the canvas couplet fused: CLEAR (left; a draft until pushed, so not danger) + FILL
                            // (right). PUSH FRAME stays a separate primary key beside it — it's the commit,
                            // distinct from the fill/clear pair.
                            SplitButton {
                                left-text: "clear";
                                right-text: "fill";
                                left-clicked => { State.clear-grid(); }
                                right-clicked => { State.fill-grid(); }
                            }
                            Button { text: "push frame"; primary: true; enabled: !State.writes-paused; clicked => { State.push-painted(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Divider {}

                // ── PLACE — position THIS layer as a sprite: a drag on the render sets its region (a
                // sibling gesture to the brush, never the same mode). Any layer — an effect or the vitals
                // readout — becomes freely placeable + resizable; moving/resizing is just another drag,
                // Reset returns it to the full board. Hidden for few-zone mice (no lattice to drag on), and
                // gated on having a layer to place — an empty stack has nothing to position. ──
                if !root.zone-mode && State.light-stack-count >= 1 : VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        SectionTitle { text: "PLACE"; }
                        Rectangle {}
                        // the honest placement readout — "full board" or the sub-rect size — always shown.
                        Mono {
                            text: State.light-place-label;
                            color: State.light-layer-placed ? Theme.accent : Theme.text-faint;
                        }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Button {
                            text: State.light-place-on ? "done placing" : "place on the render";
                            signal: State.light-place-on ? Signal.listening : Signal.idle;
                            clicked => { State.toggle-place(); }
                        }
                        Rectangle {}
                        Button {
                            text: "reset placement";
                            enabled: State.light-layer-placed;
                            clicked => { State.reset-layer-region(); }
                        }
                    }
                }
                // No APPLY transport: lighting AUTO-STREAMS. Every edit debounce-applies the current stack
                // to the board (see glue::schedule_lighting_apply); "~ live on device" above is the honest
                // readout, and the one deliberate "stop writing" is the global writes-pause gate (header /
                // Settings) — a page-local stop would be undone by the very next edit, so it's gone.
            }
        }

    }

    Rectangle { height: Theme.section-gap; }

        // ── VISITORS — how EXTERNAL paint composes with your lighting. Games speak Chroma, tools
        // speak OpenRGB (both enabled in SYSTEM → CONNECTIONS); the arbiter blends them instead of
        // letting whoever wrote last win — the one config no last-writer-wins tool can offer. Lives
        // HERE, beside the lighting it combines with. TWO LANES SIDE BY SIDE (games / tools — the
        // same instrument twice, so the symmetry is visible), then the universal hands-off list and
        // the base-priority switch the suppressed strip above points at. ──
        VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                spacing: 9px;
                SectionTitle { text: "VISITORS"; }
                VerticalLayout {
                    alignment: center;
                    Mono { text: "when games & tools paint your devices"; color: Theme.text-faint; font-size: Theme.fs-small; }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: Theme.gap-col;
                VisitorLane {
                    title: "CHROMA GAMES";
                    mode: State.host-chroma-mode;
                    strength: State.host-chroma-strength;
                    fade: State.host-chroma-fade;
                    blurb: State.host-chroma-mode == 0
                        ? "games take the LEDs they paint."
                        : State.host-chroma-mode == 2
                            ? "games brighten your lighting for loud moments."
                            : State.host-chroma-mode == 3
                                ? "games shade your lighting without washing it out."
                                : "games sit on top while your lighting stays visible.";
                    mode-picked(i) => { State.set-host-chroma-mode(i); }
                    strength-changed(v) => { State.set-host-chroma-strength(v); }
                    fade-changed(v) => { State.set-host-chroma-fade(v); }
                }
                VisitorLane {
                    title: "OPENRGB TOOLS";
                    mode: State.host-openrgb-mode;
                    strength: State.host-openrgb-strength;
                    fade: State.host-openrgb-fade;
                    blurb: State.host-openrgb-mode == 0
                        ? "tools take the LEDs they set, the classic hard takeover."
                        : State.host-openrgb-mode == 2
                            ? "tools brighten your lighting for loud moments."
                            : State.host-openrgb-mode == 3
                                ? "tools shade your lighting without washing it out."
                                : "tools sit on top while your lighting stays visible.";
                    mode-picked(i) => { State.set-host-openrgb-mode(i); }
                    strength-changed(v) => { State.set-host-openrgb-strength(v); }
                    fade-changed(v) => { State.set-host-openrgb-fade(v); }
                }
            }

            // the universal pair beneath the lanes: which devices stay yours, and who outranks whom.
            HorizontalLayout {
                spacing: Theme.gap-col;
                // HANDS-OFF DEVICES — universal (both lanes). A device toggled OFF here stays yours;
                // no visitor may paint it, whether it speaks Chroma or OpenRGB.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    SubLabel { text: "HANDS-OFF DEVICES"; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 22px;
                        for d in State.host-paint-devices : Toggle {
                            caption: d.name;
                            checked: d.enabled;
                            toggled(v) => { State.set-host-paint-device(d.id, v); }
                        }
                    }
                    Mono {
                        text: "off = no visitor paints it";
                        color: Theme.text-faint; wrap: word-wrap;
                    }
                }
                // MY LIGHTING ALWAYS WINS — the base-priority switch the suppressed strip points at.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    SubLabel { text: "PRIORITY"; }
                    Toggle {
                        caption: "my lighting always wins";
                        checked: State.host-base-always-wins;
                        toggled(v) => { State.set-host-base-always-wins(v); }
                    }
                    Mono {
                        text: "visitors keep painting underneath, shown as suppressed";
                        color: Theme.text-faint; wrap: word-wrap;
                    }
                }
            }
            // CHROMA LAB — what the connected game paints, read as layers; hide, name, bind and
            // restyle it right beside the lane that blends it.
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 9px;
                    SubLabel { text: "CHROMA LAB"; }
                    VerticalLayout {
                        alignment: center;
                        Mono { text: "what a chroma game is painting, as layers"; color: Theme.text-faint; font-size: Theme.fs-small; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Toggle {
                        horizontal-stretch: 0;
                        width: 96px;
                        caption: "show";
                        checked: State.chroma-lab-open;
                        toggled(v) => { State.chroma-lab-open = v; }
                    }
                }
                // fades in where it opens (it's the page's last block, so nothing below moves); the
                // lab only ticks, and the tap only reads, while it's open
                if State.chroma-lab-open : Rectangle {
                    opacity: 0;
                    init => { self.opacity = 1; }
                    animate opacity { duration: 180ms; easing: ease-out; }
                    VerticalLayout { ChromaLab { } }
                }
            }

        }
}
