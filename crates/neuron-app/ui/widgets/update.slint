// The updater's surfaces: the header pill, its what's-new drawer, and the notes renderer both it
// and SYSTEM use. Notes are plain styled text (bold leads, bullets), never markup.

import { Theme, Signal } from "../theme.slint";
import { State } from "../state.slint";
import { NoteRow, NoteMedia } from "../models.slint";
import { LoadingRim, Mono } from "controls.slint";

// Release notes: the images first, then the headline, the groups and their items, the thanks.
export component NotesView inherits VerticalLayout {
    in property <[NoteRow]> rows;
    in property <[NoteMedia]> media;
    spacing: 7px;
    for m in root.media : Rectangle {
        height: self.width * m.ratio;
        border-radius: Theme.radius-sm;
        clip: true;
        background: Theme.well;
        Image {
            width: parent.width;
            height: parent.height;
            source: m.img;
            image-fit: contain;
            accessible-label: m.alt;
        }
    }
    for r in root.rows : VerticalLayout {
        padding-top: r.kind == "group" ? 5px : 0px;
        if r.kind == "head" : Text {
            text: r.body;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-family: Theme.mono;
            wrap: word-wrap;
        }
        if r.kind == "group" : Text {
            text: r.title;
            color: Theme.accent-dim;
            font-size: Theme.fs-small;
            font-family: Theme.mono;
            font-weight: 700;
            letter-spacing: Theme.track-2;
            overflow: elide;
        }
        if r.kind == "item" : HorizontalLayout {
            spacing: 7px;
            Text {
                text: "·";
                color: Theme.accent-dim;
                font-size: Theme.fs-body;
                font-family: Theme.mono;
                vertical-alignment: top;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                if r.title != "" : Text {
                    text: r.title;
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    font-family: Theme.mono;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if r.body != "" : Text {
                    text: r.body;
                    color: Theme.text-mid;
                    font-size: Theme.fs-small;
                    font-family: Theme.mono;
                    wrap: word-wrap;
                }
            }
        }
        if r.kind == "thanks" : Text {
            text: r.body;
            color: Theme.text-dim;
            font-size: Theme.fs-small;
            font-family: Theme.mono;
            wrap: word-wrap;
        }
    }
}

// One half of the pill: a label that is also a key.
component PillSeg inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-mid;
    in property <bool> enabled: true;
    in property <bool> strong: false;
    callback clicked();
    horizontal-stretch: 0;
    min-width: lbl.preferred-width + 18px;
    background: !root.enabled ? transparent : ta.pressed ? Theme.well-hi : ta.has-hover ? Theme.well : transparent;
    animate background { duration: ta.has-hover ? Theme.hover-in : Theme.hover-out; }
    lbl := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: Theme.fs-small;
        font-family: Theme.mono;
        font-weight: root.strong ? 700 : 500;
        letter-spacing: Theme.track-1;
        vertical-alignment: center;
        horizontal-alignment: center;
        y: ta.pressed && root.enabled ? 1px : 0px;
        animate y { duration: Theme.press-throw; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// The header pill: the version (opens what's new), the next step, and "& install" for the
// one-click path. While downloading, a thin fill runs along its foot.
export component UpdatePill inherits Rectangle {
    property <string> phase: State.update-phase;
    property <bool> offering: root.phase == "available" || root.phase == "downloading";
    horizontal-stretch: 0;
    height: Theme.row-h-sm - 4px;
    border-radius: Theme.radius-sm;
    border-width: Theme.hair;
    border-color: root.phase == "error" ? Theme.danger.with-alpha(0.4) : root.phase == "rolled-back" ? Theme.line : Theme.accent-line;
    background: State.update-notes-open ? Theme.accent-glow : transparent;
    clip: true;
    animate background, border-color { duration: Theme.settle; }
    HorizontalLayout {
        spacing: 0;
        if root.phase == "rolled-back" : PillSeg {
            text: State.update-version + " didn't start, so you're back on " + State.app-version;
            ink: Theme.warn;
            clicked => { State.update-dismiss(); }
        }
        if root.phase != "rolled-back" : PillSeg {
            text: root.phase == "updated" ? "updated · v" + State.update-version : "v" + State.update-version;
            ink: Theme.accent;
            strong: true;
            clicked => { State.update-notes-open = !State.update-notes-open; }
        }
        if root.phase != "updated" : Rectangle { width: Theme.hair; background: root.phase == "rolled-back" ? Theme.line : Theme.accent-line; }
        if root.phase == "rolled-back" : PillSeg {
            text: "report";
            clicked => { State.update-open-release(); }
        }
        if root.phase == "available" : PillSeg {
            text: "download";
            clicked => { State.update-download(); }
        }
        if root.phase == "downloading" : PillSeg {
            text: round(State.update-progress * 100) + "%";
            ink: Theme.text-dim;
            enabled: false;
        }
        if root.phase == "ready" : PillSeg {
            text: "install";
            ink: Theme.accent;
            strong: true;
            clicked => { State.update-install(); }
        }
        if root.phase == "installing" : Rectangle {
            horizontal-stretch: 0;
            min-width: busy.preferred-width + 18px;
            LoadingRim { width: parent.width; height: parent.height; tint: Theme.accent-dim; }
            busy := Text {
                width: parent.width;
                height: parent.height;
                text: "restarting";
                color: Theme.accent-dim;
                font-size: Theme.fs-small;
                font-family: Theme.mono;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        if root.phase == "error" : PillSeg {
            text: State.update-error + " · retry";
            ink: Theme.danger;
            clicked => { State.update-download(); }
        }
        if root.offering : Rectangle { width: Theme.hair; background: Theme.accent-line; }
        if root.offering : PillSeg {
            text: "& install";
            ink: State.update-install-queued ? Theme.accent : Theme.text-mid;
            strong: State.update-install-queued;
            enabled: !State.update-install-queued;
            clicked => { State.update-install(); }
        }
    }
    if root.phase == "downloading" : Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: parent.width * clamp(State.update-progress, 0, 1);
        height: 2px;
        background: Theme.accent;
        animate width { duration: Theme.settle; }
    }
}

// The what's-new drawer: drops from the pill, holds the notes and two quiet verbs.
export component UpdateDrawer inherits Rectangle {
    // takes presses only while it is there to see, not while fading in or out
    in property <bool> open;
    property <bool> live: root.open && root.opacity > 0.5;
    background: Theme.bg-2;
    border-radius: Theme.radius;
    border-width: Theme.hair;
    border-color: Theme.line;
    clip: true;
    TouchArea { enabled: root.live; }
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: (State.update-phase == "updated" ? "now on v" : "v") + State.update-version;
                color: Theme.accent;
                font-size: Theme.fs-small;
                font-family: Theme.mono;
                font-weight: 700;
                letter-spacing: Theme.track-2;
                vertical-alignment: center;
            }
            Mono {
                text: "what's new";
                color: Theme.text-faint;
                font-size: Theme.fs-small;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        notes-scroll := Flickable {
            interactive: false;
            height: min(notes.preferred-height, 380px);
            viewport-width: self.width;
            viewport-height: notes.preferred-height;
            notes := NotesView {
                width: parent.viewport-width;
                rows: State.update-notes;
                media: State.update-media;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            PillSeg {
                text: "release page";
                ink: Theme.text-dim;
                enabled: root.live;
                clicked => { State.update-open-release(); }
            }
            Rectangle { horizontal-stretch: 1; }
            PillSeg {
                text: State.update-phase == "updated" ? "got it" : "not now";
                ink: Theme.text-dim;
                enabled: root.live;
                clicked => { State.update-notes-open = false; State.update-dismiss(); }
            }
        }
    }
}
