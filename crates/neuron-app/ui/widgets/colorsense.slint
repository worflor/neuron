// The second colour picker and the suggestion row that travels with it. Rust renders both picker
// surfaces and owns the colour maths (glue/colorsense.rs); this file is geometry and gestures.

import { Theme } from "../theme.slint";
import { State } from "../state.slint";
import { Field, LumaInk, Mono, SplitToggle, SwatchRow } from "controls.slint";

// A key that does something here, drawn as the key. `ground` is for sitting on a colour.
component Keycap inherits Rectangle {
    in property <string> key;
    in property <bool> ground;
    width: k.preferred-width + 8px;
    height: 14px;
    border-radius: 3px;
    border-width: Theme.hair;
    border-color: root.ground ? #ffffff50 : Theme.line;
    background: root.ground ? #000000b0 : Theme.well;
    k := Mono {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.key;
        color: root.ground ? #ffffffd8 : Theme.text-mid;
        font-size: Theme.fs-small;
    }
}

// A colour as three independent moves: the plane sets lightness (up) and vividness (right) at the
// current hue, the rail below sets hue at the current lightness and vividness. Each surface shows
// the colours a click on it would give, and the rail carries a tick for every other stop's hue.
//
// With a colour model installed, the plane carries a relief map: rings close in on the colours it
// would put at this stop's place in the palette, and a skyline on the rail stands tallest at the
// hues where those lie. They come from the other stops, so they hold still while this one is dragged.
//
// A suggested colour for the stop sits on the plane as a dot of that colour, at its own lightness
// and vividness, with a tick at its hue under the rail. Resting on the dot shows it on the stop and
// says why it is offered; moving off puts the stop back; a click keeps it.
//
// Grabbing a stop gives the picker the keyboard: arrows step lightness and vividness, Shift with
// left or right steps hue. Tab moves a suggestion forward (show the first choice, then keep it);
// held, it numbers the offers, and a number shows that one (again keeps it). Enter keeps what is
// on show, Escape puts the palette back or, with nothing on show, lets the keyboard go, and
// Ctrl+Z takes the way back.
export component SensePicker inherits VerticalLayout {
    in property <color> current;       // the selected stop's colour
    in property <string> value;        // its bare RRGGBB
    in property <[{hex: string, col: color}]> swatches;
    in property <bool> lead;
    in property <color> lead-col;
    callback lead-pick();
    callback pick(string);             // a bare RRGGBB typed or chosen from a chip
    callback preview(string);          // a bare RRGGBB while typing
    // the offer on show: under the pointer, else stepped to from the keyboard
    property <int> lit: pta.dot >= 0 ? pta.dot : State.assist-keyed;
    property <bool> lit-dot: root.lit >= State.assist-ramps && root.lit < State.assist-offers.length;
    property <bool> prime-dot: State.assist-prime >= State.assist-ramps && State.assist-prime < State.assist-offers.length;
    property <float> step: 0.02;
    // grabbing a stop on the strip hands the picker the keyboard
    property <int> focus-asked: State.picker-focus;
    changed focus-asked => { keys.focus(); }
    spacing: 9px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 26px; height: 26px; border-radius: Theme.radius-sm;
            border-width: Theme.hair; border-color: Theme.line;
            background: fld.has-focus && State.hex-preview-ok ? State.hex-preview-col : root.current;
            animate background { duration: Theme.quick; }
        }
        fld := Field {
            fits: "ffffff";
            placeholder: "4af2b0";
            text: root.value;
            invalid: self.has-focus && State.hex-preview-bad;
            edited(t) => { State.preview-hex(t); root.preview(t); }
            accepted(t) => { root.pick(t); }
        }
        Rectangle {}
    }
    plane := Rectangle {
        height: 96px;
        border-radius: Theme.radius-sm;
        border-width: Theme.hair;
        border-color: keys.has-focus ? Theme.accent-line : Theme.line;
        animate border-color { duration: Theme.quick; }
        clip: true;
        Image { source: State.picker-plane; width: 100%; height: 100%; image-fit: fill; }
        // the model's ground for this stop, as a relief map: rings close in on where it belongs
        Image {
            source: State.picker-terrain;
            width: 100%; height: 100%;
            image-fit: fill;
            opacity: State.picker-terrain-on ? 1 : 0;
            animate opacity { duration: 250ms; easing: ease-out; }
        }
        // Tab moves a suggestion forward: the first press shows the first choice, the next keeps
        // what is on show. Held, it shows every offer's number; Tab with a number (or the number
        // alone) shows that one, and the same number again keeps it.
        keys := FocusScope {
            x: 0px; y: 0px;
            width: 0px; height: 0px;
            // a number pressed while Tab was down: letting Tab go then does nothing more
            property <bool> chord;
            function draft(row: int) {
                State.assist-keyed = row;
                State.assist-preview(row);
            }
            // with nothing to show, Tab asks the model outright
            function forward() {
                if (State.assist-keyed >= 0) {
                    State.assist-accept(State.assist-keyed);
                } else if (State.assist-prime >= 0) {
                    self.draft(State.assist-prime);
                } else if (State.assist-can-ask) {
                    State.assist-ask();
                }
            }
            changed has-focus => {
                State.assist-keys = self.has-focus;
                State.assist-tab-held = false;
                // a draft never outlives the keyboard that showed it
                if (!self.has-focus && State.assist-keyed >= 0) { self.draft(-1); }
            }
            key-pressed(e) => {
                if (e.text == Key.Tab) {
                    if (!State.assist-tab-held) {
                        State.assist-tab-held = true;
                        self.chord = false;
                    }
                    return accept;
                }
                if (e.text.is-float() && e.text != "0" && !e.modifiers.control) {
                    let row = State.assist-option(Math.round(e.text.to-float()));
                    if (row >= 0) {
                        if (State.assist-keyed == row) { State.assist-accept(row); } else { self.draft(row); }
                    }
                    self.chord = State.assist-tab-held;
                    return accept;
                }
                if (e.text == Key.Return && State.assist-keyed >= 0) {
                    State.assist-accept(State.assist-keyed);
                    return accept;
                }
                if (e.text == Key.Escape) {
                    if (State.assist-keyed >= 0) { self.draft(-1); } else { self.clear-focus(); }
                    return accept;
                }
                if ((e.text == "r" || e.text == "R") && !e.modifiers.control) {
                    State.roll();
                    return accept;
                }
                if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                    let back = State.assist-option(0);
                    if (back >= 0) {
                        State.assist-accept(back);
                        return accept;
                    }
                    return reject;
                }
                if (e.text == Key.UpArrow) { State.picker-nudge(0, root.step, 0); return accept; }
                if (e.text == Key.DownArrow) { State.picker-nudge(0, -root.step, 0); return accept; }
                if (e.text == Key.RightArrow) {
                    State.picker-nudge(e.modifiers.shift ? 0 : root.step, 0, e.modifiers.shift ? 0.01 : 0);
                    return accept;
                }
                if (e.text == Key.LeftArrow) {
                    State.picker-nudge(e.modifiers.shift ? 0 : -root.step, 0, e.modifiers.shift ? -0.01 : 0);
                    return accept;
                }
                reject
            }
            key-released(e) => {
                if (e.text == Key.Tab && State.assist-tab-held) {
                    State.assist-tab-held = false;
                    if (!self.chord) { self.forward(); }
                    return accept;
                }
                reject
            }
        }
        // the cursor: the chosen colour in a ring that stays readable on any ground
        Rectangle {
            width: 12px; height: 12px; border-radius: 6px;
            x: clamp(State.picker-vivid * plane.width - 6px, 0px, plane.width - 12px);
            y: clamp((1 - State.picker-light) * plane.height - 6px, 0px, plane.height - 12px);
            background: root.current;
            border-width: 1.5px;
            border-color: State.picker-light > 0.62 ? #000000b0 : #ffffffe0;
        }
        for offer[i] in State.assist-offers : Rectangle {
            property <bool> hot: i == root.lit;
            property <bool> born;
            // the first choice sits a little larger: it is the one Tab reaches for
            property <length> d: self.hot ? 14px : i == State.assist-prime ? 11px : 9px;
            init => { self.born = true; }
            visible: offer.solid;
            width: self.d; height: self.d; border-radius: self.d / 2;
            x: clamp(offer.vivid * plane.width - self.d / 2, 0px, plane.width - self.d);
            y: clamp((1 - offer.light) * plane.height - self.d / 2, 0px, plane.height - self.d);
            // a colour offered only because the model was asked is a ring of that colour: a reach
            background: offer.reach ? offer.col.with-alpha(0.3) : offer.col;
            border-width: offer.reach ? 2px : self.hot ? 1.5px : 1px;
            border-color: self.hot ? Theme.accent : offer.reach ? offer.col : offer.light > 0.62 ? #00000090 : #ffffffb0;
            opacity: self.born ? 1 : 0;
            animate opacity { duration: 200ms; easing: ease-out; }
            animate d, x, y { duration: Theme.quick; easing: ease-out; }
        }
        // while Tab is held, each dot carries its number
        for offer[i] in State.assist-offers : Keycap {
            visible: offer.solid && State.assist-tab-held;
            ground: true;
            key: offer.num;
            x: clamp(offer.vivid * plane.width + 8px, 0px, plane.width - self.width);
            y: clamp((1 - offer.light) * plane.height - self.height / 2, 0px, plane.height - self.height);
        }
        // why the dot on show is offered, in the half of the plane the dot is not in. With the
        // keyboard here it also names the first choice before anything is on show, beside the key
        // that moves it forward.
        why := Rectangle {
            property <bool> hint: !root.lit-dot && State.assist-keys && root.prime-dot;
            property <int> told: root.lit-dot ? root.lit : self.hint ? State.assist-prime : -1;
            property <bool> low: self.told >= 0 && State.assist-offers[self.told].light < 0.5;
            x: 4px;
            y: self.low ? 4px : plane.height - self.height - 4px;
            width: min(why-row.preferred-width, plane.width - 8px);
            height: 16px;
            border-radius: 8px;
            background: #000000b0;
            opacity: self.told >= 0 && !State.assist-tab-held ? 1 : 0;
            animate opacity { duration: Theme.quick; }
            why-row := HorizontalLayout {
                property <bool> keyed: State.assist-keys && (why.hint || State.assist-keyed == root.lit);
                padding-left: 6px;
                padding-right: self.keyed ? 1px : 6px;
                spacing: 5px;
                alignment: start;
                Mono {
                    vertical-alignment: center;
                    overflow: elide;
                    text: why.told >= 0 ? State.assist-offers[why.told].title : "";
                    color: why.hint ? #ffffffa0 : #ffffffe6;
                    font-size: Theme.fs-small;
                }
                if self.keyed : VerticalLayout {
                    alignment: center;
                    Keycap { key: "tab"; ground: true; }
                }
            }
        }
        pta := TouchArea {
            // The dot under the pointer. A drag never lands on one: the pointer has to arrive at
            // a dot, so a colour being chosen is not swapped for a suggestion that appears under it.
            property <int> under: self.has-hover && State.assist-offers.length > State.assist-ramps
                ? State.assist-at(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px) : -1;
            property <bool> armed: true;
            property <bool> dragging;
            property <int> dot: self.armed && !self.dragging ? self.under : -1;
            // the dot whose colour is on the lights. Arriving from nowhere waits a beat, so a
            // pointer passing over a dot on its way somewhere does not flash the lights; once one
            // is on show, moving to the next is immediate.
            property <int> shown: -1;
            changed dot => {
                State.assist-keyed = -1;
                if (self.dot < 0 || self.shown >= 0) {
                    self.shown = self.dot;
                    State.assist-preview(self.dot);
                }
            }
            changed under => { if (self.under < 0 && !self.dragging) { self.armed = true; } }
            mouse-cursor: self.dot >= 0 ? MouseCursor.pointer : MouseCursor.crosshair;
            function at() {
                State.picker-plane-pick(clamp(self.mouse-x / self.width, 0.0, 1.0),
                    1 - clamp(self.mouse-y / self.height, 0.0, 1.0));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    keys.focus();
                    if (self.dot >= 0) {
                        State.assist-accept(self.dot);
                    } else {
                        self.dragging = true;
                        self.at();
                    }
                    self.armed = false;
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    self.dragging = false;
                    if (self.under < 0) { self.armed = true; }
                }
            }
            moved => { if (self.dragging) { self.at(); } }
        }
        Timer {
            interval: 110ms;
            running: pta.dot >= 0 && pta.shown < 0;
            triggered => {
                pta.shown = pta.dot;
                State.assist-preview(pta.dot);
            }
        }
    }
    rail := Rectangle {
        height: 16px;
        border-radius: Theme.radius-sm;
        border-width: Theme.hair;
        border-color: Theme.line;
        clip: true;
        Image { source: State.picker-rail; width: 100%; height: 100%; image-fit: fill; }
        // the model's ground by hue: a skyline on the rail's foot, tallest where it would turn to
        Image {
            source: State.picker-ridge;
            width: 100%; height: 100%;
            image-fit: fill;
            opacity: State.picker-ridge-on ? 1 : 0;
            animate opacity { duration: 250ms; easing: ease-out; }
        }
        // the other stops' hues hang from the top edge; suggested hues stand on the bottom one
        // thin marks sit on whole pixels, or they draw blurred across two
        for mark in State.picker-marks : Rectangle {
            x: clamp(Math.round(mark * rail.width / 1px) * 1px, 0px, rail.width - 1px);
            y: 0px;
            width: 1px; height: 5px;
            background: #ffffffc8;
        }
        for offer[i] in State.assist-offers : Rectangle {
            property <bool> hot: i == root.lit;
            visible: offer.solid;
            x: clamp(Math.round(offer.hue * rail.width / 1px) * 1px - 1px, 0px, rail.width - 2px);
            y: parent.height - self.height;
            width: 2px;
            height: self.hot ? 9px : 6px;
            background: self.hot ? Theme.accent : #ffffffe6;
            animate height, background { duration: Theme.quick; }
        }
        Rectangle {
            width: 5px; height: parent.height;
            x: clamp(State.picker-hue * rail.width - 2.5px, 0px, rail.width - 5px);
            background: root.current;
            border-width: 1px;
            border-color: State.picker-light > 0.62 ? #000000b0 : #ffffffe0;
        }
        TouchArea {
            mouse-cursor: MouseCursor.ew-resize;
            function at() { State.picker-hue-pick(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    keys.focus();
                    self.at();
                }
            }
            moved => { if (self.pressed) { self.at(); } }
        }
    }
    SwatchRow {
        swatches: root.swatches;
        value: root.value;
        lead: root.lead;
        lead-col: root.lead-col;
        lead-pick => { root.lead-pick(); }
        pick(h) => { root.pick(h); State.preview-hex(h); }
    }
}

// The whole-palette suggestions for the palette being edited (single colours sit in the picker).
// Resting on a capsule shows it on the strip and the board; leaving puts the palette back. Only a
// click keeps it, and the capsule that then says "undo" is the way back. Rolls lead the row, newest
// first. The first choice is drawn a little wider: the one Tab reaches for. A capsule the model
// offers only because it was asked is drawn faint, a reach rather than a recommendation.
//
// At the row's end, with a model to ask, the ask capsule: when the model is quiet it asks anyway,
// and asked once it asks for the next few. One touch area outside the `for` owns the gesture over
// the capsules, so a row update cannot drop the hover.
export component SenseOffers inherits Rectangle {
    property <int> n: min(State.assist-ramps, State.assist-offers.length);
    property <length> cw: 40px;
    property <length> gap: 5px;
    // the head capsule is wider when it holds the first choice
    property <length> hw: State.assist-prime == 0 ? 54px : root.cw;
    property <length> span: root.n > 0 ? root.hw + root.gap + (root.n - 1) * (root.cw + root.gap) : 0px;
    property <bool> quiet: State.assist-prime < 0;
    property <length> label-x: root.span + (State.assist-can-ask ? root.cw + root.gap : 0px) + 2px;
    property <int> hov: !ta.has-hover || root.n <= 0 ? -1
        : ta.mouse-x < root.hw + root.gap ? 0
        : min(root.n - 1, 1 + Math.floor((ta.mouse-x - root.hw - root.gap) / (root.cw + root.gap)));
    // the capsule whose palette is on the lights: arriving waits a beat, moving along is immediate
    property <int> shown: -1;
    property <int> lit: root.hov >= 0 ? root.hov : State.assist-keyed < root.n ? State.assist-keyed : -1;
    property <bool> hint: root.lit < 0 && State.assist-keys && State.assist-prime >= 0 && State.assist-prime < root.n;
    // a roll or an option asked for can be waved off: its right end is an x while it is pointed at
    property <bool> can-wave: root.hov >= 0 && root.hov < State.assist-offers.length
        && (State.assist-offers[root.hov].rolled || State.assist-offers[root.hov].reach);
    property <length> hov-end: root.hov == 0 ? root.hw : root.hw + root.gap + root.hov * (root.cw + root.gap) - root.gap;
    property <bool> on-wave: root.can-wave && ta.mouse-x >= root.hov-end - 16px;
    changed hov => {
        State.assist-keyed = -1;
        if (root.hov < 0 || root.shown >= 0) {
            root.shown = root.hov;
            State.assist-preview(root.hov);
        }
    }
    height: root.n > 0 || State.assist-can-ask ? 26px : 0px;
    animate height { duration: 200ms; easing: ease-out; }
    clip: true;
    Timer {
        interval: 110ms;
        running: root.hov >= 0 && root.shown < 0;
        triggered => {
            root.shown = root.hov;
            State.assist-preview(root.hov);
        }
    }
    for offer[i] in State.assist-offers : Rectangle {
        visible: i < root.n;
        x: i == 0 ? 0px : root.hw + root.gap + (i - 1) * (root.cw + root.gap);
        y: 0px;
        width: i == 0 ? root.hw : root.cw;
        height: 26px;
        border-radius: 13px;
        border-width: Theme.hair;
        border-color: i == root.lit ? Theme.accent : i == State.assist-prime ? Theme.text-faint : Theme.line;
        animate border-color { duration: Theme.quick; }
        animate width { duration: Theme.quick; easing: ease-out; }
        clip: true;
        Image {
            source: offer.swatch;
            width: 100%; height: 100%;
            image-fit: fill;
            opacity: offer.reach && i != root.lit ? 0.5 : 1;
            animate opacity { duration: Theme.quick; }
        }
        if offer.back : Rectangle {
            background: #000000a8;
            Mono {
                width: parent.width;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "undo";
                color: #ffffffe6;
                font-size: Theme.fs-small;
            }
        }
        // while Tab is held, each capsule carries its number
        if State.assist-tab-held && offer.num > 0 : Keycap {
            ground: true;
            key: offer.num;
        }
        if i == root.hov && root.can-wave : Rectangle {
            x: parent.width - 16px;
            y: 7px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: #000000b8;
            Path {
                x: 3px; y: 3px;
                width: 6px; height: 6px;
                viewbox-width: 6; viewbox-height: 6;
                fill: transparent;
                stroke: root.on-wave ? Theme.danger : Theme.text-mid;
                stroke-width: 1.3px;
                commands: "M0 0 L6 6 M6 0 L0 6";
                animate stroke { duration: Theme.quick; }
            }
        }
    }
    // ask the model outright: "ask" while it has nothing to say, "more" once asked
    ask := Rectangle {
        property <bool> live: root.quiet && (ata.has-hover || State.assist-keys);
        visible: State.assist-can-ask;
        x: root.span;
        y: 0px;
        width: root.cw;
        height: 26px;
        border-radius: 13px;
        border-width: Theme.hair;
        border-color: ata.has-hover ? Theme.text-faint : Theme.line;
        background: ata.pressed ? Theme.well-hi : ata.has-hover ? Theme.well : transparent;
        animate border-color, background { duration: Theme.quick; }
        HorizontalLayout {
            alignment: center;
            LumaInk {
                letters: State.assist-asking ? ["m", "o", "r", "e"] : ["a", "s", "k"];
                ink: root.quiet ? Theme.text-mid : Theme.text-faint;
                size: Theme.fs-small;
                track: 0px;
                live: ask.live;
            }
        }
        ata := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                State.assist-ask();
                State.picker-focus += 1;
            }
        }
    }
    // what the lit capsule does; with the keyboard here and nothing lit, the first choice and the
    // key that moves it forward
    HorizontalLayout {
        x: root.label-x;
        y: 0px;
        width: max(0px, parent.width - self.x);
        height: 26px;
        spacing: 6px;
        alignment: start;
        if root.hint || (root.lit < 0 && State.assist-keys && root.quiet && State.assist-can-ask) : VerticalLayout {
            alignment: center;
            Keycap { key: "tab"; }
        }
        Mono {
            vertical-alignment: center;
            overflow: elide;
            text: root.lit >= 0 ? State.assist-offers[root.lit].title
                : root.hint ? State.assist-offers[State.assist-prime].title
                : "";
            color: root.lit >= 0 ? Theme.text-mid : Theme.text-faint;
            font-size: Theme.fs-small;
        }
        if State.assist-keys && root.lit >= 0 && State.assist-keyed == root.lit : VerticalLayout {
            alignment: center;
            Keycap { key: "tab"; }
        }
    }
    // pinned to the row's left edge: a sized element with no position is centred in its parent
    ta := TouchArea {
        x: 0px; y: 0px;
        width: root.span;
        height: 26px;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if (root.on-wave) {
                // whatever slides under the pointer next shows once the beat has passed
                State.assist-dismiss(root.hov);
                root.shown = -1;
            } else if (root.hov >= 0) {
                State.assist-accept(root.hov);
                State.picker-focus += 1;
            }
        }
    }
}

// Roll a palette: the wide half rolls one and puts it on show at the head of the suggestion row,
// the narrow half opens the drawer that sets what a roll starts from and how far it strays.
export component RollButton inherits Rectangle {
    in-out property <bool> open;
    property <length> more: 22px;
    width: 76px;
    height: Theme.row-h-sm;
    border-radius: Theme.radius-sm;
    border-width: Theme.hair;
    border-color: root.open ? Theme.accent-line : Theme.line;
    animate border-color { duration: Theme.quick; }
    clip: true;
    Rectangle {
        x: 0px; y: 0px;
        width: root.width - root.more;
        height: root.height;
        background: rta.pressed ? Theme.well-hi : rta.has-hover ? Theme.well : transparent;
        animate background { duration: rta.has-hover ? Theme.hover-in : Theme.hover-out; }
        Text {
            y: rta.pressed ? 1px : 0px;
            animate y { duration: Theme.press-throw; }
            width: parent.width;
            height: parent.height;
            text: "roll";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: rta.has-hover ? Theme.text : Theme.text-mid;
            font-size: Theme.fs-small;
            font-weight: 500;
            font-family: Theme.mono;
            letter-spacing: Theme.track-1;
        }
        rta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                State.roll();
                State.picker-focus += 1;
            }
        }
    }
    Rectangle {
        x: root.width - root.more;
        y: 0px;
        width: Theme.hair;
        height: root.height;
        background: Theme.line;
    }
    Rectangle {
        x: root.width - root.more + Theme.hair;
        y: 0px;
        width: root.more - Theme.hair;
        height: root.height;
        background: root.open ? Theme.accent-glow : mta.has-hover ? Theme.well : transparent;
        animate background { duration: Theme.quick; }
        Text {
            width: parent.width;
            height: parent.height;
            text: "▾";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.open ? Theme.accent : mta.has-hover ? Theme.text : Theme.text-dim;
            font-size: Theme.fs-small;
            font-family: Theme.mono;
        }
        mta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.open = !root.open; }
        }
    }
}

// A colour dot centred on (cx, cy), for the roll glyphs.
component RollDot inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <length> d: 4px;
    in property <bool> hollow;
    in property <color> tint;
    x: self.cx - self.d / 2;
    y: self.cy - self.d / 2;
    width: self.d;
    height: self.d;
    border-radius: self.d / 2;
    background: self.hollow ? transparent : self.tint;
    border-width: self.hollow ? 1.2px : 0px;
    border-color: self.tint;
    animate x, y { duration: 160ms; easing: ease-out; }
}

// A roll setting drawn as a picture of what it does, under its name. `stir` is the pointer on it:
// the picture moves the way that setting moves a palette.
component RollGlyph inherits Rectangle {
    in property <int> kind;     // 0..3 the start (around, fresh, mine, wildcard); 10..12 the wildness
    in property <bool> stir;
    width: 48px;
    height: 10px;
    // around: the held stop, ringed, with near hues drawing in to it
    if root.kind == 0 : Rectangle {
        RollDot { cx: 24px; cy: 5px; d: 7px; hollow: true; tint: #4af2b0; }
        RollDot { cx: root.stir ? 15px : 11px; cy: 5px; d: 4px; tint: #38c99a; }
        RollDot { cx: root.stir ? 33px : 37px; cy: 5px; d: 4px; tint: #7ff5c8; }
        RollDot { cx: root.stir ? 9px : 3px; cy: 5px; d: 3px; tint: #2fa883; }
        RollDot { cx: root.stir ? 39px : 45px; cy: 5px; d: 3px; tint: #a8f8db; }
    }
    // fresh: new, evenly spread hues from nothing
    if root.kind == 1 : Rectangle {
        RollDot { cx: root.stir ? 3px : 9px; cy: 5px; tint: #ff6f91; }
        RollDot { cx: root.stir ? 18px : 19px; cy: 5px; tint: #ffd166; }
        RollDot { cx: root.stir ? 30px : 29px; cy: 5px; tint: #4af2b0; }
        RollDot { cx: root.stir ? 45px : 39px; cy: 5px; tint: #5aa7e0; }
    }
    // mine: a palette off your own pile
    if root.kind == 2 : Rectangle {
        Rectangle {
            x: root.stir ? 13px : 11px; y: root.stir ? 0px : 1px;
            width: 26px; height: 4px; border-radius: 2px;
            background: @linear-gradient(90deg, #6b5bd6 0%, #c86bb0 100%);
            opacity: 0.45;
            animate x, y { duration: 160ms; easing: ease-out; }
        }
        Rectangle {
            x: root.stir ? 9px : 11px; y: root.stir ? 6px : 5px;
            width: 26px; height: 4px; border-radius: 2px;
            background: @linear-gradient(90deg, #e07a5f 0%, #f2cc8f 100%);
            animate x, y { duration: 160ms; easing: ease-out; }
        }
    }
    // wildcard: anything, anywhere
    if root.kind == 3 : Rectangle {
        RollDot { cx: 6px; cy: root.stir ? 7px : 2px; d: 3px; tint: #5aa7e0; }
        RollDot { cx: 17px; cy: root.stir ? 2px : 7px; d: 5px; tint: #ff6f91; }
        RollDot { cx: 28px; cy: root.stir ? 8px : 4px; d: 3px; tint: #ffd166; }
        RollDot { cx: 40px; cy: root.stir ? 3px : 7px; d: 4px; tint: #4af2b0; }
    }
    // the wildness: how far the line wanders, stirred up under the pointer
    if root.kind >= 10 : Path {
        x: 2px;
        width: 44px;
        height: root.stir && root.kind > 10 ? 10px : 7px;
        y: (root.height - self.height) / 2;
        viewbox-width: 44;
        viewbox-height: 8;
        fill: transparent;
        stroke: root.kind == 10 ? #5aa7e0 : root.kind == 11 ? #4af2b0 : #ff6f91;
        stroke-width: 1.4px;
        commands: root.kind == 10 ? "M 0 4 L 44 4"
            : root.kind == 11 ? "M 0 4 Q 5.5 0.5 11 4 T 22 4 T 33 4 T 44 4"
            : "M 0 4 L 4 1 L 8 7 L 12 1.5 L 16 7.5 L 20 0.5 L 24 6.5 L 28 2 L 32 7.5 L 36 0.5 L 40 5.5 L 44 3";
        animate height { duration: 160ms; easing: ease-out; }
    }
}

// A row of roll settings, each a name over a picture of it. `base` picks the pictures
// (0 the starts, 10 the wildness).
component RollBank inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    in property <int> base;
    callback picked(int);
    height: 36px;
    border-radius: Theme.radius-sm;
    border-width: Theme.hair;
    border-color: Theme.line;
    clip: true;
    HorizontalLayout {
        spacing: 0;
        for opt[i] in root.options : seg := Rectangle {
            property <bool> on: i == root.index;
            min-width: max(56px, txt.preferred-width + 20px);
            horizontal-stretch: 1;
            background: seg.on ? Theme.accent-glow : sta.pressed ? Theme.well-hi : sta.has-hover ? Theme.well : transparent;
            animate background { duration: sta.has-hover ? Theme.hover-in : Theme.hover-out; }
            if i > 0 : Rectangle { x: 0; width: Theme.hair; background: Theme.line; }
            txt := Text {
                y: 3px;
                height: 18px;
                text: opt;
                vertical-alignment: center; horizontal-alignment: center;
                color: seg.on ? Theme.accent : (sta.has-hover ? Theme.text-mid : Theme.text-dim);
                font-size: Theme.fs-small; font-weight: 700; font-family: Theme.mono;
                letter-spacing: Theme.track-2;
            }
            RollGlyph {
                x: (seg.width - self.width) / 2;
                y: 22px;
                kind: root.base + i;
                stir: sta.has-hover;
                opacity: seg.on ? 1 : sta.has-hover ? 0.85 : 0.4;
                animate opacity { duration: sta.has-hover ? Theme.hover-in : Theme.hover-out; }
            }
            sta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

// What a roll starts from and how far it strays, in a drawer that opens under the roll button.
// Both apply to the next roll; only the roll button rolls.
export component RollDrawer inherits Rectangle {
    in property <bool> open;
    height: root.open ? lay.preferred-height : 0px;
    animate height { duration: 200ms; easing: ease-out; }
    clip: true;
    lay := VerticalLayout {
        x: 0px; y: 0px;
        width: root.width;
        height: self.preferred-height;
        spacing: 6px;
        RollBank {
            options: State.roll-modes;
            index: State.roll-mode;
            base: 0;
            picked(i) => { State.roll-choose(i, State.roll-wild); }
        }
        RollBank {
            options: State.roll-wilds;
            index: State.roll-wild;
            base: 10;
            picked(i) => { State.roll-choose(State.roll-mode, i); }
        }
    }
}
