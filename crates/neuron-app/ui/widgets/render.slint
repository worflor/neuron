import { Theme } from "../theme.slint";
import { Pill } from "controls.slint";

// DEVICE RENDER — the auto-generated picture of the peripheral itself, LEDs live.
//
// Built procedurally from what the registry actually knows (rows × cols + the device kind) and
// NOTHING it doesn't: a keyboard is a bezel around a keycap lattice, a mouse with a handful of
// LED zones is a chassis with placed zone pads — never fake key legends or invented geometry.
// The cells are bound to the live frame model (`px`), so whatever the device is running (an
// applied effect mirrored through the SAME render_frame math, or the user's painted frame) is
// what this draws. Painting happens directly on the render: one TouchArea over the lattice
// (per-cell areas would grab the pointer and kill drag-sweeps), left paints, right erases.
//
// Ink rules: chassis = hairline monochrome (structure, never accent); the LEDs are the only
// colour, with a soft under-bloom (an oversized translucent twin — cheap in the software
// renderer, reads as light not paint).

export component DeviceRender inherits Rectangle {
    in property <int> rows;
    in property <int> cols;
    in property <[color]> px;          // row-major live frame (the one source of light)
    in property <string> kind;         // registry icon hint: "keyboard" | "mouse" | other
    in property <bool> editable: false; // PAINT mode — pointer paints cells
    callback paint(int);
    callback erase(int);
    // PLACE mode — a SEPARATE gesture from the brush (only one is `enabled` at a time; the panel makes
    // them mutually exclusive). A drag defines a RECTANGLE: the press cell is one corner, the cell under
    // the cursor the opposite one; on release the enclosed cells become the selected layer's region.
    in property <bool> placing: false;
    // the SELECTED layer's COMMITTED region as inclusive corner cells — drawn as a persistent placement
    // outline while placing (so moving/resizing is obvious). place-r0 < 0 = full board (nothing to outline).
    in property <int> place-r0: -1;
    in property <int> place-c0: -1;
    in property <int> place-r1: -1;
    in property <int> place-c1: -1;
    callback place-region(int, int, int, int); // (row0, col0, row1, col1) on release — the enclosed rect, normalised

    // a mouse with a handful of LEDs is ZONES on a body, not a lattice (honest geometry).
    property <bool> zone-mode: root.kind == "mouse" && root.rows * root.cols <= 4;

    background: transparent;

    // ── keyboard / generic chassis + lattice ─────────────────────────────
    if !root.zone-mode : Rectangle {
        // bezel — the instrument's body. Stroke only; the void shows through.
        x: parent.width * 4%;
        y: parent.height * 4%;
        width: parent.width * 92%;
        height: parent.height * 92%;
        border-radius: Theme.radius-case;
        border-width: Theme.hair;
        border-color: Theme.line;
        background: Theme.bg-2;

        // a faint inner field line — where the keys live
        field := Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            border-radius: Theme.radius-case-inner;
            border-width: Theme.hair;
            border-color: Theme.line-soft;
            background: transparent;

            property <length> pad: 10px;
            property <length> gap: 3px;
            property <length> cell: max(2px, min(
                (self.width - 2 * self.pad - (root.cols - 1) * self.gap) / max(1, root.cols),
                (self.height - 2 * self.pad - (root.rows - 1) * self.gap) / max(1, root.rows)));
            // center the lattice in the field so odd aspect ratios don't pile keys in a corner
            property <length> ox: (self.width - root.cols * self.cell - (root.cols - 1) * self.gap) / 2;
            property <length> oy: (self.height - root.rows * self.cell - (root.rows - 1) * self.gap) / 2;

            // under-bloom: an oversized translucent twin behind each cap — lit caps glow,
            // unlit caps (the dark well colour) vanish into the void. No comparisons needed.
            for p[i] in root.px : Rectangle {
                property <int> gr: floor(i / root.cols);
                property <int> gc: mod(i, root.cols);
                x: field.ox + gc * (field.cell + field.gap) - 4px;
                y: field.oy + gr * (field.cell + field.gap) - 4px;
                width: field.cell + 8px;
                height: field.cell + 8px;
                border-radius: field.cell / 2;
                background: p.with-alpha(Theme.bloom);
            }
            // the keycaps themselves
            for p[i] in root.px : Rectangle {
                property <int> gr: floor(i / root.cols);
                property <int> gc: mod(i, root.cols);
                x: field.ox + gc * (field.cell + field.gap);
                y: field.oy + gr * (field.cell + field.gap);
                width: field.cell;
                height: field.cell;
                border-radius: max(1px, field.cell / 4);
                background: p;
                border-width: Theme.hair;
                border-color: brush.has-hover && root.editable && i == brush.hover-cell
                    ? Theme.text-faint : Theme.line-soft;
            }

            // the PLACEMENT rectangle — the live drag (bright) while placing, else the selected layer's
            // committed region (persistent), shown ONLY while in place mode so the normal render stays
            // calm. Reuses the active-cell ink (accent line + glow) and the render's OWN cell math, so it
            // snaps to the exact lattice the caps sit on. A plain Rectangle never grabs input, so it can't
            // shadow the placer beneath it.
            if root.placing && (placer.dragging || root.place-r0 >= 0) : Rectangle {
                property <bool> live: placer.dragging;                       // dragging wins over the committed outline
                property <int> r0: self.live ? min(placer.ar, placer.cr) : root.place-r0;
                property <int> c0: self.live ? min(placer.ac, placer.cc) : root.place-c0;
                property <int> r1: self.live ? max(placer.ar, placer.cr) : root.place-r1;
                property <int> c1: self.live ? max(placer.ac, placer.cc) : root.place-c1;
                x: field.ox + self.c0 * (field.cell + field.gap) - 3px;
                y: field.oy + self.r0 * (field.cell + field.gap) - 3px;
                width: (self.c1 - self.c0) * (field.cell + field.gap) + field.cell + 6px;
                height: (self.r1 - self.r0) * (field.cell + field.gap) + field.cell + 6px;
                border-radius: Theme.radius-sm;
                border-width: Theme.hair-2;
                border-color: Theme.accent;
                background: Theme.accent-glow;
            }

            brush := TouchArea {
                enabled: root.editable;
                mouse-cursor: root.editable ? MouseCursor.crosshair : MouseCursor.default;
                property <int> hover-cell: self.cell-at(self.mouse-x, self.mouse-y);
                function cell-at(mx: length, my: length) -> int {
                    return clamp(floor((my - field.oy) / (field.cell + field.gap)), 0, root.rows - 1) * root.cols
                         + clamp(floor((mx - field.ox) / (field.cell + field.gap)), 0, root.cols - 1);
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        if (ev.button == PointerEventButton.right) {
                            root.erase(self.cell-at(self.mouse-x, self.mouse-y));
                        } else if (ev.button == PointerEventButton.left) {
                            root.paint(self.cell-at(self.mouse-x, self.mouse-y));
                        }
                    }
                }
                moved => { if (self.pressed) { root.paint(self.cell-at(self.mouse-x, self.mouse-y)); } }
            }

            // PLACE gesture — declared LAST so it sits ON TOP when enabled; when disabled a TouchArea is
            // transparent to input, so the brush beneath still works when NOT placing (only one of the two
            // is ever `enabled`). Mirrors the brush's cell math (row-at / col-at ≡ cell-at split into axes)
            // so the dragged rectangle snaps to the same lattice. Commits the enclosed rect on release.
            placer := TouchArea {
                enabled: root.placing;
                mouse-cursor: root.placing ? MouseCursor.crosshair : MouseCursor.default;
                property <bool> dragging: false;   // a rectangle is being dragged out right now
                property <int> ar;                 // anchor cell row (the press corner)
                property <int> ac;                 // anchor cell col
                property <int> cr;                 // current cell row (the live opposite corner)
                property <int> cc;                 // current cell col
                function row-at(my: length) -> int {
                    return clamp(floor((my - field.oy) / (field.cell + field.gap)), 0, root.rows - 1);
                }
                function col-at(mx: length) -> int {
                    return clamp(floor((mx - field.ox) / (field.cell + field.gap)), 0, root.cols - 1);
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.ar = self.row-at(self.mouse-y);
                        self.ac = self.col-at(self.mouse-x);
                        self.cr = self.ar;
                        self.cc = self.ac;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up && self.dragging) {
                        self.dragging = false;
                        // require actual movement: a stray click (end cell == the anchor) commits NOTHING,
                        // so it can't collapse the layer to a 1×1 region. A real drag normalises its two
                        // corners into (min, max) so a drag in ANY direction is a valid rect.
                        if (self.cr != self.ar || self.cc != self.ac) {
                            root.place-region(min(self.ar, self.cr), min(self.ac, self.cc),
                                              max(self.ar, self.cr), max(self.ac, self.cc));
                        }
                    }
                }
                moved => {
                    if (self.pressed && self.dragging) {
                        self.cr = self.row-at(self.mouse-y);
                        self.cc = self.col-at(self.mouse-x);
                    }
                }
            }
        }
    }

    // ── mouse chassis + zone pads (≤4 LEDs — zones, not a lattice) ───────
    if root.zone-mode : Rectangle {
        body := Rectangle {
            // the mouse body — a tall capsule, centered
            width: min(parent.width * 38%, parent.height * 64%);
            height: parent.height * 86%;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2.2;
            border-width: Theme.hair;
            border-color: Theme.line;
            background: Theme.bg-2;

            // button split line (upper third) + wheel slot — silhouette cues, ink only
            Rectangle {
                x: parent.width / 2;
                y: parent.height * 4%;
                width: Theme.hair;
                height: parent.height * 24%;
                background: Theme.line;
            }

            // zone pads — one per LED, placed where mouse zones actually live
            // (0 = scroll wheel, 1 = logo, 2/3 = side strips). Colour = the live frame.
            // bloom twins first (light sits UNDER the pad, not as a wash over it)…
            for p[i] in root.px : Rectangle {
                property <length> pw: body.width * 26%;
                width: self.pw + 10px;
                height: (i == 0 ? body.height * 12% : self.pw) + 10px;
                x: (i == 2 ? body.width * 12% : i == 3 ? body.width * 62% : (body.width - self.pw) / 2) - 5px;
                y: (i == 0 ? body.height * 10%
                    : i == 1 ? body.height * 52%
                    : body.height * 36%) - 5px;
                border-radius: self.width / 2;
                background: p.with-alpha(Theme.bloom);
            }
            // …then the pads themselves
            for p[i] in root.px : Rectangle {
                property <length> pw: body.width * 26%;
                width: self.pw;
                height: i == 0 ? body.height * 12% : self.pw;
                x: (i == 2 ? body.width * 12% : i == 3 ? body.width * 62% : (body.width - self.width) / 2);
                y: i == 0 ? body.height * 10%
                    : i == 1 ? body.height * 52%
                    : body.height * 36%;
                border-radius: i == 0 ? 4px : self.width / 2;
                background: p;
                border-width: Theme.hair;
                border-color: zta.has-hover && root.editable ? Theme.text-faint : Theme.line-soft;
                zta := TouchArea {
                    enabled: root.editable;
                    mouse-cursor: root.editable ? MouseCursor.crosshair : MouseCursor.default;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            if (ev.button == PointerEventButton.right) { root.erase(i); }
                            else if (ev.button == PointerEventButton.left) { root.paint(i); }
                        }
                    }
                }
            }
        }
        // honesty note: zone positions are approximate (the registry knows counts, not microns).
        // Dressed as the established caveat idiom — a small text-faint Pill, kin to "FIXED IN FIRMWARE"
        // on the device pane — so a rendered qualifier reads as a real chip, not a bare raw-offset label.
        Pill {
            text: "ZONES APPROXIMATE";
            tint: Theme.text-faint;
            x: parent.width - self.width - 6px;
            y: parent.height - self.height - 4px;
        }
    }
}
