// The GUIDE content registry — the data behind the in-app help popup. Each guide is pure DATA: an id
// (matched against State.guide-active-id), a title, and a list of sections. A section is a bold heading
// over a list of BLOCKS, where each block is either PROSE (rendered in quiet sans) or CODE (rendered in
// a mono code cell, like the editor). The GuidePopup (app.slint) renders the active guide straight off
// this model, so adding help is data + a dropped GuideButton — never new UI.
//
// To add a guide: append a GuideEntry below, then drop `GuideButton { guide-id: "<your-id>"; }` next
// to the relevant header. That's it — the popup, the tooltip<->sticky window, the X, and the scroll
// all come for free.

// One block within a section: a paragraph of prose, OR a snippet of code. `code: true` flips the
// renderer from sans-prose to a mono code cell. Keep code lines short (~44 chars) so they don't wrap.
export struct GuideBlock {
    code: bool,
    text: string,
}

// One section of a guide — a bold heading over a list of prose / code blocks.
export struct GuideSection {
    head: string,
    blocks: [GuideBlock],
}

// One whole guide — selected by `id`, titled in the popup's title bar, bodied by its sections.
export struct GuideEntry {
    id: string,
    title: string,
    sections: [GuideSection],
}

export global GuideContent {
    // The WORKSHOP guide is a BUILD guide that climbs gently: from "anyone can write this" (plain
    // keystrokes) to "it reacts to me" (ctx as input) to the deep power (drive the device, sense,
    // remember, compose), then closes with the no-code + no-limit escape hatches. Every section is a
    // paste-able recipe, never engine exposition. The order is the lesson — keep the ramp intact.
    out property <[GuideEntry]> guides: [
        {
            id: "macros",
            title: "MACROS \u{00b7} WORKSHOP",
            sections: [
                {
                    head: "Your first macro",
                    blocks: [
                        { code: false, text: "A macro is a Python function. Its body runs every time you press the control you bind it to." },
                        { code: true, text: "def macro(ctx):\n    neuron.type_text(\"on my way!\")" },
                        { code: false, text: "Paste it, bind it on this page, press the key. Testing in the Workshop is disarmed: you see what a macro would do, its asks and notifications, but nothing types or clicks. You can't break anything while you learn." },
                    ],
                },
                {
                    head: "The everyday verbs",
                    blocks: [
                        { code: false, text: "Most macros are just the keystrokes and clicks you'd rather not do by hand." },
                        { code: true, text: "neuron.type_text(\"...\")     # type a string\nneuron.hotkey(\"ctrl\", \"s\")  # a chord\nneuron.key(\"enter\")         # one key\nneuron.click(\"right\")       # a mouse click\nneuron.run(\"notepad\")       # run a program" },
                        { code: false, text: "Also handy: type_ghost (slow, organic typing that lands in chats and games), scroll, mouse_to, clipboard_get, clipboard_set, focus(title), sleep(ms). Chain a few and you've automated a routine." },
                    ],
                },
                {
                    head: "Make it react",
                    blocks: [
                        { code: false, text: "ctx is a snapshot of the moment you pressed. Read from it and one macro behaves differently depending on where you are." },
                        { code: true, text: "def macro(ctx):\n    # SHOUT the highlighted text\n    neuron.type_text(ctx.selection.upper())\n\ndef macro(ctx):\n    if \"code\" in ctx.app:    # editor only\n        neuron.hotkey(\"ctrl\", \"/\")" },
                        { code: false, text: "What you get: ctx.app, ctx.title, ctx.selection, ctx.clipboard, ctx.cwd." },
                    ],
                },
                {
                    head: "Ask before acting",
                    blocks: [
                        { code: false, text: "A macro can stop and ask you. A small radial appears at the cursor and blocks this macro only, never the rest of your input." },
                        { code: true, text: "if neuron.ask(\"deploy?\"):\n    ...\npick = neuron.choose(\"profile?\",\n    [\"gaming\", \"work\", \"quiet\"])\nif neuron.confirm(\"wipe disk\"):\n    return   # swipe = stop, ignore = go" },
                        { code: false, text: "Flick to answer, or ignore it and take the default. confirm is a one-swipe pause to review: leave it alone and the macro keeps going." },
                    ],
                },
                {
                    head: "Drive Neuron itself",
                    blocks: [
                        { code: false, text: "A macro can drive the app and your device, exactly like a bound action. That's how you build a one-press scene." },
                        { code: true, text: "def macro(ctx):\n    neuron.profile(\"gaming\")\n    neuron.dpi(1600)\n    neuron.mic_mute(\"off\")" },
                        { code: false, text: "Verbs: dpi, dpi_cycle, scroll_cycle, profile, profile_cycle, brightness, mic_mute, out_mute, mic_gain, out_gain. Each one is the real write, the same as flipping it in the UI." },
                    ],
                },
                {
                    head: "Read state, then branch",
                    blocks: [
                        { code: false, text: "Macros can read live state and decide based on it." },
                        { code: true, text: "def macro(ctx):\n    b = neuron.battery()\n    if b and b[\"percent\"] < 15:\n        neuron.profile(\"powersave\")" },
                        { code: false, text: "Readers: battery() gives percent and charging, plus current_dpi(), active_profile(), scroll_stage()." },
                    ],
                },
                {
                    head: "Give it a memory",
                    blocks: [
                        { code: false, text: "store and load persist per macro across restarts. That's how you build toggles and counters." },
                        { code: true, text: "def macro(ctx):             # a DPI toggle\n    on = not neuron.load(\"on\", False)\n    neuron.store(\"on\", on)\n    neuron.dpi(3200 if on else 800)\n    neuron.notify(\"on\" if on else \"off\")" },
                    ],
                },
                {
                    head: "Compose small macros",
                    blocks: [
                        { code: false, text: "Keep each macro to one job, then wire them together. invoke() runs another by name and hands back its result. option() reads a knob you declared in NEURON_OPTIONS, so one macro can serve several uses." },
                        { code: true, text: "def macro(ctx):\n    neuron.invoke(\"mute_all\")   # run, wait\n    if neuron.invoke(\"is_clean\"):\n        neuron.invoke(\"deploy\", wait=False)\n    speed = neuron.option(\"spd\", \"fast\")" },
                    ],
                },
                {
                    head: "No code, or no limits",
                    blocks: [
                        { code: false, text: "Two ways past the basics. If you'd rather not write Python, every macro is also a drag-and-drop block tree, and it converts back to code without losing anything. If you need more than the toolkit, the engine underneath is real CPython in its own process: import anything, open files, call Win32 through ctypes, hit the network. A crash only takes down that sidecar, which respawns, and your input never stutters." },
                    ],
                },
            ],
        },
    ];
}
