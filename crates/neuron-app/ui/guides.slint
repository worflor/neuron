// The GUIDE content registry — the data behind the in-app help popup. Each guide is pure DATA: an id
// (matched against State.guide-active-id), a title, and a list of sections. A section is a bold heading
// over a list of BLOCKS, where each block is either PROSE (rendered in quiet sans) or CODE (rendered in
// a mono code cell, like the editor). The GuidePopup (app.slint) renders the active guide straight off
// this model, so adding help is data + a dropped GuideButton — never new UI.
//
// To add a guide: append a GuideEntry below, then drop `GuideButton { guide-id: "<your-id>"; }` next
// to the relevant header. That's it — the popup, the tooltip<->sticky window, the X, and the scroll
// all come for free.

// One block within a section: a paragraph of prose, OR a snippet of code. `code: true` flips the
// renderer from sans-prose to a mono code cell. Keep code lines short (~44 chars) so they don't wrap.
export struct GuideBlock {
    code: bool,
    text: string,
}

// One section of a guide — a bold heading over a list of prose / code blocks.
export struct GuideSection {
    head: string,
    blocks: [GuideBlock],
}

// One whole guide — selected by `id`, titled in the popup's title bar, bodied by its sections.
export struct GuideEntry {
    id: string,
    title: string,
    sections: [GuideSection],
}

export global GuideContent {
    // The WORKSHOP guide is a BUILD guide that climbs: your FIRST macro types, your SECOND reacts
    // (ctx), your THIRD hits an API — then the toolbox, asking, memory, SHARED state across macros
    // (the librarian pattern), the device verbs, and the no-code / no-limit escape hatches. Every
    // section is a paste-able recipe grounded in the REAL prelude (runtime/host/neuron.py), never
    // engine exposition. The order is the lesson — keep the ramp intact. (ctx.selection is always
    // None on Windows today — never teach it.)
    out property <[GuideEntry]> guides: [
        {
            id: "macros",
            title: "MACROS \u{00b7} WORKSHOP",
            sections: [
                {
                    head: "Your first macro",
                    blocks: [
                        { code: false, text: "A macro is a Python function. It runs every time you press the control you bind it to." },
                        { code: true, text: "def macro(ctx):\n    neuron.type_text(\"on my way!\")" },
                        { code: false, text: "Paste it, bind it on this page, press the key. The Workshop tests disarmed: you see everything a macro would do, but nothing actually types or clicks. You can't break anything while you learn." },
                    ],
                },
                {
                    head: "Your second macro: it reacts",
                    blocks: [
                        { code: false, text: "ctx is a snapshot of the moment you pressed. Read it and one key behaves differently wherever you are." },
                        { code: true, text: "def macro(ctx):\n    # shout whatever you copied\n    s = ctx.clipboard or \"\"\n    neuron.type_text(s.upper())\n\ndef macro(ctx):\n    if \"code\" in ctx.app:    # editor only\n        neuron.hotkey(\"ctrl\", \"/\")" },
                        { code: false, text: "You get: ctx.app, ctx.title, ctx.clipboard, and ctx.cwd (the folder, when you're in explorer)." },
                    ],
                },
                {
                    head: "Your third macro: hit an API",
                    blocks: [
                        { code: false, text: "The runtime is full CPython with the whole stdlib: urllib, sockets, json, subprocess. Any API you can reach, a keypress can hit." },
                        { code: true, text: "def macro(ctx):\n    import urllib.request\n    r = urllib.request.urlopen(\n        \"https://wttr.in/?format=%t\")\n    neuron.notify(r.read().decode())" },
                        { code: false, text: "The weather, on a mouse button. Swap the URL for your CI, your home server, a webhook: notify() puts the answer on screen without stealing focus." },
                    ],
                },
                {
                    head: "The everyday verbs",
                    blocks: [
                        { code: false, text: "Most macros are just the keystrokes and clicks you'd rather not do by hand." },
                        { code: true, text: "neuron.type_text(\"...\")     # type a string\nneuron.hotkey(\"ctrl\", \"s\")  # a chord\nneuron.key(\"enter\")         # one key\nneuron.click(\"right\")       # a mouse click\nneuron.run(\"notepad\")       # run a program" },
                        { code: false, text: "Also handy: type_ghost (slow, organic typing that lands in chats and games), scroll, mouse_to, key_down / key_up (holds), clipboard_get, clipboard_set, focus(title), sleep(ms). And run(cmd, wait=True) hands back (exit code, stdout), so the shell doubles as a sensor." },
                    ],
                },
                {
                    head: "Ask before acting",
                    blocks: [
                        { code: false, text: "A macro can stop and ask you. A small radial appears at the cursor and blocks this macro only, never the rest of your input." },
                        { code: true, text: "if neuron.ask(\"deploy?\"):\n    ...\npick = neuron.choose(\"profile?\",\n    [\"gaming\", \"work\", \"quiet\"])\nif neuron.confirm(\"wipe disk\"):\n    return   # swipe = stop, ignore = go" },
                        { code: false, text: "Flick to answer, or ignore it and take the default. confirm is a one-swipe pause: leave it alone and the macro keeps going. Asks work even in SAFE mode, and in the terminal when you run headless." },
                    ],
                },
                {
                    head: "Give it a memory",
                    blocks: [
                        { code: false, text: "store and load persist per macro across restarts, atomic on disk. forget() wipes, stored() shows everything. Toggles and counters fall out." },
                        { code: true, text: "def macro(ctx):             # a DPI toggle\n    on = not neuron.load(\"on\", False)\n    neuron.store(\"on\", on)\n    neuron.dpi(3200 if on else 800)\n    neuron.notify(\"on\" if on else \"off\")" },
                    ],
                },
                {
                    head: "Share state between macros",
                    blocks: [
                        { code: false, text: "Each macro's store is its own, so shared state is a macro that owns the data. Siblings invoke() it: kwargs arrive as its options, and its return value comes back." },
                        { code: true, text: "def macro(ctx):          # counter.py\n    if neuron.option(\"op\") == \"add\":\n        n = neuron.load(\"n\", 0) + 1\n        neuron.store(\"n\", n)\n    return neuron.load(\"n\", 0)" },
                        { code: true, text: "def macro(ctx):          # anywhere else\n    n = neuron.invoke(\"counter\", op=\"add\")\n    neuron.notify(f\"count: {n}\")" },
                        { code: false, text: "invoke runs the sibling inline and waits; wait=False queues it and moves on. A failed invoke returns None instead of raising, and nesting stops at 16 deep. Small macros, wired together, is the whole style." },
                    ],
                },
                {
                    head: "Drive the device",
                    blocks: [
                        { code: false, text: "When you do want the hardware: a macro drives Neuron exactly like a bound action, same verified writes, same confirmation cards. One press, whole setup:" },
                        { code: true, text: "def macro(ctx):\n    neuron.profile(\"gaming\")\n    neuron.dpi(1600)\n    neuron.mic_mute(\"off\")" },
                        { code: false, text: "Writes: dpi, dpi_cycle, scroll_cycle, profile, profile_cycle, brightness, mic_mute, out_mute, mic_gain, out_gain. Reads: battery() (percent + charging), current_dpi(), active_profile(), scroll_stage()." },
                        { code: false, text: "And signal(channel, value) drives the Signal lighting layer: paint it anywhere on the LIGHTING page, then any script can light it. signal(1, 1.0) when CI breaks, signal(1, 0.0) when it heals; the value picks the colour on the layer's gradient and stays until you change it." },
                    ],
                },
                {
                    head: "Drive OBS, and let OBS drive you",
                    blocks: [
                        { code: false, text: "With CONNECTIONS + obs on (SYSTEM page), OBS is bindable with no code at all: the action picker's obs entry does stream, record, pause, replay (\"clip that!\"), scene switches, and input mute from any key, wedge, or gesture. Macros get the same verbs and more: obs_scene(name), obs_stream(), obs_record(), obs_replay(), obs_mute(), and obs_request() for anything else in the obs-websocket API. Reads: obs_scene_name(), obs_streaming(), obs_recording(), obs_connected()." },
                        { code: false, text: "It runs the other way too. Name a macro on_obs_scene, on_obs_stream, or on_obs_record and Neuron fires it whenever OBS changes that state. Going live can set your profile, your DPI, and your mic in one motion:" },
                        { code: true, text: "def macro(ctx):          # on_obs_stream.py\n    if neuron.obs_streaming():\n        neuron.profile(\"streaming\")\n        neuron.mic_mute(\"off\")\n    else:\n        neuron.profile(\"default\")" },
                    ],
                },
                {
                    head: "No code, or no limits",
                    blocks: [
                        { code: false, text: "Rather not write Python? Every macro is also a drag-and-drop block tree, and it converts back to code without losing anything." },
                        { code: false, text: "Need more? It's real CPython in its own process: import anything, open files and sockets, call Win32 through ctypes, spawn threads, even loop forever as a watcher (a busy macro only ever blocks its own queue). No pip in the bundled runtime: point NEURON_PYTHON at your own interpreter, or sys.path.append a folder. A crash only takes down the sidecar, which respawns; your input never stutters. The helpers respect SAFE mode; raw ctypes is your own rope." },
                    ],
                },
            ],
        },
        {
            id: "spell-assist",
            title: "SPELL ASSIST",
            sections: [
                {
                    head: "What assist does",
                    blocks: [
                        { code: false, text: "When you draw a spell, Neuron scores how close your stroke is to each glyph you've taught. Assist is how far past the strict gate a near-miss may sit and still snap to the closest spell." },
                        { code: false, text: "At 0 (off) only a clean match fires. Nudge it up and a slightly-off stroke still lands — but only when one spell is a clear winner, never when two are close (it won't guess between them)." },
                        { code: false, text: "Higher is more forgiving, with more chance of the wrong spell. Lower is stricter, with more misses. A cast that only landed because assist helped tells you so." },
                    ],
                },
            ],
        },
        {
            id: "spectrum",
            title: "SPECTRUM \u{00b7} MOTION",
            sections: [
                {
                    head: "Stops",
                    blocks: [
                        { code: false, text: "A stop is one colour pinned at a spot along the strip. One stop is a solid colour; add more and the colours blend between them into a gradient." },
                        { code: false, text: "Click a stop to recolour it, drag it to move it, + adds one beside the selected stop, − removes it. The strip is the board's colours, left to right." },
                    ],
                },
                {
                    head: "Motion",
                    blocks: [
                        { code: false, text: "Motion is how those colours move over time:" },
                        { code: false, text: "HOLD stays still. DRIFT slides the gradient along the board. CYCLE rotates the hues through the wheel. BREATHE fades the whole thing up and down. FLOW is a soft, organic wander." },
                        { code: false, text: "Speed paces every motion but HOLD. BREATHE adds a depth knob (how far it dims); FLOW adds a chaos knob (how restless the wander)." },
                    ],
                },
            ],
        },
    ];
}
