// The single shared State global — every property the Rust runtime pushes into the view, and
// every callback the view invokes back. One global = the Rust glue binds one object and the panels
// read/write `State.*`. This is the GUI's whole API to the engine.
//
// NAVIGATION (the void/Zune cull): FOUR top-level sections, indexed 0..3 —
//   0 Device   1 Lighting   2 Input   3 System
// Bindings + Spellweaving fold under INPUT (DIRECT/WEAVE); Profiles is a sheet; Audio (mic =
// Actions), Radial (folded into Spellweaving), and Import (a wizard flow) aren't top-level seats.

import {
    DeviceRow, ChromaDeviceRow, ChromaStreamRow, RuleRow, ProfileRow, AppRuleRow, EffectRow, RadialSector, GlyphChip, ImportLine,
    DiagRow, ActionChoice, OrganRow, MaterialCard, KnobRow, PingKind,
    PocketCard, BeaconMacro, RhythmBindRow, MacroBlock, MacroCard, EffectTile, EffectParam,
    SpectrumStop, SpectrumFrame
} from "models.slint";

export global State {
    // ── global runtime status (mirrored in the header + tray) ────────────
    in-out property <bool> writes-paused: false;     // the device-write safety gate switch
    in-out property <bool> input-armed: false;       // SAFE-MODE gate: real SendInput is a no-op unless ARMED
    // ARM STANCE — one selector over the two gates above (the header pills still read the bools live):
    // 0 OBSERVE (paused + safe) · 1 DEVICE (writes on, safe) · 2 INPUT (synth on, paused) · 3 LIVE (both).
    in-out property <int> arm-stance: 0;
    callback set-arm-stance(int);
    in-out property <bool> hypershift-on: false;     // software hold-layer active
    in-out property <bool> runtime-active: false;    // the LIVE dispatch loop is running
    in-out property <string> active-profile: "—";
    // ABOUT nameplate — set once at startup by the runtime (version from CARGO_PKG_VERSION, run dir)
    in-out property <string> app-version: "";
    in-out property <string> run-dir: "";
    in-out property <string> status-line: "ready";   // the live status readout
    in-out property <string> status-kind: "info";    // "info" | "err" — failures get the alarm tint
    in-out property <bool> status-stale: false;      // message has aged out (dim it — freshness is honest)
    in-out property <string> focused-app: "—";       // app-aware switch input

    // ── LIVE DISPATCH readouts (pushed from the worker thread) ───────────
    in-out property <string> live-last-trigger: "—"; // last trigger the engine fired
    in-out property <string> live-last-action: "—";  // its action result line
    in-out property <string> live-held: "";          // currently-held HyperShift layer(s)
    in-out property <int> live-fired: 0;             // total triggers dispatched this session

    // ── press-to-bind capture (shared overlay) ───────────────────────────
    in-out property <bool> capture-active: false;     // a press-to-bind capture is in flight
    in-out property <string> capture-prompt: "";      // "press the control you want…"
    callback cancel-capture();

    // ── BEACON (two-part macros: a python macro is asking yes/no) ────────
    in-out property <bool> beacon-active: false;      // a prompt is presented at the cursor
    in-out property <string> beacon-text: "";         // "macro · question"
    in-out property <string> beacon-macro: "";        // the id of the macro presenting right now ("" = none)
    in-out property <string> beacon-hint: "";         // the answer gesture, spelled out
    in-out property <int> beacon-count: 0;            // presented + queued prompts
    // the macros whose source calls neuron.ask — the SYSTEM panel's live BEACONS registry. Refreshed
    // at startup + after a macro save. `test-beacon` MOCK-fires one (real ask, no real-world effects).
    in-out property <[BeaconMacro]> beacon-macros;
    callback test-beacon(string);                     // macro id → mock-fire it so its real beacon rises
    callback delete-beacon(string);                   // macro id → delete its .py from disk (refreshes registry)

    // ── navigation ───────────────────────────────────────────────────────
    in-out property <int> page: 0;                   // selected section (0..3: DEVICE LIGHTING INPUT SYSTEM)
    in-out property <int> input-view: 0;             // INPUT depth: 0 = DIRECT (bindings), 1 = WEAVE (spellweaving)
    // is the WINDOW actually on screen (vs hidden in the tray)? main.rs flips it on show/close, so a
    // page's animation timers can stand down when nothing's visible — no rendering an unseen page.
    in-out property <bool> window-shown: false;
    // a cross-panel "jump to the macro editor" request: set by the SYSTEM→BEACONS "author a macro"
    // link, consumed ONCE by the INPUT→DIRECT page Flickable (app.slint), which scrolls to MACRO.
    in-out property <bool> macro-jump-pending: false;
    in-out property <string> gesture-predict: "";    // live "what the stroke is becoming" (chip highlight)
    callback try-teleport();                         // prime teleport on a plain hold (no rhythm needed)
    callback try-whiteboard();                       // open a whiteboard session right now
    in-out property <bool> profile-sheet-open: false; // the PROFILES sheet (a global affordance, not a section)

    // ── GUIDE — the in-app help system (a "book button" opens a popup). The popup is a CLICK-AWAY
    // TOOLTIP by default; DRAG its title bar and it promotes to a STICKY, draggable window with an X.
    // Content is data-driven (GuideContent in guides.slint) and selected by `guide-active-id`, so a
    // new guide = add data + drop a GuideButton (no new wiring). The popup lives at the window root.
    in-out property <bool> guide-open: false;        // the popup is showing
    in-out property <string> guide-active-id;        // which guide (matches a GuideContent.guides[].id)
    in-out property <bool> guide-sticky: false;      // false = tooltip (click-away closes) · true = pinned window
    in-out property <length> guide-x;                // popup top-left (the popup clamps it on-screen)
    in-out property <length> guide-y;
    callback guide-toggle(string, length, length);   // (id, anchor-x, anchor-y) — open at the button, or toggle off if same
    callback guide-make-sticky();                    // promote tooltip -> pinned (the instant a title-bar drag begins)
    callback guide-move(length, length);             // (x, y) — reposition the pinned popup
    callback guide-close();                          // hide it

    // ── Device (merged Dashboard + Performance) ──────────────────────────
    in-out property <[DeviceRow]> devices;
    // ONE dim footnote line under the device deck: our vendor's pipes that no dialect can frame
    // (the audio sidecars). INVENTORY, not channels — their functional faces already list as device
    // rows — so glue answers "why isn't my pipe a channel" in one elided line. "" = none this scan.
    in-out property <string> unclaimed-note: "";
    in-out property <int> selected-device: 0;        // index into devices
    in-out property <string> selected-device-name: "—"; // the channel every per-device panel tunes
    // the selected device's KIND drives which control cards the panel shows (a mic shows volume/mute,
    // a mouse shows DPI/polling/sniper). "" = nothing selected. Set on refresh + on select.
    in-out property <string> selected-device-kind: ""; // mouse | keyboard | device | mic | output
    // the SELECTED device's capabilities (from its descriptor) — the panel shows a control only when
    // the device can actually do it. Set on selection from the chosen row's cap-* flags.
    in-out property <bool> sel-can-dpi: false;
    in-out property <bool> sel-can-poll: false;
    in-out property <bool> sel-can-light: false;
    in-out property <bool> sel-can-bright-set: false;
    in-out property <bool> sel-can-scroll: false;
    in-out property <bool> sel-can-store: false;
    in-out property <bool> sel-can-idle: false;
    // the selected device has swappable SIDE PLATES (a [side_plates] map). When true, the DEVICE page
    // surfaces the last plate the mouse pushed. The plate is push-only (no getter) — see selected-plate.
    in-out property <bool> sel-can-plate: false;
    // the last side-plate label the mouse pushed ("12-button" / "6-button" / "detached"); "" = unknown
    // yet. Seeded on selection from the last-known plate; kept fresh by a light poll while the app runs.
    in-out property <string> selected-plate: "";
    // EXTENDED HyperPolling (>1000Hz, the 0x00/0x40 path) — true ONLY for known extended PIDs (the
    // HyperPolling Wireless Dongle + Viper-8K-class). The Naga's stock dongle is legacy-capped at
    // 1000Hz, so this is false for it and the HYPERPOLLING card shows an honest "use REPORT RATE" note.
    in-out property <bool> sel-can-hyperpoll: false;
    // the selected KEYBOARD exposes the FIRMWARE game mode (the FN+F10 Win-key kill / GAME_LED). When
    // true, the KEY GUARD card shows its device-side sibling row beside the host-chord rail.
    in-out property <bool> sel-can-game-mode: false;
    // live state of that firmware game mode (true = the board is eating the Win key in firmware).
    // Seeded from the perf-snapshot sweep; flipped by toggle-game-mode (which re-reads device truth).
    in-out property <bool> game-mode-on: false;
    // audio-endpoint controls (shown when the selected device is a mic/output): act on the selected
    // endpoint by its id, NOT the system default.
    in-out property <float> device-volume: 50;       // 0..100
    in-out property <bool> device-muted: false;
    // is the selected mic's mute HARDWARE-owned (a registry [events] MuteState def claims this
    // endpoint, e.g. the Seiren V3 Mini)? Gates the device panel between a real OS toggle, a
    // read-only firmware-state pill, and (false on a mic with neither) no mute control at all.
    // Always false for an "output" row — an output's OS mute IS its real mute.
    in-out property <bool> device-mute-hardware: false;
    // the WRITE facet: is there a PROVEN device setter behind this mute (device.slint renders an
    // interactive toggle only when true)? Always true for an "output" row (a render endpoint's OS
    // mute IS a real, writable mute); for a mic, true only when the arming dialect proved a setter —
    // the Seiren (read-only tap-mute) stays false and renders a live indicator instead.
    in-out property <bool> device-mute-writable: false;
    callback set-device-volume(float);
    callback toggle-device-mute();
    callback refresh-devices();
    callback select-device(int);
    callback backup-device(string);                  // unit id (DeviceRow.id)
    in-out property <float> dpi: 1600;
    in-out property <float> polling-hz: 1000;
    in-out property <float> brightness: 75;
    in-out property <bool> persist-to-onboard: false;
    callback set-persist(bool);                      // the ONE write path into the runtime's persist flag
    callback apply-dpi(float);
    callback apply-polling(float);
    callback apply-brightness(float);
    // the EVERYDAY DECK's global commit — one gesture for the whole FEEL tier instead of a per-control
    // apply on each row. `apply-feel` writes every everyday capability the selected device supports
    // (dpi / polling / brightness / dpi-stages) in one go. (Revert is just SCAN — `refresh-devices`
    // re-seeds the controls from the device. The gated ADVANCED writes stay deliberate / per-control;
    // sniper auto-saves; persist is immediate — none ride this.)
    callback apply-feel();
    // the FEEL deck's ADVANCED reveal (gated hardware writes) open state. A global, not a local element
    // property on the conditional deck VerticalLayout — that write proved unreliable (clicking the
    // disclosure did nothing). Persists across reselects, which is fine.
    in-out property <bool> feel-adv-open: false;
    // FEEL DIRTY tracking — the everyday-deck's seeded baselines, stamped by glue on every seed (device
    // select / scan / apply). `feel-dirty` is the honest "you have unapplied edits" signal the SCAN⇄APPLY
    // deck reads: any draft that diverges from its baseline flips it, and re-seeding (which re-stamps the
    // baselines to the just-read/just-committed truth) clears it. Only the caps the device actually has
    // count, so a knob the board can't expose never registers as dirt.
    in-out property <float> feel-base-dpi: 1600;
    in-out property <float> feel-base-polling: 1000;
    in-out property <float> feel-base-brightness: 75;
    in-out property <string> feel-base-stages: "800/1600/3200";
    in-out property <int> feel-base-active-stage: 0;
    out property <bool> feel-dirty:
        (root.sel-can-dpi && round(root.dpi) != round(root.feel-base-dpi))
        || (root.sel-can-poll && round(root.polling-hz) != round(root.feel-base-polling))
        || (root.sel-can-bright-set && round(root.brightness) != round(root.feel-base-brightness))
        || (root.sel-can-dpi && root.dpi-stages != root.feel-base-stages)
        || (root.sel-can-dpi && root.dpi-active-stage != root.feel-base-active-stage);

    // ── EVERY perf control Synapse buries (Device panel) ─────────────────
    // DPI STAGE LIST — the cycle, applied as a full table (writes::set_dpi_stages).
    in-out property <string> dpi-stages: "800/1600/3200";  // editable "/"-separated list
    in-out property <[int]> dpi-stage-nums: [800, 1600, 3200]; // parsed stages (chips + fader detents)
    in-out property <int> dpi-active-stage: 0;
    in-out property <bool> dpi-stages-valid: true;
    in-out property <string> dpi-stages-note: "3 stages ready";
    callback dpi-stages-edited(string);              // re-parse the list into dpi-stage-nums
    callback apply-dpi-stages(string, int);
    // SCROLL / HyperScroll stages (gated until class 0x0B is hardware-verified).
    in-out property <string> scroll-stages: "tactile/free";
    in-out property <bool> scroll-stages-valid: true;
    in-out property <string> scroll-stages-note: "2 modes ready";
    callback scroll-stages-edited(string);
    callback apply-scroll-stages(string);
    // SNIPER / hold-to-precision-DPI — bind a button (press-to-bind) + target DPI.
    in-out property <string> sniper-button: "—";
    in-out property <float> sniper-dpi: 400;
    callback capture-sniper-button();
    callback save-sniper(float);
    callback unbind-sniper();       // drop the sniper rule (the split button's right half)
    // SLEEP / idle-off timer (seconds). Read-back shown; write verify-gated (NEURON_IDLE_WRITE).
    in-out property <float> idle-secs: 300;
    in-out property <string> idle-secs-text: "300";
    in-out property <bool> idle-secs-valid: true;
    in-out property <string> idle-secs-note: "300s ready";
    in-out property <string> idle-readout: "—";       // live read of the current device value
    callback idle-edited(string);
    callback apply-idle(float);
    // IN-GAME polling (wired/dongle split). Verify-gated (NEURON_INGAME_POLL_WRITE).
    in-out property <float> ingame-wired-hz: 1000;
    in-out property <float> ingame-dongle-hz: 1000;
    callback apply-ingame-polling(float, float);
    // GAMING MODE / disable-alt-tab (host-side LL hook, no device write).
    // KEY GUARD — a multi-select of OS chords to swallow mid-game (one control, grows by chord, not
    // by a new toggle each time). Each bool is one chip; `apply-gaming-mode` rebuilds the live policy.
    in-out property <bool> disable-alt-tab: false;
    in-out property <bool> disable-win: false;
    in-out property <bool> disable-alt-f4: false;
    in-out property <bool> disable-alt-esc: false;
    // The ONE "is any live key-guard active?" predicate — derived over ALL four chips. Every consumer
    // (the LIVE capture preview, any future badge) reads THIS, so adding a chord above can't leave a
    // hand-inlined OR behind out of sync. Grows by chord, exactly as the KEY GUARD note above intends.
    in-out property <bool> gaming-live: disable-alt-tab || disable-win || disable-alt-f4 || disable-alt-esc;
    callback apply-gaming-mode();
    // flip the keyboard's FIRMWARE game mode (the device-side Win-key kill). The glue writes via the
    // verify-gated capability setter, re-reads device truth, and updates game-mode-on to match.
    callback toggle-game-mode();
    // LIFT-OFF distance — REAL verify-gated write (symmetric low/med/high). Verify-gated +
    // env-gated (NEURON_LOD_WRITE) until confirmed on hardware; the read-back is the safety net.
    in-out property <int> lod-level: 0;                // 0 low / 1 medium / 2 high
    in-out property <string> lod-readout: "—";         // live read of the current device level
    callback apply-lod(int);
    // ASYMMETRIC LIFT-OFF (separate lift vs landing) — the Focus-Pro-30K flex. `lod-async` picks
    // even (false) vs split (true); the split pair rides lod-lift (2..26) / lod-land (1..25).
    // Verify-gated (writes::set_lift_off_asymmetric re-reads 0x0B/0x85). razerctl-derived.
    in-out property <bool> lod-async: false;           // false = even (symmetric), true = split
    in-out property <int> lod-lift: 8;                 // lift-off level 2..26 (async mode)
    in-out property <int> lod-land: 8;                 // landing level 1..25 (async mode)
    callback apply-lod-async(int, int);
    // DEBOUNCE — honest hardware-pending stub (greyed, [gated]); no opcode known.
    in-out property <bool> debounce-supported: false;
    in-out property <string> perf-status: "";          // last perf-control result line

    // ── Lighting ─────────────────────────────────────────────────────────
    in-out property <[EffectRow]> effects;            // the full set (tray + apply key on idx order)
    in-out property <[EffectRow]> effects-fw;          // firmware-native bank (display)
    in-out property <[EffectRow]> effects-sw;          // Neuron-computed bank (display)
    in-out property <int> selected-effect: -1;       // the cursor (browsing) — hairline, never accent
    in-out property <int> applied-effect: -1;        // what the DEVICE is actually running — the accent
    in-out property <string> light-color: "4af2b0";  // hex RRGGBB (the phosphor accent default; lowercase to match Palette.accent)
    in-out property <bool> light-color-valid: true;  // live parse verdict for the hex field
    in-out property <color> brush-color: #4af2b0;     // parsed brush colour (Rust keeps in sync)
    in-out property <int> grid-rows: 0;
    in-out property <int> grid-cols: 0;
    in-out property <[color]> grid-px;               // rows*cols, row-major
    in-out property <string> grid-kind: "";          // registry icon hint ("keyboard"/"mouse"/…)
    in-out property <bool> light-paint-mode: false;  // EFFECTS (live render) vs PAINT (per-LED)
    in-out property <bool> animating: false;
    callback preview-tick();                         // mirror the applied effect onto the render
    callback apply-effect(int);                      // effect index -> set on device
    callback stop-animation();
    callback color-changed(string);
    callback paint-cell(int);                        // index into grid-px (paint w/ current color)
    callback erase-cell(int);                        // paint the off colour (right-click erase)
    callback clear-grid();                           // whole frame -> off
    callback fill-grid();                            // whole frame -> brush colour

    // ── Lighting COMPOSITOR — the layered effect studio (a layer = PATTERN × SPECTRUM) ──
    in-out property <int> selected-layer: -1;        // which stacked layer the inspector + spectrum editor act on
    // Lighting AUTO-APPLIES: every edit debounce-streams the current stack to the board (no manual apply
    // button). `compositing` stays as the honest "is the stack live on the device" indicator — set true
    // by the auto-apply stream, false when writes pause. There is no composite-apply/stop transport: the
    // one deliberate "stop writing" is the global writes-pause gate (the header pill / Settings).
    in-out property <bool> compositing: false;       // the stack is streaming live to the device
    callback import-light-file();                    // pick a .ChromaEffects / .synapse3 → frame or layer

    // ── Lighting UNIFIED SURFACE — the render-first, tile-driven page ─────
    // ONE grid of live-preview tiles (effects AND data modes together); picking one plays it on the
    // render and auto-renders its declared params inline (the weave-knobs pattern). The layer stack
    // (above) is the backend; this is the calm front: a single effect is the default, stacking is an
    // optional spatial act, paint is a brush you pick up — no mode toggle, no layers list.
    in-out property <[EffectTile]> light-tiles;       // the grid (effects + data + stub), each a live swatch
    in-out property <string> light-effect: "";        // the active tile's slug (lights the tile, drives the knobs); "" = none
    in-out property <[EffectParam]> light-params;     // the active effect's auto-rendered param controls (range/enum/toggle)
    // STREAM RATE — the frame-rate the live effect runs at, driving BOTH the device stream AND this
    // page's preview (they tick together). Seeded per-device on selection (legacy → 6, matrix → 30);
    // the user tunes from there. Applies to EVERY layer now — vitals streams like any effect, so there's
    // no rate-less readout mode to gate the control off for.
    in-out property <float> light-fps: 30;
    in-out property <bool> light-fps-legacy: false;   // selected board is a slow legacy keyboard (~6 fps)
    in-out property <bool> light-is-readout: false;   // the SELECTED layer is a live device readout (vitals), not a tunable effect
    callback set-light-fps(float);                     // re-pace the live stream + preview together (1–30)
    callback tile-preview-tick();                     // re-render the grid swatches (animated, ~throttled)
    callback pick-tile(string);                       // slug → make it the active single effect, play on render + show knobs
    callback set-param-range(string, float);          // (param key, value) — a slider edit
    callback set-param-enum(string, int);             // (param key, index) — a segment edit
    callback set-param-toggle(string, bool);          // (param key, on) — a switch edit
    // STACK — the optional spatial composite. `light-stack-count` is how many effects are layered
    // (1 = the simple single-effect default; >1 = you stacked). A light strip shows the stack; +stack
    // adds the active effect as another layer; tapping a strip cell selects that layer as the active one.
    in-out property <int> light-stack-count: 0;
    callback stack-current();                          // add the active effect as another layer on top
    callback select-stack(int);                        // make stack layer `i` the active (knobs follow it)
    callback remove-stack(int);                        // drop stack layer `i`
    callback move-stack(int, int);                     // reorder layer `i` in the stack (dir -1 down / +1 up)
    // PAINT — a brush you pick up ON the render (not a top-level mode). Off = effects play; on = your
    // pointer paints cells in the brush colour over the current frame.
    in-out property <bool> light-brush-on: false;     // is the per-key brush picked up?
    callback toggle-brush();                           // pick up / put down the paint brush
    callback push-painted();                           // commit the painted frame to the device
    // PLACE — position THIS layer as a sprite: a drag ON the render defines a RECTANGLE that becomes the
    // SELECTED layer's spatial REGION, so ANY layer (an effect OR the vitals readout) is freely
    // placeable + resizable. A SIBLING gesture to the brush, never the same mode (the two are mutually
    // exclusive on the render). Moving/resizing is just another drag; Reset clears the region → full board.
    in-out property <bool> light-place-on: false;      // is the place-layer gesture active?
    in-out property <bool> light-layer-placed: false;  // the selected layer occupies a sub-region (not the full board)
    in-out property <string> light-place-label: "full board"; // honest placement readout ("full board" / "3×4 block")
    // the SELECTED layer's committed region as INCLUSIVE corner cells (grid row/col coords) — the render
    // draws its persistent placement outline from these while placing. r0 < 0 = full board (no outline).
    in-out property <int> light-place-r0: -1;
    in-out property <int> light-place-c0: -1;
    in-out property <int> light-place-r1: -1;
    in-out property <int> light-place-c1: -1;
    // the STACK selector's per-layer display names (bottom→top), so each stack cell reads as its effect /
    // readout (e.g. "Vitals", "Heat") — the user can SEE and pick which layer to place, vitals included.
    in-out property <[string]> light-stack-labels;
    callback toggle-place();                           // enter / exit the place-layer gesture
    callback set-layer-region(int, int, int, int);     // (row0, col0, row1, col1) — commit the dragged rect as the layer's region
    callback reset-layer-region();                      // clear the region → the layer fills the whole board again

    // ── Lighting SPECTRUM editor — the active layer's COLOUR PROGRAM (the other half of a layer) ──
    // A layer = PATTERN (shape, the knobs above) × SPECTRUM (colour, this block). The active layer is
    // the selected stack layer; these project its spectrum and every edit writes straight back into it
    // (live preview + persistence follow). Phase-4 builds the gradient strip / motion row / timeline
    // against THIS surface — every callback here is fully implemented in the glue.
    //
    // does the active layer carry an editable 1-D spectrum? false for the Screen pattern (Ambient is
    // full-colour, the spectrum is bypassed) and for a DATA readout — the editor hides for those.
    in-out property <bool> light-has-spectrum: false;
    // GRADIENT STRIP — the active palette's stops (the ACTIVE frame's stops when sequenced). A single
    // stop is a solid; click a stop → the shared ColorPicker; +/- add/remove; drag → reposition.
    in-out property <[SpectrumStop]> light-stops;
    // which gradient stop the prism edits — AUTHORITATIVE here (not a view-local cursor) so the glue
    // can SELECT a stop after a structural edit: `add-stop` sets this to the just-inserted stop's
    // post-sort index, delivering the documented "add a stop, select it" contract. The strip writes it
    // directly on click/drag; the editor clamps it into 0..length-1 so a delete never strands the picker.
    in-out property <int> light-sel-stop: 0;
    callback set-stop-color(int, string);              // (stop idx, hex) — recolour a stop
    callback add-stop(float);                          // (at 0..1) — insert a stop (colour sampled there), select it
    callback remove-stop(int);                         // (stop idx) — delete (a palette never drops below 1 stop)
    callback move-stop(int, float);                    // (stop idx, at 0..1) — reposition along the gradient
    // (at 0..1) — the strip's press gesture: glue hit-tests the nearest stop (grab = select) or
    // inserts one on open track, then selects it — so the drag that follows always moves light-sel-stop.
    callback strip-press(float);
    // MOTION row — the active palette's intra-frame animation. `speed` always applies; `depth` only to
    // breathe, `chaos` only to flow (the UI shows the relevant knob by `light-motion`).
    in-out property <string> light-motion: "hold";     // hold | drift | cycle | breathe | flow
    in-out property <float> light-motion-speed: 1.0;
    in-out property <float> light-motion-depth: 0.5;   // breathe dip 0..1
    in-out property <float> light-motion-chaos: 0.5;   // flow octaves 0..1
    callback set-motion(string);                       // kind — keeps speed/depth/chaos across a switch
    callback set-motion-speed(float);
    callback set-motion-depth(float);
    callback set-motion-chaos(float);
    // GRADIENT INTERPOLATION — how colour blends between stops. "rgb" (default, predictable) | "hsv"
    // (perceptual: the shortest hue path, so 2-stop+ gradients stay vivid). Per active-frame palette.
    in-out property <string> light-interp: "rgb";      // rgb | hsv
    callback set-interp(string);                        // rgb | hsv — the gradient colour space
    // TIMELINE / sequencer — the keyframe track. The model `light-seq` is the SINGLE source of truth for
    // the frame count: `light-seq.length` 1 = no sequence (the timeline collapses); >1 = a sequence, with
    // `light-active-frame` the frame the strip + motion above are editing (the scrubber). (There is no
    // redundant length int — every reader/guard reads `light-seq.length`, so the two can never drift.)
    in-out property <[SpectrumFrame]> light-seq;
    in-out property <int> light-active-frame: 0;
    in-out property <string> light-loop: "loop";       // once | loop | pingpong
    callback add-frame();                              // append a keyframe (clone of the active), select it
    callback remove-frame(int);                        // (frame idx) — delete (collapses to a palette at len 1)
    callback move-frame(int, int);                     // (frame idx, dir -1 earlier / +1 later) — reorder
    callback select-frame(int);                        // (frame idx) — make it the active frame (strip/motion edit it)
    callback set-frame-hold(int, float);               // (frame idx, dwell seconds)
    callback set-frame-fade(int, float);               // (frame idx, crossfade-in seconds)
    callback set-frame-ease(int, string);              // (frame idx, linear | smooth | snap)
    callback set-loop(string);                         // once | loop | pingpong

    // ── Bindings (remap + HyperShift + macros + mic-as-Actions) ──────────
    in-out property <[RuleRow]> rules;
    in-out property <[RuleRow]> hypershift-rules;
    // POCKETS — portable clipboards. Each carries its emergent content-sigil + legible summary;
    // rebuilt from neuron-core only when a pocket actually changes (a generation counter).
    in-out property <[PocketCard]> pockets;
    callback reload-bindings();
    callback remove-rule(int);                        // remove a GUI-authored BASE rule by row index
    callback remove-hyper-rule(int);                  // remove a GUI-authored HYPERSHIFT rule by row index
    callback move-rule(int, int);                     // reorder a GUI-authored BASE rule: (row, dir -1 up / +1 down)
    callback move-hyper-rule(int, int);               // reorder a GUI-authored HYPERSHIFT rule: (row, dir)
    // the HyperShift STANCE — hold (momentary, Razer's only mode) | latch (tap on/off) |
    // smart (tap latches, hold is momentary) | one-shot (next press only). Persisted in feel.toml.
    in-out property <string> hypershift-mode: "hold";
    callback set-hypershift-mode(string);
    // the HyperShift HOLD KEY — the control you hold to REACH the second layer (a Noop activator rule
    // on the layer; Rust surfaces it + filters it out of the shifted list). "—" / not-ready when unset.
    in-out property <string> hypershift-hold-label: "—";
    in-out property <bool> hypershift-hold-ready: false;
    callback capture-hypershift-hold();               // press-to-bind the hold key
    callback clear-hypershift-hold();
    // the FEEL timing windows (feel.toml), in ms — the press grammar's forgiveness knobs:
    //   hold = tap↔hold cutoff · gap = max silence between phrase presses · coyote = post-release tail.
    // Seeded from FeelConfig at startup; one callback mirrors set-hypershift-mode (load → set → save → reload).
    in-out property <int> feel-hold-ms: 200;
    in-out property <int> feel-gap-ms: 280;
    in-out property <int> feel-coyote-ms: 120;
    callback set-feel-timing(int, int, int);          // hold_ms, gap_ms, coyote_ms
    in-out property <int> editable-count: 0;          // how many of `rules` are GUI-authored (the tail)
    in-out property <int> editable-hyper-count: 0;    // same for the hypershift column
    // PRESS-TO-BIND a new spine rule: capture the HID control you press, pick an Action, write it to
    // the GUI rules sidecar (profiles/gui.rules.toml). No hardcoded buttons.
    in-out property <string> bind-trigger-label: "—"; // friendly name of the captured trigger
    in-out property <bool> bind-trigger-ready: false; // a trigger has been captured
    in-out property <bool> bind-hypershift: false;    // author this on the HyperShift layer
    // DUPLICATE-TRIGGER honesty: set by glue at capture time when the captured trigger is ALREADY
    // claimed by another rule on the SAME layer (base vs HyperShift). The live dispatch runs EVERY
    // matching rule (executor resolves all, not first-wins), so a second bind doesn't replace — both
    // fire. Surfaced inline by the TriggerWell. "" = no clash (hidden).
    in-out property <string> dup-trigger-note: "";
    // the action being authored — picked from a typed list with one parameter field
    in-out property <[ActionChoice]> action-choices;  // the Action palette (key / run / mic / dpi / …)
    in-out property <int> action-choice: 0;           // selected action index
    in-out property <string> action-param: "";        // the action's parameter (key name / cmd / delta)
    in-out property <[string]> param-suggestions;     // clickable fills for the param (windows / profiles / macros)
    callback action-choice-changed();                  // the picker moved — recompute suggestions
    callback capture-action-param();                   // press-to-fill: capture a key/chord/button into the param
    callback record-action-keys();                     // toggle the key-sequence recorder (REC ⇄ STOP)
    in-out property <bool> recording-keys: false;      // a sequence take is rolling
    callback capture-trigger();                        // start HID control capture for a new bind
    callback add-binding();                            // commit the captured trigger + chosen action
    // EDIT an existing GUI-authored rule IN PLACE: clicking it opens the same wire-editor inline,
    // seeded from its current trigger + action (edit-shows-current). `editing-rule` is the list ROW
    // being edited (-1 = none); `editing-rule-hyper` says which layer's list it lives in (the DIRECT
    // page reuses one RuleList per layer, so the row index alone is ambiguous without it).
    in-out property <int> editing-rule: -1;
    in-out property <bool> editing-rule-hyper: false;
    callback begin-edit-rule(int, bool);               // (row, hyper) open the inline editor for that rule
    callback commit-edit-rule();                        // save the in-place edit (trigger + action)
    callback cancel-edit-rule();                         // close the inline editor without saving
    // mic gain/mute are surfaced here as Actions (no longer a top-level Audio panel)
    in-out property <string> mic-name: "—";
    in-out property <float> mic-gain: 100;
    in-out property <bool> mic-muted: false;
    callback refresh-mic();
    // OUTPUT (render) side — headphones / sound card / speakers volume + mute (Core Audio, generic).
    // The matching bindable Actions are out-gain / out-mute in the palette.
    in-out property <string> out-name: "—";
    in-out property <float> out-gain: 100;
    in-out property <bool> out-muted: false;
    callback refresh-out();
    // macro authoring: write PYTHON -> check (syntax) -> save+register -> test run.
    // A macro is real CPython run warm by the Macro Host sidecar (full power: ctypes/subprocess/
    // anything). `def macro(ctx):` is the entry; `import neuron` gives ctx + key/clipboard/mouse/run.
    in-out property <string> macro-name: "";          // the macro's name (file stem + registry id)
    in-out property <string> macro-source: "";
    in-out property <[string]> macro-dryrun;          // defs found (after check) / log lines (after test)
    in-out property <string> macro-status: "";
    in-out property <bool> macro-busy: false;
    // does the editor source contain a neuron.ask() — gates the self-surfacing "test asks" button.
    // Computed in Rust (Slint 1.16 has no string.contains) via note-macro-source on every edit.
    in-out property <bool> macro-has-ask: false;
    // NODE-BLOCKS CANVAS — the DIRECT-MANIPULATION macro constructor. `macro-code-view` is the two-
    // position switch: false = the blocks canvas (you build the macro by touch), true = the raw Python
    // editor (the CodeArea). The TRUE source of truth is a `Vec<MacroNode>` held in the Rust glue; the
    // canvas mutates THAT tree via the edit-ops below, then Rust regenerates `macro-source` (pure Rust
    // codegen, instant) and re-flattens into `macro-blocks` synchronously — so the canvas + code view
    // never drift. `macro-blocks` is the flat display model (steps + lanes + add-points; see MacroBlock).
    //
    // EDIT-OPS — each mutates the Rust tree, regenerates the source, re-flattens, all instant (no Python):
    //   edit-step(path, value)   set the addressed node's param
    //   add-step(insert, kind)   append a default node of `kind` to the body at `insert`
    //   delete-step(path)        remove the addressed node (an ask takes its branches with it)
    //   move-step(path, dir)     reorder within the node's own body (-1 up / +1 down, clamped)
    //
    // BIDIRECTIONAL SYNC (no loops): a canvas edit regenerates the source AND sets `macro-source-dirty`
    // so the code editor's `edited` hook knows that change came from codegen and skips the re-parse. A
    // change the USER types in code view leaves the flag false → `refresh-macro-blocks` re-parses OFF the
    // UI thread (parse_macro blocks up to FIRE_BUDGET) and, on Ok, RESEEDS the tree + repopulates blocks;
    // on a syntax error it KEEPS the last good blocks (the canvas never blanks) + shows "line N: msg".
    in-out property <bool> macro-code-view: true;    // CODE-first by default; false = the blocks canvas
    in-out property <[MacroBlock]> macro-blocks;
    in-out property <string> macro-parse-error: "";  // "" = ok; else "line N: msg" shown inline
    in-out property <bool> macro-parsing: false;     // a parse is in flight (show a subtle spinner)
    // set true by Rust whenever IT regenerates `macro-source` from the tree (a canvas edit / a parse
    // reseed). The CodeArea's `edited` hook reads + clears it: if it was set, the keystroke was codegen,
    // not a human — skip the re-parse so an edit doesn't loop back through the parser.
    in-out property <bool> macro-source-dirty: false;
    // FOCUS-ON-ADD: set by Rust to the path of a just-added step (or its question field for an `ask`).
    // The rendered step field, on `init`, focuses itself if its path matches, then clears this — so a
    // fresh step is ready to type into with no second click. "" = no pending focus target.
    in-out property <string> macro-focus-path: "";
    callback edit-step(string, string);              // (path, value) -> set the node's param
    callback add-step(string, string);               // (insert-context, kind) -> append a default node
    callback delete-step(string);                    // (path) -> remove the node
    callback move-step(string, int);                 // (path, dir) -> reorder within its body
    callback refresh-macro-blocks(string);           // (source) -> parse off-thread -> reseed tree + set macro-blocks/-error
    callback macro-check(string);                     // ast.parse only — no execution
    callback macro-save(string, string);              // (name, source) -> persist + register warm
    callback macro-test(string, string);              // (name, source) -> register + run once now
    // (name, source) -> register the LIVE editor source + fire_mock so ONLY its neuron.ask() beacons
    // rise (input disarmed — nothing real runs), the SAME pipeline as SYSTEM→BEACONS' test. A safe way
    // to discover + learn the ask/beacon syntax by seeing it work.
    callback test-asks(string, string);
    callback note-macro-source(string);               // editor source edited -> Rust recomputes macro-has-ask
    // THE WORKSHOP CATALOG — every macro on disk, read emergently so users understand their macros
    // without opening the code. Each card carries the plain-English summary (from its nodes), its size,
    // its option count, and the trigger(s) that fire it (cross-ref'd from the loaded rules). Rebuilt on
    // editor open, on reload, and on save. Clicking a card loads that macro into the editor.
    in-out property <[MacroCard]> macro-catalog;
    in-out property <bool> macro-catalog-building: false;  // a catalog rebuild is parsing off-thread
    callback open-macro(string);                       // (id) -> load that macro's source into the editor
    callback delete-macro(string);                     // (id) -> delete its .py from disk, refresh catalog + beacons
    callback reveal-macros();                          // open the macros folder in the OS file manager (made if missing)
    callback reload-macros();                          // re-scan disk -> register dropped-in macros -> rebuild catalog + reload the open macro

    // ── Spellweaving (merged gesture + radial: two facets of the cast engine) ─
    in-out property <[GlyphChip]> glyphs;             // the vault, each chip carrying its bound action
    in-out property <bool> capturing-gesture: false;
    // strokelab: a RICH (Shift+Record) capture is in flight — the full stroke is written to a research
    // file instead of teaching the vault. Drives the panel's distinct "different mode" amber treatment.
    in-out property <bool> rich-capturing: false;
    // live Shift state, polled by the weave page while it's on-screen — previews the rich-mode
    // affordance on the Record button the instant Shift goes down, before you commit to a capture.
    in-out property <bool> shift-armed: false;
    callback poll-shift() -> bool;                    // glue → is Shift physically down right now?
    // true only when `gesture-status` is a rich-save confirmation — turns that line into a clickable
    // link that reveals the strokes folder in the OS file manager. Cleared at the start of any capture.
    in-out property <bool> stroke-saved: false;
    callback reveal-strokes();                         // open ./strokes/ in Explorer (made if missing)
    in-out property <string> gesture-status: "idle";
    in-out property <string> radial-status: "";       // wheel-side feedback (lives BY the wheel)
    in-out property <[float]> trail;                 // normalized live/last trail (x,y interleaved)
    callback record-gesture();
    callback clear-gestures();
    callback delete-gesture(string);                  // remove ONE glyph (template + its binding)
    callback rename-gesture(string, string);          // (old, new) — keeps the cast binding attached
    // cast trigger (the hold button) — press-to-bind, NEVER hardcoded (seeded from cast.toml)
    in-out property <string> cast-trigger-label: "—";
    callback capture-cast-trigger();
    // the ACTIVATION RHYTHM on that trigger — a feel::Phrase ("hold", "tap hold", "tap tap", …).
    // Presets cover the sane ones; record-activation captures YOUR rhythm and normalizes it.
    in-out property <string> activation-pattern: "hold";
    in-out property <string> activation-display: "▬";   // the rhythm as symbols (● tap · ▬ hold · ↔ toggle)
    in-out property <bool> recording-activation: false;
    callback set-activation(string);
    callback record-activation();
    // bind a recorded glyph -> an Action (uses the shared action palette)
    in-out property <string> gesture-bind-target: ""; // the glyph name being bound
    callback bind-gesture(string);                     // open the action picker for this glyph
    callback commit-gesture-bind();                    // write the glyph->action into cast.toml
    // ── THE RHYTHM MAP — each cast rhythm (N taps then hold) is a first-class Trigger::Cast bound
    // to any Action, remappable here. taps = the tap count (1 = tap-hold, 2 = tap-tap-hold, …);
    // label = the rhythm in symbols; desc = the bound action; bound = action != Noop. The weave
    // (plain hold) is NOT in this list — it keeps its own row + rhythm recorder above.
    in-out property <[RhythmBindRow]> rhythm-binds;
    in-out property <int> rhythm-bind-target: -1;      // which rhythm's taps is being bound (-1 = none)
    callback bind-rhythm(int);                          // open the action picker for this rhythm (by taps)
    callback commit-rhythm-bind();                      // write the chosen action into cast.toml's rhythm_actions
    callback delete-rhythm(int);                        // unbind a rhythm (remove the RhythmBind by taps)
    in-out property <int> radial-sectors: 8;
    in-out property <int> radial-max: 16;             // COMPUTED cap: 2π·deadzone / hand-jitter (no manual cap)
    in-out property <[RadialSector]> radial-items;
    in-out property <int> radial-preview-sector: -1; // hovered/active wedge
    callback set-sector-count(int);
    // SPELL ASSIST — recognition FORGIVENESS (continuous): how far past the strict gate a near-miss
    // may sit and still snap to the closest spell (clear-winner only). 0 = off (strict). The engine's
    // `assist` margin IS this value (0.0..0.6), so it's a slider, not an on/off — a bool would throw
    // the dimension away.
    in-out property <float> weave-assist: 0.35;
    callback set-weave-assist(float);
    callback preview-radial();                         // hold-trigger + flick to test the wheel (same overlay)
    // per-sector radial action editor: pick a wedge, choose an Action, write cast.toml
    callback edit-sector(int);                         // open the action picker for sector i
    callback commit-sector-action();                   // write the chosen action into the sector
    in-out property <int> editing-sector: -1;          // which sector the action picker targets
    // HYPERSHIFT RADIAL — a parallel wedge set (same sectors) shown only while HyperShift is held.
    // Off by default; reuses the SAME editor — `radial-edit-hyper` just retargets which set is shown/written.
    in-out property <bool> hyper-radial-on: false;     // enable the HyperShift radial swap (persists to cast.toml)
    callback set-hyper-radial-on(bool);
    in-out property <bool> radial-edit-hyper: false;   // the editor is authoring the HyperShift set (vs base)
    callback set-radial-edit-hyper(bool);

    // ── Profiles & App-Rules (active-profile switch is a global element) ──
    in-out property <[ProfileRow]> profiles;
    in-out property <[string]> profile-names;          // the legal targets for an app rule
    in-out property <[AppRuleRow]> app-rules;
    in-out property <int> active-app-rule: -1;         // which rule the FOCUSED app matches right now
    in-out property <bool> profile-name-exists: false; // typed save-name collides (save = overwrite)
    in-out property <string> profile-name-suggested: ""; // glue's low-friction default (focused app / value descriptor); non-colliding
    callback profile-name-edited(string);              // glue answers profile-name-exists
    callback refresh-profile-suggestion();             // recompute the zero-typing default from LIVE state — called on sheet-open so a value tuned since last focus-change isn't stale
    callback apply-profile(string);
    callback save-current-profile(string);
    callback delete-profile(string);
    callback add-app-rule(string, string);           // app-needle, profile
    callback remove-app-rule(int);

    // ── Settings: startup + gate + theme + Import WIZARD (a flow) + DIAGNOSTICS ─
    // LAUNCH behaviour — one selector instead of two booleans (autostart + minimized) that could
    // express a dead combo. 0 = Manual (no autostart) · 1 = Boot to tray (autostart, resident) ·
    // 2 = Boot with window (autostart, window shown).
    in-out property <int> launch-mode: 0;
    callback set-launch-mode(int);
    // APPEARANCE — the user's two tunable colours (bare RRGGBB), mirrored from app.toml at startup.
    // `set-ui-accent` recolours the whole instrument live (Theme.accent + derived) and persists;
    // `set-weave-accent` retints the spellweaving cast/glyph/sigil and persists.
    in-out property <string> ui-accent: "4af2b0";
    in-out property <string> weave-accent: "4af2b0";
    in-out property <color> weave-accent-col: #4af2b0;   // parsed weave colour (Rust keeps in sync), for the preview swatch
    callback set-ui-accent(string);
    callback set-weave-accent(string);
    // LIVE hex preview — Rust parses the in-progress field text WITHOUT committing (no persist, no
    // recolour), so entering a custom hex shows the colour the instant it's complete instead of leaving
    // you blind until Enter. Shared is fine: only one field has focus at a time, and the picker gates the
    // swatch on its own focus. (Enter still commits — we never recolour the whole UI mid-keystroke.)
    callback preview-hex(string);
    in-out property <color> hex-preview-col;
    in-out property <bool>  hex-preview-ok;     // a COMPLETE valid 6-digit hex → morph the live swatch
    in-out property <bool>  hex-preview-bad;    // clearly wrong (non-hex char / overlong) → danger hairline; mid-typing stays neutral
    // PRISM picker — hue (0..1 across) + brightness (0..1 down) → live preview. The bare RRGGBB it's
    // pointing at lands in `hue-pick-hex` so a pointer-release can commit it through the normal `pick`.
    callback preview-hue(float, float);
    in-out property <string> hue-pick-hex;
    // the spellweaving MATERIAL gallery — live preview swatches the user picks the cast's physics from.
    in-out property <[MaterialCard]> material-cards;
    in-out property <string> weave-material: "directed-intent";
    callback set-weave-material(string);
    callback material-preview-tick();                     // re-render the gallery swatches (animated)
    // which swatch slot is showing (the A/B crossfade phase) — flipped by the glue after each
    // worker frame lands in the hidden slot; the tile animates the alt slot's opacity on it.
    in-out property <bool> material-show-alt: false;
    // the SELECTED material's tunable knobs — the UI renders a slider per row; editing reshapes the
    // live substance. Generic + data-driven: a material declares its own knobs.
    in-out property <[KnobRow]> weave-knobs;
    callback set-weave-knob(int, float);
    callback reset-weave-material();                       // knobs back to the recipe defaults

    // RELIABILITY — the flight recorder surfaced. Uptime, per-organ heartbeats, the crash record, and
    // the phoenix auto-restart switch. Refreshed ~1s by the main heartbeat tick.
    in-out property <string> uptime: "—";
    in-out property <[OrganRow]> organs;
    in-out property <string> crash-summary: "no crashes recorded";
    in-out property <bool> crash-present: false;          // a dump exists on disk (colour the readout)
    in-out property <bool> phoenix: true;                 // OS auto-restart armed (next-launch pref)
    callback set-phoenix(bool);
    // ── CONNECTIONS — the protocol host (System page). Other software paints THROUGH the
    // arbiter: games speak Chroma (54235), tools speak OpenRGB (6742), composing ABOVE the
    // configured lighting. Toggles persist to app.toml; the status lines carry PORT TRUTH
    // (a bind that failed — real Synapse holding the socket — never shows as serving).
    in-out property <bool> host-enabled: false;            // master switch (default OFF — opt-in)
    in-out property <bool> host-chroma: true;              // serve Chroma (games) while enabled
    in-out property <bool> host-openrgb: true;             // serve OpenRGB (tools) while enabled
    in-out property <bool> host-obs: false;                // connect OUT to OBS (macros drive scenes)
    // VISITORS — how external paint combines with your lighting (LIGHTING page). Two lanes:
    // CHROMA games + OPENRGB tools, each its own blend/strength/fade. 0 replace, 1 merge, 2 boost,
    // 3 tint. Plus a universal hands-off device list and the "my lighting always wins" priority.
    in-out property <int> host-chroma-mode: 1;             // chroma lane blend index
    in-out property <float> host-chroma-strength: 100;
    in-out property <float> host-chroma-fade: 450;
    in-out property <int> host-openrgb-mode: 0;            // openrgb lane blend index (default replace)
    in-out property <float> host-openrgb-strength: 100;
    in-out property <float> host-openrgb-fade: 0;
    in-out property <[ChromaDeviceRow]> host-paint-devices; // universal hands-off list (both lanes)
    in-out property <bool> host-base-always-wins: false;   // your lighting outranks every visitor
    in-out property <bool> host-chroma-detail-open: false;
    in-out property <[ChromaStreamRow]> host-chroma-streams;
    in-out property <string> host-obs-password: "";        // obs-websocket Server Password (masked field)
    in-out property <string> host-chroma-status: "";       // honest per-protocol readout
    in-out property <string> host-openrgb-status: "";
    in-out property <string> host-obs-status: "";
    // LIVE lamps — true when that protocol is actually up (port bound / OBS authenticated), so the
    // row lights phosphor the instant it connects. This is the visible "yes, it works" signal.
    in-out property <bool> host-chroma-live: false;
    in-out property <bool> host-openrgb-live: false;
    in-out property <bool> host-obs-live: false;
    in-out property <string> host-devices-line: "";        // "N device(s) on the arbiter"
    callback set-host-enabled(bool);
    callback set-host-chroma(bool);
    callback set-host-openrgb(bool);
    callback set-host-obs(bool);
    callback set-host-chroma-mode(int);
    callback set-host-chroma-strength(float);
    callback set-host-chroma-fade(float);
    callback set-host-openrgb-mode(int);
    callback set-host-openrgb-strength(float);
    callback set-host-openrgb-fade(float);
    callback set-host-paint-device(string, bool);          // universal hands-off list (both lanes)
    callback set-host-base-always-wins(bool);
    callback set-host-obs-password(string);                 // save + reconnect with the new secret
    // LIGHTING page truth strip: a client holds a claim above your base on the selected board
    // (painting now; your effect resumes when it releases).
    in-out property <bool> light-foreign: false;
    // the flip side of "who wins": a named client is CONNECTED but your base wins, so it's
    // here and honestly not showing (the truth no last-writer-wins tool has).
    in-out property <bool> light-suppressed: false;
    // best-effort NAME of the client (a Chroma game's title, an OpenRGB client's name) —
    // "" when unknown; meaningful while light-foreign OR light-suppressed is true.
    in-out property <string> light-foreign-app: "";
    // ── NOTIFICATIONS — state-change confirmation cards (System page) ──
    in-out property <bool> notif-enabled: true;
    in-out property <string> notif-placement: "top-right"; // off/top-left/top-right/bottom-left/bottom-right/inline/custom
    in-out property <float> notif-x: 1.0;                 // hand-placed card anchor, fraction of the work-area (0..1)
    in-out property <float> notif-y: 0.0;
    in-out property <bool> notif-audio: true;
    // the WHAT-EARNS-A-PING cards, data-driven off confirm::Kind::ALL (see PingKind in models) and
    // grouped by DOMAIN — three captioned clusters, each rendered as one full-width row, so the
    // layout can never grow a dangling odd card: a new kind joins its domain's row and the row just
    // gets denser. Per-kind bool props are GONE; the glue rebuilds these on seed + toggle. Adding a
    // DOMAIN (rare, deliberate) = one more model here + one caption block in settings.slint.
    in-out property <[PingKind]> ping-pointer;   // aim & report: dpi · sniper · sensitivity · polling
    in-out property <[PingKind]> ping-hardware;  // the physical device: brightness · battery · side plate
    in-out property <[PingKind]> ping-session;   // software state: profile · layer · beacon
    in-out property <string> notif-stack: "stack";       // WHEN SEVERAL LAND: stack | latest | digest
    callback set-notif-stack(string);
    callback set-notif-enabled(bool);
    callback set-notif-placement(string);
    callback set-notif-pos(float, float);                 // a free hand-placed spot (Rust snaps an exact preset back to its slug)
    callback set-notif-audio(bool);
    in-out property <float> notif-volume: 0.7;            // audio cue volume 0..1
    in-out property <string> notif-sound: "pulse";        // voice palette: pulse / warm / glass
    callback set-notif-volume(float);
    callback set-notif-sound(string);
    in-out property <bool> notif-panel: true;            // grounded squircle card vs floating spell
    callback set-notif-panel(bool);
    callback set-notif-event(string, bool);               // (event-slug, on)
    callback test-notification();                          // fire a real test card of a random allowed kind

    // ── MECHANICAL ADVANTAGES — opt-in, edge-giving device features behind a two-step consent ──
    // Snap Tap (SOCD): resolves opposing key-pairs (A/D) to the last pressed → instant counter-strafe.
    // Each option carries its own consent state: `revealed` (step 1, locked→visual) + `enabled`
    // (step 2, the toggle). `supported` is seeded by Rust from a Synapse-4 keyboard PID allowlist —
    // false on the user's BlackWidow Chroma V2, so the toggle stays honestly GATED there.
    in-out property <bool> snap-tap-supported: false;     // the SELECTED device is a Snap-Tap-capable keyboard (gates the whole MECHANICAL ADVANTAGES section)
    in-out property <bool> snap-tap-revealed: false;      // step 1 done: the stage visual is unsealed
    in-out property <bool> snap-tap-enabled: false;       // step 2: the feature is on (the device write)
    callback set-snap-tap(bool);                          // enable/disable (perf-gated runtime write)
    callback write-flight-dump();                         // append a live snapshot to neuron-crash.log
    callback open-crash-log();                            // open neuron-crash.log in the default viewer
    callback toggle-writes-paused();
    callback toggle-input-armed();                    // SAFE-MODE: arm/disarm real input synthesis
    callback open-config-dir();

    // PURGE SYNAPSE — kill every Razer Synapse process + demote its respawning services to manual.
    // Razer's slopware is a hydra (Synapse 3 esp.); this button sets the SYSTEM services to demand-start
    // (gone from boot, but still launchable — never *disabled*, which permanently bricks Synapse) and
    // stops them, then sweeps the process table. Needs elevation, so it may trigger a UAC prompt.
    callback purge-synapse();
    in-out property <string> purge-status: "";            // result line shown under the button

    // Import is a wizard flow launched from Settings, not a nav seat.
    in-out property <bool> import-open: false;        // the wizard overlay is showing
    in-out property <string> import-path;
    in-out property <[ImportLine]> import-preview;     // the full parse (apply gates on this)
    in-out property <[ImportLine]> import-perf;        // scalar settings + lighting (readout strip)
    in-out property <[ImportLine]> import-bindings;    // trigger → action rows
    in-out property <[ImportLine]> import-notes;       // honestly NOT migrated
    in-out property <string> import-status: "Pick a Synapse export (.synapse3 / .ChromaEffects).";
    in-out property <bool> import-ready: false;       // a successful parse to apply
    // an ACTUAL parse ran and FAILED — set true by glue only after parse-import tried and produced
    // nothing to apply, cleared the moment the path is edited. Gates the danger ink so the untried
    // hint (a path just typed, never parsed) stays neutral text-mid instead of flashing alarm-red.
    in-out property <bool> import-parse-failed: false;
    callback browse-import();
    callback parse-import(string);
    callback apply-import();

    // Diagnostics = the in-app test bench ("prove it works to me"): fire each capability live.
    in-out property <[DiagRow]> diagnostics;
    in-out property <bool> diag-running: false;
    in-out property <int> diag-pass: 0;               // the segmented verdict bar's three widths
    in-out property <int> diag-fail: 0;
    in-out property <int> diag-skip: 0;
    in-out property <string> diag-summary: "Run diagnostics to prove every capability live.";
    callback run-diagnostics();

    // generic: jump to a page (the ONE audited navigation entrypoint for tray + cross-panel links)
    callback goto-page(int);
}
