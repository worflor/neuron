// Neuron — the resident GUI shell. "Precision instrument, not a skinned app."
//
// The chrome is an instrument fascia: a quiet top rail with a small monospace SECTION SELECTOR on
// the left (numbered channels, the active one lit phosphor) and a live SIGNAL CLUSTER on the right
// (profile / shift / link / gate — accent ONLY when something is actually live). No icon-rail, no
// kinetic word-nav, no oversized display type. A hairline separates the fascia from the work area;
// a mono status strip runs along the bottom like a scope's readout line.
//
// Keyboard: 1..6 switch channels (mirroring the numbered ticks), ESC backs out of any modal.
// Panel switches SETTLE (110ms opacity + a 4px drop) — mechanical, not bouncy, never instant-teleport.
//
// Tray-resident: this window is created once and hidden on close; the event loop lives on regardless
// (see the Rust runtime). One window, one process, direct typed calls into neuron-core.

import { Theme } from "theme.slint";
import { State } from "state.slint";
import { GuideContent } from "guides.slint";
import { Pill, Mono, CaptureOverlay, StatusLamp, IconButton, SectionTitle, Label } from "widgets/controls.slint";

import { DevicePanel } from "panels/device.slint";
import { LightingPanel } from "panels/lighting.slint";
import { BindingsPanel } from "panels/bindings.slint";
import { SpellweavingPanel } from "panels/spellweaving.slint";
import { ProfilesMenu } from "panels/profiles.slint";
import { SettingsPanel } from "panels/settings.slint";
import { ImportWizard } from "panels/import.slint";

// State drives every panel; Theme is exported too so Rust can swap the live accent (APPEARANCE).
export { State }
export { Theme }

// One entry in the section selector — a numbered channel. Quiet mono; the active one is lit phosphor
// with a short underscore tick. No size-jump, no pan: it just changes state (mechanical, not kinetic).
// The nav-rail sibling of controls.slint's Contact — same lit-cell grammar (accent-glow fill +
// accent-line frame), kept local because it carries a channel-index tick Contact doesn't. Every
// colour / size / motion value routes through Theme; only the layout paddings are raw pixels.
component NavEntry inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 0;
    height: Theme.seg-h;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent-glow : (ta.has-hover ? Theme.well : transparent);
    border-width: Theme.hair;
    border-color: active ? Theme.accent-line : transparent;
    animate background, border-color { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 7px;
        // channel index — dim tick that lights with the active entry
        Text {
            text: (root.index + 1);
            // the channel address lifts WITH the label on hover — half-lit read as a glitch before
            color: root.active ? Theme.accent : (ta.has-hover ? Theme.text-dim : Theme.text-faint);
            font-size: Theme.fs-small;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : (ta.has-hover ? Theme.text-mid : Theme.text-dim);
            font-size: Theme.fs-nav;
            font-family: Theme.mono;
            font-weight: root.active ? 700 : 500;
            letter-spacing: Theme.track-4;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// One settling panel slot — the channel switch is a mechanical contact: the leaving panel CUTS
// (instant, a selector releasing) and only the arriving one settles in over Theme.settle.
// Gating `visible` strictly on `active` is also the switch's paint bill halved: the old
// cross-dissolve (`|| opacity > 0.01`) kept BOTH page trees painting for the whole settle, and
// on the heavier pages (LIGHTING's live tile grid) that double-paint read as a switch hitch.
component PanelSlot inherits Rectangle {
    in property <bool> active;
    opacity: root.active ? 1.0 : 0.0;
    visible: root.active;
    y: root.active ? 0px : 4px;
    animate opacity, y { duration: Theme.settle; }
    @children
}

// Every channel scrolls — the window must work at ANY size, never "fullscreen it to see the rest".
// Vertical-only: the viewport is pinned to the page width and the panel (a VerticalLayout) sizes
// its own height; the wheel scrolls when content exceeds the glass and is inert when it doesn't.
// The viewport is measured EXPLICITLY through the named body: a Flickable only auto-sizes from
// children declared inside the component, and ours arrive via @children — without this binding
// the viewport never outgrows the glass and the wheel is dead (the off-screen-rows bug).
component PanelPage inherits Flickable {
    // WHEEL-ONLY scroll. A Flickable's drag-to-flick gesture is all-or-nothing and competes with every
    // child control — a click-drag that began on a swatch / button / slider got hijacked into a page
    // scroll. `interactive: false` drops the drag gesture; the mouse wheel still scrolls (Slint exempts
    // Wheel events from this gate), which is the right primary on a mouse-driven desktop anyway.
    interactive: false;
    viewport-width: self.width;
    viewport-height: max(self.height, body.preferred-height);
    body := VerticalLayout {
        width: parent.viewport-width;
        height: parent.viewport-height;
        @children
    }
}

export component AppWindow inherits Window {
    title: "Neuron";
    // Pages scroll (see PanelPage), so the minimum is "still comfortable", not "fits everything".
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-size: Theme.fs-body;
    default-font-family: Theme.mono;
    forward-focus: keys;

    // The four warranted sections — user INTENTS, not feature taxonomy: make it feel right /
    // make it look right / make input do things / set it up + prove it works. PROFILES is a
    // global affordance (the header sheet), not a seat. Index == State.page.
    property <[string]> sections: ["DEVICE", "LIGHTING", "INPUT", "SYSTEM"];
    // ARMING REAL INPUT deserves friction: first click on the SAFE pill arms the question,
    // a second click within 2.5s commits. Disarming (ARMED -> SAFE) is always one click.
    property <bool> arm-confirm: false;
    Timer {
        interval: Theme.confirm-window;
        running: root.arm-confirm;
        triggered => { root.arm-confirm = false; }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                // back out of one transient state per press, most-modal first…
                if (State.capture-active) { State.cancel-capture(); return accept; }
                if (State.import-open) { State.import-open = false; return accept; }
                if (State.profile-sheet-open) { State.profile-sheet-open = false; return accept; }
                if (State.guide-open) { State.guide-close(); return accept; }
                if (root.arm-confirm) { root.arm-confirm = false; return accept; }
                if (State.editing-sector >= 0) { State.editing-sector = -1; return accept; }
                if (State.gesture-bind-target != "") { State.gesture-bind-target = ""; return accept; }
                // …nothing matched: pull focus back to nav (so ESC backs OUT of a focused text field
                // instead of stranding keyboard nav) and `reject` so Slint's own fallback can still
                // close an open Picker/ActionPicker popup.
                keys.focus();
                return reject;
            }
            if (!State.import-open && !State.capture-active && !State.profile-sheet-open) {
                if (e.text == "1") { State.page = 0; return accept; }
                if (e.text == "2") { State.page = 1; return accept; }
                if (e.text == "3") { State.page = 2; return accept; }
                if (e.text == "4") { State.page = 3; return accept; }
            }
            return reject;
        }

        VerticalLayout {
            padding: 0;

            // ── instrument fascia: section selector + live signal cluster ─────
            Rectangle {
                height: 56px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: Theme.pad-page;
                    padding-right: Theme.pad-page;
                    spacing: 0;
                    // wordmark — quiet, mono, the instrument's name plate
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: Theme.dot-lg; height: Theme.dot-lg; border-radius: 1px;
                                y: (parent.height - self.height) / 2;
                                background: State.runtime-active ? Theme.accent : Theme.text-faint;
                                animate background { duration: Theme.settle; }
                            }
                            Text {
                                text: "NEURON";
                                color: Theme.text;
                                font-size: Theme.fs-title;
                                font-family: Theme.mono;
                                font-weight: 700;
                                letter-spacing: Theme.track-5;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { width: 26px; }
                    // the section selector
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        for s[i] in root.sections : NavEntry {
                            label: s;
                            index: i;
                            active: State.page == i;
                            clicked => { State.page = i; }
                        }
                    }
                    Rectangle {}  // push the right cluster over
                    // The right cluster is ONE affordance, not a row of tags: the PROFILE sheet
                    // trigger (plus a quiet "shift" word while a layer is held — a state, not a
                    // badge). The link lamp is the wordmark dot; gate/paused/beacon live on the
                    // scope strip below, where modes belong.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;
                            // show WHICH layer(s) are held when the runtime names them, not a static
                            // word. A FIXED-WIDTH slot (sized to the longest expected label) always
                            // reserves its space so the PROFILE pill never slides when a layer is held
                            // — the same lamp-gutter doctrine the atoms follow (reserve, don't reflow).
                            // The word right-anchors against the pill and only paints while shifted.
                            Rectangle {
                                width: 68px;
                                Text {
                                    visible: State.hypershift-on;
                                    text: State.live-held != "" ? State.live-held : "shift";
                                    width: 100%;
                                    horizontal-alignment: right;
                                    color: Theme.accent;
                                    font-size: Theme.fs-small;
                                    font-family: Theme.mono;
                                    letter-spacing: Theme.track-4;
                                    vertical-alignment: center;
                                }
                            }
                            // PROFILE — opens the profiles sheet (save/apply/rules from anywhere).
                            Pill {
                                text: State.active-profile == "—" ? "NO PROFILE" : State.active-profile;
                                live: State.active-profile != "—";
                                clickable: true;
                                clicked => { State.refresh-profile-suggestion(); State.profile-sheet-open = true; }
                            }
                        }
                    }
                }
            }
            // fascia hairline
            Rectangle { height: Theme.hair; background: Theme.line; }

            // ── work area (content floats on the void) ────────────────────────
            Rectangle {
                background: Theme.bg;
                clip: true;
                VerticalLayout {
                    padding-left: Theme.pad-page;
                    padding-right: Theme.pad-page;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    Rectangle {
                        // DEVICE owns its OWN inner inspector Flickable (fixed-footprint pane, scrolls
                        // internally) — so it must NOT also be wrapped in the page-level PanelPage, or the
                        // two nested Flickables break hit-testing on the inner's scrolled content (clicking
                        // ▸ advanced / sniper / persist did nothing once scrolled). One Flickable only.
                        PanelSlot { active: State.page == 0; DevicePanel {} }
                        PanelSlot { active: State.page == 1; PanelPage { LightingPanel {} } }
                        // INPUT — one section, two depths: DIRECT (plain binds) / WEAVE (the
                        // held-stroke engine). Same spine, same action palette, one home.
                        PanelSlot { active: State.page == 2 && State.input-view == 0; bp_page := PanelPage { bp := BindingsPanel {} } }
                        PanelSlot { active: State.page == 2 && State.input-view == 1; PanelPage { SpellweavingPanel {} } }
                        PanelSlot { active: State.page == 3; PanelPage { SettingsPanel {} } }
                        // "author a macro" (SYSTEM→BEACONS) lands here: once INPUT→DIRECT is active,
                        // defer one frame (so the panel has laid out + macro-y is valid), then scroll
                        // the page to the MACRO editor and clear the request. One-shot — clearing the
                        // flag stops the timer, and viewport-y is set imperatively (not bound), so the
                        // wheel still scrolls freely afterwards.
                        Timer {
                            interval: 16ms;
                            running: State.macro-jump-pending && State.page == 2 && State.input-view == 0;
                            triggered => {
                                bp_page.viewport-y = -max(0px, min(bp.macro-y, bp_page.viewport-height - bp_page.height));
                                State.macro-jump-pending = false;
                            }
                        }
                    }
                }
            }

            // ── status strip (the scope readout line) ─────────────────────────
            Rectangle {
                height: Theme.seg-h;
                background: Theme.bg-2;
                Rectangle { x: 0; y: 0; width: parent.width; height: Theme.hair; background: Theme.line; }
                HorizontalLayout {
                    padding-left: Theme.pad-page;
                    padding-right: Theme.pad-page;
                    spacing: 8px;

                    // ── ZONE L — the readout message. It owns ALL the horizontal slack, so the state
                    // cluster on the right stays pinned to the edge (the old blind spacer let that
                    // cluster float mid-strip). A caret marks the line — phosphor for info, alarm red
                    // for failures.
                    Text {
                        text: "›";
                        color: State.status-kind == "err" ? Theme.danger : Theme.accent;
                        font-size: Theme.fs-mono;
                        font-family: Theme.mono;
                        vertical-alignment: center;
                        animate color { duration: Theme.settle; }
                    }
                    Mono {
                        text: State.status-line;
                        // freshness is honest: an aged message dims instead of posing as current
                        color: State.status-stale ? Theme.text-faint
                            : State.status-kind == "err" ? Theme.danger
                            : Theme.text-mid;
                        font-size: Theme.fs-mono;
                        overflow: elide;
                        // THE message absorbs every pixel of slack (and elides first) so the state
                        // cluster packs hard against the right edge — never floats in the middle.
                        horizontal-stretch: 1;
                        min-width: 0;
                        animate color { duration: Theme.settle; }
                    }

                    // ── ZONE R — the mode readouts, packed right, split by hairline DIVIDERS (visible
                    // structure) instead of blind spacer gaps. Gates + live states belong on the scope
                    // line. Order: beacon | writes-paused | gate | fired | focus. Each group LEADS with
                    // its own divider, so whichever renders first is cleanly parted from the message.
                    //
                    // SANCTIONED REFLOW EXCEPTION (audit-ruled): the transient chips (beacon, writes-
                    // paused) pop in and push the groups to their right. That is ACCEPTED here — these
                    // are short-lived signals, and reserving a fixed slot for each would waste strip
                    // width that the readout message legitimately wants. Don't "fix" this with gutters.
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;

                        // BEACON: a macro is asking at the cursor (count includes queued asks).
                        // A plain lit readout — the outer `if` IS the "lit" condition, so it always shows phosphor.
                        if State.beacon-count > 0 : HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: Theme.hair; height: 12px; y: (parent.height - self.height) / 2; background: Theme.line; }
                            StatusLamp {
                                text: State.beacon-count > 1 ? "beacon ×" + State.beacon-count : "beacon";
                                lit: true;
                            }
                        }

                        // WRITES PAUSED: the global device-write kill-switch — click = go to its gate.
                        // The lamp makes it read as a THROWN switch (a red kill-lamp), not inert text.
                        if State.writes-paused : HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: Theme.hair; height: 12px; y: (parent.height - self.height) / 2; background: Theme.line; }
                            StatusLamp {
                                text: "writes paused";
                                lit: true;
                                tint: Theme.danger;
                                clickable: true;
                                clicked => { State.page = 3; }
                            }
                        }

                        // THE GATE: armed/safe. SAFE -> ARMED takes a confirming second click (real
                        // keystrokes are consequential); ARMED -> SAFE disarms instantly. The lamp makes
                        // the gate read as a physical switch, not inert text — accent=armed, warn=arm?,
                        // a dim dot=safe.
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: Theme.hair; height: 12px; y: (parent.height - self.height) / 2; background: Theme.line; }
                            // lit in either loud state — accent when ARMED, warn when ARM?; SAFE is the
                            // unlit gutter (StatusLamp draws lamp-off + the text-dim ink, hover→text-mid).
                            StatusLamp {
                                text: State.input-armed ? "armed" : root.arm-confirm ? "arm?" : "safe";
                                lit: State.input-armed || root.arm-confirm;
                                tint: State.input-armed ? Theme.accent : Theme.warn;
                                clickable: true;
                                clicked => {
                                    if (State.input-armed || root.arm-confirm) {
                                        State.toggle-input-armed();
                                        root.arm-confirm = false;
                                    } else {
                                        root.arm-confirm = true;
                                    }
                                }
                            }
                        }

                        // live dispatch readout — last trigger fired + total count. A hard max-width
                        // caps it (elides a long trigger→action) so it can never shove `focus` off-edge.
                        if State.live-fired > 0 : HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: Theme.hair; height: 12px; y: (parent.height - self.height) / 2; background: Theme.line; }
                            Mono {
                                text: "fired " + State.live-fired + " · " + State.live-last-trigger
                                    + " → " + State.live-last-action;
                                color: Theme.accent-dim;
                                font-size: Theme.fs-mono;
                                overflow: elide;
                                max-width: 340px;
                            }
                        }

                        // the focus readout — the last item; natural width, elides at its own cap.
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: Theme.hair; height: 12px; y: (parent.height - self.height) / 2; background: Theme.line; }
                            Mono {
                                text: "focus " + State.focused-app;
                                color: Theme.text-faint;
                                font-size: Theme.fs-mono;
                                overflow: elide;
                                max-width: 260px;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── press-to-bind capture overlay (shown over any panel during a capture) ──
    CaptureOverlay {}

    // ── PROFILES dropdown — a global affordance, not a section, and NOT a full-screen takeover. A
    // profile is the act of saving / restoring the other sections, so it drops from the header pill
    // wherever you are. A light backdrop focuses it + click-anywhere-outside (or ESC) closes it; it
    // fades + slides down on open, obeying the same motion law as everything else. ──
    Rectangle {
        visible: State.profile-sheet-open || drop.opacity > 0.01;
        // a LIGHT scrim — focuses the menu and catches outside clicks, without the heavy modal blackout
        background: State.profile-sheet-open ? Theme.scrim-soft : transparent;
        animate background { duration: Theme.settle; }
        TouchArea { clicked => { State.profile-sheet-open = false; } }
        drop := Rectangle {
            width: 440px;
            // content-sized but capped to the glass; the menu scrolls inside if it ever outgrows it
            height: min(menu.preferred-height, parent.height - 80px);
            x: parent.width - self.width - Theme.pad-page;     // right-aligned under the header pill
            y: State.profile-sheet-open ? 50px : 42px;         // a gentle slide-down on open
            opacity: State.profile-sheet-open ? 1.0 : 0.0;
            background: Theme.bg-2;
            border-radius: Theme.radius;
            border-width: Theme.hair;
            border-color: Theme.line;
            clip: true;
            animate opacity, y { duration: Theme.settle; easing: ease-out; }
            TouchArea {}   // swallow clicks inside — only the backdrop closes
            Flickable {
                interactive: false;   // wheel-only, like the panels
                viewport-width: self.width;
                viewport-height: menu.preferred-height;
                menu := ProfilesMenu { width: parent.viewport-width; }
            }
        }
    }

    // ── Import wizard overlay (a FLOW launched from Settings, not a nav seat) ──
    // ESC closes it (the FocusScope above), and so does a click on the void around the card.
    Rectangle {
        opacity: State.import-open ? 1.0 : 0.0;
        visible: State.import-open || self.opacity > 0.01;
        animate opacity { duration: Theme.settle; }
        background: Theme.scrim;
        TouchArea { clicked => { State.import-open = false; } }
        ImportWizard {
            width: min(760px, parent.width - Theme.modal-inset);
            height: min(640px, parent.height - Theme.modal-inset);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // ── GUIDE popup — the reusable in-app help surface (a "book button" opens it). By default it's a
    // CLICK-AWAY TOOLTIP: a transparent full-window catcher behind the card closes it on an outside
    // click. DRAG the title bar and it PROMOTES to a STICKY, draggable window with an X (the catcher
    // is gone — the app stays fully live). Content is data-driven (GuideContent), picked by
    // State.guide-active-id. Lives at the window root, above every page, so it belongs to no panel.
    // When closed it isn't painted or hit-tested (visible gate), so it never steals the page's clicks.
    Rectangle {
        visible: State.guide-open || gcard.opacity > 0.01;
        background: transparent;   // no scrim — a tooltip / floating window, not a modal blackout
        // CLICK-AWAY catcher — TOOLTIP mode only. Going sticky removes it (no more click-away).
        if State.guide-open && !State.guide-sticky : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { State.guide-close(); }
        }
        gcard := Rectangle {
            // anchored at the book button, CLAMPED so the WHOLE card stays on-screen. The upper bound
            // (winSize - cardSize - margin) pulls the card UP/LEFT when a low/right anchor would run it
            // off the bottom/right edge — i.e. a button low on the page opens the card upward. The
            // `max(margin, …)` keeps lo ≤ hi on a window too small for the card.
            x: clamp(State.guide-x, Theme.pad-page / 2, max(Theme.pad-page / 2, parent.width - self.width - Theme.pad-page / 2));
            y: clamp(State.guide-y, Theme.pad-page / 2, max(Theme.pad-page / 2, parent.height - self.height - Theme.pad-page / 2));
            width: 384px;   // wide enough that a ~44-char mono code line fits the cell without wrapping
            // a comfortable readable height, capped to 70% of the glass. NOT derived from the inner
            // content's preferred-height: that lives inside the Flickable, whose geometry doesn't
            // propagate out to this ancestor binding (it reads ~0 and collapses the card). The body
            // Flickable FILLS this height and scrolls its content via viewport-height instead.
            height: min(420px, parent.height * 0.7);
            opacity: State.guide-open ? 1.0 : 0.0;
            background: Theme.bg-2;
            border-radius: Theme.radius;
            border-width: Theme.hair;
            border-color: Theme.line;
            clip: true;
            animate opacity { duration: Theme.settle; easing: ease-out; }
            // the title-bar grab offset captured at pointer-down (for the drag delta)
            property <length> grab-x;
            property <length> grab-y;
            property <bool> tb-down: false;
            // BASE swallow — a click anywhere ON the card is absorbed here (declared FIRST, so the
            // title-bar drag + the X, declared after, still win their own regions) so a click inside
            // the tooltip never reaches the click-away catcher behind it. The scroll-event swallow
            // catches any WHEEL the inner Flickable didn't consume (content fits, or it's at a scroll
            // edge), so spinning the wheel over the popup can never scroll the page BEHIND it.
            TouchArea {
                scroll-event(e) => {
                    accept
                }
            }
            VerticalLayout {
                // ── TITLE BAR — the drag handle (a drag promotes to sticky) + title + an X ─────
                bar := Rectangle {
                    height: 34px;
                    background: Theme.well;
                    // the drag surface BEHIND the title/X (a Text doesn't grab events; the X's own
                    // TouchArea, declared later, sits above and wins its corner) — NotifPlacer pattern.
                    drag := TouchArea {
                        mouse-cursor: MouseCursor.move;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                gcard.grab-x = self.mouse-x;
                                gcard.grab-y = self.mouse-y;
                                gcard.tb-down = true;
                            } else if (e.kind == PointerEventKind.up) {
                                gcard.tb-down = false;
                            }
                        }
                        moved => {
                            if (gcard.tb-down) {
                                // a title-bar drag PROMOTES the tooltip to a pinned window…
                                if (!State.guide-sticky) { State.guide-make-sticky(); }
                                // …and follows the cursor. The delta is taken off the LIVE clamped
                                // card position (gcard.x/y), so edge-clamping can't desync the grab.
                                State.guide-move(
                                    gcard.x + self.mouse-x - gcard.grab-x,
                                    gcard.y + self.mouse-y - gcard.grab-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 9px;
                        // a faint grip affordance — two columns of dots
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 2px;
                                for gxc in [0, 1] : VerticalLayout {
                                    spacing: 2px;
                                    for gyc in [0, 1, 2] : Rectangle {
                                        width: 2px; height: 2px; border-radius: 1px;
                                        background: Theme.text-faint;
                                    }
                                }
                            }
                        }
                        // the active guide's title (only the matching guide renders)
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            for g in GuideContent.guides : Rectangle {
                                if g.id == State.guide-active-id : Text {
                                    text: g.title;
                                    color: Theme.text;
                                    font-family: Theme.mono;
                                    font-size: Theme.fs-title;
                                    font-weight: 700;
                                    letter-spacing: Theme.track-2;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // ── X — always shown; a clear close affordance (the shared 22px icon chip) ──
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: "\u{00d7}";
                                clicked => { State.guide-close(); }
                            }
                        }
                    }
                }
                // a hairline under the bar
                Rectangle { height: Theme.hair; background: Theme.line; }
                // ── CONTENT — the active guide's sections, scrollable (wheel-only, like the panels) ──
                // The Flickable absorbs the card's remaining height (the VBox stretches it past the
                // fixed title bar + hairline). viewport-height = the REAL content height (the inner
                // body VBox's preferred-height, measured INSIDE the Flickable where it's valid — the
                // PanelPage pattern), so it scrolls when the guide outgrows the card.
                Flickable {
                    interactive: true;   // capture the wheel HERE so scrolling the popup never scrolls the page behind it
                    viewport-width: self.width;
                    viewport-height: body.preferred-height;   // the REAL content height → scrolls when the guide outgrows the card
                    body := VerticalLayout {
                        width: parent.viewport-width;
                        height: parent.viewport-height;
                        alignment: start;   // pack sections from the top; slack (if any) sits at the bottom
                        padding: 16px;
                        spacing: 0px;
                        // a LAYOUT wrapper, not a bare Rectangle: a Rectangle doesn't size to its
                        // children, so `body.preferred-height` read ~0 and the Flickable thought it had
                        // nothing to scroll (the wheel fell through to the page). A VerticalLayout adopts
                        // the section block's REAL height, so the popup scrolls when the guide is long.
                        for g in GuideContent.guides : VerticalLayout {
                            // `g.tabs.length > 0` isn't decorative: every guide today ships at
                            // least one tab, but `g.tabs[tab-idx]` below would index an empty
                            // array the moment that stops being true — this keeps a future
                            // data-only guide entry that forgets a tab from being a panic instead
                            // of just an empty popup.
                            if g.id == State.guide-active-id && g.tabs.length > 0 : activetab := VerticalLayout {
                                spacing: 18px;
                                // the tab this guide is showing, clamped in case a stale index ever
                                // outlives its guide (guide-toggle already resets it to 0 on open).
                                property <int> tab-idx: clamp(State.guide-active-tab, 0, g.tabs.length - 1);
                                for s in g.tabs[activetab.tab-idx].sections : VerticalLayout {
                                    spacing: 8px;
                                    // the section legend — SectionTitle in accent, kept at the guide's
                                    // own body size + track-1 so the copy stays byte-identical.
                                    SectionTitle {
                                        text: s.head;
                                        color: Theme.accent;
                                        font-size: Theme.fs-body;
                                        letter-spacing: Theme.track-1;
                                        wrap: word-wrap;
                                    }
                                    // each block is PROSE (quiet sans, the exception in a mono UI) or a
                                    // CODE CELL (mono on a well, hairline-framed — the same surface as the
                                    // macro editor, so a snippet here looks like where it'll be pasted). The
                                    // code cell is selectable and carries a floating copy button (top-right).
                                    for b in s.blocks : VerticalLayout {
                                        if !b.code : Label {
                                            text: b.text;
                                            color: Theme.text-mid;
                                        }
                                        if b.code : codecell := Rectangle {
                                            // flipped true for ~1.2s after a copy → swaps the glyph to a ✓
                                            property <bool> copied;
                                            background: Theme.well;
                                            border-radius: Theme.radius-sm;
                                            border-width: Theme.hair;
                                            border-color: Theme.line;
                                            clip: true;
                                            HorizontalLayout {
                                                padding: 10px;
                                                // a READ-ONLY TextInput (not a Text): renders identical to the
                                                // editor's CodeArea, but the snippet is now SELECTABLE (drag /
                                                // Ctrl-C) and is the clipboard source the copy button drives.
                                                codeti := TextInput {
                                                    text: b.text;
                                                    read-only: true;
                                                    color: Theme.text;
                                                    font-family: Theme.mono;
                                                    font-size: Theme.fs-data;
                                                    single-line: false;
                                                    wrap: no-wrap;   // preserve indentation + comment alignment
                                                }
                                                Rectangle {}   // soak leftover width so the cell spans the card
                                            }
                                            // ── floating COPY button — pinned top-right, painted OVER the cell
                                            // (declared after the layout). The snippet literally says "paste it";
                                            // this is the one-click path. copy() writes the selection to the OS
                                            // clipboard via the winit backend, then we drop the highlight so the
                                            // cell reads clean; the Timer flips the ✓ back to the glyph.
                                            copybtn := Rectangle {
                                                x: parent.width - self.width - 6px;
                                                y: 6px;
                                                width: 22px;
                                                height: 22px;
                                                border-radius: Theme.radius-sm;
                                                background: cta.has-hover || codecell.copied ? Theme.well-hi
                                                    : Theme.bg-2.with-alpha(0.75);
                                                border-width: Theme.hair;
                                                border-color: cta.has-hover ? Theme.line : Theme.line.with-alpha(0.5);
                                                animate background, border-color { duration: Theme.quick; }
                                                // custom copy mark — two offset sheets (front + the L of the sheet
                                                // behind), hand-authored as SVG path commands so it tints with the
                                                // theme and brightens on hover. Hidden once copied.
                                                Path {
                                                    visible: !codecell.copied;
                                                    x: 5px;
                                                    y: 5px;
                                                    width: 12px;
                                                    height: 12px;
                                                    viewbox-width: 24;
                                                    viewbox-height: 24;
                                                    fill: transparent;
                                                    stroke: cta.has-hover ? Theme.text : Theme.text-dim;
                                                    stroke-width: 1.3px;
                                                    // front sheet (closed) + the L of the sheet behind (open),
                                                    // straight-line only — crisp at 12px, on the mono grain
                                                    commands: "M9 9 H20 V20 H9 Z M6 15 H4 V4 H15 V6";
                                                    animate stroke { duration: Theme.quick; }
                                                }
                                                // the copied ✓ — a hand-drawn check, shown briefly after a copy
                                                Path {
                                                    visible: codecell.copied;
                                                    x: 5px;
                                                    y: 5px;
                                                    width: 12px;
                                                    height: 12px;
                                                    viewbox-width: 24;
                                                    viewbox-height: 24;
                                                    fill: transparent;
                                                    stroke: Theme.accent;
                                                    stroke-width: 1.7px;
                                                    commands: "M5 13 L9 17 L19 6";
                                                }
                                                cta := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => {
                                                        codeti.select-all();
                                                        codeti.copy();
                                                        codeti.clear-selection();
                                                        codecell.copied = true;
                                                    }
                                                }
                                                // single-shot reset — runs only while `copied`, then clears it
                                                Timer {
                                                    interval: 1200ms;
                                                    running: codecell.copied;
                                                    triggered => { codecell.copied = false; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // ── TAB DOCK — a genuinely FLOATING island, absolutely overlaid on the card instead of
            // living in its own reserved footer row. The old reserved strip read as a permanent black
            // chin under the guide even when nothing needed it; this way the body keeps the card's
            // full height (the scrollable content runs right underneath, and the last inch of a long
            // guide simply scrolls in behind the pill) and the pill only ever costs the screen space
            // it actually occupies. Surfaces only when this guide has more than one tab.
            for g in GuideContent.guides : Rectangle {
                if g.id == State.guide-active-id && g.tabs.length > 1 : HorizontalLayout {
                    x: 0;
                    y: gcard.height - self.height - 10px;
                    width: gcard.width;
                    height: 30px;
                    alignment: center;
                    // the pill itself: fixed-width cells (the labels are short curated words, not
                    // arbitrary text), so the active mark can glide as ONE piece between them by
                    // simple arithmetic instead of measuring neighbours. A soft drop-shadow lifts it
                    // off whatever's scrolling underneath instead of reading flush with the card.
                    dock := Rectangle {
                        property <length> cell-w: 80px;
                        property <int> tab-idx: clamp(State.guide-active-tab, 0, g.tabs.length - 1);
                        height: 30px;
                        width: dock.cell-w * g.tabs.length;
                        border-radius: self.height / 2;
                        // a hair short of opaque — enough that a scrolling line of code underneath
                        // never fights the tab labels for legibility, but still a whisper glassy
                        // rather than a flat opaque slab pretending it isn't floating over content.
                        background: Theme.bg-2.with-alpha(0.94);
                        border-width: Theme.hair;
                        border-color: Theme.line;
                        drop-shadow-color: Theme.bg.with-alpha(0.8);
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        // the MARK — one capsule that glides + settles under the active label, instead
                        // of N cells each independently cross-fading their own fill (which read as a
                        // static swap, not a slide). Inset 4px on every side — clear of the dock's own
                        // rounded ends, so the two radii never collide into a mismatched-corner seam.
                        mark := Rectangle {
                            y: 4px;
                            height: dock.height - 8px;
                            width: dock.cell-w - 8px;
                            x: dock.tab-idx * dock.cell-w + 4px;
                            border-radius: self.height / 2;
                            background: Theme.accent-glow;
                            border-width: Theme.hair;
                            border-color: Theme.accent-line;
                            // a decisive glide that settles without overshoot (the app's motion rule:
                            // mechanical, not bouncy) — quick departure, soft arrival.
                            animate x { duration: 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        }
                        HorizontalLayout {
                            for t[i] in g.tabs : cell := Rectangle {
                                property <bool> on: dock.tab-idx == i;
                                width: dock.cell-w;
                                Text {
                                    text: t.label;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    color: cell.on ? Theme.accent
                                        : (tabta.has-hover ? Theme.text-mid : Theme.text-dim);
                                    font-family: Theme.mono;
                                    font-size: Theme.fs-small;
                                    font-weight: 700;
                                    letter-spacing: Theme.track-2;
                                    animate color { duration: Theme.quick; }
                                }
                                tabta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { State.guide-active-tab = i; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
