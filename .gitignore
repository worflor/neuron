# Rust build output
/target/

# Runtime diagnostics and crash artifacts
*.dmp
*.mdmp
neuron-crash.log
/diagnostics/

# Local/generated runtime state
/runtime/host/__pycache__/
**/__pycache__/
*.py[cod]

# Scratch screenshots and generated visual probes
/_*.png
/runtime/_*.png

# Local editor/OS noise
.DS_Store
Thumbs.db

# Logs + scratch probes (session diagnostics)
*.log
/_*.log

# Session scratch dirs (audio auditions, screenshots)
/_audio/
/_shots/

# Stray redirect artifact
/null

# Per-user RUNTIME + PERSONAL state — generated by the app, never source. May hold personal
# binds / recorded macros / device exports, so it stays out of version control entirely.
/runtime/
/backups/
/macros/
/reference/
/profiles/

# Live user config — the app writes these from defaults; personal binds don't belong in source.
# (covers both the repo root and the per-crate dev copies)
cast.toml
apps.toml
bindings.toml
feel.toml
gestures.json
app.toml

